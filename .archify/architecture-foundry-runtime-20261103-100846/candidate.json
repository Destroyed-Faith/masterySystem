  "cards": [
    {
      "dot": "emerald",
      "title": "Primary path",
      "items": [
        "Player opens the token HUD, picks a target, and gets an attack chat card.",
        "Roll on a hit opens damage resolution, which writes health through the GM relay.",
        "MasteryActor is the document Foundry persists."
      ]
    },
    {
      "dot": "rose",
      "title": "Trust",
      "items": [
        "If the current user can update the actor, the relay calls actor.update directly.",
        "Otherwise it emits gmActorUpdate. The handler returns unless that client is a GM.",
        "Relayed keys are health, stress, status, phases, and mastery-system flags.",
        "An active GM is required; the relay times out when none is connected."
      ]
    },
    {
      "dot": "slate",
      "title": "Outside this path",
      "items": [
        "Foundry loads dist/module.js from system.json. The same host brokers the socket.",
        "Character sheets, compendium packs, rituals, the calendar, and particle effects register at init and are not on the attack path."
      ]
    }
  ]
