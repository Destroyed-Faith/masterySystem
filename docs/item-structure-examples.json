    "inventorySizeExamples": {
      "description": "Mögliche Werte für inventorySize:",
      "values": [
        "1x1 - Standard-Größe (1 Feld)",
        "2x1 - Horizontal (2 Felder nebeneinander)",
        "1x2 - Vertikal (2 Felder übereinander)",
        "2x2 - Quadrat (4 Felder)",
        "L - L-förmig (3 Felder in L-Form)",
        "3x1 - Horizontal lang (3 Felder)",
        "1x3 - Vertikal lang (3 Felder)",
        "3x2 - Rechteck (6 Felder)",
        "2x3 - Rechteck vertikal (6 Felder)"
      ]
    },

