        "\"\" - Kein Basis-Schaden (leer)"
      ]
    },

    "artifactPowerTypes": {
      "description": "Power-Typen für Artefakt-Powers (wie normale Powers):",
      "types": [
        "active - Aktive Power, die eine Aktion kostet",
        "buff - Buff-Power, die einen temporären Bonus gibt",
        "utility - Utility-Power für spezielle Zwecke",
        "passive - Passive Power, die ständig aktiv ist",
        "reaction - Reaktions-Power, die als Reaktion verwendet wird",
        "movement - Bewegungs-Power"
      ],
      "tags": [
        "spell - Markiert die Power als Zauber",
        "charged - Power hat Ladungen/Charges"
      ]
    }
