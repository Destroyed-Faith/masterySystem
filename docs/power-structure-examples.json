    "howToIdentifyPowerType": {
      "description": "So identifizierst du den Power-Typ:",
      "steps": [
        "1. Prüfe item.type === 'power' (auf Item-Ebene)",
        "2. Prüfe item.system.powerType (im system-Objekt)",
        "3. Mögliche Werte: 'active', 'buff', 'utility', 'passive', 'reaction', 'movement'"
      ],
      "codeExample": "const powerType = item.system.powerType; // z.B. 'active'"
    },

    "howToCheckProperties": {
      "description": "So prüfst du Power-Eigenschaften:",
      "examples": {
        "isSpell": "item.system.tags.includes('spell')",
        "isCharged": "item.system.tags.includes('charged')",
        "hasCharges": "item.system.cost.charges > 0",
        "costsAction": "item.system.cost.action === true",
        "costsStones": "item.system.cost.stones > 0",
        "hasDamage": "item.system.roll.damage !== ''",
        "hasHealing": "item.system.roll.healing !== ''",
        "isPassive": "item.system.powerType === 'passive'",
        "isActive": "item.system.powerType === 'active'",
        "isBuff": "item.system.powerType === 'buff'"
      }
    }
