{
  "powerStructureExplanation": {
    "description": "Vollständige Erklärung der Power-Struktur im Mastery System",
    
    "itemLevel": {
      "description": "Auf Item-Ebene (oberste Ebene):",
      "fields": {
        "name": "string - Name der Power",
        "type": "string - MUSS 'power' sein, um als Power erkannt zu werden",
        "img": "string - Pfad zum Bild",
        "system": "object - Enthält alle Power-spezifischen Daten (siehe unten)"
      }
    },

    "systemLevel": {
      "description": "Im system-Objekt (Power-spezifische Daten):",
      "fields": {
        "powerType": "string - Der Typ der Power: 'active' | 'buff' | 'utility' | 'passive' | 'reaction' | 'movement'",
        "level": "number - Level der Power (1-5 typischerweise)",
        "tree": "string - Zu welcher Power-Tree gehört sie (z.B. 'Berserker', 'Crane', etc.)",
        "tags": "string[] - Array von Tags (z.B. ['spell', 'charged'])",
        "range": "string - Reichweite (z.B. '0m', '30m', 'Self')",
        "aoe": "string - Area of Effect (z.B. '5m Radius', '10m Cone')",
        "duration": "string - Dauer (z.B. 'instant', '5 Runden', 'permanent')",
        "effect": "string - Beschreibung der Wirkung",
        "specials": "string[] - Array mit maximal 3 Special-Eigenschaften",
        "ap": "number - Action Points (typischerweise 20-40)",
        "cost": {
          "action": "boolean - Kostet eine Aktion?",
          "movement": "boolean - Kostet Bewegung?",
          "reaction": "boolean - Kostet eine Reaktion?",
          "stones": "number - Anzahl benötigter Attribute Stones",
          "charges": "number - Anzahl benötigter Charges"
        },
        "roll": {
          "attribute": "string - Welches Attribut wird gewürfelt (z.B. 'might', 'intellect')",
          "tn": "number - Target Number (Schwierigkeit)",
          "damage": "string - Schadensformel (z.B. '2d8', '4d8+2')",
          "healing": "string - Heilungsformel (z.B. '1d6', '2d8+3')",
          "raises": "string - Beschreibung was bei Raises passiert"
        },
        "requirements": {
          "masteryRank": "number - Benötigter Mastery Rank",
          "other": "string - Weitere Anforderungen (z.B. 'Berserker Level 3')"
        },
        "description": "string - Allgemeine Beschreibung",
        "inventorySize": "string - Inventar-Größe (z.B. '1x1')",
        "baseDamage": "string - Basis-Schaden (z.B. '2d8' oder leer)",
        "specials": "string[] - Specials (maximal 3)"
      }
    },

    "powerTypeExplanation": {
      "description": "Erklärung der Power-Typen:",
      "types": {
        "active": {
          "description": "Aktive Power, die eine Aktion kostet",
          "typicalCost": "action: true",
          "useCase": "Angriffe, direkte Effekte"
        },
        "buff": {
          "description": "Buff-Power, die temporäre Boni gibt",
          "typicalCost": "action: true",
          "useCase": "Temporäre Stat-Verbesserungen, Schutz-Buffs"
        },
        "utility": {
          "description": "Utility-Power für spezielle Zwecke",
          "typicalCost": "action: true",
          "useCase": "Teleport, Heilen, Status-Effekte entfernen"
        },
        "passive": {
          "description": "Passive Power, die ständig aktiv ist",
          "typicalCost": "action: false, movement: false, reaction: false",
          "useCase": "Ständige Boni, Regeneration, Immunitäten"
        },
        "reaction": {
          "description": "Reaktions-Power, die als Reaktion verwendet wird",
          "typicalCost": "reaction: true",
          "useCase": "Parry, Counter, Defensive Reaktionen"
        },
        "movement": {
          "description": "Bewegungs-Power",
          "typicalCost": "movement: true",
          "useCase": "Sprint, Dash, Teleport-Bewegung"
        }
      }
    },

    "tagsExplanation": {
      "description": "Häufige Tags für Powers:",
      "tags": {
        "spell": "Markiert die Power als Zauber (für Magie-System)",
