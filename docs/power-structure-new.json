    "mergedPrimitivesV1": {
      "description": "Rückwärtskompatible Erweiterung (Primitive-Merge): externe Vorschläge landen in bestehenden Typen — kein zweites `area`-Feld; logisches „area“ = `aoe` / AoeSpec.",
      "consistencyRules": [
        "1 specials: Kanonisch nur { key (lowercase), rank?, raiseCost?, note?, … } in levels[n].specials. type/value nur Import; persistPowerMechanics / normalizePowerSpecial entfernen Aliase.",
        "2 specials-Quelle: Direkte Effekte nur levels[n].specials. mechanics enthält keine parallele Liste derselben Effekte; Ausnahme: grantNextHitEffect.specials (Rider). modifySpecial / healing / Limits bleiben in mechanics.",
        "3 condition: Entweder mechanics.condition (Enum) ODER mechanics.conditionExpr (frei). Beide gleichzeitig nicht nötig; beim Speichern wird conditionExpr verworfen, wenn condition gesetzt ist.",
        "4 limits: Kanonisch nur mechanics.usageLimit. triggerLimit nur Import-Alias → wird beim Speichern in usageLimit übernommen und entfernt.",
        "5 aoe: radiusM und sizeM nicht parallel persistieren (radius|aura|zone: radiusM gewinnt; sizeM nur Import-Fallback → radiusM).",
        "6 Ebenen: levels[n].type = Delivery; range / aoe / duration getrennt; system.roll.kind = Wurfart.",
        "7 effect.text: rein narrativ, niemals Source of Truth für Regeln."
      ],
      "synonyms": {
        "specials": "Import: type→key, value→rank, key lowercasing. Persistenz: nur key/rank.",
        "area": "Entspricht levels[n].aoe (AoeSpec): center, targetFilter, shape zone, …",
        "triggerLimit": "Nur Import-Alias zu mechanics.usageLimit — beim Speichern zusammenführen, Feld entfernen."
      },
      "powerSpecialExtended": {
        "key": "string (kanonisch, lowercase nach Normalisierung)",
        "type": "deprecated Import-Alias für key",
        "rank": "number? (kanonisch für Stärke)",
        "value": "deprecated Import-Alias für rank",
        "raiseCost": "number?",
        "note": "string?",
        "target": "string?",
        "condition": "string?",
        "duration": "string?",
        "applyOn": "string? — z.B. onHit, onSaveFail"
      },
      "aoeSpecExtended": {
        "shape": "… | 'zone'",
        "radiusM": "number? — bei radius/aura/zone (nicht parallel zu sizeM persistieren)",
        "sizeM": "number? — nur Import-Fallback, wird zu radiusM normalisiert",
        "lengthM": "number? — cone/line",
        "widthM": "number? — line",
        "angleDeg": "number? — cone",
        "center": "'self' | 'targetPoint' | 'targetCreature'?",
        "targetFilter": "'enemies' | 'allies' | 'allCreatures' | 'self' | 'sameAsAttackTarget' | 'attacker'"
      },
      "powerMechanicsTriggerSuggested": [
        "onUse",
        "onHit",
        "onMiss",
        "endOfTurn",
        "startOfTurn",
        "afterAttack",
        "onSaveFail",
        "onIgniteTickByYou"
      ],
      "powerMechanicsExtended": {
        "healing": "{ flat?, target?, condition?, trigger?, maxTargets? }",
        "modifySpecial": "{ type, mode, amount?, minExisting?, maxValue?, target?, condition? } — mode: increaseExisting | decreaseExisting | setIfHigher | consume | remove | refreshDuration",
        "grantNextHitEffect": "{ expires, qualifier?, damageRiderFlat?, specials?: PowerSpecial[], condition? } — Standard für next-hit/next-spell",
        "conditionExpr": "Freie Bedingung nur wenn mechanics.condition nicht reicht; nicht redundant zu condition setzen",
        "trigger": "Siehe powerMechanicsTriggerSuggested (+ erweiterbar)",
        "usageLimit": "{ per: 'round'|'combat'|'day', max: number }? — einziges kanonisches Limit-Feld"
      },
      "durationKindSuggested": [
        "instant",
        "endOfTurn",
        "untilStartOfNextTurn",
        "rounds",
        "masteryRounds",
        "masteryRankRounds",
        "untilNextTurn",
        "untilUsed",
        "untilBroken",
        "scene"
      ],
      "exampleHealingAoe": {
        "aoe": {
          "shape": "radius",
          "radiusM": 4,
          "center": "targetPoint",
          "targetFilter": "allies"
        },
        "mechanics": {
          "applyWhen": "activeBuff-active",
          "healing": {
            "flat": "3d8",
            "target": "alliesInArea",
            "trigger": "onUse"
          }
        }
      },
      "exampleModifySpecial": {
        "mechanics": {
          "applyWhen": "passive-slotted-active",
          "modifySpecial": {
            "type": "ignite",
            "mode": "increaseExisting",
            "amount": 2,
            "minExisting": 1
          }
        }
      },
      "exampleGrantNextHit": {
        "mechanics": {
          "applyWhen": "activeBuff-active",
          "grantNextHitEffect": {
            "expires": "endOfTurn",
            "qualifier": "nextHit",
            "damageRiderFlat": "+2d8",
            "specials": [
              { "key": "ignite", "rank": 2 }
            ]
          }
        }
      }
    },

    "structureExplanation": {
      "powerRoot": {
        "name": "string - Anzeigename der Power (inkl. chosen-Special-Suffix bei Actives)",
        "templateId": "string - Kanonische Template-ID (z.B. 'movement-teleport', 'active-melee-damage-t3')",
        "templateName": "string - Template-Display-Name ohne chosen-Special-Suffix",
        "subfamily": "string - Feingranulares Subfamily-Label (z.B. 'teleport', 'damage-aoe', 'conditional-combined')",
        "category": "'active' | 'activeBuff' | 'utility' | 'reaction' | 'passive' | 'movement'",
        "tags": "string[] - z.B. ['spell', 'charged']",
        "chosenSpecial": "{ key: string, tier: 3|4|5|6 }? - nur bei Actives nach Pick gesetzt",
        "isSpell": "boolean? - Active-as-Spell: in Charaktererschaffung aktiviert",
        "castingAttribute": "'intellect' | 'resolve'? - Pflicht wenn isSpell=true",
        "spellResolution": "'spellAttack' | 'saveSpell'? - Resolution-Modus",
        "spellSaveType": "'body' | 'mind' | 'spirit'? - nur bei spellResolution='saveSpell'",
        "overcast": "number? - reservierte Raise-Aufladung (Spec noch offen)",
        "rank": "number - Aktuelles Level (1-16). Max cast/learn = MasteryRank × 2.",
        "trigger": "string? - Für Reactions: Trigger-Bedingung",
        "cost": {
          "action": "'attack' | 'utility' | 'reaction' | 'movement' | 'full'",
          "stones": "number? - Anzahl Attribute Stones",
          "charges": "number? - Anzahl Charges (bei 'charged' Tag)",
          "note": "string? - Zusätzliche Notizen"
        },
        "roll": {
          "kind": "'attack' | 'contest' | 'check' | 'none'",
          "attribute": "string? - z.B. 'might', 'intellect'",
          "vs": "string? - z.B. 'evade' oder 'save:body'"
        },
        "levels": {
          "1..16": "PowerLevelRow - Deterministisch aus Templates generiert; Keys '1'..'16'."
        }
      },
      "powerLevelRow": {
        "lvl": "1..16",
        "type": "string - 'melee' | 'ranged' | 'utility' | 'buff' | 'reaction' | 'passive' | 'movement'",
        "range": "RangeSpec",
        "aoe": "AoeSpec",
        "duration": "DurationSpec",
        "effect": "EffectSpec",
        "specials": "PowerSpecial[]",
        "raiseUpgrades": "RaiseUpgrade[]?",
        "trigger": "string? - Für Reactions"
      },
      "rangeSpec": {
        "kind": "'self' | 'touch' | 'distance'",
        "m": "number? - Nur bei kind='distance'",
        "note": "string? - z.B. 'below 8m counts as melee'"
      },
      "aoeSpec": {
        "shape": "'none' | 'single' | 'line' | 'radius' | 'cone' | 'weapon' | 'aura' | 'zone'",
        "radiusM": "number? - Bei radius/aura/zone",
        "sizeM": "number? - Alias zu radiusM (Import/Doku)",
        "lengthM": "number? - Bei line/cone",
        "widthM": "number? - Bei line",
        "angleDeg": "number? - Bei cone",
        "targets": "number? - z.B. bei weapon (Anzahl, nicht Zielfilter)",
        "targetFilter": "'enemies' | 'allies' | 'allCreatures' | 'self' | 'sameAsAttackTarget' | 'attacker'?",
        "center": "'self' | 'targetPoint' | 'targetCreature'?",
        "note": "string?"
      },
      "durationSpec": {
        "kind": "Siehe mergedPrimitivesV1.durationKindSuggested (u.a. instant, endOfTurn, untilStartOfNextTurn, rounds, masteryRankRounds, untilUsed, untilBroken, scene)",
        "rounds": "number? - Bei kind='rounds'",
        "note": "string?"
      },
      "effectSpec": {
        "text": "string - Nur narrativ / UI — niemals Source of Truth für Regeln (SoT: mechanics, specials, aoe, range, duration)",
        "dice": "string? - Optional untyped Xd8 (z.B. '2d8')",
        "tempHpDice": "string? - Optional '1d8' etc für Temp HP",
        "flat": "number? - Optional für +Armor/+Evade etc",
        "notes": "string?"
      },
      "powerSpecial": {
        "key": "string - kanonisch lowercase nach Normalisierung, z.B. push, shock, ignite",
        "type": "string? - nur Import-Alias",
        "rank": "number? - Stack/Rang (kanonisch)",
        "value": "number? - nur Import-Alias für rank",
        "raiseCost": "number - Kosten in Raises",
        "note": "string?",
        "target": "string?",
        "condition": "string?",
        "duration": "string?",
        "applyOn": "string?"
      },
      "raiseUpgrade": {
        "kind": "'rangePlus' | 'aoeRadiusPlus' | 'specialPlus' | 'custom'",
        "m": "number? - Bei rangePlus/aoeRadiusPlus",
        "key": "string? - Bei specialPlus",
        "delta": "number? - Bei specialPlus",
        "text": "string? - Bei custom",
        "raiseCost": "number - Kosten in Raises"
      }
    }
  }
}

