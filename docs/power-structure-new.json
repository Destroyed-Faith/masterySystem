    "structureExplanation": {
      "powerRoot": {
        "name": "string - Name der Power",
        "category": "'active' | 'activeBuff' | 'utility' | 'reaction' | 'passive' | 'movement'",
        "tags": "string[] - z.B. ['spell', 'charged']",
        "rank": "number - Aktuelles Level (1-4)",
        "trigger": "string? - Für Reactions: Trigger-Bedingung",
        "cost": {
          "action": "'attack' | 'utility' | 'reaction' | 'movement' | 'full'",
          "stones": "number? - Anzahl Attribute Stones",
          "charges": "number? - Anzahl Charges (bei 'charged' Tag)",
          "note": "string? - Zusätzliche Notizen"
        },
        "roll": {
          "kind": "'attack' | 'contest' | 'check' | 'none'",
          "attribute": "string? - z.B. 'might', 'intellect'",
          "vs": "string? - z.B. 'evade' oder 'save:body'"
        },
        "levels": {
          "1": "PowerLevelRow",
          "2": "PowerLevelRow",
          "3": "PowerLevelRow",
          "4": "PowerLevelRow"
        }
      },
      "powerLevelRow": {
        "lvl": "1 | 2 | 3 | 4",
        "type": "string - 'melee' | 'ranged' | 'utility' | 'buff' | 'reaction' | 'passive' | 'movement'",
        "range": "RangeSpec",
        "aoe": "AoeSpec",
        "duration": "DurationSpec",
        "effect": "EffectSpec",
        "specials": "PowerSpecial[]",
        "raiseUpgrades": "RaiseUpgrade[]?",
        "trigger": "string? - Für Reactions"
      },
      "rangeSpec": {
        "kind": "'self' | 'touch' | 'distance'",
        "m": "number? - Nur bei kind='distance'",
        "note": "string? - z.B. 'below 8m counts as melee'"
      },
      "aoeSpec": {
        "shape": "'none' | 'single' | 'line' | 'radius' | 'cone' | 'weapon' | 'aura'",
        "radiusM": "number? - Bei radius/aura",
        "lengthM": "number? - Bei line/cone",
        "widthM": "number? - Bei line",
        "angleDeg": "number? - Bei cone",
        "targets": "number? - z.B. bei weapon",
        "note": "string?"
      },
      "durationSpec": {
        "kind": "'instant' | 'rounds' | 'masteryRankRounds' | 'untilNextTurn'",
        "rounds": "number? - Bei kind='rounds'",
        "note": "string?"
      },
      "effectSpec": {
        "text": "string - UI-Spalte 'Effect' (z.B. 'Weapon DMG +2d8', '+2d8 Heal')",
        "dice": "string? - Optional untyped Xd8 (z.B. '2d8')",
        "tempHpDice": "string? - Optional '1d8' etc für Temp HP",
        "flat": "number? - Optional für +Armor/+Evade etc",
        "notes": "string?"
      },
      "powerSpecial": {
        "key": "string - z.B. 'Push', 'Shock', 'Ignite', 'Prone', 'Bleeding', 'Crit', 'Mark'",
        "value": "number? - Zahl in Klammern, z.B. Push(3) -> 3",
        "raiseCost": "number - Kosten in Raises",
        "note": "string?"
      },
      "raiseUpgrade": {
        "kind": "'rangePlus' | 'aoeRadiusPlus' | 'specialPlus' | 'custom'",
        "m": "number? - Bei rangePlus/aoeRadiusPlus",
        "key": "string? - Bei specialPlus",
        "delta": "number? - Bei specialPlus",
        "text": "string? - Bei custom",
        "raiseCost": "number - Kosten in Raises"
      }
    }
  }
