{
  "id": "mastery-system",
  "title": "Mastery System / Destroyed Faith",
  "description": "A dark fantasy tabletop RPG system featuring Roll & Keep dice mechanics, Attribute Stones, Mastery Ranks, and divine power progression.",
  "version": "0.9.391",
  "template": "template.json",
  "logo": "assets/logo.png",
  "banner": "assets/banner.jpg",
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "authors": [
    {
      "name": "Daniel Rodrigo Navarro Melendo",
      "url": "https://github.com/Destroyed-Faith/masterySystem"
    }
  ],
  "media": [
    {
      "type": "setup",
      "url": "assets/banner.jpg",
      "thumbnail": "assets/logo.png",
      "caption": "Mastery System / Destroyed Faith"
    }
  ],
  "esmodules": [
    "dist/module.js"
  ],
  "styles": [
    "styles/mastery.css",
    "styles/mastery-themes.css",
    "styles/character-sheet.css",
    "styles/character-print.css",
    "styles/npc-print.css",
    "styles/chat.css",
    "styles/overlays.css",
    "styles/xp-management.css",
    "styles/combat-carousel.css",
    "styles/combat-tracker.css",
    "styles/stone-powers-dialog.css",
    "styles/summon-sheet.css",
    "styles/df-rulebook-ui.css",
    "styles/artifacts.css",
    "styles/tower-wizard.css",
    "styles/item-info-dialog.css",
    "styles/encounter-generator.css",
    "styles/character-import.css",
    "styles/epic-mastery-roll.css",
    "styles/tyhra-calendar.css",
    "styles/summon-bond-dialog.css",
    "styles/ritual-workshop-dialog.css",
    "styles/minor-magic-dialog.css",
    "styles/scene-editor.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "de",
      "name": "Deutsch",
      "path": "lang/de.json"
    }
  ],
  "packs": [
    {
      "name": "echo-artifacts",
      "label": "Echo Artifacts",
      "path": "packs/echo-artifacts",
      "type": "Item",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    }
  ],
  "documentTypes": {
    "Actor": {
      "character": {},
      "npc": {},
      "summon": {}
    },
    "Item": {
      "power": {},
      "echo": {},
      "schtick": {},
      "artifact": {},
      "condition": {},
      "weapon": {},
      "armor": {},
      "shield": {},
      "gear": {}
    }
  },
  "socket": true,
  "initiative": "1d20 + @combat.initiative",
  "gridDistance": 1,
  "gridUnits": "m",
  "primaryTokenAttribute": "health",
  "secondaryTokenAttribute": "stress",
  "url": "https://github.com/Destroyed-Faith/masterySystem",
  "manifest": "https://raw.githubusercontent.com/Destroyed-Faith/masterySystem/main/system.json",
  "download": "https://github.com/Destroyed-Faith/masterySystem/releases/download/v0.9.391/mastery-system-0.9.391.zip",
  "license": "LICENSE.md",
  "readme": "README.md",
  "bugs": "https://github.com/Destroyed-Faith/masterySystem/issues",
  "changelog": "CHANGELOG.md"
}
