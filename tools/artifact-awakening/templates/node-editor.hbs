<div class="node-editor-wrapper">

<form>

    <h2>Node: {{name}}</h2>

    <h3>Current Activities</h3>
    {{#if activities.length}}
        {{#each activities}}
            <div>
                <button type="button" class="edit-activity" data-index="{{@index}}">
                    {{name}} ({{type}})
                    <i class="fas fa-trash remove-activity" data-index="{{@index}}"></i>
                </button>
            </div>
        {{/each}}
    {{else}}
        <p>No activities yet.</p>
    {{/if}}

    <hr>

    <h3>Add Activity</h3>
    {{#each availableActivities}}
        <div>
            <input type="radio" name="newActivity" value="{{this}}" id="activity-{{this}}">
            <label for="activity-{{this}}">{{this}}</label>
        </div>
    {{/each}}

    <button type="button" id="add-activity">Add Activity</button>
</form>
</div>
