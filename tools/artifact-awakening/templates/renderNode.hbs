
{{#each artifact.nodes as |node|}}
    {{#ifEquals node.id ../nodeId}}
        <div class="node" data-node-id="{{node.id}}">
            <strong>{{node.name}}</strong><br>
            <button type="button" class="edit-node">Edit</button>
            <button type="button" class="add-child-node" data-parent="{{node.id}}">+ Add Child</button>
            <div class="children">
                {{#each node.children as |childId|}}
                    {{> renderNode nodeId=childId}}
                {{/each}}
            </div>
        </div>
    {{/ifEquals}}
{{/each}}
