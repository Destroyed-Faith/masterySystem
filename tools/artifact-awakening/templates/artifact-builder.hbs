<section class="window-content">

    <header class="window-header flexrow draggable" style="flex:none">
        <h4 class="window-title">
            {{artifact.name}}  <!-- Oder einfach "Artifact Builder", wenn kein Name -->
        </h4>

        <div class="header-elements">
            <div class="source-book">
                <a class="config-button" data-action="source" title="Configure Source" hidden>
                    <i class="fas fa-cog"></i>
                </a>
                <span></span>
            </div>
        </div>

        <a class="pseudo-header-button state-toggle toggle-equipped" title="Equipped">
            <i class="fas fa-shield-halved"></i>
        </a>
        <a class="pseudo-header-button state-toggle toggle-identified active" title="Identified">
            <i class="fas fa-wand-sparkles"></i>
        </a>
        <a class="document-id-link pseudo-header-button" title="Copy Document UUID">
            <i class="fa-solid fa-passport"></i>
        </a>
        <a class="header-button control configure-sheet" title="Sheet Config">
            <i class="fas fa-cog"></i>
        </a>
        <a class="header-button control close" title="Close">
            <i class="fas fa-times"></i>
        </a>
    </header>

    <div class="sheet-header" style="height:auto">

        <div class="left" >
            <img class="item-image" src="{{#if artifact.img}}{{artifact.img}}{{else}}icons/svg/mystery-man.svg{{/if}}"
                 data-edit="img" alt="{{artifact.name}}">
        </div>

        <div class="middle identity-info">
            <input type="text" name="name" value="{{artifact.name}}" placeholder="New Item">
            <span class="save-artifact-name" title="Name speichern" style="cursor: pointer;">
                <i class="fas fa-check-circle"></i>
            </span>
            <ul class="subtitles unlist">
                <li>
                    <label>Rarity:</label>
                    <select name="rarity">
                        <option value="">None</option>
                        <option value="common" {{#ifEquals artifact.rarity "common"}}selected{{/ifEquals}}>Common
                        </option>
                        <option value="uncommon" {{#ifEquals artifact.rarity "uncommon"}}selected{{/ifEquals}}>
                            Uncommon
                        </option>
                        <option value="rare" {{#ifEquals artifact.rarity "rare"}}selected{{/ifEquals}}>Rare</option>
                        <option value="veryRare" {{#ifEquals artifact.rarity "veryRare"}}selected{{/ifEquals}}>Very
                            Rare
                        </option>
                        <option value="legendary" {{#ifEquals artifact.rarity "legendary"}}selected{{/ifEquals}}>
                            Legendary
                        </option>
                        <option value="artifact" {{#ifEquals artifact.rarity "artifact"}}selected{{/ifEquals}}>
                            Artifact
                        </option>
                    </select>
                </li>
                <li style="flex: 1 1 auto;">
                    <label>Actor Allocation:</label>
                    <div class="actor-allocation-row" style="display: flex; gap: 0.5em; align-items: center;">
                        <select class="actor-select">
                            <option value="">-- Actor wählen --</option>
                            {{#each actors}}
                                <option value="{{this.id}}" {{#ifEquals this.id ../assignedActorId}}selected{{/ifEquals}}>{{this.name}}</option>
                            {{/each}}
                        </select>
                        <select class="actor-visible-level">
                            {{#each levels}}
                                <option value="{{this}}" {{#ifEquals this ../assignedLevel}}selected{{/ifEquals}}>Level {{this}}</option>
                            {{/each}}
                        </select>
                        <span class="save-actor-level" style="cursor: pointer;" title="Speichern">
        <i class="fas fa-wand-sparkles"></i>
    </span>
                    </div>

                </li>
            </ul>
        </div>

        <div class="right common-fields physical">

            <div class="quantity">
                <span class="separator">×</span>
                <input type="number" name="quantity" value="{{artifact.quantity}}" min="1">
            </div>

            <div class="weight">
                <input type="number" name="weight" value="{{artifact.weight}}" step="0.1">
                <i class="fas fa-weight-hanging" aria-label="Pounds"></i>
            </div>

            <div class="price">
                <input type="number" name="price" value="{{artifact.price}}" step="0.1">
                <i class="currency gp" aria-label="Gold"></i>
            </div>

        </div>

    </div>

    <div id="node-editor">

        <h2>Artifact Evolution Tree</h2>


        <div class="tree-container">
            {{{treeHTML}}}
        </div>


    </div>


</section>
