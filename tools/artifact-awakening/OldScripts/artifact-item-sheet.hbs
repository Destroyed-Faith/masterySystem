<form class="artifact-item-sheet" autocomplete="off">
    <header class="sheet-header">
        <h1>
            <input name="name" type="text" value="{{item.name}}" placeholder="Artifact Name"/>
        </h1>
        <div class="level-display">
            <label>Artifact Level:</label>
            <input type="number" name="system.level" value="{{system.level}}" min="1" max="10"/>
        </div>
    </header>

    <nav class="sheet-tabs tabs" data-group="primary">
        <a class="item" data-tab="description">Description</a>
        <a class="item" data-tab="details">Details</a>
        <a class="item" data-tab="passives">Passive Bonuses</a>
        <a class="item" data-tab="activities">Activities</a>
        <a class="item" data-tab="effects">Effects</a>
    </nav>

    <section class="sheet-body">

        <div class="tab" data-group="primary" data-tab="description">
            <h2>Description</h2>

            <div class="desc-section">
                <strong>Identified Description</strong>
                <div class="desc-display" data-field="system.description.value">
                    {{{system.description.value}}}
                </div>
                <button type="button" class="edit-description" data-target="system.description.value">
                    Edit
                </button>
            </div>
        </div>

        <!-- DETAILS TAB -->
        <div class="tab" data-group="primary" data-tab="details">
            <h2>Details</h2>

            <div class="form-group">
                <label>Source:</label>
                <input type="text" name="system.source" value="{{system.source}}"/>
            </div>

            <div class="form-group">
                <label>Rarity:</label>
                <select name="system.rarity">
                    <option value="">—</option>
                    <option value="common" {{#if (eq system.rarity "common")}}selected{{/if}}>Common</option>
                    <option value="uncommon" {{#if (eq system.rarity "uncommon")}}selected{{/if}}>Uncommon</option>
                    <option value="rare" {{#if (eq system.rarity "rare")}}selected{{/if}}>Rare</option>
                    <option value="veryRare" {{#if (eq system.rarity "veryRare")}}selected{{/if}}>Very Rare</option>
                    <option value="legendary" {{#if (eq system.rarity "legendary")}}selected{{/if}}>Legendary</option>
                    <option value="artifact" {{#if (eq system.rarity "artifact")}}selected{{/if}}>Artifact</option>
                </select>
            </div>

            <div class="form-group">
                <label>Requires Attunement:</label>
                <input type="checkbox" name="system.attunement" {{checked system.attunement}} />
            </div>

            <div class="form-group">
                <label>Charges:</label>
                <input type="number" name="system.uses.value" value="{{system.uses.value}}"/>
                <span> / </span>
                <input type="number" name="system.uses.max" value="{{system.uses.max}}"/>
            </div>

        </div>

        <!-- PASSIVE BONUSES TAB -->
        <div class="tab" data-group="primary" data-tab="passives">
            <h2>Passive Bonuses</h2>

            <div class="form-group">
                <label>Strength Bonus:</label>
                <input type="number" name="system.passiveBonuses.str" value="{{system.passiveBonuses.str}}"/>
            </div>

            <div class="form-group">
                <label>Dexterity Bonus:</label>
                <input type="number" name="system.passiveBonuses.dex" value="{{system.passiveBonuses.dex}}"/>
            </div>

            <div class="form-group">
                <label>Armor Class Bonus:</label>
                <input type="number" name="system.passiveBonuses.ac" value="{{system.passiveBonuses.ac}}"/>
            </div>

            <div class="form-group">
                <label>Movement Bonus (ft):</label>
                <input type="number" name="system.passiveBonuses.movement" value="{{system.passiveBonuses.movement}}"/>
            </div>
        </div>

        <!-- ACTIVITIES TAB -->
        <div class="tab" data-group="primary" data-tab="activities">
            <h2>Activities</h2>

            <div class="activity-drop-area">
                {{#if system.actions.length}}
                    <ul class="activity-list">
                        {{#each system.actions}}
                            <li>
                                <strong>{{this.name}}</strong> - {{this.type}}
                            </li>
                        {{/each}}
                    </ul>
                {{else}}
                    <p>No activities yet. Click the + button to add one.</p>
                {{/if}}
            </div>

            <button type="button" class="activity-add-button">
                <i class="fas fa-plus"></i> Add Activity
            </button>
        </div>
        <!-- EFFECTS TAB -->
        <div class="tab" data-group="primary" data-tab="effects">
            <h2>Active Effects</h2>
            <p>This Artifact currently has no Active Effects.</p>
        </div>
    </section>

    <footer class="sheet-footer">
        <button type="button" class="level-up-button">
            Level Up Artifact
        </button>
    </footer>
</form>
