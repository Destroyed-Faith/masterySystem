<form class="threadbound-item-sheet" autocomplete="off">
    <header class="sheet-header">
        <h1><input name="name" type="text" value="{{item.name}}" placeholder="Item Name" /></h1>
        <div class="level-up">
            <button type="button" class="level-up-button">Level Up (Cost: 1 Threadpoint)</button>
        </div>
    </header>

    <nav class="sheet-tabs tabs" data-group="primary">
        <a class="item" data-tab="passives">Passives</a>
        <a class="item" data-tab="actives">Actives</a>
        <a class="item" data-tab="upgrades">Upgrades</a>
        <a class="item" data-tab="special">Special</a>
    </nav>

    <section class="sheet-body">

        <div class="tab" data-group="primary" data-tab="passives">
            <h2>Passive Bonuses</h2>
            <ul>
                <li>Strength Bonus: {{system.passiveBonuses.str}}</li>
                <li>Dexterity Bonus: {{system.passiveBonuses.dex}}</li>
                <li>AC Bonus: {{system.passiveBonuses.ac}}</li>
                <li>Movement Bonus: {{system.passiveBonuses.movement}}</li>
            </ul>
        </div>

        <div class="tab" data-group="primary" data-tab="actives">
            <h2>Active Skills</h2>
            {{#each system.skills}}
                <div class="skill-entry">
                    <strong>{{this.name}}</strong> ({{this.type}}) – Unlock: Level {{this.unlockLevel}}<br>
                    <em>{{this.description}}</em>
                </div>
            {{/each}}
        </div>

        <div class="tab" data-group="primary" data-tab="upgrades">
            <h2>Next Upgrade</h2>
            {{#with (lookup system.skills (subtract system.level 0))}}
                {{#if this}}
                    <div class="skill-upgrade">
                        <strong>{{this.name}}</strong> ({{this.type}})<br>
                        <em>{{this.description}}</em>
                    </div>
                {{else}}
                    <p>No further upgrades at this level.</p>
                {{/if}}
            {{/with}}
        </div>

        <div class="tab" data-group="primary" data-tab="special">
            <h2>Set Bonus / Special Ability</h2>
            <p>{{system.setBonus.description}}</p>
        </div>

    </section>
</form>
