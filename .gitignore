# Dependencies
node_modules/

# TypeScript
*.tsbuildinfo

# Editor directories
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment
.env
.env.local
.env.*.local

# Foundry user data (when testing)
packs/*/*.db
packs/*/*.db-shm
packs/*/*.db-wal

# Compiled compendium packs (LevelDB) — build via `npm run build:packs`.
# Echo Artifacts is shipped in-repo so Foundry installs include the compendium.
# Other packs remain build-time only until explicitly added here.

# Temporary files
*.tmp

# Playwright (credentials stay local — never commit Forge/login secrets)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
e2e/.env
e2e/.env.local
e2e/.env.*
!e2e/.env.example

