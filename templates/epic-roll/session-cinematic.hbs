<div class="emr-cinematic-overlay" style="--emr-band-hue: {{bandHue}};">
  <div class="emr-cinematic-scrim"></div>
  <div class="emr-cinematic-band">
    {{#if isGM}}
    <button type="button" class="emr-cinematic-close" data-action="emr-cancel" title="Close Skill Roll">
      <i class="fas fa-times"></i>
    </button>
    {{/if}}

    <header class="emr-cinematic-header">
      <h2 class="emr-cinematic-title">{{session.title}}</h2>
      <p class="emr-cinematic-meta">{{rollLabel}} · {{resolved}}/{{total}} complete</p>
      {{#if session.flavor}}
      <p class="emr-cinematic-flavor">{{session.flavor}}</p>
      {{/if}}
      {{#if showTn}}
      <p class="emr-cinematic-tn">
        TN <strong>{{tn.baseTN}}</strong>
        {{#if (gt tn.raises 0)}}
        · Raise TN <strong>{{add tn.baseTN (multiply tn.raises 4)}}</strong>
        {{/if}}
      </p>
      {{/if}}
    </header>

    <div class="emr-cinematic-portraits">
      {{#each participants as |p|}}
      <div class="emr-portrait-column {{p.status}}">
        <div class="emr-portrait-stack {{#if p.showResultFrame}}emr-has-result{{/if}}">
          <div class="emr-portrait-frame">
            <img class="emr-portrait-img" src="{{p.portrait}}" alt="{{p.actorName}}" crossorigin="anonymous" />
          </div>

          {{#if p.canRoll}}
          <button type="button" class="emr-roll-btn" data-action="emr-roll" data-actor-id="{{p.actorId}}" title="Roll" {{#if ../rolling}}disabled{{/if}}>
            Roll
          </button>
          {{else if p.showRollResult}}
          <div class="emr-roll-result {{#if p.success}}emr-roll-result-success{{else}}emr-roll-result-fail{{/if}}" aria-label="Roll result">
            <span class="emr-roll-result-value">{{p.displayTotal}}</span>
          </div>
          {{#if p.success}}
          <div class="emr-roll-raises-meta">{{p.displayRaises}} Raise{{#unless (eq p.displayRaises 1)}}s{{/unless}}</div>
          {{/if}}
          {{#if p.showDiceFaces}}
          <div class="emr-dice-row" aria-label="Dice rolled">
            {{#each p.diceFaces as |die|}}
            <span class="emr-die {{#if die.kept}}emr-die-kept{{/if}}{{#if die.exploded}} emr-die-exploded{{/if}}" title="{{die.label}}">{{die.label}}</span>
            {{/each}}
          </div>
          {{/if}}
          {{else if p.skipped}}
          <div class="emr-roll-result emr-roll-result-skipped">Skipped</div>
          {{/if}}

          {{#if p.showFailureActions}}
          <div class="emr-failure-actions">
            {{#if p.showReroll}}
            <button type="button" class="emr-reroll-btn" data-action="emr-reroll" data-actor-id="{{p.actorId}}" title="Spend 1 Reroll Point to reroll all dice once" {{#if ../rolling}}disabled{{/if}}>
              <i class="fas fa-sync-alt"></i> Reroll (1 Reroll Point)
            </button>
            {{/if}}
            <button type="button" class="emr-keep-roll-btn" data-action="emr-confirm" data-actor-id="{{p.actorId}}">Keep Roll</button>
          </div>
          {{/if}}

          {{#if p.showFinalMeta}}
          <div class="emr-roll-final-meta">
            {{#if p.result.rerolled}}Rerolled{{/if}}
          </div>
          {{/if}}

          {{#if p.waiting}}
          <div class="emr-waiting-label">Waiting…</div>
          {{/if}}
        </div>

        <div class="emr-portrait-name">{{p.actorName}}</div>
      </div>
      {{/each}}
    </div>
  </div>
</div>
