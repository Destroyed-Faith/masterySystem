<details class="combat-senses-config-details">
  <summary><i class="fas fa-eye"></i> Combat Senses</summary>
  <p class="stat-summary-hint">
    Active in battle: <strong>{{combatSensesPanel.activeSenseLabel}}</strong>.
    The battle sheet lists only senses your character actually has.
  </p>

  <div class="combat-senses-grants">
    {{#each combatSensesPanel.grantedRows}}
    {{#if this.fromArtifact}}
    <div class="combat-sense-grant-row is-artifact">
      <span class="combat-sense-grant-label">{{this.label}} ({{this.rangeM}} m)</span>
      <span class="combat-sense-grant-badge">From artifact</span>
    </div>
    {{else}}
    <label class="combat-sense-grant-row">
      <input
        type="checkbox"
        class="js-combat-sense-grant"
        data-sense-id="{{this.id}}"
        {{#if this.selected}}checked{{/if}}
        {{#unless ../editable}}disabled{{/unless}}
      />
      <span class="combat-sense-grant-label">{{this.label}} ({{this.rangeM}} m)</span>
    </label>
    {{/if}}
    {{/each}}
  </div>

  <label class="combat-sense-darkvision-row">
    <input
      type="checkbox"
      class="js-combat-sense-darkvision"
      {{#if combatSensesPanel.hasDarkvision}}checked{{/if}}
      {{#unless editable}}disabled{{/unless}}
    />
    <span>Darkvision — minor upgrade (augments Normal Combat Awareness in darkness)</span>
  </label>
</details>
