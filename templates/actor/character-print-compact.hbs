<section class="print-page print-page-compact">
  <header class="cpc-id">
    {{#if hasPortrait}}
    <img class="cpc-portrait" src="{{portrait}}" alt="{{name}}" />
    {{/if}}
    <div class="cpc-id-text">
      <h1 class="cpc-name">{{name}}</h1>
      <p class="cpc-meta">{{echoName}} · MR {{masteryRank}}</p>
    </div>
  </header>

  <div class="cpc-cores">
    <div class="cpc-core"><span class="cpc-k">Move</span><span class="cpc-v">{{movement}}</span></div>
    <div class="cpc-core"><span class="cpc-k">Evade</span><span class="cpc-v">{{evade}}</span></div>
    <div class="cpc-core"><span class="cpc-k">Armor</span><span class="cpc-v">{{armor}}</span></div>
    <div class="cpc-core"><span class="cpc-k">Init</span><span class="cpc-v">{{initiative}}</span></div>
    <div class="cpc-core"><span class="cpc-k">Health</span><span class="cpc-v">{{health}}</span></div>
    <div class="cpc-core"><span class="cpc-k">Stress</span><span class="cpc-v">{{stress}}</span></div>
  </div>

  <section class="cpc-block">
    <h2>Attributes</h2>
    <div class="cpc-attrs">
      {{#each attributes}}
      <div class="cpc-attr cpc-attr-{{key}}">
        <span class="cpc-attr-name">{{label}}</span>
        <span class="cpc-attr-val">{{value}}</span>
        <span class="cpc-attr-st">{{stones}}</span>
      </div>
      {{/each}}
    </div>
    <p class="cpc-hint">Value / Stones</p>
  </section>

  {{#if hasSkills}}
  <section class="cpc-block">
    <h2>Skills</h2>
    <ul class="cpc-skills">
      {{#each skills}}
      <li><span>{{name}}</span><span class="cpc-skill-r">{{rating}}{{#if attr}} {{attr}}{{/if}}</span></li>
      {{/each}}
    </ul>
  </section>
  {{/if}}

  {{#if powerGroups.length}}
  <section class="cpc-block">
    <h2>Powers</h2>
    {{#each powerGroups}}
    <div class="cpc-pg">
      <h3>{{phase}}</h3>
      {{#each items}}
      <p class="cpc-power">
        <strong>{{name}}</strong>{{#if attack}} · {{attack}}{{/if}}{{#if damage}} · {{damage}}{{/if}}{{#if effect}} — {{effect}}{{/if}}
      </p>
      {{/each}}
    </div>
    {{/each}}
  </section>
  {{/if}}

  {{#if hasEchoCards}}
  <section class="cpc-block">
    <h2>Echo</h2>
    {{#each echoCards}}
    <p class="cpc-echo"><strong>{{name}}</strong> — {{summary}}</p>
    {{/each}}
  </section>
  {{/if}}

  {{#if hasArtifacts}}
  <section class="cpc-block">
    <h2>Artifacts</h2>
    {{#each artifacts}}
    <p class="cpc-art"><strong>{{name}}</strong>{{#if note}} — {{note}}{{/if}}</p>
    {{/each}}
  </section>
  {{/if}}

  <div class="cp-page-footer">— Kompaktbogen —</div>
</section>
