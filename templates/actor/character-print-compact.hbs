<section class="print-page print-page-compact">
  <header class="qp-top">
    {{#if hasPortrait}}
    <img class="qp-portrait" src="{{portrait}}" alt="{{name}}" />
    {{/if}}
    <div class="qp-id">
      <h1 class="qp-name">{{name}}</h1>
      <p class="qp-meta">{{echoName}} · MR {{masteryRank}}</p>
      {{#if hasFaithFractures}}
      <p class="qp-faith">Faith Fractures <b>{{faithFractures}}</b></p>
      {{/if}}
      <div class="qp-cores">
        <div class="qp-core qp-core-narrow">
          <span>Move</span>
          <b>{{movement}}</b>
        </div>
        <div class="qp-core qp-core-wide">
          <span>Evade</span>
          <b>{{evade}}</b>
          {{#if hasEvadeSources}}<p class="qp-core-sources">{{evadeSources}}</p>{{/if}}
        </div>
        <div class="qp-core qp-core-narrow">
          <span>Init</span>
          <b>{{initiative}}</b>
        </div>
        <div class="qp-core qp-core-wide">
          <span>Armor</span>
          <b>{{armor}}</b>
          {{#if hasArmorSources}}<p class="qp-core-sources">{{armorSources}}</p>{{/if}}
        </div>
      </div>
    </div>
    <div class="qp-tracks">
      {{#if hasHealth}}
      <div class="qp-track">
        <h2>Health</h2>
        {{#each healthBars}}
        <div class="qp-bar">
          <span class="qp-bar-name">{{name}}</span>
          <span class="qp-mark"></span>
          <span class="qp-bar-n">{{available}}</span>
          <span class="qp-bar-pen">{{penalty}}</span>
        </div>
        {{/each}}
        <div class="qp-bar qp-temp">
          <span class="qp-bar-name">Temp HP</span>
          <span class="qp-mark">{{tempHp}}</span>
        </div>
      </div>
      {{/if}}
      {{#if hasStress}}
      <div class="qp-track">
        <h2>Stress</h2>
        {{#each stressBars}}
        <div class="qp-bar">
          <span class="qp-bar-name">{{name}}</span>
          <span class="qp-mark"></span>
          <span class="qp-bar-n">{{available}}</span>
          <span class="qp-bar-pen"></span>
        </div>
        {{/each}}
        <div class="qp-bar">
          <span class="qp-bar-name">Breakdown</span>
          <span class="qp-mark"></span>
        </div>
      </div>
      {{/if}}
    </div>
  </header>
  <div class="qp-combat-strip">
    <div class="qp-res"><span>Initiative Left</span><i class="qp-write-line"></i></div>
    <div class="qp-res">
      <span>Colorless Stones</span>
      <span class="qp-tick-row">{{#each colorlessBoxes}}<i class="qp-tick"></i>{{/each}}</span>
    </div>
    <p class="qp-res-note">{{colorlessCost}} Initiative = 1 Colorless Stone</p>
    {{#if hasDefenseSpecial}}
    <div class="qp-res">
      <span>{{defenseSpecialLabel}}</span>
      <span class="qp-tick-row">{{#each defenseSpecialBoxes}}<i class="qp-tick"></i>{{/each}}</span>
    </div>
    {{/if}}
  </div>

  <section class="qp-stones">
    <div class="qp-attr-grid">
      {{#each attributeModules}}
      <article class="qp-mod qp-mod-{{key}}{{#unless hasStones}} is-empty{{/unless}}">
        <header class="qp-mod-head">
          <span class="qp-mod-name">{{label}}</span>
          <span class="qp-mod-val">{{value}}</span>
          <span class="qp-mod-pips">
            <span class="qp-mod-stones-label">Stones:</span>
            {{#each stones}}<i class="qp-pip{{#if ready}} is-ready{{/if}}"></i>{{/each}}
          </span>
        </header>
        <div class="qp-sp-grid">
          {{#each powers}}
          <p class="qp-sp{{#if supported}} is-supported{{/if}}">
            <span class="qp-sp-name">{{name}}</span>
            <span class="qp-sp-tiers">
              {{#each tiers}}
              <span class="qp-sp-tg">
                <span class="qp-sp-tl">{{label}}</span>
                <span class="qp-sp-boxes is-{{layout}}">
                  {{#each boxes}}<i class="qp-cost{{#if filled}} is-filled{{/if}}"></i>{{/each}}
                </span>
              </span>
              {{/each}}
            </span>
          </p>
          {{/each}}
        </div>
      </article>
      {{/each}}
      <article class="qp-mod qp-mod-generic">
        <header class="qp-mod-head">
          <span class="qp-mod-name">General Stone Powers</span>
        </header>
        <div class="qp-sp-grid">
          {{#each generalStones.powers}}
          <p class="qp-sp{{#if supported}} is-supported{{/if}}">
            <span class="qp-sp-name">{{name}}</span>
            <span class="qp-sp-tiers">
              {{#each tiers}}
              <span class="qp-sp-tg">
                <span class="qp-sp-tl">{{label}}</span>
                <span class="qp-sp-boxes is-{{layout}}">
                  {{#each boxes}}<i class="qp-cost{{#if filled}} is-filled{{/if}}"></i>{{/each}}
                </span>
              </span>
              {{/each}}
            </span>
          </p>
          {{/each}}
        </div>
      </article>
    </div>
  </section>

  {{#if hasMinorExpressions}}
  <section class="qp-block qp-minors">
    <h2>Minor Expressions</h2>
    <div class="qp-tiles qp-minor-tiles">
      {{#each minorExpressionTiles}}
      <article class="qp-tile qp-tile-{{phaseClass}}">
        <header>
          <strong>{{name}}</strong>
          <span>Minor Expression · {{attr}}</span>
        </header>
        {{#if effect}}<p>{{effect}}</p>{{/if}}
      </article>
      {{/each}}
    </div>
  </section>
  {{/if}}

  {{#if hasSkills}}
  <section class="qp-block">
    <h2>Skills</h2>
    <ul class="qp-skills">
      {{#each skills}}
      <li>
        <span class="qp-sk-name">{{name}} <em>({{attr}})</em></span>
        <span class="qp-sk-keep">{{pool}}{{keep}}</span>
        <span class="qp-sk-boxes">
          {{#each boxes}}<i class="qp-sk-box is-{{state}}">{{#if size}}{{size}}{{/if}}</i>{{/each}}
        </span>
      </li>
      {{/each}}
    </ul>
  </section>
  {{/if}}

  {{#if hasWeaponSets}}
  <section class="qp-block qp-sets">
    <h2>Weapon Sets</h2>
    <div class="qp-tiles qp-set-tiles">
      {{#each weaponSetTiles}}
      <article class="qp-tile qp-tile-Set{{#if active}} is-active{{/if}}">
        <header>
          <strong>{{title}}</strong>
          <span>{{kindLabel}}</span>
        </header>
        {{#if body}}<p>{{body}}</p>{{/if}}
      </article>
      {{/each}}
    </div>
  </section>
  {{/if}}

  {{#if hasPowerArea}}
  <section class="qp-block qp-powers">
    <h2>Powers</h2>
    <div class="qp-power-cols">
      {{#each powerColumns}}
      <div class="qp-pg-col">
        {{#each groups}}
        <div class="qp-pg">
          <h3>{{phase}}</h3>
          <div class="qp-tiles">
            {{#each items}}
            <article class="qp-tile qp-tile-{{phaseClass}}">
              <header>
                <strong>{{name}}</strong>
                <span>{{#unless hideRank}}{{phase}} · PL {{rank}}{{else}}{{phase}}{{/unless}}</span>
              </header>
              {{#if source}}<p class="qp-power-source">{{source}}</p>{{/if}}
              {{#if attack}}<p>Attack: {{attack}}</p>{{/if}}
              {{#if damage}}<p>Damage: {{damage}}</p>{{/if}}
              {{#each damageLines}}<p>Damage: {{this}}</p>{{/each}}
              {{#if effect}}<p>{{effect}}</p>{{/if}}
            </article>
            {{/each}}
          </div>
        </div>
        {{/each}}
      </div>
      {{/each}}
    </div>
  </section>
  {{/if}}
</section>
