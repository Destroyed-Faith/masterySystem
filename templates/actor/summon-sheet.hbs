<section class="summon-sheet">
  <header class="summon-sheet-header">
    <img class="summon-sheet-portrait" src="{{actor.img}}" alt="{{actor.name}}" />
    <div class="summon-sheet-identity">
      <h1 class="summon-sheet-name">{{actor.name}}</h1>
      <p class="summon-sheet-type">SUMMON</p>
      <p class="summon-sheet-owner">Owner: <a href="#" data-action="open-owner">{{ownerName}}</a></p>
      {{#if expression}}<p class="summon-sheet-expression">{{expression}}</p>{{/if}}
    </div>
  </header>

  <dl class="summon-sheet-stats">
    <div><dt>HP</dt><dd>{{familiarStats.hp}}</dd></div>
    <div><dt>Armor</dt><dd>{{familiarStats.armor}}</dd></div>
    <div><dt>Evade</dt><dd>{{familiarStats.evade}}</dd></div>
    <div><dt>Movement</dt><dd>{{familiarStats.speed}} m ({{movementMode}})</dd></div>
    <div><dt>Attack</dt><dd>{{familiarStats.attack}}</dd></div>
    <div><dt>Damage</dt><dd>{{familiarStats.damage}}</dd></div>
    <div><dt>Summon Attacks</dt><dd>{{summonAttacks}}</dd></div>
    <div><dt>Bound Stones</dt><dd>{{boundStoneCount}}</dd></div>
  </dl>

  {{#if specialDisplay}}
  <p class="summon-sheet-special">Special: {{specialDisplay}} <span class="summon-sheet-meta">(once per Round)</span></p>
  {{/if}}

  {{#if dormant}}
  <p class="summon-sheet-dormant">Dormant — restore via Bond Ritual or Safe Haven Rest</p>
  {{/if}}

  {{#if sharedSenseLabels.length}}
  <section class="summon-sheet-senses">
    <h3>Shared Senses (this Body)</h3>
    <ul>{{#each sharedSenseLabels}}<li>{{this}}</li>{{/each}}</ul>
  </section>
  {{/if}}

  {{#if powerLabels.length}}
  <section class="summon-sheet-powers">
    <h3>Purchased Powers</h3>
    <ul>{{#each powerLabels}}<li>{{this}}</li>{{/each}}</ul>
  </section>
  {{/if}}
</section>
