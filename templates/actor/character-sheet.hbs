                  <span class="bd-main"><span class="bd-label">{{this.source}}</span><span class="bd-val">{{#if (gte this.value 0)}}+{{/if}}{{this.value}}d8</span></span>
                </li>
                {{/each}}
              </ul>
              {{/if}}
            </div>
            <div class="stat-icon initiative-icon"><i class="fas fa-bolt"></i></div>
            <div class="stat-content">
              <label>Initiative (basis) <i class="fas fa-info-circle combat-stat-hint-icon" aria-hidden="true"></i></label>
              <div class="stat-value">{{default system.combat.initiativeMasteryRank 2}}d8</div>
            </div>
          </div>
        </div>
      </div>
      
      <div style="margin-top: 30px;"></div>
      
      <!-- Saving Throws Section -->
