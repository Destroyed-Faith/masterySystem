        {{#each disadvantages as |disadvantage index|}}
        <div class="disadvantage-card-sheet" data-index="{{index}}">
          <div class="disadvantage-header-sheet">
            {{#if (eq disadvantage.cardMode "named")}}
            <h4 class="disadvantage-title-named">
              <span class="disadv-custom-title">{{#if disadvantage.details.sheetTitle}}{{disadvantage.details.sheetTitle}}{{else}}{{#if disadvantage.details.name}}{{disadvantage.details.name}}{{else}}{{disadvantage.name}}{{/if}}{{/if}}</span><span class="disadv-category-paren"> ({{disadvantage.categoryShort}})</span>
            </h4>
            {{else}}
            <h4>{{disadvantage.name}}</h4>
            {{/if}}
            <div class="disadvantage-controls">
              <span class="disadvantage-points-sheet">{{disadvantage.points}} pts</span>
              {{#unless ../creationComplete}}
              <button type="button" class="disadvantage-edit-btn" data-index="{{index}}" title="Edit">
                <i class="fas fa-edit"></i>
              </button>
              <button type="button" class="disadvantage-remove-btn" data-index="{{index}}" title="Remove">
                <i class="fas fa-trash"></i>
              </button>
              {{else}}
              {{#if (userIsGM)}}
              <button type="button" class="disadvantage-edit-btn" data-index="{{index}}" title="Edit (GM)">
                <i class="fas fa-edit"></i>
              </button>
              <button type="button" class="disadvantage-remove-btn" data-index="{{index}}" title="Remove (GM)">
                <i class="fas fa-trash"></i>
              </button>
              {{/if}}
              {{/unless}}
            </div>
