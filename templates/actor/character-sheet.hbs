          <!-- Health Bars -->
          <div class="health-bars-container">
            <h4><i class="fas fa-heart"></i> Health (Vitality × 2 per bar)</h4>
            <div class="health-bars-list">
              {{#each system.health.bars as |bar index|}}
              <div class="health-bar-row {{#if (eq index ../system.health.currentBar)}}active{{/if}}">
                <div class="health-bar-info">
                  <span class="health-bar-name">
                    {{#if (eq bar.penalty 0)}}
                      Healthy (0 penalty)
                    {{else if (eq bar.penalty -1)}}
                      Bruised (-1 penalty)
                    {{else if (eq bar.penalty -2)}}
                      Injured (-2 penalty)
                    {{else if (eq bar.penalty -4)}}
                      Wounded (-4 penalty)
                    {{else}}
                      {{bar.name}}{{#if bar.penalty}} ({{bar.penalty}} penalty){{/if}}
                    {{/if}}
                  </span>
                </div>
                <div class="health-bar-inputs">
                  <input type="number" name="system.health.bars.{{index}}.current" value="{{bar.current}}" data-dtype="Number" min="0" max="{{bar.max}}" />
                  <span class="health-bar-separator">/</span>
                  <input type="number" name="system.health.bars.{{index}}.max" value="{{bar.max}}" data-dtype="Number" min="0" readonly />
                </div>
                <div class="health-bar-boxes">
                  {{#times bar.max}}
                  <span class="health-box {{#if (lt @index bar.current)}}filled{{else}}empty{{/if}}"></span>
                  {{/times}}
                </div>
              </div>
              {{/each}}
            </div>
            <div class="health-temp-hp">
              <label>Temp HP:</label>
              <input type="number" name="system.health.tempHP" value="{{default system.health.tempHP 0}}" data-dtype="Number" min="0" />
            </div>
          </div>
          
          <!-- Stress Bars -->
          <div class="stress-bars-container">
            <h4><i class="fas fa-brain"></i> Stress (Resolve + Intellect per bar)</h4>
            <div class="stress-bars-list">
              {{#each system.stress.bars as |bar index|}}
              <div class="stress-bar-row {{#if (eq index ../system.stress.currentBar)}}active{{/if}}">
                <div class="stress-bar-info">
                  <span class="stress-bar-name">{{bar.name}}</span>
                </div>
                <div class="stress-bar-inputs">
                  <input type="number" name="system.stress.bars.{{index}}.current" value="{{bar.current}}" data-dtype="Number" min="0" max="{{bar.max}}" />
                  <span class="stress-bar-separator">/</span>
                  <input type="number" name="system.stress.bars.{{index}}.max" value="{{bar.max}}" data-dtype="Number" min="0" readonly />
                </div>
                <div class="stress-bar-boxes">
                  {{#times bar.max}}
                  <span class="stress-box {{#if (lt @index bar.current)}}filled{{else}}empty{{/if}}"></span>
                  {{/times}}
                </div>
              </div>
              {{/each}}
            </div>
          </div>
        </div>
      </div>
      
      <!-- Schticks (editable during and after character creation) -->
      <div class="schticks-section">
        <h3><i class="fas fa-star"></i> Schticks</h3>
        {{#if creationComplete}}
        <p class="schticks-post-creation-hint">You can update Schticks and manifestations anytime; changes save when you leave a field.</p>
        {{/if}}
        <table class="schticks-table">
          <thead>
            <tr>
              <th class="rank-column">
                <span class="rank-header">Rank</span>
              </th>
              <th class="schtick-column">Schtick</th>
              <th class="manifestation-column">Manifestation</th>
            </tr>
          </thead>
          <tbody>
            {{#each creation.schticksRows}}
            <tr class="schtick-row" data-rank="{{this.rank}}">
              <td class="rank-cell">
                <span 
                  class="rank-number" 
                  title="{{lookup (lookup ../creation.rankTooltips this.rank) 'description'}} | Example: {{lookup (lookup ../creation.rankTooltips this.rank) 'example'}}"
                >
                  {{this.rank}}
                </span>
              </td>
              <td class="schtick-cell">
                <input 
                  type="text" 
                  class="schtick-input" 
                  data-rank="{{this.rank}}"
                  value="{{this.schtickName}}"
                  placeholder="Enter Schtick name..."
                  title="Enter a Schtick name for Rank {{this.rank}}"
                  {{#unless @root.editable}}readonly disabled{{/unless}}
                />
              </td>
              <td class="manifestation-cell">
                <input 
                  type="text" 
                  class="schtick-manifestation-input" 
                  data-rank="{{this.rank}}"
                  value="{{this.manifestation}}"
                  placeholder="Describe the manifestation..."
                  title="Describe how this Schtick manifests at Rank {{this.rank}}"
                  {{#unless @root.editable}}readonly disabled{{/unless}}
                />
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>

      {{!-- Manual Adjustments — player/GM-authored additive bonuses layered
           on top of the calculated stats. All fields default to 0 (no
           change). Positive values add, negative subtract. Health/Stress
           bonuses add to every bar's max. --}}
      <div class="manual-adjustments-section{{#unless (userIsGM)}} is-readonly{{/unless}}">
        <h3><i class="fas fa-wrench"></i> Manual Adjustments
          {{#if (userIsGM)}}
            <span class="manual-adjustments-badge manual-adjustments-badge-gm">GM Edit</span>
          {{else}}
            <span class="manual-adjustments-badge manual-adjustments-badge-readonly">Read-only</span>
          {{/if}}
        </h3>
        <p class="section-help">
          Additive bonuses applied on top of calculated stats. Use for edge
          cases (&ldquo;+5 HP on every bar&rdquo;, GM-granted perks, etc.).
          All fields default to 0. Only the GM can edit these values.
        </p>

        <div class="manual-adjustments-grid">
          <div class="manual-adjustments-card manual-combat-card">
            <h4><i class="fas fa-shield-alt"></i> Combat Totals</h4>
            <div class="manual-adjustments-row">
              <label>Armor Bonus</label>
              <input type="number" name="system.manual.combat.armor" value="{{system.manual.combat.armor}}" data-dtype="Number" step="1" {{#unless (userIsGM)}}readonly disabled{{/unless}} />
            </div>
            <div class="manual-adjustments-row">
              <label>Evade Bonus</label>
              <input type="number" name="system.manual.combat.evade" value="{{system.manual.combat.evade}}" data-dtype="Number" step="1" {{#unless (userIsGM)}}readonly disabled{{/unless}} />
            </div>
            <div class="manual-adjustments-row">
              <label title="Damage Reduction percentage (clamped 0-100)">DR % Bonus</label>
              <input type="number" name="system.manual.combat.damageReductionPct" value="{{system.manual.combat.damageReductionPct}}" data-dtype="Number" step="1" {{#unless (userIsGM)}}readonly disabled{{/unless}} />
            </div>
            <div class="manual-adjustments-row">
              <label>Initiative Bonus</label>
              <input type="number" name="system.manual.combat.initiative" value="{{system.manual.combat.initiative}}" data-dtype="Number" step="1" {{#unless (userIsGM)}}readonly disabled{{/unless}} />
            </div>
          </div>

          <div class="manual-adjustments-card manual-rolls-card">
            <h4><i class="fas fa-dice-d20"></i> Roll Bonuses</h4>
            <div class="manual-rolls-grid">
              <span></span>
              <span class="manual-rolls-header" title="Extra d8 mastery dice">+d8</span>
              <span class="manual-rolls-header" title="Flat bonus to the roll total">+Flat</span>

              <label title="Applies to every roll">Any Roll</label>
              <input type="number" name="system.manual.rolls.any.dice" value="{{system.manual.rolls.any.dice}}" data-dtype="Number" step="1" min="0" {{#unless (userIsGM)}}readonly disabled{{/unless}} />
              <input type="number" name="system.manual.rolls.any.flat" value="{{system.manual.rolls.any.flat}}" data-dtype="Number" step="1" {{#unless (userIsGM)}}readonly disabled{{/unless}} />

              <label>Attack</label>
              <input type="number" name="system.manual.rolls.attack.dice" value="{{system.manual.rolls.attack.dice}}" data-dtype="Number" step="1" min="0" {{#unless (userIsGM)}}readonly disabled{{/unless}} />
              <input type="number" name="system.manual.rolls.attack.flat" value="{{system.manual.rolls.attack.flat}}" data-dtype="Number" step="1" {{#unless (userIsGM)}}readonly disabled{{/unless}} />

              <label>Skill</label>
              <input type="number" name="system.manual.rolls.skill.dice" value="{{system.manual.rolls.skill.dice}}" data-dtype="Number" step="1" min="0" {{#unless (userIsGM)}}readonly disabled{{/unless}} />
              <input type="number" name="system.manual.rolls.skill.flat" value="{{system.manual.rolls.skill.flat}}" data-dtype="Number" step="1" {{#unless (userIsGM)}}readonly disabled{{/unless}} />

              <label title="Body / Mind / Spirit saves">Save</label>
              <input type="number" name="system.manual.rolls.save.dice" value="{{system.manual.rolls.save.dice}}" data-dtype="Number" step="1" min="0" {{#unless (userIsGM)}}readonly disabled{{/unless}} />
              <input type="number" name="system.manual.rolls.save.flat" value="{{system.manual.rolls.save.flat}}" data-dtype="Number" step="1" {{#unless (userIsGM)}}readonly disabled{{/unless}} />

              <label title="Applied in the damage dialog pipeline">Damage</label>
              <input type="number" name="system.manual.rolls.damage.dice" value="{{system.manual.rolls.damage.dice}}" data-dtype="Number" step="1" min="0" {{#unless (userIsGM)}}readonly disabled{{/unless}} />
              <input type="number" name="system.manual.rolls.damage.flat" value="{{system.manual.rolls.damage.flat}}" data-dtype="Number" step="1" {{#unless (userIsGM)}}readonly disabled{{/unless}} />
            </div>
          </div>

          <div class="manual-adjustments-card manual-hpstress-card">
            <h4><i class="fas fa-heart"></i> Health &amp; Stress Bars</h4>
            <div class="manual-adjustments-row">
              <label title="Added to every Health bar's max (4 bars). Negative values also allowed.">+ Health / bar</label>
              <input type="number" name="system.manual.health.barMaxBonus" value="{{system.manual.health.barMaxBonus}}" data-dtype="Number" step="1" {{#unless (userIsGM)}}readonly disabled{{/unless}} />
            </div>
            <div class="manual-adjustments-row">
              <label title="Added to every Stress bar's max (4 bars). Negative values also allowed.">+ Stress / bar</label>
              <input type="number" name="system.manual.stress.barMaxBonus" value="{{system.manual.stress.barMaxBonus}}" data-dtype="Number" step="1" {{#unless (userIsGM)}}readonly disabled{{/unless}} />
            </div>
            <p class="manual-adjustments-note">
              Current HP / Stress scale proportionally when you change these.
            </p>
          </div>
        </div>
      </div>

    </div>
    
    <!-- SKILLS TAB -->
    <div class="tab skills" data-group="primary" data-tab="skills">
      
      <div class="skills-overview">
        {{#if creationComplete}}
        <div class="attribute-xp-distribution-controls skill-xp-toolbar">
          <div class="pending-skill-changes-info">
            <span class="remaining-xp-text">After pending: <span id="remaining-skill-xp">0</span> XP</span>
            <span class="pending-changes-text">Steps: <span id="pending-skill-changes-count">0</span></span>
            <span class="pending-skill-xp-net-wrap">Net: <span id="pending-skill-xp-net">0</span> XP</span>
          </div>
          <div class="skill-xp-toolbar-actions">
            <button type="button" class="confirm-skill-changes" id="confirm-skill-changes-btn" disabled>
              <i class="fas fa-check"></i> Confirm Changes
            </button>
            <button type="button" class="cancel-skill-changes" id="cancel-skill-changes-btn" disabled>
              <i class="fas fa-times"></i> Cancel
            </button>
          </div>
        </div>
        <div class="safe-haven-rest-row">
          <button type="button" class="safe-haven-rest" title="Rest at Safe Haven — restore Skill Points, Vitality save uses, and Faith Fractures">
            <i class="fas fa-bed"></i> Safe Haven Rest
          </button>
          {{#if (userIsGM)}}
          <button type="button" class="gm-award-faith-fracture" title="Reward playing out disadvantages (+1 Faith Fracture, up to maximum)">
            <i class="fas fa-plus-circle"></i> GM: +1 Faith (RP)
          </button>
          {{/if}}
        </div>
        {{/if}}
      </div>
      
      {{#each skills}}
        <div class="skill-category-compact">
          <h4 class="category-header-compact">
            {{#if (eq this.category "Awareness")}}<i class="fas fa-eye"></i>{{/if}}
            {{#if (eq this.category "Physical")}}<i class="fas fa-running"></i>{{/if}}
            {{#if (eq this.category "Knowledge & Craft")}}<i class="fas fa-book"></i>{{/if}}
            {{#if (eq this.category "Social")}}<i class="fas fa-comments"></i>{{/if}}
            {{#if (eq this.category "Survival")}}<i class="fas fa-tree"></i>{{/if}}
            {{#if (eq this.category "Martial")}}<i class="fas fa-sword"></i>{{/if}}
            {{this.category}}
          </h4>
          <div class="skills-list-compact">
            {{#each this.skills}}
              <div class="skill-row-compact">
                <span class="skill-name-compact">{{this.name}}</span>
                <div class="skill-attrs-compact">
                  {{#each this.attributes}}
                    <span class="attr-badge">{{capitalize this}}</span>
                  {{/each}}
                </div>
                <div class="skill-value-display-compact">
                  <div class="skill-rank-block">
                    <span class="skill-value-compact">{{default this.value 0}}</span>
                    {{#if @root.creationComplete}}
                    <span class="skill-rank-pending-badge" data-skill="{{this.key}}" title="Rank after pending changes"></span>
                    {{/if}}
                  </div>
                  {{#if @root.creationComplete}}
                  <span class="skill-pool-display">{{default this.remaining 0}} / {{default this.value 0}} uses</span>
                  <span class="skill-pending-xp" data-skill="{{this.key}}" title="XP reserved on this skill until Confirm"></span>
                  <div class="skill-progress-controls">
                    <button type="button" class="skill-spend-point" data-skill="{{this.key}}" title="Increase Skill (Spend XP)">
                      <i class="fas fa-plus"></i>
                    </button>
                    <button type="button" class="skill-refund-point" data-skill="{{this.key}}" title="Decrease Skill (Refund XP)">
                      <i class="fas fa-minus"></i>
                    </button>
                  </div>
                  {{else}}
                  <div class="creation-controls">
                    <button type="button" class="skill-decrease" data-skill="{{this.key}}" title="Decrease Skill" {{#if (lte this.value 0)}}disabled{{/if}}>
                      <i class="fas fa-minus"></i>
                    </button>
                    <button type="button" class="skill-increase" data-skill="{{this.key}}" title="Increase Skill" {{#if (gte this.value 4)}}disabled{{/if}} {{#if (eq @root.creation.skillPointsRemaining 0)}}disabled{{/if}}>
                      <i class="fas fa-plus"></i>
                    </button>
                  </div>
                  {{/if}}
                </div>
                {{#if @root.creationComplete}}
                <div class="skill-use-boxes" title="{{this.remaining}}/{{this.value}} uses remaining">
                  <span class="skill-use-box {{#if (gte this.value 1)}}{{#if (gte this.remaining 1)}}available{{else}}spent{{/if}}{{else}}locked{{/if}}"></span>
                  <span class="skill-use-box {{#if (gte this.value 2)}}{{#if (gte this.remaining 2)}}available{{else}}spent{{/if}}{{else}}locked{{/if}}"></span>
                  <span class="skill-use-box {{#if (gte this.value 3)}}{{#if (gte this.remaining 3)}}available{{else}}spent{{/if}}{{else}}locked{{/if}}"></span>
                  <span class="skill-use-box {{#if (gte this.value 4)}}{{#if (gte this.remaining 4)}}available{{else}}spent{{/if}}{{else}}locked{{/if}}"></span>
                </div>
                {{/if}}
                {{#if (eq this.key "perception")}}
                <div class="skill-roll-perception-group" title="Perception — gleicher Wurf-Dialog wie üblich (Schwierigkeit, Raises)">
                  <button type="button" class="skill-roll-compact skill-roll-with-attr" data-skill="{{this.key}}" data-attribute="wits" title="Perception (Wits)">
                    <i class="fas fa-brain"></i>
                  </button>
                  <button type="button" class="skill-roll-compact skill-roll-with-attr" data-skill="{{this.key}}" data-attribute="intellect" title="Perception (Intellect)">
                    <i class="fas fa-lightbulb"></i>
                  </button>
                  <button type="button" class="skill-roll-compact skill-roll-with-attr" data-skill="{{this.key}}" data-attribute="resolve" title="Perception (Resolve)">
                    <i class="fas fa-shield-alt"></i>
                  </button>
                </div>
                {{else}}
                <button type="button" class="skill-roll-compact" data-skill="{{this.key}}" title="Roll {{this.name}}">
                  <i class="fas fa-dice-d20"></i>
                </button>
                {{/if}}
              </div>
            {{/each}}
          </div>
        </div>
      {{/each}}
      
    </div>
    
    <!-- POWERS TAB -->
    <div class="tab powers" data-group="primary" data-tab="powers">

      <details class="radial-maneuver-prefs-details"{{#if radialManeuverPrefsDetailsOpen}} open{{/if}}>
        <summary class="radial-maneuver-prefs-summary">
          <i class="fas fa-compass"></i> Token-Radial: Standard-Manöver
        </summary>
        <div class="radial-maneuver-prefs-body">
          <label class="radial-maneuver-hide-all-label">
            <input type="checkbox" class="radial-maneuver-hide-all" {{#if radialManeuverPrefsPanel.hideAllStandard}}checked{{/if}} {{#unless @root.editable}}disabled{{/unless}} />
            <span>Alle Standard-Manöver im Token-Radial ausblenden</span>
          </label>
          <p class="radial-maneuver-prefs-hint">Änderungen werden <strong>sofort</strong> am Akteur gespeichert. Pro Eintrag: angehakt = erscheint <strong>nicht</strong> im Radialmenü (Move, Dash, Stances, Reaktionen, …).</p>
          {{#each radialManeuverPrefsPanel.rowsByGroup}}
          <div class="radial-maneuver-prefs-group">
            <span class="radial-maneuver-prefs-group-label">{{this.group}}</span>
            <div class="radial-maneuver-prefs-grid">
              {{#each this.rows}}
              <label class="radial-maneuver-item-label">
                <input type="checkbox" class="radial-maneuver-hide-one" data-maneuver-id="{{this.id}}" {{#if this.hideFromRadial}}checked{{/if}} {{#if this.masterHideAll}}disabled{{/if}} {{#unless @root.editable}}disabled{{/unless}} />
                <span>{{this.name}}</span>
              </label>
              {{/each}}
            </div>
          </div>
          {{/each}}
        </div>
      </details>
      
      <!-- Active Buffs Section -->
      {{#if activeBuffs}}
      {{#if (gt activeBuffs.length 0)}}
      <div class="active-buffs-section">
        <h3><i class="fas fa-shield-alt"></i> Active Buffs</h3>
        <div class="active-buffs-list">
          {{#each activeBuffs}}
          <div class="active-buff-item" data-effect-id="{{this.id}}" title="{{this.name}}&#10;Duration: {{#if (gt this.roundsRemaining 0)}}{{this.roundsRemaining}} round{{#if (gt this.roundsRemaining 1)}}s{{/if}} remaining{{else}}Expiring this round{{/if}}{{#if this.description}}&#10;&#10;{{this.description}}{{/if}}">
            <div class="active-buff-icon">
              <img src="{{this.icon}}" alt="{{this.name}}" />
            </div>
            <div class="active-buff-info">
              <div class="active-buff-name">{{this.name}}</div>
              <div class="active-buff-duration">
                <i class="fas fa-clock"></i> 
                {{#if (gt this.roundsRemaining 0)}}
                  {{this.roundsRemaining}} round{{#if (gt this.roundsRemaining 1)}}s{{/if}} remaining
                {{else}}
                  Expiring this round
                {{/if}}
              </div>
            </div>
            <button type="button" class="active-buff-remove" data-effect-id="{{this.id}}" title="Remove Buff">
              <i class="fas fa-times"></i>
            </button>
          </div>
          {{/each}}
        </div>
      </div>
      {{/if}}
      {{/if}}

      <!-- Buttons always visible -->
      <div class="powers-overview">
        {{#if creationComplete}}
        <div class="power-level-distribution-controls" style="width: 230px;">
          <button type="button" class="confirm-power-level-changes" id="confirm-power-level-changes-btn" disabled style="width: 200px;">
            <i class="fas fa-check"></i> Confirm Changes
          </button>
          <button type="button" class="cancel-power-level-changes" id="cancel-power-level-changes-btn" disabled style="width: 200px;">
            <i class="fas fa-times"></i> Cancel
          </button>
        </div>
        {{/if}}
        <div class="powers-controls">
          <button type="button" class="add-power-creation-btn" title="Add any Power (Mastery Tree or Spell School)">
            <i class="fas fa-plus"></i> Add Power
          </button>
          {{#unless creationComplete}}
          <button type="button" class="add-power-creation-btn" data-category="active" title="Add Active Power">
            <i class="fas fa-plus"></i> Active
          </button>
          <button type="button" class="add-power-creation-btn" data-category="activeBuff" title="Add Active Buff">
            <i class="fas fa-plus"></i> Active Buff
          </button>
          <button type="button" class="add-power-creation-btn" data-category="movement" title="Add Movement Power">
            <i class="fas fa-plus"></i> Movement
          </button>
          <button type="button" class="add-power-creation-btn" data-category="reaction" title="Add Reaction">
            <i class="fas fa-plus"></i> Reaction
          </button>
          <button type="button" class="add-power-creation-btn" data-category="passive" title="Add Passive">
            <i class="fas fa-plus"></i> Passive
          </button>
          {{/unless}}
        </div>
      </div>
      
      {{#unless creationComplete}}
      <!-- CHARACTER CREATION: Powers & Magic Selection Status -->
      <div class="creation-powers-section">
        <div class="creation-banner">
          <h3><i class="fas fa-magic"></i> Character Creation: Powers & Magic Selection</h3>
          <div class="creation-status">
            <div class="status-item">
              <label>Total:</label>
              <span class="{{#if (eq creation.powersSelected creation.powersRequired)}}valid{{else}}invalid{{/if}}">
                {{creation.powersSelected}} / {{creation.powersRequired}}
              </span>
            </div>
            {{#each creation.categoryRequirements}}
            <div class="status-item">
              <label>{{this.label}}:</label>
              <span class="{{#if this.valid}}valid{{else}}invalid{{/if}}">
                {{this.selected}} / {{this.required}}
              </span>
            </div>
            {{/each}}
            <div class="status-item">
              <label>At Rank 2:</label>
              <span class="{{#if (eq creation.powersAtRank2 creation.powersAtRank2Required)}}valid{{else}}invalid{{/if}}">
                {{creation.powersAtRank2}} / {{creation.powersAtRank2Required}}
              </span>
            </div>
          </div>
        </div>

        <div class="creation-instructions">
          <p><strong>Character Creation Rules:</strong></p>
          <ul>
            <li><strong>Powers</strong> — choose <strong>2 Active</strong>, <strong>2 Passive</strong>, <strong>1 Reaction</strong>, <strong>1 Movement</strong>, and <strong>1 Active Buff</strong>. All are <strong>Rank 2</strong>.</li>
            <li>Mastery Trees and Spell Schools share one picker – filter by Category, Subfamily, and Special (Ignite, Freeze, Shock, …).</li>
            <li>Choose your <strong>Echo</strong> (ancestry, with sub-choice / Veiled Form if required) and pick your <strong>first Echo Card</strong>.</li>
          </ul>
        </div>

        <!-- Selected Powers List (Creation Mode) -->
        <div class="creation-powers-list">
          <h4>Selected Powers:</h4>
          {{#if items.powers}}
            {{#each items.powers}}
              <div class="power-card creation-power" data-item-id="{{this.id}}">
                <div class="power-header-compact">
                  <div class="power-name-compact">
                    <label class="power-radial-toggle-label" title="Im Token-Radialmenü anzeigen">
                      <input type="checkbox" class="power-radial-checkbox" data-item-id="{{this.id}}" {{#unless (eq this.system.showInRadialMenu false)}}checked{{/unless}}/>
                    </label>
                    <input type="text" class="power-display-name-input" data-item-id="{{this.id}}" value="{{this.name}}" title="Display name — rename anytime (sheet &amp; rolls use this label)" />
                    <span class="power-level-badge" title="Power Level {{default this.system.level 1}}"><strong>Level {{default this.system.level 1}}</strong></span>
                  </div>
                  <div class="power-info-compact">
                    {{#if (lookup this.system.roll 'damage')}}
                    <span class="power-damage-compact" title="Damage">
