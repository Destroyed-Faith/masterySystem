<form class="{{cssClass}}" autocomplete="off">
  
  <!-- Header -->
  <header class="sheet-header">
    <div class="portrait-section">
      <div class="profile-img-wrapper">
        <div class="profile-img-container {{#unless editable}}locked{{/unless}}" data-image-type="portrait">
          <img class="profile-img {{#if editable}}{{else}}locked{{/if}}" src="{{actor.img}}" title="{{actor.name}} Portrait" alt="{{actor.name}} Portrait" />
          <div class="profile-overlay">
            <div class="profile-zone profile-zone-edit" data-action="edit" data-img-type="portrait">
              <span class="zone-label">EDIT</span>
            </div>
            <div class="profile-zone profile-zone-show" data-action="show" data-img-type="portrait">
              <span class="zone-label">SHOW</span>
            </div>
          </div>
        </div>
        <div class="profile-img-label">PORTRAIT</div>
      </div>
      <div class="profile-img-wrapper">
        <div class="profile-img-container profile-img-container-token {{#unless editable}}locked{{/unless}}" data-image-type="token">
          <img class="profile-img {{#if editable}}{{else}}locked{{/if}}" src="{{default actor.prototypeToken.texture.src actor.img}}" title="{{actor.name}} Token" alt="{{actor.name}} Token" />
          <div class="profile-overlay">
            <div class="profile-zone profile-zone-edit" data-action="edit" data-img-type="token">
              <span class="zone-label">EDIT</span>
            </div>
            <div class="profile-zone profile-zone-show" data-action="show" data-img-type="token">
              <span class="zone-label">SHOW</span>
            </div>
          </div>
        </div>
        <div class="profile-img-label">TOKEN</div>
      </div>
    </div>
    
    <div class="header-info">
      <div class="mastery-rank-box" title="Mastery Rank">
        <label>MR</label>
        {{#if isGM}}
        <select class="mastery-rank-select" data-dtype="Number" title="GM: Mastery Rank für diesen Charakter" aria-label="Mastery Rank">
          <option value="1" {{#if (eqNum system.mastery.rank 1)}}selected{{/if}}>1</option>
          <option value="2" {{#if (eqNum system.mastery.rank 2)}}selected{{/if}}>2</option>
          <option value="3" {{#if (eqNum system.mastery.rank 3)}}selected{{/if}}>3</option>
          <option value="4" {{#if (eqNum system.mastery.rank 4)}}selected{{/if}}>4</option>
          <option value="5" {{#if (eqNum system.mastery.rank 5)}}selected{{/if}}>5</option>
          <option value="6" {{#if (eqNum system.mastery.rank 6)}}selected{{/if}}>6</option>
          <option value="7" {{#if (eqNum system.mastery.rank 7)}}selected{{/if}}>7</option>
          <option value="8" {{#if (eqNum system.mastery.rank 8)}}selected{{/if}}>8</option>
        </select>
        {{#if system.mastery.suggestedRank}}
        <span class="rank-stone-hint" title="Empfehlung aus Total Stones (nur Hinweis, kein Auto-Rank-Up)">↗{{system.mastery.suggestedRank}}</span>
        {{/if}}
        {{else}}
        <span class="rank-value">{{default system.mastery.rank 2}}</span>
        {{/if}}
      </div>
      
      {{#if creationComplete}}
      <div class="points-box" title="Experience Points">
        <label>XP</label>
        <div class="points-display">
          <span class="points-value" id="sheet-xp-display">{{default system.points.xp 0}}</span>
        </div>
      </div>
      <div class="points-box points-box-faith" title="Faith Fractures: noch verfügbar zum Ändern des Würfelergebnisses (je 1 pro Reroll im Chat)">
        <label>FF</label>
        <div class="points-display faith-fractures-display">
          <span class="points-value" id="sheet-faith-current">{{default system.faithFractures.current 0}}</span>
          <span class="points-label">/ {{default system.faithFractures.maximum 0}}</span>
        </div>
      </div>
      {{else}}
      <!-- Attribute Distribution Counter -->
      <div class="points-box creation-points" title="Attribute Distribution: 2×8, 2×6, 2×4, 1×2">
        <label>Attr</label>
        <div class="points-display attr-distribution-display">
          <span class="attr-dist-item {{#if (eq creation.attrCount8 2)}}complete{{else}}remaining{{/if}}">8×{{creation.attrCount8}}/2</span>
          <span class="attr-dist-item {{#if (eq creation.attrCount6 2)}}complete{{else}}remaining{{/if}}">6×{{creation.attrCount6}}/2</span>
          <span class="attr-dist-item {{#if (eq creation.attrCount4 2)}}complete{{else}}remaining{{/if}}">4×{{creation.attrCount4}}/2</span>
        </div>
      </div>
      
      <div class="points-box creation-points" title="Skill Points Remaining">
        <label>SP</label>
        <div class="points-display">
          <span class="points-value {{#if (eq creation.skillPointsRemaining 0)}}complete{{else}}remaining{{/if}}">{{creation.skillPointsRemaining}}</span>
          <span class="points-label">/ {{creation.skillPointsConfig}}</span>
        </div>
      </div>
      
      <div class="points-box creation-points" title="Disadvantages: {{creation.disadvantagePointsMin}}–{{creation.disadvantagePointsMax}} pts required to finish creation">
        <label>DP</label>
        <div class="points-display">
          <span class="points-value {{#if creation.disadvantagesValid}}complete{{else}}remaining{{/if}}">{{creation.disadvantagePoints}}</span>
          <span class="points-label">/ {{creation.disadvantagePointsMax}}</span>
        </div>
      </div>
      {{/if}}
      
      <div class="character-name-box">
        {{#if editable}}
          <input name="name" type="text" value="{{actor.name}}" placeholder="Character Name" />
        {{else}}
          <h1>{{actor.name}}</h1>
        {{/if}}
      </div>
    </div>
  </header>

  <!-- Character Creation Banner -->
  {{#unless creationComplete}}
  <div class="creation-banner">
    <div class="creation-banner-content">
      <h3><i class="fas fa-user-edit"></i> Character Creation Mode</h3>
      <p>Distribute attributes: <strong>2×8, 2×6, 2×4, 1×2</strong> ({{#if creation.attributeDistributionValid}}done{{else}}{{creation.attrCount8}}/2×8, {{creation.attrCount6}}/2×6, {{creation.attrCount4}}/2×4, {{creation.attrCount2}}/1×2{{/if}}). 
      <strong>{{creation.skillPointsRemaining}}</strong> Skill Points remaining. 
      <strong>Disadvantages:</strong> <strong>{{creation.disadvantagePoints}}</strong> / {{creation.disadvantagePointsMax}} pts — <strong>at least {{creation.disadvantagePointsMin}} pts required</strong> to finalize.</p>
      <button type="button" class="reset-creation-attributes" title="Set all attributes to 2 so you can redistribute (fixes hidden dropdown options)">
        <i class="fas fa-undo"></i> Reset attributes
      </button>
      {{#if creation.canFinalize}}
      <button type="button" class="finalize-creation" title="Finalize character creation">
        <i class="fas fa-check-circle"></i> Finalize Character Creation
      </button>
      {{else}}
      <span class="creation-status">
        Remaining: Attributes ({{#if creation.attributeDistributionValid}}done{{else}}{{creation.attrCount8}}/2×8, {{creation.attrCount6}}/2×6, {{creation.attrCount4}}/2×4, {{creation.attrCount2}}/1×2{{/if}}), Skills ({{creation.skillPointsRemaining}} remaining), Powers ({{creation.powersSelected}}/{{creation.powersRequired}}){{#unless creation.disadvantagesValid}}, Disadvantages ({{creation.disadvantagePoints}}/{{creation.disadvantagePointsMin}}–{{creation.disadvantagePointsMax}} pts){{/unless}}{{#unless creation.echoCreationValid}}, Echo (not chosen){{/unless}}{{#unless creation.languagesCreationValid}}, Languages (need 1+ besides Common){{/unless}}.
      </span>
      {{/if}}
      {{#if (userIsGM)}}
      <button type="button" class="force-unlock-creation" title="GM Only: Force unlock character creation">
        <i class="fas fa-unlock"></i> Force Unlock
      </button>
      <button type="button" class="reset-character" title="GM Only: Wipe this character back to creation (keeps name + portrait; earned XP returned to pool)">
        <i class="fas fa-trash-restore-alt"></i> Reset Character
      </button>
      {{/if}}
    </div>
  </div>
  {{/unless}}

  {{#if creationComplete}}
  {{#if (userIsGM)}}
  <div class="gm-character-tools">
    <span class="gm-character-tools-label"><i class="fas fa-user-shield"></i> GM Tools</span>
    <button type="button" class="reset-character" title="Wipe this character back to creation (keeps name + portrait; earned XP returned to the player's pool). Destructive, requires double confirmation.">
      <i class="fas fa-trash-restore-alt"></i> Reset Character
    </button>
  </div>
  {{/if}}
  {{/if}}

  <!-- Compact Combat Stats Panel — always visible on every tab so the current
       Armor / Evade / DR% / Initiative / HP / Stress values are at-a-glance.
       The detailed per-source breakdowns remain in the Attributes tab cards. -->
  {{#if combatStatsView}}
  <div class="combat-stats-panel" aria-label="Current combat stats">
    <div class="combat-stats-panel-title">
      <i class="fas fa-shield-halved"></i>
      <span>Aktuelle Kampfwerte</span>
    </div>
    <div class="combat-stats-panel-grid">
      <div class="combat-stats-chip combat-stats-chip-armor" title="{{#if combatStatsView.armorBreakdownTip}}{{combatStatsView.armorBreakdownTip}}{{else}}Armor total{{/if}}">
        <i class="fas fa-shield-alt"></i>
        <span class="chip-label">Armor</span>
        <span class="chip-value">{{combatStatsView.armor}}</span>
      </div>
      <div class="combat-stats-chip combat-stats-chip-evade" title="{{#if combatStatsView.evadeBreakdownTip}}{{combatStatsView.evadeBreakdownTip}}{{else}}Evade total{{/if}}">
        <i class="fas fa-wind"></i>
        <span class="chip-label">Evade</span>
        <span class="chip-value">{{combatStatsView.evade}}</span>
      </div>
      <div class="combat-stats-chip combat-stats-chip-dr" title="{{#if combatStatsView.drBreakdownTip}}{{combatStatsView.drBreakdownTip}}{{else}}Damage reduction % (passive + buff + per-hit reaction rows){{/if}}">
        <i class="fas fa-user-shield"></i>
        <span class="chip-label">DR</span>
        <span class="chip-value">{{combatStatsView.drPct}}%</span>
      </div>
      <div class="combat-stats-chip combat-stats-chip-initiative" title="Initiative-Wurf: {{combatStatsView.initiativeDice}}d8, plus Equipment-Mod {{combatStatsView.initiativeEquipmentDisplay}}.">
        <i class="fas fa-bolt"></i>
        <span class="chip-label">Init</span>
        <span class="chip-value">{{combatStatsView.initiativeDice}}d8 {{combatStatsView.initiativeEquipmentDisplay}}</span>
      </div>
      <div class="combat-stats-chip combat-stats-chip-hp" title="HP (Summe aller Wundlevel-Bars).">
        <i class="fas fa-heart"></i>
        <span class="chip-label">HP</span>
        <span class="chip-value">{{combatStatsView.hp.current}}/{{combatStatsView.hp.max}}</span>
      </div>
      <div class="combat-stats-chip combat-stats-chip-stress" title="Stress (Summe aller Stress-Bars).">
        <i class="fas fa-brain"></i>
        <span class="chip-label">Stress</span>
        <span class="chip-value">{{combatStatsView.stress.current}}/{{combatStatsView.stress.max}}</span>
      </div>
    </div>
  </div>
  {{/if}}

  <!-- Tabs Navigation (Right Side Bookmarks) -->
  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="attributes"><i class="fas fa-fist-raised"></i> Attributes</a>
    <a class="item" data-tab="echo"><i class="fas fa-mask"></i> Echo</a>
    <a class="item" data-tab="skills"><i class="fas fa-cogs"></i> Skills</a>
    <a class="item" data-tab="powers"><i class="fas fa-magic"></i> Powers</a>
    <a class="item" data-tab="equipment"><i class="fas fa-shield-alt"></i> Equipment</a>
    <a class="item" data-tab="disadvantages"><i class="fas fa-exclamation-triangle"></i> Disadvantages</a>
  </nav>

  <!-- Sheet Body -->
  <section class="sheet-body">

    <!-- ECHO TAB -->
    <div class="tab echo" data-group="primary" data-tab="echo">
      <div class="echo-tab-content">

        <!-- Echo Selection (always available; change at any time) -->
        <div class="creation-echo-section">
          <div class="creation-echo-header">
            <h4><i class="fas fa-mask"></i> Echo</h4>
            <button type="button" class="choose-echo-btn" title="Choose or change your Echo, Sub-choice (if any), Veiled Form (Dragonborn), and your Echo cards">
              <i class="fas fa-mask"></i> {{#if echoView}}Change Echo{{else}}Choose Echo{{/if}}
            </button>
            {{#if echoView}}
            <span class="echo-status {{#if echoView.creationValid}}echo-status-ok{{else}}echo-status-partial{{/if}}">
              {{echoView.def.name}}{{#if echoView.subChoice}} · {{echoView.subChoice.name}}{{/if}}{{#if echoView.veiled}} · veiled as {{echoView.veiled.name}}{{/if}}{{#if echoView.creationValid}} ✓{{else}} (incomplete){{/if}}
            </span>
            {{else}}
            <span class="echo-status echo-status-missing">Not chosen</span>
            {{/if}}
          </div>
        </div>

        {{#if echoView}}
        <!-- Echo Deck (moved from Biography tab) -->
        <div class="form-group echo-deck-block">
          <label><i class="fas fa-mask"></i> Echo Deck</label>
          <div class="echo-deck-summary">
            <div class="echo-deck-title">
              <strong>{{echoView.def.name}}</strong>
              {{#if echoView.subChoice}}· {{echoView.subChoice.name}}{{/if}}
              {{#if echoView.veiled}}· veiled as {{echoView.veiled.name}}{{/if}}
            </div>
            <div class="echo-deck-meta">
              <em>{{echoView.def.tagline}}</em><br/>
              Type: {{echoView.def.creatureType}} · Size: {{echoView.def.size}} · Speed: {{echoView.def.speed}} m
            </div>
            {{#if echoView.def.veiledForm}}
            <div class="echo-veiled-callout">
              <strong>Veiled Form:</strong>
              {{#if echoView.veiled}}appears as <em>{{echoView.veiled.name}}</em>{{else}}not chosen yet — pick in Echo dialog{{/if}}.
              Appearance only; you remain Dragonborn mechanically.
            </div>
            {{/if}}
          </div>

          <div class="echo-deck-traits">
            <h4>Core Traits</h4>
            {{#each echoView.traits}}
            <div class="echo-trait-row {{#if this.gated}}echo-trait-gated{{/if}}">
              <div class="echo-trait-name">
                <strong>{{this.name}}</strong>
                {{#if this.trackedUses}}
                <span class="echo-trait-uses" title="Uses restored on Safe Haven Rest">
                  {{this.remaining}} / {{this.max}} uses
                </span>
                {{/if}}
                {{#if this.gated}}
                <span class="echo-trait-gated-label" title="Unlocks at higher Mastery Rank">locked</span>
                {{/if}}
              </div>
              <div class="echo-trait-effect">{{this.effect}}</div>
              {{#if this.flavor}}<div class="echo-trait-flavor"><em>{{this.flavor}}</em></div>{{/if}}
            </div>
            {{/each}}
          </div>

          <div class="echo-deck-cards">
            <div class="echo-deck-cards-header">
              <h4>Cards <span class="echo-deck-slots">({{echoView.selectedCardIds.length}} / {{echoView.unlockedCardSlots}})</span></h4>
              {{#if echoView.canAddCard}}
              <button type="button" class="add-echo-card-btn" title="Add another Echo card from your deck">
                <i class="fas fa-plus"></i> Add Card
              </button>
              {{/if}}
            </div>
            {{#each echoView.deck}}
            {{#if this.selected}}
            <div class="echo-card {{#if this.used}}echo-card-used{{/if}}" data-card-id="{{this.id}}">
              <div class="echo-card-header">
                <span class="echo-card-name"><strong>{{this.name}}</strong></span>
                {{#if this.used}}<span class="echo-card-used-label">Used today</span>{{/if}}
              </div>
              <div class="echo-card-trigger"><em>Trigger:</em> {{this.trigger}}</div>
              <ol class="echo-card-options">
                {{#each this.options}}
                <li class="echo-card-option">
                  <div class="echo-card-option-head">
                    <strong>{{this.label}}</strong>
                    <span class="echo-card-option-skill">Skill: {{this.skill}}</span>
                    <button type="button"
                      class="echo-card-use-btn"
                      data-card-id="{{../id}}"
                      data-option-id="{{this.id}}"
                      {{#if ../used}}disabled{{/if}}
                      title="Roll the skill for this option (spends the card for today)">
                      <i class="fas fa-dice-d20"></i> Use
                    </button>
                  </div>
                  <div class="echo-card-option-desc">{{this.description}}</div>
                </li>
                {{/each}}
              </ol>
            </div>
            {{/if}}
            {{/each}}
          </div>
        </div>
        {{/if}}

        <!-- Languages (Players Guide 3100–3127) -->
        <div class="form-group languages-section">
          <label>Languages:</label>
          <div class="languages-row">
            <span class="languages-list">
              {{#if languagesView.list}}
                {{#each languagesView.list}}<span class="language-tag">{{this.name}}</span>{{/each}}
              {{else}}
                <span class="language-empty">Common Tongue</span>
              {{/if}}
            </span>
            <button type="button" class="open-languages-btn" title="Pick the languages your character speaks">
              <i class="fas fa-language"></i> Languages
            </button>
          </div>
          {{#unless languagesView.creationValid}}
          <p class="hint hint-warning">
            <i class="fas fa-exclamation-triangle"></i>
            Pick at least 1 additional language at character creation.
          </p>
          {{/unless}}
        </div>

        <!-- Echo Notes (moved from Biography tab's Echo freetext) -->
        <div class="form-group">
          <label>Echo Notes:</label>
          {{editor system.bio.echo target="system.bio.echo" button=true owner=owner editable=editable}}
        </div>

        <!-- Biography fields (merged from former Bio tab) -->
        <div class="form-group">
          <label>Blood Color (Blutfarbe):</label>
          <div class="blood-color-input-group">
            <input type="color" name="system.bloodColor" id="blood-color-picker" value="{{default system.bloodColor '#8b0000'}}" title="Choose the color for blood pools when this character takes damage"/>
            <input type="text" class="blood-color-text" id="blood-color-text" value="{{default system.bloodColor '#8b0000'}}" placeholder="#8b0000" pattern="^#[0-9A-Fa-f]{6}$" title="Hex color code (e.g., #8b0000 for dark red, #ff0000 for red, #0000ff for blue)"/>
          </div>
          <p class="hint"><i class="fas fa-info-circle"></i> This color will be used for blood pools when this character takes damage.</p>
        </div>

        <div class="form-group">
          <label>Concept:</label>
          {{editor system.bio.concept target="system.bio.concept" button=true owner=owner editable=editable}}
        </div>

        <div class="form-group">
          <label>Appearance:</label>
          {{editor system.bio.appearance target="system.bio.appearance" button=true owner=owner editable=editable}}
        </div>

        <div class="form-group">
          <label>Notes:</label>
          {{editor system.bio.notes target="system.bio.notes" button=true owner=owner editable=editable}}
        </div>

      </div>
    </div>

    <!-- ATTRIBUTES TAB -->
    <div class="tab attributes" data-group="primary" data-tab="attributes">

      <!-- Attributes Grid Section -->
      <div class="attributes-grid-section">
        <div class="attributes-header-with-confirm">
          {{#if creationComplete}}
          <div class="attribute-xp-distribution-controls">
            <div class="attribute-xp-confirm-row">
              <div class="attribute-xp-confirm-pair">
                <button type="button" class="confirm-attribute-changes" id="confirm-attribute-changes-btn" disabled>
                  <i class="fas fa-check"></i> Confirm Changes
                </button>
                <button type="button" class="cancel-attribute-changes" id="cancel-attribute-changes-btn" disabled>
                  <i class="fas fa-times"></i> Cancel
                </button>
              </div>
              <button type="button" class="stone-powers-btn stone-powers-btn-header" data-action="openStonePowers" title="Stone powers">
                <i class="fas fa-gem"></i> Stone powers
              </button>
              {{#if hasArtifactEvolution}}
              <button type="button" class="artifact-evolution-btn stone-powers-btn-header" data-action="openArtifactEvolution" title="Artifact evolution — link and upgrade along the tree">
                <i class="fas fa-project-diagram"></i> Artifact evolution
              </button>
              {{/if}}
            </div>
          </div>
          {{else}}
          <div class="attribute-xp-confirm-row">
          <button type="button" class="stone-powers-btn stone-powers-btn-header" data-action="openStonePowers" title="Stone powers">
            <i class="fas fa-gem"></i> Stone powers
          </button>
          {{#if hasArtifactEvolution}}
          <button type="button" class="artifact-evolution-btn stone-powers-btn-header" data-action="openArtifactEvolution" title="Artifact evolution — link and upgrade along the tree">
            <i class="fas fa-project-diagram"></i> Artifact evolution
          </button>
          {{/if}}
          </div>
          {{/if}}
        </div>
        
        <!-- Row 1: Physical + Mental Attributes -->
        <div class="attributes-grid">
          
          <!-- Might -->
          {{#with system.attributes.might}}
            <div class="attribute-card" data-attribute="might">
              <div class="attribute-card-header">
                <h4 class="attribute-name"><i class="fas fa-dumbbell"></i> Might</h4>
                <div class="attribute-value-with-button">
                  <div class="attribute-value">
                    <span class="attribute-base-value">{{default value 0}}</span>
                    <span class="attribute-pending-change" data-attribute="might" style="display: none;"><span class="pending-delta"></span></span>
                  </div>
                  {{#if ../creationComplete}}
                  <div class="attribute-controls attribute-controls-vertical">
                    <button type="button" class="attr-increase-xp" data-attribute="might" title="Increase Attribute (Pending)">
                      <i class="fas fa-plus"></i>
                    </button>
                    <button type="button" class="attr-decrease-xp" data-attribute="might" title="Decrease Attribute (Pending)" disabled>
                      <i class="fas fa-minus"></i>
                    </button>
                  </div>
                  {{else}}
                  <select class="attr-creation-select" data-attribute="might">
                    {{#if @root.creation.attrCreationSelect.might.s2}}<option value="2" {{#if (eq value 2)}}selected{{/if}}>2</option>{{/if}}
                    {{#if @root.creation.attrCreationSelect.might.s4}}<option value="4" {{#if (eq value 4)}}selected{{/if}}>4</option>{{/if}}
                    {{#if @root.creation.attrCreationSelect.might.s6}}<option value="6" {{#if (eq value 6)}}selected{{/if}}>6</option>{{/if}}
                    {{#if @root.creation.attrCreationSelect.might.s8}}<option value="8" {{#if (eq value 8)}}selected{{/if}}>8</option>{{/if}}
                  </select>
                  {{/if}}
                </div>
              </div>
              
              {{#if ../creationComplete}}
              <div class="minor-expressions-card minor-expressions-card--button-only">
                <button type="button" class="minor-expressions-open" data-attribute="might" title="Minor Expressions (Might)">Minor Expressions</button>
              </div>
              {{else}}
              <div class="minor-expressions-card minor-expressions-card--muted">
                <span>Minor Expressions nach Abschluss der Erstellung</span>
              </div>
              {{/if}}
              
              <!-- Roll Button -->
              <button type="button" class="attribute-roll" data-attribute="might" title="Roll Might">
                <i class="fas fa-dice-d20"></i> Roll Might
              </button>
            </div>
          {{/with}}
          
          <!-- Agility -->
          {{#with system.attributes.agility}}
            <div class="attribute-card" data-attribute="agility">
              <div class="attribute-card-header">
                <h4 class="attribute-name"><i class="fas fa-running"></i> Agility</h4>
                <div class="attribute-value-with-button">
                  <div class="attribute-value">
                    <span class="attribute-base-value">{{default value 0}}</span>
                    <span class="attribute-pending-change" data-attribute="agility" style="display: none;"><span class="pending-delta"></span></span>
                  </div>
                  {{#if ../creationComplete}}
                  <div class="attribute-controls attribute-controls-vertical">
                    <button type="button" class="attr-increase-xp" data-attribute="agility" title="Increase Attribute (Pending)">
                      <i class="fas fa-plus"></i>
                    </button>
                    <button type="button" class="attr-decrease-xp" data-attribute="agility" title="Decrease Attribute (Pending)" disabled>
                      <i class="fas fa-minus"></i>
                    </button>
                  </div>
                  {{else}}
                  <select class="attr-creation-select" data-attribute="agility">
                    {{#if @root.creation.attrCreationSelect.agility.s2}}<option value="2" {{#if (eq value 2)}}selected{{/if}}>2</option>{{/if}}
                    {{#if @root.creation.attrCreationSelect.agility.s4}}<option value="4" {{#if (eq value 4)}}selected{{/if}}>4</option>{{/if}}
