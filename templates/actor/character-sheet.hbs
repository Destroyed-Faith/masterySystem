            <summary class="disadvantage-fold-rules-summary">{{disadvantage.name}} — rules &amp; description</summary>
            <div class="disadvantage-fold-rules-body">
              <p class="disadvantage-description-sheet">{{disadvantage.description}}</p>
            </div>
          </details>
          {{/if}}
          {{else}}
          {{#if disadvantage.description}}
          <p class="disadvantage-description-sheet">{{disadvantage.description}}</p>
          {{/if}}
          {{#if disadvantage.details}}
          <div class="disadvantage-details-sheet">
            {{#each disadvantage.details as |value key|}}
            <div class="detail-item-sheet">
              <strong>{{capitalize key}}:</strong> {{value}}
            </div>
            {{/each}}
          </div>
          {{/if}}
          {{/if}}
        </div>
        {{/each}}
      </div>
      {{else}}
      <p class="empty-message">No disadvantages selected.</p>
      {{/if}}
      
      {{#unless creationComplete}}
      <div class="creation-note">
        <p><i class="fas fa-info-circle"></i> You must take at least <strong>{{creation.disadvantagePointsMin}}</strong> and at most <strong>{{creation.disadvantagePointsMax}}</strong> points of disadvantages to finalize creation. Total points set your starting Faith Fractures.</p>
      </div>
      {{/unless}}
    </div>
    
  </section>
</form>
