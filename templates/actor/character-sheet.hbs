<form class="{{cssClass}}" autocomplete="off">
  
  <!-- Header -->
  <header class="sheet-header">
    <div class="portrait-section">
      <div class="profile-img-wrapper">
        <div class="profile-img-container {{#unless editable}}locked{{/unless}}" data-image-type="portrait">
          <img class="profile-img {{#if editable}}{{else}}locked{{/if}}" src="{{actor.img}}" title="{{actor.name}} Portrait" alt="{{actor.name}} Portrait" />
          <div class="profile-overlay">
            <div class="profile-zone profile-zone-edit" data-action="edit" data-img-type="portrait">
              <span class="zone-label">EDIT</span>
            </div>
            <div class="profile-zone profile-zone-show" data-action="show" data-img-type="portrait">
              <span class="zone-label">SHOW</span>
            </div>
          </div>
        </div>
        <div class="profile-img-label">PORTRAIT</div>
      </div>
      <div class="profile-img-wrapper">
        <div class="profile-img-container profile-img-container-token {{#unless editable}}locked{{/unless}}" data-image-type="token">
          <img class="profile-img {{#if editable}}{{else}}locked{{/if}}" src="{{default actor.prototypeToken.texture.src actor.img}}" title="{{actor.name}} Token" alt="{{actor.name}} Token" />
          <div class="profile-overlay">
            <div class="profile-zone profile-zone-edit" data-action="edit" data-img-type="token">
              <span class="zone-label">EDIT</span>
            </div>
            <div class="profile-zone profile-zone-show" data-action="show" data-img-type="token">
              <span class="zone-label">SHOW</span>
            </div>
          </div>
        </div>
        <div class="profile-img-label">TOKEN</div>
      </div>
    </div>
    
    <div class="header-info">
      <div class="mastery-rank-box" title="Mastery Rank">
        <label>MR</label>
        <span class="rank-value">{{default system.mastery.rank 2}}</span>
      </div>
      
      {{#if creationComplete}}
      <div class="points-box" title="Experience Points">
        <label>XP</label>
        <div class="points-display">
          <span class="points-value" id="sheet-xp-display">{{default system.points.xp 0}}</span>
        </div>
      </div>
      {{else}}
      <!-- Attribute Distribution Counter -->
      <div class="points-box creation-points" title="Attribute Distribution: 2×8, 2×6, 2×4, 1×2">
        <label>Attr</label>
        <div class="points-display attr-distribution-display">
          <span class="attr-dist-item {{#if (eq creation.attrCount8 2)}}complete{{else}}remaining{{/if}}">8×{{creation.attrCount8}}/2</span>
          <span class="attr-dist-item {{#if (eq creation.attrCount6 2)}}complete{{else}}remaining{{/if}}">6×{{creation.attrCount6}}/2</span>
          <span class="attr-dist-item {{#if (eq creation.attrCount4 2)}}complete{{else}}remaining{{/if}}">4×{{creation.attrCount4}}/2</span>
        </div>
      </div>
      
      <div class="points-box creation-points" title="Skill Points Remaining">
        <label>SP</label>
        <div class="points-display">
          <span class="points-value {{#if (eq creation.skillPointsRemaining 0)}}complete{{else}}remaining{{/if}}">{{creation.skillPointsRemaining}}</span>
          <span class="points-label">/ {{creation.skillPointsConfig}}</span>
        </div>
      </div>
      
      <div class="points-box creation-points" title="Disadvantage Points">
        <label>DP</label>
        <div class="points-display">
          <span class="points-value">{{creation.disadvantagePoints}}</span>
          <span class="points-label">/ 8</span>
        </div>
      </div>
      {{/if}}
      
      <div class="character-name-box">
        {{#if editable}}
          <input name="name" type="text" value="{{actor.name}}" placeholder="Character Name" />
        {{else}}
          <h1>{{actor.name}}</h1>
        {{/if}}
      </div>
    </div>
  </header>

  <!-- Character Creation Banner -->
  {{#unless creationComplete}}
  <div class="creation-banner">
    <div class="creation-banner-content">
      <h3><i class="fas fa-user-edit"></i> Character Creation Mode</h3>
      <p>Distribute attributes: <strong>2×8, 2×6, 2×4, 1×2</strong> ({{#if creation.attributeDistributionValid}}done{{else}}{{creation.attrCount8}}/2×8, {{creation.attrCount6}}/2×6, {{creation.attrCount4}}/2×4, {{creation.attrCount2}}/1×2{{/if}}). 
      <strong>{{creation.skillPointsRemaining}}</strong> Skill Points remaining. 
      <strong>Disadvantages:</strong> <strong>{{creation.disadvantagePoints}}</strong> / 8 points (optional).</p>
      <button type="button" class="reset-creation-attributes" title="Set all attributes to 2 so you can redistribute (fixes hidden dropdown options)">
        <i class="fas fa-undo"></i> Reset attributes
      </button>
      {{#if creation.canFinalize}}
      <button type="button" class="finalize-creation" title="Finalize character creation">
        <i class="fas fa-check-circle"></i> Finalize Character Creation
      </button>
      {{else}}
      <span class="creation-status">
        Remaining: Attributes ({{#if creation.attributeDistributionValid}}done{{else}}{{creation.attrCount8}}/2×8, {{creation.attrCount6}}/2×6, {{creation.attrCount4}}/2×4, {{creation.attrCount2}}/1×2{{/if}}), Skills ({{creation.skillPointsRemaining}} remaining)
        {{#unless creation.disadvantagesReviewed}}, Disadvantages (review required){{/unless}}.
      </span>
      {{/if}}
      {{#if (userIsGM)}}
      <button type="button" class="force-unlock-creation" title="GM Only: Force unlock character creation">
        <i class="fas fa-unlock"></i> Force Unlock
      </button>
      {{/if}}
    </div>
  </div>
  {{/unless}}

  <!-- Tabs Navigation (Right Side Bookmarks) -->
  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="attributes"><i class="fas fa-fist-raised"></i> Attributes</a>
    <a class="item" data-tab="skills"><i class="fas fa-cogs"></i> Skills</a>
    <a class="item" data-tab="powers"><i class="fas fa-magic"></i> Powers</a>
    <a class="item" data-tab="equipment"><i class="fas fa-shield-alt"></i> Equipment</a>
    <a class="item" data-tab="disadvantages"><i class="fas fa-exclamation-triangle"></i> Disadvantages</a>
    <a class="item" data-tab="biography"><i class="fas fa-scroll"></i> Bio</a>
  </nav>

  <!-- Sheet Body -->
  <section class="sheet-body">
    
    <!-- ATTRIBUTES TAB -->
    <div class="tab attributes" data-group="primary" data-tab="attributes">

      <!-- Status Effects Bar (Active Buffs/Effects) -->
      {{#if statusEffects}}
      {{#if (gt statusEffects.length 0)}}
      <div class="status-effects-bar">
        {{#each statusEffects}}
        <div class="status-effect-icon" title="{{this.name}}{{#if this.tooltip}}&#10;{{this.tooltip}}{{/if}}{{#if this.description}}&#10;&#10;{{this.description}}{{/if}}">
          <img src="{{this.icon}}" alt="{{this.name}}" />
          {{#if this.isActiveBuff}}
          <div class="status-effect-badge active-buff-badge"></div>
          {{/if}}
        </div>
        {{/each}}
      </div>
      {{/if}}
      {{/if}}

      <!-- Attributes Grid Section -->
      <div class="attributes-grid-section">
        <div class="attributes-header-with-confirm">
          {{#if creationComplete}}
          <div class="attribute-xp-distribution-controls">
            <div class="attribute-xp-confirm-row">
              <button type="button" class="confirm-attribute-changes" id="confirm-attribute-changes-btn" disabled>
                <i class="fas fa-check"></i> Confirm Changes
              </button>
              <button type="button" class="cancel-attribute-changes" id="cancel-attribute-changes-btn" disabled>
                <i class="fas fa-times"></i> Cancel
              </button>
              <button type="button" class="stone-powers-btn stone-powers-btn-header" data-action="openStonePowers" title="Stone powers">
                <i class="fas fa-gem"></i> Stone powers
              </button>
            </div>
          </div>
          {{else}}
          <button type="button" class="stone-powers-btn stone-powers-btn-header" data-action="openStonePowers" title="Stone powers">
            <i class="fas fa-gem"></i> Stone powers
          </button>
          {{/if}}
        </div>
        
        <!-- Row 1: Physical + Mental Attributes -->
        <div class="attributes-grid">
          
          <!-- Might -->
          {{#with system.attributes.might}}
            <div class="attribute-card" data-attribute="might">
              <div class="attribute-card-header">
                <h4 class="attribute-name"><i class="fas fa-dumbbell"></i> Might</h4>
                <div class="attribute-value-with-button">
                  <div class="attribute-value">
                    <span class="attribute-base-value">{{default value 0}}</span>
                    <span class="attribute-pending-change" data-attribute="might" style="display: none;"><span class="pending-delta"></span></span>
                  </div>
                  {{#if ../creationComplete}}
                  <div class="attribute-controls attribute-controls-vertical">
                    <button type="button" class="attr-increase-xp" data-attribute="might" title="Increase Attribute (Pending)">
                      <i class="fas fa-plus"></i>
                    </button>
                    <button type="button" class="attr-decrease-xp" data-attribute="might" title="Decrease Attribute (Pending)" disabled>
                      <i class="fas fa-minus"></i>
                    </button>
                  </div>
                  {{else}}
                  <select class="attr-creation-select" data-attribute="might">
                    {{#if @root.creation.attrCreationSelect.might.s2}}<option value="2" {{#if (eq value 2)}}selected{{/if}}>2</option>{{/if}}
                    {{#if @root.creation.attrCreationSelect.might.s4}}<option value="4" {{#if (eq value 4)}}selected{{/if}}>4</option>{{/if}}
                    {{#if @root.creation.attrCreationSelect.might.s6}}<option value="6" {{#if (eq value 6)}}selected{{/if}}>6</option>{{/if}}
                    {{#if @root.creation.attrCreationSelect.might.s8}}<option value="8" {{#if (eq value 8)}}selected{{/if}}>8</option>{{/if}}
                  </select>
                  {{/if}}
                </div>
              </div>
              
              <!-- Stones Display -->
              <div class="attribute-stones">
                <div class="stones-container">
                  {{#times (calculateStones value)}}
                    <span class="stone filled">●</span>
                  {{/times}}
                  {{#times (subtract 5 (calculateStones value))}}
                    <span class="stone empty">○</span>
                  {{/times}}
                </div>
                <div class="stones-count">{{calculateStones value}} / 5 Stones</div>
              </div>
              
              <!-- Roll Button -->
              <button type="button" class="attribute-roll" data-attribute="might" title="Roll Might">
                <i class="fas fa-dice-d20"></i> Roll Might
              </button>
            </div>
          {{/with}}
          
          <!-- Agility -->
          {{#with system.attributes.agility}}
            <div class="attribute-card" data-attribute="agility">
              <div class="attribute-card-header">
                <h4 class="attribute-name"><i class="fas fa-running"></i> Agility</h4>
                <div class="attribute-value-with-button">
                  <div class="attribute-value">
                    <span class="attribute-base-value">{{default value 0}}</span>
                    <span class="attribute-pending-change" data-attribute="agility" style="display: none;"><span class="pending-delta"></span></span>
                  </div>
                  {{#if ../creationComplete}}
                  <div class="attribute-controls attribute-controls-vertical">
                    <button type="button" class="attr-increase-xp" data-attribute="agility" title="Increase Attribute (Pending)">
                      <i class="fas fa-plus"></i>
                    </button>
                    <button type="button" class="attr-decrease-xp" data-attribute="agility" title="Decrease Attribute (Pending)" disabled>
                      <i class="fas fa-minus"></i>
                    </button>
                  </div>
                  {{else}}
                  <select class="attr-creation-select" data-attribute="agility">
                    {{#if @root.creation.attrCreationSelect.agility.s2}}<option value="2" {{#if (eq value 2)}}selected{{/if}}>2</option>{{/if}}
                    {{#if @root.creation.attrCreationSelect.agility.s4}}<option value="4" {{#if (eq value 4)}}selected{{/if}}>4</option>{{/if}}
                    {{#if @root.creation.attrCreationSelect.agility.s6}}<option value="6" {{#if (eq value 6)}}selected{{/if}}>6</option>{{/if}}
                    {{#if @root.creation.attrCreationSelect.agility.s8}}<option value="8" {{#if (eq value 8)}}selected{{/if}}>8</option>{{/if}}
                  </select>
                  {{/if}}
                </div>
              </div>
              
              <div class="attribute-stones">
                <div class="stones-container">
                  {{#times (calculateStones value)}}
                    <span class="stone filled">●</span>
                  {{/times}}
                  {{#times (subtract 5 (calculateStones value))}}
                    <span class="stone empty">○</span>
                  {{/times}}
                </div>
                <div class="stones-count">{{calculateStones value}} / 5 Stones</div>
              </div>
              
              <button type="button" class="attribute-roll" data-attribute="agility">
                <i class="fas fa-dice-d20"></i> Roll Agility
              </button>
            </div>
          {{/with}}
          
          <!-- Vitality -->
          {{#with system.attributes.vitality}}
            <div class="attribute-card" data-attribute="vitality">
              <div class="attribute-card-header">
                <h4 class="attribute-name"><i class="fas fa-heart"></i> Vitality</h4>
                <div class="attribute-value-with-button">
                  <div class="attribute-value">
                    <span class="attribute-base-value">{{default value 0}}</span>
                    <span class="attribute-pending-change" data-attribute="vitality" style="display: none;"><span class="pending-delta"></span></span>
                  </div>
                  {{#if ../creationComplete}}
                  <div class="attribute-controls attribute-controls-vertical">
                    <button type="button" class="attr-increase-xp" data-attribute="vitality" title="Increase Attribute (Pending)">
                      <i class="fas fa-plus"></i>
                    </button>
                    <button type="button" class="attr-decrease-xp" data-attribute="vitality" title="Decrease Attribute (Pending)" disabled>
                      <i class="fas fa-minus"></i>
                    </button>
                  </div>
                  {{else}}
                  <select class="attr-creation-select" data-attribute="vitality">
                    {{#if @root.creation.attrCreationSelect.vitality.s2}}<option value="2" {{#if (eq value 2)}}selected{{/if}}>2</option>{{/if}}
                    {{#if @root.creation.attrCreationSelect.vitality.s4}}<option value="4" {{#if (eq value 4)}}selected{{/if}}>4</option>{{/if}}
                    {{#if @root.creation.attrCreationSelect.vitality.s6}}<option value="6" {{#if (eq value 6)}}selected{{/if}}>6</option>{{/if}}
                    {{#if @root.creation.attrCreationSelect.vitality.s8}}<option value="8" {{#if (eq value 8)}}selected{{/if}}>8</option>{{/if}}
                  </select>
                  {{/if}}
                </div>
              </div>
              
              <div class="attribute-stones">
                <div class="stones-container">
                  {{#times (calculateStones value)}}
                    <span class="stone filled">●</span>
                  {{/times}}
                  {{#times (subtract 5 (calculateStones value))}}
                    <span class="stone empty">○</span>
                  {{/times}}
                </div>
                <div class="stones-count">{{calculateStones value}} / 5 Stones</div>
              </div>
              
              <button type="button" class="attribute-roll" data-attribute="vitality">
                <i class="fas fa-dice-d20"></i> Roll Vitality
              </button>
            </div>
          {{/with}}
          
          <!-- Wits -->
          {{#with system.attributes.wits}}
            <div class="attribute-card" data-attribute="wits">
              <div class="attribute-card-header">
                <h4 class="attribute-name"><i class="fas fa-brain"></i> Wits</h4>
                <div class="attribute-value-with-button">
                  <div class="attribute-value">
                    <span class="attribute-base-value">{{default value 0}}</span>
                    <span class="attribute-pending-change" data-attribute="wits" style="display: none;"><span class="pending-delta"></span></span>
                  </div>
                  {{#if ../creationComplete}}
                  <div class="attribute-controls attribute-controls-vertical">
                    <button type="button" class="attr-increase-xp" data-attribute="wits" title="Increase Attribute (Pending)">
                      <i class="fas fa-plus"></i>
                    </button>
                    <button type="button" class="attr-decrease-xp" data-attribute="wits" title="Decrease Attribute (Pending)" disabled>
                      <i class="fas fa-minus"></i>
                    </button>
                  </div>
                  {{else}}
                  <select class="attr-creation-select" data-attribute="wits">
                    {{#if @root.creation.attrCreationSelect.wits.s2}}<option value="2" {{#if (eq value 2)}}selected{{/if}}>2</option>{{/if}}
                    {{#if @root.creation.attrCreationSelect.wits.s4}}<option value="4" {{#if (eq value 4)}}selected{{/if}}>4</option>{{/if}}
                    {{#if @root.creation.attrCreationSelect.wits.s6}}<option value="6" {{#if (eq value 6)}}selected{{/if}}>6</option>{{/if}}
                    {{#if @root.creation.attrCreationSelect.wits.s8}}<option value="8" {{#if (eq value 8)}}selected{{/if}}>8</option>{{/if}}
                  </select>
                  {{/if}}
                </div>
              </div>
              
              <div class="attribute-stones">
                <div class="stones-container">
                  {{#times (calculateStones value)}}
                    <span class="stone filled">●</span>
                  {{/times}}
                  {{#times (subtract 5 (calculateStones value))}}
                    <span class="stone empty">○</span>
                  {{/times}}
                </div>
                <div class="stones-count">{{calculateStones value}} / 5 Stones</div>
              </div>
              
              <button type="button" class="attribute-roll" data-attribute="wits">
                <i class="fas fa-dice-d20"></i> Roll Wits
              </button>
            </div>
          {{/with}}
          
        </div>
        
        <!-- Row 2: Mental/Social Attributes -->
        <div class="attributes-grid">
          
          <!-- Intellect -->
          {{#with system.attributes.intellect}}
            <div class="attribute-card" data-attribute="intellect">
              <div class="attribute-card-header">
                <h4 class="attribute-name"><i class="fas fa-book"></i> Intellect</h4>
                <div class="attribute-value-with-button">
                  <div class="attribute-value">
                    <span class="attribute-base-value">{{default value 0}}</span>
                    <span class="attribute-pending-change" data-attribute="intellect" style="display: none;"><span class="pending-delta"></span></span>
                  </div>
                  {{#if ../creationComplete}}
                  <div class="attribute-controls">
                    <button type="button" class="attr-decrease-xp" data-attribute="intellect" title="Decrease Attribute (Pending)" disabled>
                      <i class="fas fa-minus"></i>
                    </button>
                    <button type="button" class="attr-increase-xp" data-attribute="intellect" title="Increase Attribute (Pending)">
                      <i class="fas fa-plus"></i>
                    </button>
                  </div>
                  {{else}}
                  <select class="attr-creation-select" data-attribute="intellect">
                    {{#if @root.creation.attrCreationSelect.intellect.s2}}<option value="2" {{#if (eq value 2)}}selected{{/if}}>2</option>{{/if}}
                    {{#if @root.creation.attrCreationSelect.intellect.s4}}<option value="4" {{#if (eq value 4)}}selected{{/if}}>4</option>{{/if}}
                    {{#if @root.creation.attrCreationSelect.intellect.s6}}<option value="6" {{#if (eq value 6)}}selected{{/if}}>6</option>{{/if}}
                    {{#if @root.creation.attrCreationSelect.intellect.s8}}<option value="8" {{#if (eq value 8)}}selected{{/if}}>8</option>{{/if}}
                  </select>
                  {{/if}}
                </div>
              </div>
              
              <div class="attribute-stones">
                <div class="stones-container">
                  {{#times (calculateStones value)}}
                    <span class="stone filled">●</span>
                  {{/times}}
                  {{#times (subtract 5 (calculateStones value))}}
                    <span class="stone empty">○</span>
                  {{/times}}
                </div>
                <div class="stones-count">{{calculateStones value}} / 5 Stones</div>
              </div>
              
              <button type="button" class="attribute-roll" data-attribute="intellect">
                <i class="fas fa-dice-d20"></i> Roll Intellect
              </button>
            </div>
          {{/with}}
          
          <!-- Resolve -->
          {{#with system.attributes.resolve}}
            <div class="attribute-card" data-attribute="resolve">
              <div class="attribute-card-header">
                <h4 class="attribute-name"><i class="fas fa-mountain"></i> Resolve</h4>
                <div class="attribute-value-with-button">
                  <div class="attribute-value">
                    <span class="attribute-base-value">{{default value 0}}</span>
                    <span class="attribute-pending-change" data-attribute="resolve" style="display: none;"><span class="pending-delta"></span></span>
                  </div>
                  {{#if ../creationComplete}}
                  <div class="attribute-controls">
                    <button type="button" class="attr-decrease-xp" data-attribute="resolve" title="Decrease Attribute (Pending)" disabled>
                      <i class="fas fa-minus"></i>
                    </button>
                    <button type="button" class="attr-increase-xp" data-attribute="resolve" title="Increase Attribute (Pending)">
                      <i class="fas fa-plus"></i>
                    </button>
                  </div>
                  {{else}}
                  <select class="attr-creation-select" data-attribute="resolve">
                    {{#if @root.creation.attrCreationSelect.resolve.s2}}<option value="2" {{#if (eq value 2)}}selected{{/if}}>2</option>{{/if}}
                    {{#if @root.creation.attrCreationSelect.resolve.s4}}<option value="4" {{#if (eq value 4)}}selected{{/if}}>4</option>{{/if}}
                    {{#if @root.creation.attrCreationSelect.resolve.s6}}<option value="6" {{#if (eq value 6)}}selected{{/if}}>6</option>{{/if}}
                    {{#if @root.creation.attrCreationSelect.resolve.s8}}<option value="8" {{#if (eq value 8)}}selected{{/if}}>8</option>{{/if}}
                  </select>
                  {{/if}}
                </div>
              </div>
              
              <div class="attribute-stones">
                <div class="stones-container">
                  {{#times (calculateStones value)}}
                    <span class="stone filled">●</span>
                  {{/times}}
                  {{#times (subtract 5 (calculateStones value))}}
                    <span class="stone empty">○</span>
                  {{/times}}
                </div>
                <div class="stones-count">{{calculateStones value}} / 5 Stones</div>
              </div>
              
              <button type="button" class="attribute-roll" data-attribute="resolve">
                <i class="fas fa-dice-d20"></i> Roll Resolve
              </button>
            </div>
          {{/with}}
          
          <!-- Influence -->
          {{#with system.attributes.influence}}
            <div class="attribute-card" data-attribute="influence">
              <div class="attribute-card-header">
                <h4 class="attribute-name"><i class="fas fa-users"></i> Influence</h4>
                <div class="attribute-value-with-button">
                  <div class="attribute-value">
                    <span class="attribute-base-value">{{default value 0}}</span>
                    <span class="attribute-pending-change" data-attribute="influence" style="display: none;"><span class="pending-delta"></span></span>
                  </div>
                  {{#if ../creationComplete}}
                  <div class="attribute-controls">
                    <button type="button" class="attr-decrease-xp" data-attribute="influence" title="Decrease Attribute (Pending)" disabled>
                      <i class="fas fa-minus"></i>
                    </button>
                    <button type="button" class="attr-increase-xp" data-attribute="influence" title="Increase Attribute (Pending)">
                      <i class="fas fa-plus"></i>
                    </button>
                  </div>
                  {{else}}
                  <select class="attr-creation-select" data-attribute="influence">
                    {{#if @root.creation.attrCreationSelect.influence.s2}}<option value="2" {{#if (eq value 2)}}selected{{/if}}>2</option>{{/if}}
                    {{#if @root.creation.attrCreationSelect.influence.s4}}<option value="4" {{#if (eq value 4)}}selected{{/if}}>4</option>{{/if}}
                    {{#if @root.creation.attrCreationSelect.influence.s6}}<option value="6" {{#if (eq value 6)}}selected{{/if}}>6</option>{{/if}}
                    {{#if @root.creation.attrCreationSelect.influence.s8}}<option value="8" {{#if (eq value 8)}}selected{{/if}}>8</option>{{/if}}
                  </select>
                  {{/if}}
                </div>
              </div>
              
              <div class="attribute-stones">
                <div class="stones-container">
                  {{#times (calculateStones value)}}
                    <span class="stone filled">●</span>
                  {{/times}}
                  {{#times (subtract 5 (calculateStones value))}}
                    <span class="stone empty">○</span>
                  {{/times}}
                </div>
                <div class="stones-count">{{calculateStones value}} / 5 Stones</div>
              </div>
              
              <button type="button" class="attribute-roll" data-attribute="influence">
                <i class="fas fa-dice-d20"></i> Roll Influence
              </button>
            </div>
          {{/with}}
          
        </div>
      </div>
      
      <!-- Combat Stats Section -->
      <div class="combat-stats-section">
        <h3><i class="fas fa-shield-alt"></i> Combat Statistics</h3>
        
        <div class="combat-stats-grid">
          <!-- Evade -->
          <div class="combat-stat-card">
            <div class="stat-icon evade-icon"><i class="fas fa-wind"></i></div>
            <div class="stat-content">
              <label>Evade</label>
              <div class="stat-value">{{default system.combat.evadeTotal 8}}</div>
              <div class="stat-formula">MR×4 + Agi + Shield + Armor</div>
            </div>
          </div>
          
          <!-- Armor -->
          <div class="combat-stat-card">
            <div class="stat-icon armor-icon"><i class="fas fa-shield-alt"></i></div>
            <div class="stat-content">
              <label>Armor</label>
              <div class="stat-value">{{default system.combat.armorTotal 0}}</div>
              <div class="stat-formula">MR + Armor + Shield</div>
            </div>
          </div>
          
          <!-- Speed -->
          <div class="combat-stat-card">
            <div class="stat-icon speed-icon"><i class="fas fa-running"></i></div>
            <div class="stat-content">
              <label>Speed</label>
              <div class="stat-value">{{default system.combat.speed 6}}m</div>
              <div class="stat-formula">Base Movement</div>
            </div>
          </div>
          
          <!-- Initiative Bonus -->
          <div class="combat-stat-card">
            <div class="stat-icon initiative-icon"><i class="fas fa-bolt"></i></div>
            <div class="stat-content">
              <label>Initiative</label>
              <div class="stat-value">+{{default system.combat.initiativeBonus 0}}</div>
              <div class="stat-formula">Combat Reflexes</div>
            </div>
          </div>
        </div>
      </div>
      
      <div style="margin-top: 30px;"></div>
      
      <!-- Saving Throws Section -->
      <div class="saving-throws-section">
        <h3><i class="fas fa-dice-d20"></i> Saving Throws</h3>
        
        <!-- Vitality Pool for Saves -->
        <div class="save-vitality-pool">
          <span class="save-vitality-label">
            <i class="fas fa-heart-pulse"></i> Vitality Pool ({{default system.attributes.vitality.value 2}} pts, {{default system.saves.vitalityUsesRemaining 4}}/4 uses)
          </span>
          <div class="save-vitality-uses">
            {{#times 4}}
            <span class="save-vitality-box {{#if (lt @index (default ../system.saves.vitalityUsesRemaining 4))}}available{{else}}spent{{/if}}"></span>
            {{/times}}
          </div>
        </div>
        
        <div class="saving-throws-grid-three">
          <!-- Body Save: Max(Might, Agility) k Mastery -->
          <div class="saving-throw-card">
            <h4 class="save-title">
              <i class="fas fa-dumbbell"></i> Body Save
            </h4>
            <div class="save-pool">
              {{#if (gt system.attributes.might.value system.attributes.agility.value)}}
                {{system.attributes.might.value}}d8
              {{else}}
                {{system.attributes.agility.value}}d8
              {{/if}}
              k {{default system.mastery.rank 2}}
            </div>
            <button type="button" class="save-roll-btn" data-save-type="body" title="Roll Body Save">
              <i class="fas fa-dice-d20"></i> Roll Save
            </button>
          </div>
          
          <!-- Mind Save: Max(Intellect, Wits) k Mastery -->
          <div class="saving-throw-card">
            <h4 class="save-title">
              <i class="fas fa-brain"></i> Mind Save
            </h4>
            <div class="save-pool">
              {{#if (gt system.attributes.intellect.value system.attributes.wits.value)}}
                {{system.attributes.intellect.value}}d8
              {{else}}
                {{system.attributes.wits.value}}d8
              {{/if}}
              k {{default system.mastery.rank 2}}
            </div>
            <button type="button" class="save-roll-btn" data-save-type="mind" title="Roll Mind Save">
              <i class="fas fa-dice-d20"></i> Roll Save
            </button>
          </div>
          
          <!-- Spirit Save: Max(Resolve, Influence) k Mastery -->
          <div class="saving-throw-card">
            <h4 class="save-title">
              <i class="fas fa-hands-praying"></i> Spirit Save
            </h4>
            <div class="save-pool">
              {{#if (gt system.attributes.resolve.value system.attributes.influence.value)}}
                {{system.attributes.resolve.value}}d8
              {{else}}
                {{system.attributes.influence.value}}d8
              {{/if}}
              k {{default system.mastery.rank 2}}
            </div>
            <button type="button" class="save-roll-btn" data-save-type="spirit" title="Roll Spirit Save">
              <i class="fas fa-dice-d20"></i> Roll Save
            </button>
          </div>
        </div>
      </div>
      
      <!-- Health & Stress Section (under Saving Throws) -->
      <div class="health-stress-section">
        <div class="health-stress-grid">
          <!-- Health Bars -->
          <div class="health-bars-container">
            <h4><i class="fas fa-heart"></i> Health (Vitality × 2 per bar)</h4>
            <div class="health-bars-list">
              {{#each system.health.bars as |bar index|}}
              <div class="health-bar-row {{#if (eq index ../system.health.currentBar)}}active{{/if}}">
                <div class="health-bar-info">
                  <span class="health-bar-name">
                    {{#if (eq bar.penalty 0)}}
                      Healthy (0 penalty)
                    {{else if (eq bar.penalty -1)}}
                      Bruised (-1 penalty)
                    {{else if (eq bar.penalty -2)}}
                      Injured (-2 penalty)
                    {{else if (eq bar.penalty -4)}}
                      Wounded (-4 penalty)
                    {{else}}
                      {{bar.name}}{{#if bar.penalty}} ({{bar.penalty}} penalty){{/if}}
                    {{/if}}
                  </span>
                </div>
                <div class="health-bar-inputs">
                  <input type="number" name="system.health.bars.{{index}}.current" value="{{bar.current}}" data-dtype="Number" min="0" max="{{bar.max}}" />
                  <span class="health-bar-separator">/</span>
                  <input type="number" name="system.health.bars.{{index}}.max" value="{{bar.max}}" data-dtype="Number" min="0" readonly />
                </div>
                <div class="health-bar-boxes">
                  {{#times bar.max}}
                  <span class="health-box {{#if (lt @index bar.current)}}filled{{else}}empty{{/if}}"></span>
                  {{/times}}
                </div>
              </div>
              {{/each}}
            </div>
            <div class="health-temp-hp">
              <label>Temp HP:</label>
              <input type="number" name="system.health.tempHP" value="{{default system.health.tempHP 0}}" data-dtype="Number" min="0" />
            </div>
          </div>
          
          <!-- Stress Bars -->
          <div class="stress-bars-container">
            <h4><i class="fas fa-brain"></i> Stress (Resolve + Intellect per bar)</h4>
            <div class="stress-bars-list">
              {{#each system.stress.bars as |bar index|}}
              <div class="stress-bar-row {{#if (eq index ../system.stress.currentBar)}}active{{/if}}">
                <div class="stress-bar-info">
                  <span class="stress-bar-name">{{bar.name}}</span>
                </div>
                <div class="stress-bar-inputs">
                  <input type="number" name="system.stress.bars.{{index}}.current" value="{{bar.current}}" data-dtype="Number" min="0" max="{{bar.max}}" />
                  <span class="stress-bar-separator">/</span>
                  <input type="number" name="system.stress.bars.{{index}}.max" value="{{bar.max}}" data-dtype="Number" min="0" readonly />
                </div>
                <div class="stress-bar-boxes">
                  {{#times bar.max}}
                  <span class="stress-box {{#if (lt @index bar.current)}}filled{{else}}empty{{/if}}"></span>
                  {{/times}}
                </div>
              </div>
              {{/each}}
            </div>
          </div>
        </div>
      </div>
      
      <!-- Schticks (editable during and after character creation) -->
      <div class="schticks-section">
        <h3><i class="fas fa-star"></i> Schticks</h3>
        {{#if creationComplete}}
        <p class="schticks-post-creation-hint">You can update Schticks and manifestations anytime; changes save when you leave a field.</p>
        {{/if}}
        <table class="schticks-table">
          <thead>
            <tr>
              <th class="rank-column">
                <span class="rank-header">Rank</span>
              </th>
              <th class="schtick-column">Schtick</th>
              <th class="manifestation-column">Manifestation</th>
            </tr>
          </thead>
          <tbody>
            {{#each creation.schticksRows}}
            <tr class="schtick-row" data-rank="{{this.rank}}">
              <td class="rank-cell">
                <span 
                  class="rank-number" 
                  title="{{lookup (lookup ../creation.rankTooltips this.rank) 'description'}} | Example: {{lookup (lookup ../creation.rankTooltips this.rank) 'example'}}"
                >
                  {{this.rank}}
                </span>
              </td>
              <td class="schtick-cell">
                <input 
                  type="text" 
                  class="schtick-input" 
                  data-rank="{{this.rank}}"
                  value="{{this.schtickName}}"
                  placeholder="Enter Schtick name..."
                  title="Enter a Schtick name for Rank {{this.rank}}"
                  {{#unless @root.editable}}readonly disabled{{/unless}}
                />
              </td>
              <td class="manifestation-cell">
                <input 
                  type="text" 
                  class="schtick-manifestation-input" 
                  data-rank="{{this.rank}}"
                  value="{{this.manifestation}}"
                  placeholder="Describe the manifestation..."
                  title="Describe how this Schtick manifests at Rank {{this.rank}}"
                  {{#unless @root.editable}}readonly disabled{{/unless}}
                />
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
      
    </div>
    
    <!-- SKILLS TAB -->
    <div class="tab skills" data-group="primary" data-tab="skills">
      
      <div class="skills-overview">
        {{#if creationComplete}}
        <div class="attribute-xp-distribution-controls skill-xp-toolbar">
          <div class="pending-skill-changes-info">
            <span class="remaining-xp-text">After pending: <span id="remaining-skill-xp">0</span> XP</span>
            <span class="pending-changes-text">Steps: <span id="pending-skill-changes-count">0</span></span>
            <span class="pending-skill-xp-net-wrap">Net: <span id="pending-skill-xp-net">0</span> XP</span>
          </div>
          <div class="skill-xp-toolbar-actions">
            <button type="button" class="confirm-skill-changes" id="confirm-skill-changes-btn" disabled>
              <i class="fas fa-check"></i> Confirm Changes
            </button>
            <button type="button" class="cancel-skill-changes" id="cancel-skill-changes-btn" disabled>
              <i class="fas fa-times"></i> Cancel
            </button>
          </div>
        </div>
        <button type="button" class="safe-haven-rest" title="Rest at Safe Haven - Restore all Skill Points" style="width: 200px;">
          <i class="fas fa-bed"></i> Safe Haven Rest
        </button>
        {{/if}}
      </div>
      
      {{#each skills}}
        <div class="skill-category-compact">
          <h4 class="category-header-compact">
            {{#if (eq this.category "Physical")}}<i class="fas fa-running"></i>{{/if}}
            {{#if (eq this.category "Knowledge & Craft")}}<i class="fas fa-book"></i>{{/if}}
            {{#if (eq this.category "Social")}}<i class="fas fa-comments"></i>{{/if}}
            {{#if (eq this.category "Survival")}}<i class="fas fa-tree"></i>{{/if}}
            {{#if (eq this.category "Martial")}}<i class="fas fa-sword"></i>{{/if}}
            {{this.category}}
          </h4>
          <div class="skills-list-compact">
            {{#each this.skills}}
              <div class="skill-row-compact">
                <span class="skill-name-compact">{{this.name}}</span>
                <div class="skill-attrs-compact">
                  {{#each this.attributes}}
                    <span class="attr-badge">{{capitalize this}}</span>
                  {{/each}}
                </div>
                <div class="skill-value-display-compact">
                  <div class="skill-rank-block">
                    <span class="skill-value-compact">{{default this.value 0}}</span>
                    {{#if @root.creationComplete}}
                    <span class="skill-rank-pending-badge" data-skill="{{this.key}}" title="Rank after pending changes"></span>
                    {{/if}}
                  </div>
                  {{#if @root.creationComplete}}
                  <span class="skill-pool-display">{{default this.remaining 0}} / {{default this.value 0}} uses</span>
                  <span class="skill-pending-xp" data-skill="{{this.key}}" title="XP reserved on this skill until Confirm"></span>
                  <div class="skill-progress-controls">
                    <button type="button" class="skill-spend-point" data-skill="{{this.key}}" title="Increase Skill (Spend XP)">
                      <i class="fas fa-plus"></i>
                    </button>
                    <button type="button" class="skill-refund-point" data-skill="{{this.key}}" title="Decrease Skill (Refund XP)">
                      <i class="fas fa-minus"></i>
                    </button>
                  </div>
                  {{else}}
                  <div class="creation-controls">
                    <button type="button" class="skill-decrease" data-skill="{{this.key}}" title="Decrease Skill" {{#if (lte this.value 0)}}disabled{{/if}}>
                      <i class="fas fa-minus"></i>
                    </button>
                    <button type="button" class="skill-increase" data-skill="{{this.key}}" title="Increase Skill" {{#if (gte this.value 4)}}disabled{{/if}} {{#if (eq @root.creation.skillPointsRemaining 0)}}disabled{{/if}}>
                      <i class="fas fa-plus"></i>
                    </button>
                  </div>
                  {{/if}}
                </div>
                {{#if @root.creationComplete}}
                <div class="skill-use-boxes" title="{{this.remaining}}/{{this.value}} uses remaining">
                  <span class="skill-use-box {{#if (gte this.value 1)}}{{#if (gte this.remaining 1)}}available{{else}}spent{{/if}}{{else}}locked{{/if}}"></span>
                  <span class="skill-use-box {{#if (gte this.value 2)}}{{#if (gte this.remaining 2)}}available{{else}}spent{{/if}}{{else}}locked{{/if}}"></span>
                  <span class="skill-use-box {{#if (gte this.value 3)}}{{#if (gte this.remaining 3)}}available{{else}}spent{{/if}}{{else}}locked{{/if}}"></span>
                  <span class="skill-use-box {{#if (gte this.value 4)}}{{#if (gte this.remaining 4)}}available{{else}}spent{{/if}}{{else}}locked{{/if}}"></span>
                </div>
                {{/if}}
                <button type="button" class="skill-roll-compact" data-skill="{{this.key}}" title="Roll {{this.name}}">
                  <i class="fas fa-dice-d20"></i>
                </button>
              </div>
            {{/each}}
          </div>
        </div>
      {{/each}}
      
    </div>
    
    <!-- POWERS TAB -->
    <div class="tab powers" data-group="primary" data-tab="powers">
      
      <!-- Active Buffs Section -->
      {{#if activeBuffs}}
      {{#if (gt activeBuffs.length 0)}}
      <div class="active-buffs-section">
        <h3><i class="fas fa-shield-alt"></i> Active Buffs</h3>
        <div class="active-buffs-list">
          {{#each activeBuffs}}
          <div class="active-buff-item" data-effect-id="{{this.id}}" title="{{this.name}}&#10;Duration: {{#if (gt this.roundsRemaining 0)}}{{this.roundsRemaining}} round{{#if (gt this.roundsRemaining 1)}}s{{/if}} remaining{{else}}Expiring this round{{/if}}{{#if this.description}}&#10;&#10;{{this.description}}{{/if}}">
            <div class="active-buff-icon">
              <img src="{{this.icon}}" alt="{{this.name}}" />
            </div>
            <div class="active-buff-info">
              <div class="active-buff-name">{{this.name}}</div>
              <div class="active-buff-duration">
                <i class="fas fa-clock"></i> 
                {{#if (gt this.roundsRemaining 0)}}
                  {{this.roundsRemaining}} round{{#if (gt this.roundsRemaining 1)}}s{{/if}} remaining
                {{else}}
                  Expiring this round
                {{/if}}
              </div>
            </div>
            <button type="button" class="active-buff-remove" data-effect-id="{{this.id}}" title="Remove Buff">
              <i class="fas fa-times"></i>
            </button>
          </div>
          {{/each}}
        </div>
      </div>
      {{/if}}
      {{/if}}
      
      <!-- Buttons always visible -->
      <div class="powers-overview">
        {{#if creationComplete}}
        <div class="power-level-distribution-controls" style="width: 230px;">
          <button type="button" class="confirm-power-level-changes" id="confirm-power-level-changes-btn" disabled style="width: 200px;">
            <i class="fas fa-check"></i> Confirm Changes
          </button>
          <button type="button" class="cancel-power-level-changes" id="cancel-power-level-changes-btn" disabled style="width: 200px;">
            <i class="fas fa-times"></i> Cancel
          </button>
        </div>
        {{/if}}
        <div class="powers-controls">
          <button type="button" class="add-power-creation-btn" title="Add Power from Mastery Tree">
            <i class="fas fa-plus"></i> Add Mastery Power
          </button>
          <button type="button" class="add-spell-creation-btn" title="Add Spell from Spell School">
            <i class="fas fa-plus"></i> Add Spell
          </button>
        </div>
      </div>
      
      {{#unless creationComplete}}
      <!-- CHARACTER CREATION: Powers & Magic Selection Status -->
      <div class="creation-powers-section">
        <div class="creation-banner">
          <h3><i class="fas fa-magic"></i> Character Creation: Powers & Magic Selection</h3>
          <div class="creation-status">
            <div class="status-item">
              <label>Trees Selected:</label>
              <span class="valid">
                {{creation.treesSelected}} (optional)
              </span>
            </div>
            <div class="status-item">
              <label>Powers Selected:</label>
              <span class="{{#if (eq creation.powersSelected creation.powersRequired)}}valid{{else}}invalid{{/if}}">
                {{creation.powersSelected}} / {{creation.powersRequired}}
              </span>
            </div>
            <div class="status-item">
              <label>Powers at Rank 2:</label>
              <span class="{{#if (lte creation.powersAtRank2 creation.powersAtRank2Max)}}valid{{else}}invalid{{/if}}">
                {{creation.powersAtRank2}} / {{creation.powersAtRank2Max}} (max)
              </span>
            </div>
          </div>
        </div>
        
        <div class="creation-instructions">
          <p><strong>Character Creation Rules:</strong></p>
          <ul>
            <li>Select exactly <strong>4 Powers</strong> (trees are optional)</li>
            <li>Maximum <strong>2 Powers</strong> can be at <strong>Rank 2</strong> (others remain Rank 1)</li>
            <li>No power rank may exceed your Mastery Rank (currently {{creation.masteryRank}})</li>
          </ul>
        </div>
        
        {{#if creation.selectedTreesData}}
        <div class="selected-trees">
          <h4>Selected Trees:</h4>
          <div class="trees-list">
            {{#each creation.selectedTreesData}}
            <div class="tree-card">
              <div class="tree-header">
                <h5 class="tree-name">{{this.name}}</h5>
                <span class="tree-type">{{#if (eq this.type "spell")}}Spell School{{else}}Mastery Tree{{/if}}</span>
              </div>
              {{#if this.focus}}
              <div class="tree-focus">
                <strong>Focus:</strong> {{this.focus}}
              </div>
              {{/if}}
              {{#if this.roles}}
              <div class="tree-roles">
                <strong>Roles:</strong> {{#each this.roles}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}
              </div>
              {{/if}}
              {{#if this.bonus}}
              <div class="tree-bonus">
                <strong>Tree Bonus:</strong>
                <div class="bonus-text">{{this.bonus}}</div>
              </div>
              {{else}}
              <div class="tree-bonus no-bonus">
                <em>No tree bonus defined</em>
              </div>
              {{/if}}
            </div>
            {{/each}}
          </div>
        </div>
        {{/if}}
        
        <!-- Selected Powers List (Creation Mode) -->
        <div class="creation-powers-list">
          <h4>Selected Powers:</h4>
          {{#if items.powers}}
            {{#each items.powers}}
              {{#if (contains ../creation.selectedTrees (default this.system.tree ""))}}
              <div class="power-card creation-power" data-item-id="{{this.id}}">
                <div class="power-header">
                  <h4 class="power-name">{{this.name}}</h4>
                  <div class="power-controls">
                    <select class="power-rank-select" data-item-id="{{this.id}}" title="Select Power Rank">
                      <option value="1" {{#if (eq this.system.level 1)}}selected{{/if}}>Rank 1</option>
                      <option value="2" {{#if (eq this.system.level 2)}}selected{{/if}}>Rank 2</option>
                    </select>
                    <button type="button" class="item-delete" title="Remove Power"><i class="fas fa-trash"></i></button>
                  </div>
                </div>
                <div class="power-details">
                  <span class="power-tree">{{default this.system.tree "No Tree"}}</span>
                  <span class="power-level">Level {{default this.system.level 1}}</span>
                </div>
              </div>
              {{/if}}
            {{/each}}
          {{else}}
            <p class="empty-message">No powers selected yet. Click "Add Mastery Power" or "Add Spell" to start.</p>
          {{/if}}
        </div>
      </div>
      {{/unless}}
      
      {{#if creationComplete}}
      <!-- Powers List (Normal Mode) -->
      <div class="powers-list-section">
        {{#if items.powers}}
          {{#each items.powers}}
            <div class="power-card" data-item-id="{{this.id}}">
              <div class="power-header-compact">
                <div class="power-name-compact">
                  {{this.name}}
                  <span class="power-level-badge" title="Power Level {{default this.system.level 1}}"><strong>Level {{default this.system.level 1}}</strong></span>
                  <span class="power-level-pending-change" data-item-id="{{this.id}}" style="display:none;">
                    <span class="pending-delta">+0</span>
                  </span>
                </div>
                <div class="power-info-compact">
                  {{#if (lookup this.system.roll 'damage')}}
                  <span class="power-damage-compact" title="Damage">
                    <i class="fas fa-sword"></i> {{powerDamage (lookup this.system.roll 'damage')}}
                  </span>
                  {{/if}}
                  {{#if this.system.specials}}
                  {{#if (isArray this.system.specials)}}
                  {{#each this.system.specials}}
                  {{#if @first}}
                  <span class="power-special-compact" title="Power Special">
                    <i class="fas fa-star"></i> {{powerSpecials ../this.system.specials}}
                  </span>
                  {{/if}}
                  {{/each}}
                  {{/if}}
                  {{/if}}
                  <span class="power-category-compact" title="Category">
                    <i class="fas fa-crosshairs"></i> {{powerCategory this.system.range this.system.aoe}}
                  </span>
                  <span class="power-type-compact" title="Type">
                    <i class="fas fa-bolt"></i> {{powerTypeDisplay this.system.powerType}}
                  </span>
                  {{#if this.system.effect}}
                  <span class="power-effect-compact" title="Effect">
                    <i class="fas fa-magic"></i> {{this.system.effect}}
                  </span>
                  {{/if}}
                </div>
                <div class="power-controls">
                  {{#if ../creationComplete}}
                  <div class="power-level-controls">
                    <button type="button" class="power-decrease-level" data-item-id="{{this.id}}" title="Decrease Power Level (Pending)">
                      <i class="fas fa-minus"></i>
                    </button>
                    <button type="button" class="power-increase-level" data-item-id="{{this.id}}" title="Increase Power Level (Pending)" {{#if (gte (default this.system.level 1) 12)}}disabled{{/if}}>
                      <i class="fas fa-plus"></i>
                    </button>
                  </div>
                  {{/if}}
                  <button type="button" class="power-toggle-details" data-item-id="{{this.id}}" title="Toggle Details">
                    <i class="fas fa-chevron-down"></i>
                  </button>
                  <button type="button" class="item-delete" data-item-id="{{this.id}}" title="Delete"><i class="fas fa-trash"></i></button>
                </div>
              </div>
              
              <!-- Compact Description (shown when collapsed) -->
              <div class="power-description-compact">{{this.system.description}}</div>
              
              <!-- Expandable Power Details (hidden by default) -->
              <div class="power-details-expanded" data-item-id="{{this.id}}" style="display: none;">
                <div class="form-group power-details-group" id="power-details">
                  {{#if (isNewPowerStructure this.system)}}
                  <div class="power-narrative-above-table">
                    {{#if this.system.fluff}}
                    <div class="power-fluff-block is-flavor">
                      <span class="power-fluff-heading">Flavor</span>
                      <div class="power-fluff-body">{{this.system.fluff}}</div>
                    </div>
                    {{/if}}
                    {{#if this.system.description}}
                    <div class="power-fluff-block {{#if this.system.fluff}}after-fluff{{/if}}">
                      <span class="power-fluff-heading">Description</span>
                      <div class="power-fluff-body">{{this.system.description}}</div>
                    </div>
                    {{/if}}
                  </div>
                  <!-- New Power Structure: effective rank comes from Power Level (+/−); table shows all ranks for reference -->
                  <p class="power-definition-rank-note">
                    Effects use <strong>rank {{powerDefinitionRank this.system}}</strong> from the table (power level {{default this.system.level 1}}; capped at the highest rank defined for this power).
                  </p>
                  
                  <div class="power-level-table-container">
                    <table class="power-level-table">
                      <thead>
                        <tr>
                          <th>Level</th>
                          <th>Type</th>
                          <th>Range</th>
                          <th>AoE</th>
                          <th>Duration</th>
                          <th>Effect</th>
                          <th>Specials</th>
                          {{#if (or (eq this.system.category 'reaction') this.system.trigger)}}
                          <th>Trigger</th>
                          {{/if}}
                        </tr>
                      </thead>
                      <tbody>
                        {{#each (array '1' '2' '3' '4')}}
                        {{#with (lookup ../this.system.levels this)}}
                        <tr class="power-level-row {{#if (selectedPowerTableRow ../this ../../this.system)}}selected is-current-power-level{{/if}}" data-level="{{../this}}">
                          <td class="power-level-cell {{#if (selectedPowerTableRow ../this ../../this.system)}}is-current{{/if}}">
                            <span class="power-level-num">{{../this}}</span>
                            {{#if (selectedPowerTableRow ../this ../../this.system)}}
                            <span class="power-level-current-badge" title="Row used at your current power level">Current</span>
                            {{/if}}
                          </td>
                          <td class="power-type-cell">{{this.type}}</td>
                          <td class="power-range-cell">{{renderRange this.range}}</td>
                          <td class="power-aoe-cell">{{renderAoe this.aoe}}</td>
                          <td class="power-duration-cell">{{renderDuration this.duration}}</td>
                          <td class="power-effect-cell">{{this.effect.text}}</td>
                          <td class="power-specials-cell">{{powerSpecials this.specials}}</td>
                          {{#if (or (eq ../../this.system.category 'reaction') ../../this.system.trigger)}}
                          <td class="power-trigger-cell">{{default this.trigger ../../this.system.trigger '—'}}</td>
                          {{/if}}
                        </tr>
                        {{/with}}
                        {{/each}}
                      </tbody>
                    </table>
                  </div>
                  {{else}}
                  <div id="power-description" class="power-description-text">{{this.system.description}}</div>
                  <!-- Old Power Structure: Show simple info -->
                  <div id="power-level-info" class="power-level-info-text">
                    <strong>Selected Level {{default this.system.level 1}}:</strong><br>
                    {{#if this.system.powerType}}Type: {{powerTypeDisplay this.system.powerType}}<br>{{/if}}
                    {{#if this.system.range}}Range: {{this.system.range}}<br>{{/if}}
                    {{#if this.system.aoe}}AoE: {{this.system.aoe}}<br>{{/if}}
                    {{#if this.system.duration}}Duration: {{this.system.duration}}<br>{{/if}}
                    {{#if this.system.effect}}Effect: {{this.system.effect}}<br>{{/if}}
                    {{#if this.system.specials}}
                    {{#if (isArray this.system.specials)}}
                    {{#each this.system.specials}}
                    {{#if @first}}
                    Special: {{powerSpecials ../this.system.specials}}<br>
                    {{/if}}
                    {{/each}}
                    {{/if}}
                    {{/if}}
                  </div>
                  {{/if}}
                </div>
              </div>
              
              {{#if this.system.equipped}}
                <button type="button" class="power-use-btn" data-power-id="{{this.id}}">
                  <i class="fas fa-bolt"></i> Use Power
                </button>
              {{/if}}
            </div>
          {{/each}}
        {{else}}
          <p class="empty-message">No powers yet. Click "Add Mastery Power" or "Add Spell" to start.</p>
        {{/if}}
      </div>
      {{/if}}
      
    </div>
    
    <!-- EQUIPMENT TAB -->
    <div class="tab equipment" data-group="primary" data-tab="equipment">
      
      <div class="equipment-overview">
        <h3 style="width: 225px !important;"><i class="fas fa-shield-alt"></i> Equipment</h3>
        <div class="equipment-controls" style="width: 100%; height: 6px;">
          <button type="button" class="general-items-btn" title="Open General Items Storage">
            <i class="fas fa-box"></i> General Items
          </button>
          {{#if (userIsGM)}}
          <button type="button" class="store-btn" title="Open Store (GM Only)">
            <i class="fas fa-store"></i> Store
          </button>
          {{/if}}
        </div>
      </div>
      
      {{#if equipmentUi}}
      <div class="df-equipment-layout">
        <div class="df-equipment-top">
        <div class="df-enc-table">
          <div class="df-enc-header">
            <div class="df-enc-title">EQUIPMENT</div>
            <div class="df-enc-coltitle">INVENTORY GRID</div>
          </div>
          
          <div class="df-enc-grids">
            <div class="df-enc-band df-dropzone df-enc-band--single" data-df-drop="band" data-band="not">
              {{#each equipmentUi.inventory.notCells}}
                <div class="df-cell {{#if this.occupied}}df-cell--occupied{{/if}} {{#if this.item}}df-cell--item{{/if}}" data-col="{{this.col}}" data-row="{{this.row}}" style="grid-column: {{this.col}} / span {{default this.spanW 1}}; grid-row: {{this.row}} / span {{default this.spanH 1}};">
                  {{#if this.item}}
                    <div class="df-item-tile item df-draggable-item" data-item-id="{{this.item.id}}" data-inventory-size="{{this.item.system.inventorySize}}" draggable="true" title="{{this.item.name}}">
                      <img class="df-item-icon" src="{{this.item.img}}" />
                      {{#if (eq this.item.type "gear")}}
                        <div class="df-item-qty">{{default this.item.system.quantity 1}}</div>
                      {{/if}}
                      <div class="df-item-actions">
                        <a class="item-edit" title="Edit"><i class="fas fa-edit"></i></a>
                        <a class="item-delete" title="Delete"><i class="fas fa-trash"></i></a>
                      </div>
                    </div>
                  {{/if}}
                </div>
              {{/each}}
              {{#if equipmentUi.inventory.notOverflow}}
                <div class="df-overflow">+{{equipmentUi.inventory.notOverflow}}</div>
              {{/if}}
            </div>
          </div>
        </div>
        </div>

        <div class="df-equipment-bottom">
        <aside class="df-equipment-side">
          <div class="df-side-header">
            <button type="button" class="df-stash-toggle" title="Stash / Händler"><i class="fas fa-store"></i></button>
          </div>
          
          <div class="df-equipped-panel">
            <h4>Equipped</h4>
            <div class="df-equipped-grid">
              {{#each equipmentUi.equipSlots}}
                <div class="df-equip-slot df-dropzone slot-{{this.key}}" data-df-drop="equip-slot" data-slot="{{this.key}}">
                  <div class="df-slot-label">{{this.label}}</div>
                  {{#if this.item}}
                    <div class="df-item-tile item df-draggable-item" data-item-id="{{this.item.id}}" data-inventory-size="{{this.item.system.inventorySize}}" draggable="true" title="{{this.item.name}}">
                      <img class="df-item-icon" src="{{this.item.img}}" />
                      <div class="df-item-actions">
                        <a class="item-edit" title="Edit"><i class="fas fa-edit"></i></a>
                        <a class="item-delete" title="Delete"><i class="fas fa-trash"></i></a>
                      </div>
                    </div>
                  {{else}}
                    <div class="df-slot-empty">Drop</div>
                  {{/if}}
                </div>
              {{/each}}
            </div>
          </div>
          
          <div class="df-stash-panel {{#unless equipmentUi.showStash}}collapsed{{/unless}}">
            <h4>Stash</h4>
            <div class="df-stash-grid df-dropzone" data-df-drop="stash">
              {{#each equipmentUi.stash.cells}}
                <div class="df-cell {{#if this.occupied}}df-cell--occupied{{/if}} {{#if this.item}}df-cell--item{{/if}}" data-col="{{this.col}}" data-row="{{this.row}}" style="grid-column: {{this.col}} / span {{default this.spanW 1}}; grid-row: {{this.row}} / span {{default this.spanH 1}};">
                  {{#if this.item}}
                    <div class="df-item-tile item df-draggable-item" data-item-id="{{this.item.id}}" data-inventory-size="{{this.item.system.inventorySize}}" draggable="true" title="{{this.item.name}}">
                      <img class="df-item-icon" src="{{this.item.img}}" />
                      <div class="df-item-actions">
                        <a class="item-edit" title="Edit"><i class="fas fa-edit"></i></a>
                        <a class="item-delete" title="Delete"><i class="fas fa-trash"></i></a>
                      </div>
                    </div>
                  {{/if}}
                </div>
              {{/each}}
              {{#if equipmentUi.stash.overflow}}
                <div class="df-overflow">+{{equipmentUi.stash.overflow}}</div>
              {{/if}}
            </div>
          </div>
        </aside>
        </div>
      </div>
      {{/if}}
      
    </div>
    
    <!-- DISADVANTAGES TAB -->
    <div class="tab disadvantages" data-group="primary" data-tab="disadvantages">
      <div class="disadvantages-overview">
        <h3><i class="fas fa-exclamation-triangle"></i> Disadvantages</h3>
        <div class="disadvantages-summary">
          <div class="summary-item">
            <label>Total Disadvantage Points:</label>
            <span class="summary-value">{{default disadvantagePointsTotal 0}} / 8</span>
          </div>
        </div>
      </div>
      
      {{#unless creationComplete}}
      <div class="disadvantages-creation-controls">
        <button type="button" class="add-disadvantage-btn" title="Add Disadvantage">
          <i class="fas fa-plus"></i> Add Disadvantage
        </button>
      </div>
      {{else}}
      {{#if (userIsGM)}}
      <div class="disadvantages-gm-controls disadvantages-creation-controls">
        <p class="hint gm-disadvantages-hint"><i class="fas fa-user-shield"></i> GM: Add, edit, or remove disadvantages (max 8 points total).</p>
        <button type="button" class="add-disadvantage-btn" title="Add Disadvantage (GM)">
          <i class="fas fa-plus"></i> Add Disadvantage
        </button>
      </div>
      {{/if}}
      {{/unless}}
      
      {{#if disadvantages.length}}
      <div class="disadvantages-list">
        {{#each disadvantages as |disadvantage index|}}
        <div class="disadvantage-card-sheet" data-index="{{index}}">
          <div class="disadvantage-header-sheet">
            <h4>{{disadvantage.name}}</h4>
            <div class="disadvantage-controls">
              <span class="disadvantage-points-sheet">{{disadvantage.points}} pts</span>
              {{#unless ../creationComplete}}
              <button type="button" class="disadvantage-edit-btn" data-index="{{index}}" title="Edit">
                <i class="fas fa-edit"></i>
              </button>
              <button type="button" class="disadvantage-remove-btn" data-index="{{index}}" title="Remove">
                <i class="fas fa-trash"></i>
              </button>
              {{else}}
              {{#if (userIsGM)}}
              <button type="button" class="disadvantage-edit-btn" data-index="{{index}}" title="Edit (GM)">
                <i class="fas fa-edit"></i>
              </button>
              <button type="button" class="disadvantage-remove-btn" data-index="{{index}}" title="Remove (GM)">
                <i class="fas fa-trash"></i>
              </button>
              {{/if}}
              {{/unless}}
            </div>
          </div>
          {{#if disadvantage.description}}
          <p class="disadvantage-description-sheet">{{disadvantage.description}}</p>
          {{/if}}
          {{#if disadvantage.details}}
          <div class="disadvantage-details-sheet">
            {{#each disadvantage.details as |value key|}}
            <div class="detail-item-sheet">
              <strong>{{capitalize key}}:</strong> {{value}}
            </div>
            {{/each}}
          </div>
          {{/if}}
        </div>
        {{/each}}
      </div>
      {{else}}
      <p class="empty-message">No disadvantages selected.</p>
      {{/if}}
      
      {{#unless creationComplete}}
      <div class="creation-note">
        <p><i class="fas fa-info-circle"></i> You can select up to 8 points of disadvantages. These will set your starting Faith Fractures.</p>
      </div>
      {{/unless}}
    </div>
    
    <!-- BIOGRAPHY TAB -->
    <div class="tab biography" data-group="primary" data-tab="biography">
      <div class="biography-content">
        <div class="form-group">
          <label>Blood Color (Blutfarbe):</label>
          <div class="blood-color-input-group">
            <input type="color" name="system.bloodColor" id="blood-color-picker" value="{{default system.bloodColor '#8b0000'}}" title="Choose the color for blood pools when this character takes damage"/>
            <input type="text" class="blood-color-text" id="blood-color-text" value="{{default system.bloodColor '#8b0000'}}" placeholder="#8b0000" pattern="^#[0-9A-Fa-f]{6}$" title="Hex color code (e.g., #8b0000 for dark red, #ff0000 for red, #0000ff for blue)"/>
          </div>
          <p class="hint"><i class="fas fa-info-circle"></i> This color will be used for blood pools when this character takes damage.</p>
        </div>
        
        <div class="form-group">
          <label>Echo:</label>
          {{editor system.bio.echo target="system.bio.echo" button=true owner=owner editable=editable}}
        </div>
        
        <div class="form-group">
          <label>Concept:</label>
          {{editor system.bio.concept target="system.bio.concept" button=true owner=owner editable=editable}}
        </div>
        
        <div class="form-group">
          <label>Appearance:</label>
          {{editor system.bio.appearance target="system.bio.appearance" button=true owner=owner editable=editable}}
        </div>
        
        <div class="form-group">
          <label>Notes:</label>
          {{editor system.bio.notes target="system.bio.notes" button=true owner=owner editable=editable}}
        </div>
      </div>
    </div>
    
  </section>
</form>
