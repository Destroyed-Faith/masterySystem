      <!-- Combat Stats Section -->
      <div class="combat-stats-section">
        <h3><i class="fas fa-shield-alt"></i> Combat Statistics</h3>
        
        <div class="combat-stats-grid">
          <!-- Evade -->
          <div class="combat-stat-card combat-stat-card--tooltip">
            <div class="combat-stat-tooltip" role="tooltip">
              <p class="stat-summary-hint">Only equipped armor &amp; shield count toward Shield / Armor lines.</p>
              {{#if system.combat.evadeBreakdownRows}}
              <ul class="combat-stat-breakdown">
                {{#each system.combat.evadeBreakdownRows}}
                <li>
                  <span class="bd-main"><span class="bd-label">{{this.label}}</span><span class="bd-val">{{this.display}}</span></span>
                  <span class="bd-detail">{{this.detail}}</span>
                </li>
                {{/each}}
              </ul>
              {{/if}}
              {{#if system.derived.mechanicsBreakdown.evade.length}}
              <p class="stat-summary-hint mechanics-summary-hint">From active passives &amp; buffs</p>
              <ul class="combat-stat-breakdown mechanics-breakdown-list">
                {{#each system.derived.mechanicsBreakdown.evade}}
                <li>
                  <span class="bd-main"><span class="bd-label">{{this.source}}</span><span class="bd-val">{{#if (gte this.value 0)}}+{{/if}}{{this.value}}</span></span>
                </li>
                {{/each}}
              </ul>
              {{/if}}
            </div>
            <div class="stat-icon evade-icon"><i class="fas fa-wind"></i></div>
            <div class="stat-content">
              <label>Evade (total) <i class="fas fa-info-circle combat-stat-hint-icon" aria-hidden="true"></i></label>
              <div class="stat-value">{{default system.combat.evadeTotal 8}}</div>
            </div>
          </div>
          
          <!-- Armor -->
          <div class="combat-stat-card combat-stat-card--tooltip">
            <div class="combat-stat-tooltip" role="tooltip">
              <p class="stat-summary-hint">MR + values on equipped chest armor + equipped shield.</p>
              {{#if system.combat.armorBreakdownRows}}
              <ul class="combat-stat-breakdown">
                {{#each system.combat.armorBreakdownRows}}
                <li>
                  <span class="bd-main"><span class="bd-label">{{this.label}}</span><span class="bd-val">{{this.display}}</span></span>
                  <span class="bd-detail">{{this.detail}}</span>
                </li>
                {{/each}}
              </ul>
              {{/if}}
              {{#if system.derived.mechanicsBreakdown.armor.length}}
              <p class="stat-summary-hint mechanics-summary-hint">From active passives &amp; buffs</p>
              <ul class="combat-stat-breakdown mechanics-breakdown-list">
                {{#each system.derived.mechanicsBreakdown.armor}}
                <li>
                  <span class="bd-main"><span class="bd-label">{{this.source}}</span><span class="bd-val">{{#if (gte this.value 0)}}+{{/if}}{{this.value}}</span></span>
                </li>
                {{/each}}
              </ul>
              {{/if}}
              {{#if system.derived.mechanicsBreakdown.regen.length}}
              <p class="stat-summary-hint mechanics-summary-hint">Regeneration</p>
              <ul class="combat-stat-breakdown mechanics-breakdown-list">
                {{#each system.derived.mechanicsBreakdown.regen}}
                <li>
                  <span class="bd-main"><span class="bd-label">{{this.source}}</span><span class="bd-val">Regen({{this.value}})</span></span>
                </li>
                {{/each}}
              </ul>
              {{/if}}
              {{#if system.derived.mechanicsBreakdown.healing.length}}
              <p class="stat-summary-hint mechanics-summary-hint">Healing (mechanics)</p>
              <ul class="combat-stat-breakdown mechanics-breakdown-list">
                {{#each system.derived.mechanicsBreakdown.healing}}
                <li>
                  <span class="bd-main"><span class="bd-label">{{this.source}}</span><span class="bd-val">{{this.value}}</span></span>
                </li>
                {{/each}}
              </ul>
              {{/if}}
              {{#if system.derived.mechanicsBreakdown.modifySpecialDeclared.length}}
              <p class="stat-summary-hint mechanics-summary-hint">Modify special (declared)</p>
              <ul class="combat-stat-breakdown mechanics-breakdown-list">
                {{#each system.derived.mechanicsBreakdown.modifySpecialDeclared}}
                <li>
                  <span class="bd-main"><span class="bd-label">{{this.source}}</span><span class="bd-detail">{{this.text}}</span></span>
                </li>
                {{/each}}
              </ul>
              {{/if}}
              {{#if system.derived.mechanicsBreakdown.grantNextHitDeclared.length}}
              <p class="stat-summary-hint mechanics-summary-hint">Next hit / spell (declared)</p>
              <ul class="combat-stat-breakdown mechanics-breakdown-list">
                {{#each system.derived.mechanicsBreakdown.grantNextHitDeclared}}
                <li>
                  <span class="bd-main"><span class="bd-label">{{this.source}}</span><span class="bd-detail">{{this.text}}</span></span>
                </li>
                {{/each}}
              </ul>
              {{/if}}
            </div>
            <div class="stat-icon armor-icon"><i class="fas fa-shield-alt"></i></div>
            <div class="stat-content">
              <label>Armor (total soak) <i class="fas fa-info-circle combat-stat-hint-icon" aria-hidden="true"></i></label>
              <div class="stat-value">{{default system.combat.armorTotal 0}}</div>
            </div>
          </div>
          
          <!-- Initiative -->
          <div class="combat-stat-card combat-stat-card--tooltip">
            <div class="combat-stat-tooltip" role="tooltip">
              <p class="stat-summary-hint">Roll: sum of exploding d8s + optional Combat Reflexes + equipment modifier below.</p>
              {{#if system.combat.initiativeEquipmentRows}}
              <ul class="combat-stat-breakdown">
                {{#each system.combat.initiativeEquipmentRows}}
                <li>
                  <span class="bd-main"><span class="bd-label">{{this.label}}</span><span class="bd-val">{{this.display}}</span></span>
                  <span class="bd-detail">{{this.detail}}</span>
                </li>
                {{/each}}
                <li class="combat-bd-total">
                  <span class="bd-main"><span class="bd-label">Equipment total</span><span class="bd-val">{{default system.combat.initiativeEquipmentTotalDisplay "0"}}</span></span>
                  <span class="bd-detail">Applied on initiative roll (before Initiative Shop)</span>
                </li>
              </ul>
              {{/if}}
              {{#if system.scaling}}
              {{#if (ne (default system.scaling.witsInitiativeBonus 0) 0)}}
              <p class="stat-footnote-wits">Wits scaling: +{{default system.scaling.witsInitiativeBonus 0}} (reference only — not added by the system roll yet)</p>
              {{/if}}
              {{/if}}
              {{#if system.derived.mechanicsBreakdown.initiativeD8.length}}
              <p class="stat-summary-hint mechanics-summary-hint">From active passives &amp; buffs</p>
              <ul class="combat-stat-breakdown mechanics-breakdown-list">
                {{#each system.derived.mechanicsBreakdown.initiativeD8}}
