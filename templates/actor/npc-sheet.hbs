<div class="{{cssClass}}">
  {{!-- Sheet Header --}}
  <header class="sheet-header">
    <div class="npc-name-row">
      <div class="character-name-box">
        {{#if editable}}
          <input name="name" type="text" value="{{actor.name}}" placeholder="{{#if isSummon}}Summon Name{{else}}NPC Name{{/if}}" />
        {{else}}
          <h1>{{actor.name}}</h1>
        {{/if}}
      </div>
    </div>
    <div class="npc-header-main">
    <div class="portrait-section">
      <div class="profile-img-wrapper">
        <div class="profile-img-container {{#unless editable}}locked{{/unless}}" data-image-type="portrait">
          <img class="profile-img {{#if editable}}{{else}}locked{{/if}}" src="{{actor.img}}" title="{{actor.name}} Portrait" alt="{{actor.name}} Portrait" />
          <div class="profile-overlay">
            <div class="profile-zone profile-zone-edit" data-action="edit" data-img-type="portrait">
              <span class="zone-label">EDIT</span>
            </div>
            <div class="profile-zone profile-zone-show" data-action="show" data-img-type="portrait">
              <span class="zone-label">SHOW</span>
            </div>
          </div>
        </div>
        <div class="profile-img-label">PORTRAIT</div>
      </div>
      <div class="profile-img-wrapper">
        <div class="profile-img-container profile-img-container-token {{#unless editable}}locked{{/unless}}" data-image-type="token">
          <img class="profile-img {{#if editable}}{{else}}locked{{/if}}" src="{{default actor.prototypeToken.texture.src actor.img}}" title="{{actor.name}} Token" alt="{{actor.name}} Token" />
          <div class="profile-overlay">
            <div class="profile-zone profile-zone-edit" data-action="edit" data-img-type="token">
              <span class="zone-label">EDIT</span>
            </div>
            <div class="profile-zone profile-zone-show" data-action="show" data-img-type="token">
              <span class="zone-label">SHOW</span>
            </div>
          </div>
        </div>
        <div class="profile-img-label">TOKEN</div>
      </div>
    </div>
    
    <div class="header-info">
      {{#if isSummon}}
      <div class="npc-sheet-kind" title="Summon">Summon</div>
      {{/if}}
      <div class="mastery-rank-box" title="Mastery Rank">
        <label>MR</label>
        <select name="system.mastery.rank" class="mastery-rank-select" data-dtype="Number">
          <option value="1" {{#if (eq system.mastery.rank 1)}}selected{{/if}}>1</option>
          <option value="2" {{#if (eq system.mastery.rank 2)}}selected{{/if}}>2</option>
          <option value="3" {{#if (eq system.mastery.rank 3)}}selected{{/if}}>3</option>
          <option value="4" {{#if (eq system.mastery.rank 4)}}selected{{/if}}>4</option>
          <option value="5" {{#if (eq system.mastery.rank 5)}}selected{{/if}}>5</option>
          <option value="6" {{#if (eq system.mastery.rank 6)}}selected{{/if}}>6</option>
          <option value="7" {{#if (eq system.mastery.rank 7)}}selected{{/if}}>7</option>
          <option value="8" {{#if (eq system.mastery.rank 8)}}selected{{/if}}>8</option>
        </select>
      </div>
      <div class="npc-creature-type-box" title="Creature type (Requiem vs Deathless / Exorcism vs Fiend)">
        <label>Type</label>
        <select name="system.creatureType" class="npc-creature-type-select">
          {{#each creatureTypeOptions}}
          <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
      </div>
      {{#if isSummon}}
      <div class="npc-disposition-box" title="Summons are always Friendly">
        <label>Side</label>
        <span class="npc-disposition-locked">Friendly</span>
        <input type="hidden" name="prototypeToken.disposition" value="1" data-dtype="Number" />
      </div>
      {{else}}
      <div class="npc-disposition-box" title="Token side: Friendly / Neutral / Hostile — controls Threatened Ranged, targeting, and aura color">
        <label>Side</label>
        <select name="prototypeToken.disposition" class="npc-disposition-select" data-dtype="Number">
          {{#each npcDispositionOptions as |opt|}}
          <option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>
          {{/each}}
        </select>
      </div>
      {{/if}}
      {{#if canReleaseKnownNpc}}
      <div class="npc-known-release-box" title="{{localize "MASTERY.knownNpcs.sheetHint"}}">
        <label>{{localize "MASTERY.knownNpcs.sheetLabel"}}</label>
        <button type="button" class="npc-known-release-btn {{#if knownNpcReleased}}is-on{{/if}}" data-action="toggle-known-npc">
          {{#if knownNpcReleased}}{{localize "MASTERY.knownNpcs.hide"}}{{else}}{{localize "MASTERY.knownNpcs.release"}}{{/if}}
        </button>
      </div>
      {{/if}}
    </div>
    </div>
  </header>

  {{!-- Phase Tabs Navigation (if phases exist). Summons never have phases. --}}
  {{#unless isSummon}}
  {{#if system.phases}}
  <nav class="sheet-tabs tabs" data-group="primary">
    {{#each system.phases as |phase index|}}
    <a class="item" data-tab="phase-{{index}}">{{phase.name}}</a>
    {{/each}}
    <button type="button" class="phase-add-btn" title="Boss mit Phasen">
      <i class="fas fa-layer-group"></i> Phase
    </button>
  </nav>
  {{else}}
  <div class="phase-controls">
    <button type="button" class="phase-add-btn" title="NSC in Boss mit Phasen umwandeln">
      <i class="fas fa-layer-group"></i> Boss-Phasen
    </button>
  </div>
  {{/if}}
  {{/unless}}

  {{#if system.phases}}
  {{#unless isSummon}}
  <div class="npc-phase-toolbar npc-section">
    <div class="npc-phase-toolbar__field">
      <label>Active Phase (Radial / Attacks)</label>
      <select name="system.npcActivePhaseIndex" data-dtype="Number">
        {{#each system.phases as |ph idx|}}
        <option value="{{idx}}" {{#if (eq ../system.npcActivePhaseIndex idx)}}selected{{/if}}>{{ph.name}}</option>
        {{/each}}
      </select>
    </div>
    <div class="npc-phase-toolbar__field">
      <label>Attacks / Round</label>
      <input type="number" name="system.attackSlots" value="{{default system.attackSlots 1}}" min="1" max="20" step="1" data-dtype="Number" readonly title="Sum of Attacks/Round copies (active phase) — shown as ATK in combat"/>
    </div>
    <div class="npc-phase-toolbar__field">
      <label>Move Actions / Round</label>
      <input type="number" name="system.npcMovementSlots" value="{{default system.npcMovementSlots 1}}" min="1" max="10" step="1" data-dtype="Number" title="Movement actions per round"/>
    </div>
  </div>
  {{/unless}}
  {{/if}}

  {{!-- Sheet Body --}}
  <section class="sheet-body">
    {{#if system.phases}}
      {{!-- Phase Tabs Content --}}
      {{#each system.phases as |phase phaseIndex|}}
      <div class="tab phase-content" data-group="primary" data-tab="phase-{{phaseIndex}}">
        
        {{!-- Phase Header --}}
        <div class="phase-header">
          <input type="text" name="system.phases.{{phaseIndex}}.name" value="{{phase.name}}" placeholder="Phase Name" class="phase-name-input"/>
          <button type="button" class="phase-delete-btn" data-phase-index="{{phaseIndex}}" title="Delete Phase">
            <i class="fas fa-trash"></i> Delete Phase
          </button>
        </div>
        
        <section class="npc-section npc-section--combat">
          <h3 class="npc-section__title"><i class="fas fa-shield-alt"></i> Combat</h3>
          <div class="npc-combat-strip">
            <div class="npc-combat-chip">
              <span class="npc-combat-chip__label">Evade</span>
              <input type="number" name="system.phases.{{phaseIndex}}.combat.evade" value="{{default phase.combat.evade 10}}" data-dtype="Number" title="Evade"/>
            </div>
            <div class="npc-combat-chip">
              <span class="npc-combat-chip__label">Armor</span>
              <input type="number" name="system.phases.{{phaseIndex}}.combat.armor" value="{{default phase.combat.armor 0}}" data-dtype="Number" title="Armor"/>
            </div>
            {{> "systems/mastery-system/templates/actor/partials/npc-combat-ini.hbs"
              fieldPath=(concat "system.phases." phaseIndex ".combat.initiative")
              iniMalus=phase.combat.initiativeMalus
              iniBonus=phase.combat.initiativeBonus
              iniNet=phase.combat.initiative
              masteryRank=@root.npcMasteryRank}}
            <div class="npc-combat-chip">
              <span class="npc-combat-chip__label">Speed (m)</span>
              <input type="number" name="system.phases.{{phaseIndex}}.combat.speed" value="{{default phase.combat.speed 6}}" min="0" max="48" step="1" data-dtype="Number" title="Base movement in meters per Move"/>
            </div>
            <div class="npc-combat-chip">
              <span class="npc-combat-chip__label">Spell Res.</span>
              <input type="number" name="system.phases.{{phaseIndex}}.combat.spellResistance" value="{{default phase.combat.spellResistance 0}}" min="0" max="99" step="1" data-dtype="Number" title="Spell Resistance — raises the Casting TN of spells against this NPC"/>
            </div>
            <div class="npc-combat-chip">
              <span class="npc-combat-chip__label">DR %</span>
              <input type="number" name="system.phases.{{phaseIndex}}.combat.damageReduction" value="{{default phase.combat.damageReduction 0}}" min="0" max="100" step="5" data-dtype="Number" title="Damage Reduction percent — applied after Armor"/>
            </div>
          </div>
        </section>

        {{!-- Health --}}
        <div class="health-panel npc-section">
          <h3 class="npc-section__title"><i class="fas fa-heart"></i> HP</h3>
          <div class="health-display">
            {{#each phase.health.bars as |bar index|}}
            <div class="health-bar npc-hp-row {{#if (eq phase.health.currentBar index)}}active{{/if}}">
              {{!-- Use block-param phaseIndex (not ../phaseIndex): nested #each breaks ../ lookup and orphaned HP on submit. --}}
              <label class="npc-hp-field" title="Current HP on this bar">
                <span>Current</span>
                <input type="number" name="system.phases.{{phaseIndex}}.health.bars.{{index}}.current" value="{{bar.current}}" data-dtype="Number"/>
              </label>
              <span class="npc-hp-sep">/</span>
              <label class="npc-hp-field" title="Maximum HP on this bar">
                <span>Max</span>
                <input type="number" name="system.phases.{{phaseIndex}}.health.bars.{{index}}.max" value="{{bar.max}}" data-dtype="Number"/>
              </label>
              <input type="hidden" name="system.phases.{{phaseIndex}}.health.bars.{{index}}.penalty" value="{{default bar.penalty 0}}" data-dtype="Number"/>
            </div>
            {{/each}}
          </div>
        </div>

        {{!-- Status Effects (root system.statusEffects — shared across phases).
             Must use @root: inside #each phases, unbound lookups resolve on the
             phase object (same class of bug as nested ../phaseIndex for HP). --}}
        <div class="status-effects-panel npc-section">
          <h3 class="npc-section__title"><i class="fas fa-bolt"></i> Status</h3>
          <div class="status-effects-list">
            {{#if @root.hasNpcStatusEffects}}
              {{#each @root.npcStatusEffects as |effect|}}
              <div class="status-effect-item" data-effect-index="{{effect.index}}">
                <span class="effect-name">
                  <i class="fas fa-exclamation-triangle"></i>
                  {{effect.name}}
                  {{#if effect.hasValue}}
                    <span class="effect-value">({{effect.value}})</span>
                  {{/if}}
                </span>
                <div class="effect-actions">
                  <button type="button" class="effect-reduce" data-effect-index="{{effect.index}}" data-steps="1" title="−1 Stufe">−1</button>
                  <button type="button" class="effect-reduce" data-effect-index="{{effect.index}}" data-steps="2" title="−2 Stufen">−2</button>
                  <button type="button" class="effect-reduce" data-effect-index="{{effect.index}}" data-steps="3" title="−3 Stufen">−3</button>
                  <button type="button" class="effect-reduce" data-effect-index="{{effect.index}}" data-steps="4" title="−4 Stufen">−4</button>
                  <button type="button" class="effect-remove" data-effect-index="{{effect.index}}" title="Status entfernen">
                    <i class="fas fa-times"></i>
                  </button>
                </div>
              </div>
              {{/each}}
            {{else}}
              <div class="no-status-effects">No active effects</div>
            {{/if}}
          </div>
        </div>

        {{!-- Basis: Waffenangriff (Phase) --}}
        <div class="attack-values-panel npc-section">
          <h3 class="npc-section__title"><i class="fas fa-sword"></i> Base: Weapon Attack</h3>
          <p class="hint">Always in the radial menu; rows below are extras. First line: attack <strong>d8</strong> pool, second: damage <strong>d8</strong> pool.</p>
          <div class="npc-attack-card npc-attack-card--base">
            <div class="npc-attack-card__grid npc-attack-card__grid--simple">
              <div class="npc-attack-field">
                <label>Name</label>
                <input type="text" name="system.phases.{{phaseIndex}}.npcBaseAttack.name" value="{{default phase.npcBaseAttack.name 'Waffenangriff'}}" placeholder="Waffenangriff"/>
              </div>
              <div class="npc-attack-field">
                <label>Attack (Pool)</label>
                <div class="npc-dice-input">
                  <input type="number" name="system.phases.{{phaseIndex}}.npcBaseAttack.attackDiceCount" value="{{default phase.npcBaseAttack.attackDiceCount 6}}" min="1" max="80" step="1" data-dtype="Number" title="Attack pool (1–80 d8)"/>
                  <span class="npc-dice-suffix">d8</span>
                </div>
              </div>
              <div class="npc-attack-field">
                <label>Keep</label>
                <div class="npc-dice-input">
                  <input type="number" name="system.phases.{{phaseIndex}}.npcBaseAttack.keepDice" value="{{phase.npcBaseAttack.keepDice}}" min="1" max="10" step="1" data-dtype="Number" placeholder="MR" title="Keep value (statblock, e.g. 6d8 Keep 1). Empty = Mastery Rank."/>
                </div>
              </div>
              <div class="npc-attack-field">
                <label>Damage</label>
                <div class="npc-dice-input">
                  <input type="number" name="system.phases.{{phaseIndex}}.npcBaseAttack.damageDiceCount" value="{{default phase.npcBaseAttack.damageDiceCount 4}}" min="1" max="80" step="1" data-dtype="Number" title="Damage (1–80 d8)"/>
                  <span class="npc-dice-suffix">d8</span>
                </div>
              </div>
            </div>
            {{> "systems/mastery-system/templates/actor/partials/npc-attack-targeting.hbs" path=(concat "system.phases." phaseIndex ".npcBaseAttack") atk=phase.npcBaseAttack}}
            <div class="npc-attack-specials-block">
              <div class="npc-attack-specials-header">
                <span>Specials</span>
                <button type="button" class="npc-power-special-add" data-scope="phase-base" data-phase-index="{{phaseIndex}}" title="Spezial hinzufügen"><i class="fas fa-plus"></i></button>
              </div>
              {{#each phase.npcBaseAttack.specials as |sp si|}}
              <div class="npc-attack-special-row">
                <select name="system.phases.{{../phaseIndex}}.npcBaseAttack.specials.{{si}}.special" class="special-select">
                  <option value="">—</option>
                  {{#each @root.npcSpecialSelectGroups as |grp|}}
                  <optgroup label="{{grp.label}}">
                    {{#each grp.options as |opt|}}
                    <option value="{{opt.value}}" {{#if (eq sp.special opt.value)}}selected{{/if}}>{{opt.label}}</option>
                    {{/each}}
                  </optgroup>
                  {{/each}}
                </select>
                <select name="system.phases.{{../phaseIndex}}.npcBaseAttack.specials.{{si}}.specialValue" data-dtype="Number">
                  <option value="">—</option>
                  {{#each (range 1 10)}}
                  <option value="{{this}}" {{#if (eqNum sp.specialValue this)}}selected{{/if}}>{{this}}</option>
                  {{/each}}
                </select>
                <button type="button" class="npc-power-special-del" data-scope="phase-base" data-phase-index="{{../phaseIndex}}" data-special-index="{{si}}" title="Entfernen"><i class="fas fa-trash"></i></button>
              </div>
              {{/each}}
            </div>
          </div>
        </div>

        {{!-- Extra-Powers (Phase) --}}
        <div class="attack-values-panel npc-section">
          <div class="attack-values-header">
            <h3 class="npc-section__title"><i class="fas fa-khanda"></i> Weitere Powers (Extras)</h3>
            <button type="button" class="attack-value-add" data-phase-index="{{phaseIndex}}"><i class="fas fa-plus"></i> Power</button>
          </div>
          <div class="attack-values-list">
            {{#if phase.attackValues}}
              {{#each phase.attackValues as |attack index|}}
              <div class="npc-attack-card attack-value-item" data-attack-index="{{index}}" data-phase-index="{{../phaseIndex}}">
                <div class="npc-attack-card__head">
                  <input type="text" class="npc-attack-name" name="system.phases.{{../phaseIndex}}.attackValues.{{index}}.name" value="{{attack.name}}" placeholder="Power-Name"/>
                  <button type="button" class="attack-value-delete npc-attack-delete" data-attack-index="{{index}}" data-phase-index="{{../phaseIndex}}" title="Entfernen">
                    <i class="fas fa-trash"></i>
                  </button>
                </div>
                <div class="npc-attack-card__grid npc-attack-card__grid--simple">
                  <div class="npc-attack-field">
                    <label>Attack (Pool)</label>
                    <div class="npc-dice-input">
                      <input type="number" name="system.phases.{{../phaseIndex}}.attackValues.{{index}}.attackDiceCount" value="{{default attack.attackDiceCount 6}}" min="1" max="80" step="1" data-dtype="Number" title="Attack pool (1–80 d8)"/>
                      <span class="npc-dice-suffix">d8</span>
                    </div>
                  </div>
                  <div class="npc-attack-field">
                    <label>Keep</label>
                    <div class="npc-dice-input">
                      <input type="number" name="system.phases.{{../phaseIndex}}.attackValues.{{index}}.keepDice" value="{{attack.keepDice}}" min="1" max="10" step="1" data-dtype="Number" placeholder="MR" title="Keep value (statblock, e.g. 6d8 Keep 1). Empty = Mastery Rank."/>
                    </div>
                  </div>
                  <div class="npc-attack-field">
                    <label>Damage</label>
                    <div class="npc-dice-input">
                      <input type="number" name="system.phases.{{../phaseIndex}}.attackValues.{{index}}.damageDiceCount" value="{{default attack.damageDiceCount 4}}" min="1" max="80" step="1" data-dtype="Number" title="Damage (1–80 d8)"/>
                      <span class="npc-dice-suffix">d8</span>
                    </div>
                  </div>
                </div>
                {{> "systems/mastery-system/templates/actor/partials/npc-attack-targeting.hbs" path=(concat "system.phases." ../phaseIndex ".attackValues." index) atk=attack}}
                <div class="npc-attack-specials-block">
                  <div class="npc-attack-specials-header">
                    <span>Specials</span>
                    <button type="button" class="npc-power-special-add" data-scope="extra" data-phase-index="{{../phaseIndex}}" data-attack-index="{{index}}"><i class="fas fa-plus"></i></button>
                  </div>
                  {{#each attack.specials as |sp si|}}
                  <div class="npc-attack-special-row">
                    <select name="system.phases.{{../../phaseIndex}}.attackValues.{{../index}}.specials.{{si}}.special" class="special-select">
                      <option value="">—</option>
                      {{#each @root.npcSpecialSelectGroups as |grp|}}
                  <optgroup label="{{grp.label}}">
                    {{#each grp.options as |opt|}}
                    <option value="{{opt.value}}" {{#if (eq sp.special opt.value)}}selected{{/if}}>{{opt.label}}</option>
                    {{/each}}
                  </optgroup>
                  {{/each}}
                    </select>
                    <select name="system.phases.{{../../phaseIndex}}.attackValues.{{../index}}.specials.{{si}}.specialValue" data-dtype="Number">
                      <option value="">—</option>
                      {{#each (range 1 10)}}
                      <option value="{{this}}" {{#if (eqNum sp.specialValue this)}}selected{{/if}}>{{this}}</option>
                      {{/each}}
                    </select>
                    <button type="button" class="npc-power-special-del" data-scope="extra" data-phase-index="{{../../phaseIndex}}" data-attack-index="{{../index}}" data-special-index="{{si}}"><i class="fas fa-trash"></i></button>
                  </div>
                  {{/each}}
                </div>
              </div>
              {{/each}}
            {{else}}
              <div class="no-attack-values">No extra powers yet.</div>
            {{/if}}
          </div>
        </div>

        {{> "systems/mastery-system/templates/actor/partials/npc-reactions.hbs"
          path=(concat "system.phases." phaseIndex)
          slots=phase.npcReactionSlots
          rows=phase.npcReactions
          phaseIndex=phaseIndex}}
      </div>
      {{/each}}
    {{else}}
      {{!-- Normal NPC View (no phases) --}}
      <section class="npc-section npc-section--combat">
        <h3 class="npc-section__title"><i class="fas fa-shield-alt"></i> Combat</h3>
        <div class="npc-combat-strip">
          <div class="npc-combat-chip">
            <span class="npc-combat-chip__label">Evade</span>
            <input type="number" name="system.combat.evade" value="{{system.combat.evade}}" data-dtype="Number"/>
          </div>
          <div class="npc-combat-chip">
            <span class="npc-combat-chip__label">Armor</span>
            <input type="number" name="system.combat.armor" value="{{system.combat.armor}}" data-dtype="Number"/>
          </div>
          {{> "systems/mastery-system/templates/actor/partials/npc-combat-ini.hbs"
            fieldPath="system.combat.initiative"
            iniMalus=system.combat.initiativeMalus
            iniBonus=system.combat.initiativeBonus
            iniNet=system.combat.initiative
            masteryRank=npcMasteryRank}}
          <div class="npc-combat-chip">
            <span class="npc-combat-chip__label">Speed (m)</span>
            <input type="number" name="system.combat.speed" value="{{system.combat.speed}}" min="0" max="48" step="1" data-dtype="Number" title="Base movement in meters per Move"/>
          </div>
          <div class="npc-combat-chip">
            <span class="npc-combat-chip__label">Spell Res.</span>
            <input type="number" name="system.combat.spellResistance" value="{{default system.combat.spellResistance 0}}" min="0" max="99" step="1" data-dtype="Number" title="Spell Resistance — raises the Casting TN of spells against this NPC"/>
          </div>
          <div class="npc-combat-chip">
            <span class="npc-combat-chip__label">DR %</span>
            <input type="number" name="system.combat.damageReduction" value="{{default system.combat.damageReduction 0}}" min="0" max="100" step="5" data-dtype="Number" title="Damage Reduction percent — applied after Armor"/>
          </div>
          <div class="npc-combat-chip">
            <span class="npc-combat-chip__label">Attacks / Round</span>
            <input type="number" name="system.attackSlots" value="{{default system.attackSlots 1}}" min="1" max="20" step="1" data-dtype="Number" readonly title="Sum of Attacks/Round copies — shown as ATK in combat"/>
          </div>
          <div class="npc-combat-chip">
            <span class="npc-combat-chip__label">Move Actions / Round</span>
            <input type="number" name="system.npcMovementSlots" value="{{default system.npcMovementSlots 1}}" min="1" max="10" step="1" data-dtype="Number" title="Movement actions per round"/>
          </div>
        </div>
      </section>

      {{!-- Health --}}
      <div class="health-panel npc-section">
        <h3 class="npc-section__title"><i class="fas fa-heart"></i> HP</h3>
        <div class="health-display">
          {{#each system.health.bars as |bar index|}}
          <div class="health-bar npc-hp-row {{#if (eq ../system.health.currentBar index)}}active{{/if}}">
              <label class="npc-hp-field" title="Current HP on this bar">
              <span>Current</span>
              <input type="number" name="system.health.bars.{{index}}.current" value="{{bar.current}}" data-dtype="Number"/>
            </label>
            <span class="npc-hp-sep">/</span>
            <label class="npc-hp-field" title="Maximum HP on this bar">
              <span>Max</span>
              <input type="number" name="system.health.bars.{{index}}.max" value="{{bar.max}}" data-dtype="Number"/>
            </label>
            <input type="hidden" name="system.health.bars.{{index}}.penalty" value="{{default bar.penalty 0}}" data-dtype="Number"/>
          </div>
          {{/each}}
        </div>
      </div>

      {{!-- Status Effects (root system.statusEffects) --}}
      <div class="status-effects-panel npc-section">
        <h3 class="npc-section__title"><i class="fas fa-bolt"></i> Status</h3>
        <div class="status-effects-list">
          {{#if @root.hasNpcStatusEffects}}
            {{#each @root.npcStatusEffects as |effect|}}
            <div class="status-effect-item" data-effect-index="{{effect.index}}">
              <span class="effect-name">
                <i class="fas fa-exclamation-triangle"></i>
                {{effect.name}}
                {{#if effect.hasValue}}
                  <span class="effect-value">({{effect.value}})</span>
                {{/if}}
              </span>
              <div class="effect-actions">
                <button type="button" class="effect-reduce" data-effect-index="{{effect.index}}" data-steps="1" title="−1 Stufe">−1</button>
                <button type="button" class="effect-reduce" data-effect-index="{{effect.index}}" data-steps="2" title="−2 Stufen">−2</button>
                <button type="button" class="effect-reduce" data-effect-index="{{effect.index}}" data-steps="3" title="−3 Stufen">−3</button>
                <button type="button" class="effect-reduce" data-effect-index="{{effect.index}}" data-steps="4" title="−4 Stufen">−4</button>
                <button type="button" class="effect-remove" data-effect-index="{{effect.index}}" title="Status entfernen">
                  <i class="fas fa-times"></i>
                </button>
              </div>
            </div>
            {{/each}}
          {{else}}
            <div class="no-status-effects">No active effects</div>
          {{/if}}
        </div>
      </div>

      {{!-- Basis: Waffenangriff --}}
      <div class="attack-values-panel npc-section">
        <h3 class="npc-section__title"><i class="fas fa-sword"></i> Base: Weapon Attack</h3>
        <p class="hint">Standard attack, always in the radial menu. Below: extra powers. First line: attack <strong>d8</strong> pool, second: damage <strong>d8</strong> pool.</p>
        <div class="npc-attack-card npc-attack-card--base">
          <div class="npc-attack-card__grid npc-attack-card__grid--simple">
            <div class="npc-attack-field">
              <label>Name</label>
              <input type="text" name="system.npcBaseAttack.name" value="{{default system.npcBaseAttack.name 'Waffenangriff'}}" placeholder="Waffenangriff"/>
            </div>
            <div class="npc-attack-field">
              <label>Attack (Pool)</label>
              <div class="npc-dice-input">
                <input type="number" name="system.npcBaseAttack.attackDiceCount" value="{{default system.npcBaseAttack.attackDiceCount 6}}" min="1" max="80" step="1" data-dtype="Number" title="Attack pool (1–80 d8)"/>
                <span class="npc-dice-suffix">d8</span>
              </div>
            </div>
            <div class="npc-attack-field">
              <label>Keep</label>
              <div class="npc-dice-input">
                <input type="number" name="system.npcBaseAttack.keepDice" value="{{system.npcBaseAttack.keepDice}}" min="1" max="10" step="1" data-dtype="Number" placeholder="MR" title="Keep value (statblock, e.g. 6d8 Keep 1). Empty = Mastery Rank."/>
              </div>
            </div>
            <div class="npc-attack-field">
              <label>Damage</label>
              <div class="npc-dice-input">
                <input type="number" name="system.npcBaseAttack.damageDiceCount" value="{{default system.npcBaseAttack.damageDiceCount 4}}" min="1" max="80" step="1" data-dtype="Number" title="Damage (1–80 d8)"/>
                <span class="npc-dice-suffix">d8</span>
              </div>
            </div>
          </div>
          {{> "systems/mastery-system/templates/actor/partials/npc-attack-targeting.hbs" path="system.npcBaseAttack" atk=system.npcBaseAttack}}
          <div class="npc-attack-specials-block">
            <div class="npc-attack-specials-header">
              <span>Specials</span>
              <button type="button" class="npc-power-special-add" data-scope="base" title="Spezial hinzufügen"><i class="fas fa-plus"></i></button>
            </div>
            {{#each system.npcBaseAttack.specials as |sp si|}}
            <div class="npc-attack-special-row">
              <select name="system.npcBaseAttack.specials.{{si}}.special" class="special-select">
                <option value="">—</option>
                {{#each @root.npcSpecialSelectGroups as |grp|}}
                  <optgroup label="{{grp.label}}">
                    {{#each grp.options as |opt|}}
                    <option value="{{opt.value}}" {{#if (eq sp.special opt.value)}}selected{{/if}}>{{opt.label}}</option>
                    {{/each}}
                  </optgroup>
                  {{/each}}
              </select>
              <select name="system.npcBaseAttack.specials.{{si}}.specialValue" data-dtype="Number">
                <option value="">—</option>
                {{#each (range 1 10)}}
                <option value="{{this}}" {{#if (eqNum sp.specialValue this)}}selected{{/if}}>{{this}}</option>
                {{/each}}
              </select>
              <button type="button" class="npc-power-special-del" data-scope="base" data-special-index="{{si}}"><i class="fas fa-trash"></i></button>
            </div>
            {{/each}}
          </div>
        </div>
      </div>

      {{!-- Extra-Powers (NPC only — Summons inherit Bond values, no extras) --}}
      {{#unless isSummon}}
      <div class="attack-values-panel npc-section">
        <div class="attack-values-header">
          <h3 class="npc-section__title"><i class="fas fa-khanda"></i> Weitere Powers (Extras)</h3>
          <button type="button" class="attack-value-add"><i class="fas fa-plus"></i> Power</button>
        </div>
        <div class="attack-values-list">
          {{#if system.attackValues}}
            {{#each system.attackValues as |attack index|}}
            <div class="npc-attack-card attack-value-item" data-attack-index="{{index}}">
              <div class="npc-attack-card__head">
                <input type="text" class="npc-attack-name" name="system.attackValues.{{index}}.name" value="{{attack.name}}" placeholder="Power-Name"/>
                <button type="button" class="attack-value-delete npc-attack-delete" data-attack-index="{{index}}" title="Entfernen">
                  <i class="fas fa-trash"></i>
                </button>
              </div>
              <div class="npc-attack-card__grid npc-attack-card__grid--simple">
                <div class="npc-attack-field">
                  <label>Attack (Pool)</label>
                  <div class="npc-dice-input">
                    <input type="number" name="system.attackValues.{{index}}.attackDiceCount" value="{{default attack.attackDiceCount 6}}" min="1" max="80" step="1" data-dtype="Number" title="Attack pool (1–80 d8)"/>
                    <span class="npc-dice-suffix">d8</span>
                  </div>
                </div>
                <div class="npc-attack-field">
                  <label>Keep</label>
                  <div class="npc-dice-input">
                    <input type="number" name="system.attackValues.{{index}}.keepDice" value="{{attack.keepDice}}" min="1" max="10" step="1" data-dtype="Number" placeholder="MR" title="Keep value (statblock, e.g. 6d8 Keep 1). Empty = Mastery Rank."/>
                  </div>
                </div>
                <div class="npc-attack-field">
                  <label>Damage</label>
                  <div class="npc-dice-input">
                    <input type="number" name="system.attackValues.{{index}}.damageDiceCount" value="{{default attack.damageDiceCount 4}}" min="1" max="80" step="1" data-dtype="Number" title="Damage (1–80 d8)"/>
                    <span class="npc-dice-suffix">d8</span>
                  </div>
                </div>
              </div>
              {{> "systems/mastery-system/templates/actor/partials/npc-attack-targeting.hbs" path=(concat "system.attackValues." index) atk=attack}}
              <div class="npc-attack-specials-block">
                <div class="npc-attack-specials-header">
                  <span>Specials</span>
                  <button type="button" class="npc-power-special-add" data-scope="extra" data-attack-index="{{index}}"><i class="fas fa-plus"></i></button>
                </div>
                {{#each attack.specials as |sp si|}}
                <div class="npc-attack-special-row">
                  <select name="system.attackValues.{{../index}}.specials.{{si}}.special" class="special-select">
                    <option value="">—</option>
                    {{#each @root.npcSpecialSelectGroups as |grp|}}
                  <optgroup label="{{grp.label}}">
                    {{#each grp.options as |opt|}}
                    <option value="{{opt.value}}" {{#if (eq sp.special opt.value)}}selected{{/if}}>{{opt.label}}</option>
                    {{/each}}
                  </optgroup>
                  {{/each}}
                  </select>
                  <select name="system.attackValues.{{../index}}.specials.{{si}}.specialValue" data-dtype="Number">
                    <option value="">—</option>
                    {{#each (range 1 10)}}
                    <option value="{{this}}" {{#if (eqNum sp.specialValue this)}}selected{{/if}}>{{this}}</option>
                    {{/each}}
                  </select>
                  <button type="button" class="npc-power-special-del" data-scope="extra" data-attack-index="{{../index}}" data-special-index="{{si}}"><i class="fas fa-trash"></i></button>
                </div>
                {{/each}}
              </div>
            </div>
            {{/each}}
          {{else}}
            <div class="no-attack-values">No extra powers yet.</div>
          {{/if}}
        </div>
      </div>
      {{/unless}}

      {{> "systems/mastery-system/templates/actor/partials/npc-reactions.hbs"
        path="system"
        slots=system.npcReactionSlots
        rows=system.npcReactions
        phaseIndex=""}}
    {{/if}}

    {{!-- Notes --}}
    <div class="notes-panel npc-section npc-section--notes">
      <div class="form-group">
        <label>Blood Color (Blutfarbe):</label>
        <div class="blood-color-input-group">
          <input type="color" name="system.bloodColor" class="blood-color-picker" value="{{default system.bloodColor '#8b0000'}}" title="Choose the color for blood pools when this NPC takes damage"/>
          <input type="text" class="blood-color-text" value="{{default system.bloodColor '#8b0000'}}" placeholder="#8b0000" pattern="^#[0-9A-Fa-f]{6}$" title="Hex color code (e.g., #8b0000 for dark red, #ff0000 for red, #0000ff for blue)"/>
        </div>
        <p class="hint"><i class="fas fa-info-circle"></i> This color will be used for blood pools when this NPC takes damage.</p>
      </div>
      {{#unless isSummon}}
      <label>Description:</label>
      {{#if editable}}
          <prose-mirror name="system.bio.description" value="{{system.bio.description}}" toggled document-uuid="{{actor.uuid}}">{{{enrichedBio.description}}}</prose-mirror>
          {{else}}
          {{{enrichedBio.description}}}
          {{/if}}
      
      <label>Notes:</label>
      <textarea name="system.notes">{{system.notes}}</textarea>
      {{/unless}}
    </div>

  </section>
</div>

































