<div class="{{cssClass}}">
  {{!-- Sheet Header --}}
  <header class="sheet-header">
    <div class="portrait-section">
      <div class="profile-img-wrapper">
        <div class="profile-img-container {{#unless editable}}locked{{/unless}}" data-image-type="portrait">
          <img class="profile-img {{#if editable}}{{else}}locked{{/if}}" src="{{actor.img}}" title="{{actor.name}} Portrait" alt="{{actor.name}} Portrait" />
          <div class="profile-overlay">
            <div class="profile-zone profile-zone-edit" data-action="edit" data-img-type="portrait">
              <span class="zone-label">EDIT</span>
            </div>
            <div class="profile-zone profile-zone-show" data-action="show" data-img-type="portrait">
              <span class="zone-label">SHOW</span>
            </div>
          </div>
        </div>
        <div class="profile-img-label">PORTRAIT</div>
      </div>
      <div class="profile-img-wrapper">
        <div class="profile-img-container profile-img-container-token {{#unless editable}}locked{{/unless}}" data-image-type="token">
          <img class="profile-img {{#if editable}}{{else}}locked{{/if}}" src="{{default actor.prototypeToken.texture.src actor.img}}" title="{{actor.name}} Token" alt="{{actor.name}} Token" />
          <div class="profile-overlay">
            <div class="profile-zone profile-zone-edit" data-action="edit" data-img-type="token">
              <span class="zone-label">EDIT</span>
            </div>
            <div class="profile-zone profile-zone-show" data-action="show" data-img-type="token">
              <span class="zone-label">SHOW</span>
            </div>
          </div>
        </div>
        <div class="profile-img-label">TOKEN</div>
      </div>
    </div>
    
    <div class="header-info">
      <div class="mastery-rank-box" title="Mastery Rank">
        <label>MR</label>
        <select name="system.mastery.rank" class="mastery-rank-select" data-dtype="Number">
          <option value="1" {{#if (eq system.mastery.rank 1)}}selected{{/if}}>1</option>
          <option value="2" {{#if (eq system.mastery.rank 2)}}selected{{/if}}>2</option>
          <option value="3" {{#if (eq system.mastery.rank 3)}}selected{{/if}}>3</option>
          <option value="4" {{#if (eq system.mastery.rank 4)}}selected{{/if}}>4</option>
          <option value="5" {{#if (eq system.mastery.rank 5)}}selected{{/if}}>5</option>
          <option value="6" {{#if (eq system.mastery.rank 6)}}selected{{/if}}>6</option>
          <option value="7" {{#if (eq system.mastery.rank 7)}}selected{{/if}}>7</option>
          <option value="8" {{#if (eq system.mastery.rank 8)}}selected{{/if}}>8</option>
        </select>
      </div>
      
      <div class="character-name-box">
        {{#if editable}}
          <input name="name" type="text" value="{{actor.name}}" placeholder="NPC Name" />
        {{else}}
          <h1>{{actor.name}}</h1>
        {{/if}}
      </div>
      <div class="npc-creature-type-box" title="Creature type (Smite vs Undead / Fiend)">
        <label>Typ</label>
        <select name="system.creatureType" class="npc-creature-type-select">
          <option value="" {{#unless system.creatureType}}selected{{/unless}}>— Creature Type —</option>
          <option value="humanoid" {{#if (eq system.creatureType "humanoid")}}selected{{/if}}>Humanoid</option>
          <option value="undead" {{#if (eq system.creatureType "undead")}}selected{{/if}}>Undead</option>
          <option value="fiend" {{#if (eq system.creatureType "fiend")}}selected{{/if}}>Dämon / Fiend</option>
          <option value="beast" {{#if (eq system.creatureType "beast")}}selected{{/if}}>Beast</option>
          <option value="construct" {{#if (eq system.creatureType "construct")}}selected{{/if}}>Construct</option>
          <option value="elemental" {{#if (eq system.creatureType "elemental")}}selected{{/if}}>Elemental</option>
          <option value="other" {{#if (eq system.creatureType "other")}}selected{{/if}}>Other</option>
        </select>
      </div>
    </div>
  </header>

  {{!-- Phase Tabs Navigation (if phases exist) --}}
  {{#if system.phases}}
  <nav class="sheet-tabs tabs" data-group="primary">
    {{#each system.phases as |phase index|}}
    <a class="item" data-tab="phase-{{index}}">{{phase.name}}</a>
    {{/each}}
    <button type="button" class="phase-add-btn" title="Boss mit Phasen">
      <i class="fas fa-layer-group"></i> Phase
    </button>
  </nav>
  {{else}}
  <div class="phase-controls">
    <button type="button" class="phase-add-btn" title="NSC in Boss mit Phasen umwandeln">
      <i class="fas fa-layer-group"></i> Boss-Phasen
    </button>
  </div>
  {{/if}}

  {{#if system.phases}}
  <div class="npc-phase-toolbar npc-section">
    <div class="npc-phase-toolbar__field">
      <label>Aktive Phase (Radial / Angriffe)</label>
      <select name="system.npcActivePhaseIndex" data-dtype="Number">
        {{#each system.phases as |ph idx|}}
        <option value="{{idx}}" {{#if (eq ../system.npcActivePhaseIndex idx)}}selected{{/if}}>{{ph.name}}</option>
        {{/each}}
      </select>
    </div>
    <div class="npc-phase-toolbar__field">
      <label>Angriffe / Runde</label>
      <input type="number" name="system.attackSlots" value="{{default system.attackSlots 1}}" min="1" max="20" step="1" data-dtype="Number" readonly title="Summe der Angriffe/Runde aller Powers (aktive Phase) — erscheint als ATK im Kampf"/>
    </div>
    <div class="npc-phase-toolbar__field">
      <label>Bewegung / Runde</label>
      <input type="number" name="system.npcMovementSlots" value="{{default system.npcMovementSlots 1}}" min="1" max="10" step="1" data-dtype="Number" title="Movement-Aktionen pro Runde"/>
    </div>
  </div>
  {{/if}}

  {{!-- Sheet Body --}}
  <section class="sheet-body">
    {{#if system.phases}}
      {{!-- Phase Tabs Content --}}
      {{#each system.phases as |phase phaseIndex|}}
      <div class="tab phase-content" data-group="primary" data-tab="phase-{{phaseIndex}}">
        
        {{!-- Phase Header --}}
        <div class="phase-header">
          <input type="text" name="system.phases.{{phaseIndex}}.name" value="{{phase.name}}" placeholder="Phase Name" class="phase-name-input"/>
          <button type="button" class="phase-delete-btn" data-phase-index="{{phaseIndex}}" title="Delete Phase">
            <i class="fas fa-trash"></i> Delete Phase
          </button>
        </div>
        
        <section class="npc-section npc-section--combat">
          <h3 class="npc-section__title"><i class="fas fa-shield-alt"></i> Kampfwerte</h3>
          <div class="npc-combat-strip">
            <div class="npc-combat-chip">
              <span class="npc-combat-chip__label">Ausweichen</span>
              <input type="number" name="system.phases.{{phaseIndex}}.combat.evade" value="{{default phase.combat.evade 10}}" data-dtype="Number" title="Evade"/>
            </div>
            <div class="npc-combat-chip">
              <span class="npc-combat-chip__label">Rüstung</span>
              <input type="number" name="system.phases.{{phaseIndex}}.combat.armor" value="{{default phase.combat.armor 0}}" data-dtype="Number" title="Rüstung"/>
            </div>
            <div class="npc-combat-chip">
              <span class="npc-combat-chip__label">Tempo</span>
              <input type="number" name="system.phases.{{phaseIndex}}.combat.speed" value="{{default phase.combat.speed 6}}" data-dtype="Number" title="Speed"/>
            </div>
          </div>
        </section>

        {{!-- Health --}}
        <div class="health-panel npc-section">
          <h3 class="npc-section__title"><i class="fas fa-heart"></i> Trefferpunkte</h3>
          <div class="health-display">
            <label>HP:</label>
            {{#each phase.health.bars as |bar index|}}
            <div class="health-bar {{#if (eq ../phase.health.currentBar index)}}active{{/if}}">
              <input type="number" name="system.phases.{{../phaseIndex}}.health.bars.{{index}}.current" value="{{bar.current}}" data-dtype="Number"/> / 
              <input type="number" name="system.phases.{{../phaseIndex}}.health.bars.{{index}}.max" value="{{bar.max}}" data-dtype="Number"/>
              <span class="bar-penalty">({{bar.penalty}})</span>
            </div>
            {{/each}}
          </div>
        </div>

        {{!-- Status Effects --}}
        <div class="status-effects-panel npc-section">
          <h3 class="npc-section__title"><i class="fas fa-bolt"></i> Status</h3>
          <div class="status-effects-list">
            {{#if phase.statusEffects}}
              {{#each phase.statusEffects as |effect index|}}
              <div class="status-effect-item" data-effect-index="{{index}}" data-phase-index="{{../phaseIndex}}">
                <span class="effect-name">
                  <i class="fas fa-exclamation-triangle"></i>
                  {{effect.name}}
                  {{#if effect.value}}
                    <span class="effect-value">({{effect.value}})</span>
                  {{/if}}
                </span>
                <button type="button" class="effect-remove" data-effect-index="{{index}}" data-phase-index="{{../phaseIndex}}" title="Remove Effect">
                  <i class="fas fa-times"></i>
                </button>
              </div>
              {{/each}}
            {{else}}
              <div class="no-status-effects">Keine aktiven Effekte</div>
            {{/if}}
          </div>
        </div>

        {{!-- Basis: Waffenangriff (Phase) --}}
        <div class="attack-values-panel npc-section">
          <h3 class="npc-section__title"><i class="fas fa-sword"></i> Basis: Waffenangriff</h3>
          <p class="hint">Immer im Radialmenü; zusätzliche Einträge unten sind Extras. Erste Zeile: Angriffs-<strong>W8</strong> im Pool, zweite: Schadens-<strong>W8</strong> im Pool.</p>
          <div class="npc-attack-card npc-attack-card--base">
            <div class="npc-attack-card__grid npc-attack-card__grid--simple">
              <div class="npc-attack-field">
                <label>Name</label>
                <input type="text" name="system.phases.{{phaseIndex}}.npcBaseAttack.name" value="{{default phase.npcBaseAttack.name 'Waffenangriff'}}" placeholder="Waffenangriff"/>
              </div>
              <div class="npc-attack-field">
                <label>Angriff (Pool)</label>
                <select name="system.phases.{{phaseIndex}}.npcBaseAttack.attackDiceCount" data-dtype="Number">
                  <option value="">—</option>
                  {{#each (range 2 16)}}
                  <option value="{{this}}" {{#if (eqNum ../phase.npcBaseAttack.attackDiceCount this)}}selected{{/if}}>{{this}}d8</option>
                  {{/each}}
                </select>
              </div>
              <div class="npc-attack-field">
                <label>Schaden</label>
                <select name="system.phases.{{phaseIndex}}.npcBaseAttack.damageDiceCount" data-dtype="Number">
                  <option value="">—</option>
                  {{#each (range 4 16)}}
                  <option value="{{this}}" {{#if (eqNum ../phase.npcBaseAttack.damageDiceCount this)}}selected{{/if}}>{{this}}d8</option>
                  {{/each}}
                </select>
              </div>
            </div>
            <div class="npc-attack-advanced-grid">
              <p class="npc-attack-advanced-hint">Radial: Reach/Fern; Spell = Casting TN 8×MR; <strong>Angriffe/Runde</strong> = so oft die Power im Radial erscheint (setzt ATK); Stress = W8.</p>
              <div class="npc-attack-field">
                <label>Reichweite</label>
                <select name="system.phases.{{phaseIndex}}.npcBaseAttack.npcRangeKind">
                  <option value="" {{#unless phase.npcBaseAttack.npcRangeKind}}selected{{/unless}}>Reach</option>
                  <option value="ranged" {{#if (eq phase.npcBaseAttack.npcRangeKind "ranged")}}selected{{/if}}>Fern</option>
                </select>
              </div>
              <div class="npc-attack-field">
                <label>m (Reach 1–8 / Fern-Max 12–24)</label>
                <input type="number" name="system.phases.{{phaseIndex}}.npcBaseAttack.npcRangeMeters" value="{{default phase.npcBaseAttack.npcRangeMeters 2}}" min="1" max="24" step="1" data-dtype="Number" title="Reach: 1–8 m. Fernkampf: maximale Distanz 12–24 m."/>
              </div>
              <div class="npc-attack-field">
                <label>Fern Min. m</label>
                <input type="number" name="system.phases.{{phaseIndex}}.npcBaseAttack.npcRangeMinMeters" value="{{default phase.npcBaseAttack.npcRangeMinMeters 12}}" min="12" max="24" step="1" data-dtype="Number" title="Nur Fernkampf: minimale Distanz (Standard 12 m)"/>
              </div>
              <div class="npc-attack-field">
                <label>AoE-Form</label>
                <select name="system.phases.{{phaseIndex}}.npcBaseAttack.npcAoeShape">
                  <option value="" {{#unless phase.npcBaseAttack.npcAoeShape}}selected{{/unless}}>Keine</option>
                  <option value="radius" {{#if (eq phase.npcBaseAttack.npcAoeShape "radius")}}selected{{/if}}>Radius</option>
                  <option value="cone" {{#if (eq phase.npcBaseAttack.npcAoeShape "cone")}}selected{{/if}}>Kegel</option>
                  <option value="line" {{#if (eq phase.npcBaseAttack.npcAoeShape "line")}}selected{{/if}}>Linie</option>
                </select>
              </div>
              <div class="npc-attack-field">
                <label>AoE m (Radius/Länge)</label>
                <input type="number" name="system.phases.{{phaseIndex}}.npcBaseAttack.npcAoeRadiusM" value="{{default phase.npcBaseAttack.npcAoeRadiusM 0}}" min="0" step="1" data-dtype="Number" title="Meter: Radius (Burst), Kegel- oder Linienlänge je nach Tool"/>
              </div>
              <div class="npc-attack-field npc-attack-field--check">
                <label>Split-Angriff</label>
                <label class="npc-attack-checkbox-label"><input type="checkbox" name="system.phases.{{phaseIndex}}.npcBaseAttack.npcSplitAttack" {{#if phase.npcBaseAttack.npcSplitAttack}}checked{{/if}} data-dtype="Boolean"/> Zwei Treffer (Pool/Schaden halbiert)</label>
              </div>
              <div class="npc-attack-field npc-attack-field--check">
                <label>Spell</label>
                <label class="npc-attack-checkbox-label"><input type="checkbox" name="system.phases.{{phaseIndex}}.npcBaseAttack.npcIsSpell" {{#if phase.npcBaseAttack.npcIsSpell}}checked{{/if}} data-dtype="Boolean"/> Casting TN = 8×MR (nicht Evade)</label>
              </div>
              <div class="npc-attack-field">
                <label>Angriffe/Runde</label>
                <select name="system.phases.{{phaseIndex}}.npcBaseAttack.npcAttacksPerRound" data-dtype="Number" title="So oft erscheint diese Power im Radialmenü (1–5). Summe aller Powers = ATK.">
                  {{#each (range 1 5)}}
                  <option value="{{this}}" {{#if (eqNum ../phase.npcBaseAttack.npcAttacksPerRound this)}}selected{{/if}}>{{this}}</option>
                  {{/each}}
                </select>
              </div>
              <div class="npc-attack-field">
                <label>Stress-Schaden (W8)</label>
                <select name="system.phases.{{phaseIndex}}.npcBaseAttack.npcStressD8" data-dtype="Number" data-tooltip="Stress-Schaden bei Treffer (Stress-Rüstung mindert)">
                  <option value="" {{#unless phase.npcBaseAttack.npcStressD8}}selected{{/unless}}>—</option>
                  {{#each (range 1 4)}}
                  <option value="{{this}}" {{#if (eqNum ../phase.npcBaseAttack.npcStressD8 this)}}selected{{/if}}>{{this}}d8</option>
                  {{/each}}
                </select>
              </div>
            </div>
            <div class="npc-attack-specials-block">
              <div class="npc-attack-specials-header">
                <span>Speziale</span>
                <button type="button" class="npc-power-special-add" data-scope="phase-base" data-phase-index="{{phaseIndex}}" title="Spezial hinzufügen"><i class="fas fa-plus"></i></button>
              </div>
              {{#each phase.npcBaseAttack.specials as |sp si|}}
              <div class="npc-attack-special-row">
                <select name="system.phases.{{../phaseIndex}}.npcBaseAttack.specials.{{si}}.special" class="special-select">
                  <option value="">—</option>
                  {{#each @root.npcSpecialSelectGroups as |grp|}}
                  <optgroup label="{{grp.label}}">
                    {{#each grp.options as |opt|}}
                    <option value="{{opt.value}}" {{#if (eq sp.special opt.value)}}selected{{/if}}>{{opt.label}}</option>
                    {{/each}}
                  </optgroup>
                  {{/each}}
                </select>
                <select name="system.phases.{{../phaseIndex}}.npcBaseAttack.specials.{{si}}.specialValue" data-dtype="Number">
                  <option value="">—</option>
                  {{#each (range 1 10)}}
                  <option value="{{this}}" {{#if (eqNum sp.specialValue this)}}selected{{/if}}>{{this}}</option>
                  {{/each}}
                </select>
                <button type="button" class="npc-power-special-del" data-scope="phase-base" data-phase-index="{{../phaseIndex}}" data-special-index="{{si}}" title="Entfernen"><i class="fas fa-trash"></i></button>
              </div>
              {{/each}}
            </div>
          </div>
        </div>

        {{!-- Extra-Powers (Phase) --}}
        <div class="attack-values-panel npc-section">
          <div class="attack-values-header">
            <h3 class="npc-section__title"><i class="fas fa-khanda"></i> Weitere Powers (Extras)</h3>
            <button type="button" class="attack-value-add" data-phase-index="{{phaseIndex}}"><i class="fas fa-plus"></i> Power</button>
          </div>
          <div class="attack-values-list">
            {{#if phase.attackValues}}
              {{#each phase.attackValues as |attack index|}}
              <div class="npc-attack-card attack-value-item" data-attack-index="{{index}}" data-phase-index="{{../phaseIndex}}">
                <div class="npc-attack-card__head">
                  <input type="text" class="npc-attack-name" name="system.phases.{{../phaseIndex}}.attackValues.{{index}}.name" value="{{attack.name}}" placeholder="Power-Name"/>
                  <button type="button" class="attack-value-delete npc-attack-delete" data-attack-index="{{index}}" data-phase-index="{{../phaseIndex}}" title="Entfernen">
                    <i class="fas fa-trash"></i>
                  </button>
                </div>
                <div class="npc-attack-card__grid npc-attack-card__grid--simple">
                  <div class="npc-attack-field">
                    <label>Angriff (Pool)</label>
                    <select name="system.phases.{{../phaseIndex}}.attackValues.{{index}}.attackDiceCount" data-dtype="Number">
                      <option value="">—</option>
                      {{#each (range 2 16)}}
                      <option value="{{this}}" {{#if (eqNum ../attack.attackDiceCount this)}}selected{{/if}}>{{this}}d8</option>
                      {{/each}}
                    </select>
                  </div>
                  <div class="npc-attack-field">
                    <label>Schaden</label>
                    <select name="system.phases.{{../phaseIndex}}.attackValues.{{index}}.damageDiceCount" data-dtype="Number">
                      <option value="">—</option>
                      {{#each (range 4 16)}}
                      <option value="{{this}}" {{#if (eqNum ../attack.damageDiceCount this)}}selected{{/if}}>{{this}}d8</option>
                      {{/each}}
                    </select>
                  </div>
                </div>
                <div class="npc-attack-advanced-grid">
                  <p class="npc-attack-advanced-hint">Radial: Reach/Fern; AoE; Split; Spell (8×MR); Angriffe/Runde = Radial-Kopien (Summe = ATK); Stress = W8.</p>
                  <div class="npc-attack-field">
                    <label>Reichweite</label>
                    <select name="system.phases.{{../phaseIndex}}.attackValues.{{index}}.npcRangeKind">
                      <option value="" {{#unless attack.npcRangeKind}}selected{{/unless}}>Reach</option>
                      <option value="ranged" {{#if (eq attack.npcRangeKind "ranged")}}selected{{/if}}>Fern</option>
                    </select>
                  </div>
                  <div class="npc-attack-field">
                    <label>m (Reach / Fern-Max)</label>
                    <input type="number" name="system.phases.{{../phaseIndex}}.attackValues.{{index}}.npcRangeMeters" value="{{default attack.npcRangeMeters 2}}" min="1" max="24" step="1" data-dtype="Number" title="Reach 1–8 m oder Fern-Max 12–24 m"/>
                  </div>
                  <div class="npc-attack-field">
                    <label>Fern Min. m</label>
                    <input type="number" name="system.phases.{{../phaseIndex}}.attackValues.{{index}}.npcRangeMinMeters" value="{{default attack.npcRangeMinMeters 12}}" min="12" max="24" step="1" data-dtype="Number" title="Nur Fernkampf: Min. 12–24 m"/>
                  </div>
                  <div class="npc-attack-field">
                    <label>AoE-Form</label>
                    <select name="system.phases.{{../phaseIndex}}.attackValues.{{index}}.npcAoeShape">
                      <option value="" {{#unless attack.npcAoeShape}}selected{{/unless}}>Keine</option>
                      <option value="radius" {{#if (eq attack.npcAoeShape "radius")}}selected{{/if}}>Radius</option>
                      <option value="cone" {{#if (eq attack.npcAoeShape "cone")}}selected{{/if}}>Kegel</option>
                      <option value="line" {{#if (eq attack.npcAoeShape "line")}}selected{{/if}}>Linie</option>
                    </select>
                  </div>
                  <div class="npc-attack-field">
                    <label>AoE m</label>
                    <input type="number" name="system.phases.{{../phaseIndex}}.attackValues.{{index}}.npcAoeRadiusM" value="{{default attack.npcAoeRadiusM 0}}" min="0" step="1" data-dtype="Number"/>
                  </div>
                  <div class="npc-attack-field npc-attack-field--check">
                    <label>Split</label>
                    <label class="npc-attack-checkbox-label"><input type="checkbox" name="system.phases.{{../phaseIndex}}.attackValues.{{index}}.npcSplitAttack" {{#if attack.npcSplitAttack}}checked{{/if}} data-dtype="Boolean"/></label>
                  </div>
                  <div class="npc-attack-field npc-attack-field--check">
                    <label>Spell</label>
                    <label class="npc-attack-checkbox-label"><input type="checkbox" name="system.phases.{{../phaseIndex}}.attackValues.{{index}}.npcIsSpell" {{#if attack.npcIsSpell}}checked{{/if}} data-dtype="Boolean" title="Casting TN = 8×MR (nicht Evade)"/></label>
                  </div>
                  <div class="npc-attack-field">
                    <label>Angriffe/Runde</label>
                    <select name="system.phases.{{../phaseIndex}}.attackValues.{{index}}.npcAttacksPerRound" data-dtype="Number" title="So oft erscheint diese Power im Radialmenü (1–5). Summe aller Powers = ATK.">
                      {{#each (range 1 5)}}
                      <option value="{{this}}" {{#if (eqNum ../attack.npcAttacksPerRound this)}}selected{{/if}}>{{this}}</option>
                      {{/each}}
                    </select>
                  </div>
                  <div class="npc-attack-field">
                    <label>Stress-Schaden (W8)</label>
                    <select name="system.phases.{{../phaseIndex}}.attackValues.{{index}}.npcStressD8" data-dtype="Number" data-tooltip="Stress-Schaden bei Treffer (Stress-Rüstung mindert)">
                      <option value="" {{#unless attack.npcStressD8}}selected{{/unless}}>—</option>
                      {{#each (range 1 4)}}
                      <option value="{{this}}" {{#if (eqNum ../attack.npcStressD8 this)}}selected{{/if}}>{{this}}d8</option>
                      {{/each}}
                    </select>
                  </div>
                </div>
                <div class="npc-attack-specials-block">
                  <div class="npc-attack-specials-header">
                    <span>Speziale</span>
                    <button type="button" class="npc-power-special-add" data-scope="extra" data-phase-index="{{../phaseIndex}}" data-attack-index="{{index}}"><i class="fas fa-plus"></i></button>
                  </div>
                  {{#each attack.specials as |sp si|}}
                  <div class="npc-attack-special-row">
                    <select name="system.phases.{{../../phaseIndex}}.attackValues.{{../index}}.specials.{{si}}.special" class="special-select">
                      <option value="">—</option>
                      {{#each @root.npcSpecialSelectGroups as |grp|}}
                  <optgroup label="{{grp.label}}">
                    {{#each grp.options as |opt|}}
                    <option value="{{opt.value}}" {{#if (eq sp.special opt.value)}}selected{{/if}}>{{opt.label}}</option>
                    {{/each}}
                  </optgroup>
                  {{/each}}
                    </select>
                    <select name="system.phases.{{../../phaseIndex}}.attackValues.{{../index}}.specials.{{si}}.specialValue" data-dtype="Number">
                      <option value="">—</option>
                      {{#each (range 1 10)}}
                      <option value="{{this}}" {{#if (eqNum sp.specialValue this)}}selected{{/if}}>{{this}}</option>
                      {{/each}}
                    </select>
                    <button type="button" class="npc-power-special-del" data-scope="extra" data-phase-index="{{../../phaseIndex}}" data-attack-index="{{../index}}" data-special-index="{{si}}"><i class="fas fa-trash"></i></button>
                  </div>
                  {{/each}}
                </div>
              </div>
              {{/each}}
            {{else}}
              <div class="no-attack-values">Noch keine Extra-Powers.</div>
            {{/if}}
          </div>
        </div>
      </div>
      {{/each}}
    {{else}}
      {{!-- Normal NPC View (no phases) --}}
      <section class="npc-section npc-section--combat">
        <h3 class="npc-section__title"><i class="fas fa-shield-alt"></i> Kampfwerte</h3>
        <div class="npc-combat-strip">
          <div class="npc-combat-chip">
            <span class="npc-combat-chip__label">Ausweichen</span>
            <input type="number" name="system.combat.evade" value="{{system.combat.evade}}" data-dtype="Number"/>
          </div>
          <div class="npc-combat-chip">
            <span class="npc-combat-chip__label">Rüstung</span>
            <input type="number" name="system.combat.armor" value="{{system.combat.armor}}" data-dtype="Number"/>
          </div>
          <div class="npc-combat-chip">
            <span class="npc-combat-chip__label">Tempo</span>
            <input type="number" name="system.combat.speed" value="{{system.combat.speed}}" data-dtype="Number"/>
          </div>
          <div class="npc-combat-chip">
            <span class="npc-combat-chip__label">Angriffe / Runde</span>
            <input type="number" name="system.attackSlots" value="{{default system.attackSlots 1}}" min="1" max="20" step="1" data-dtype="Number" readonly title="Summe der Angriffe/Runde aller Powers (aktive Phase) — erscheint als ATK im Kampf"/>
          </div>
          <div class="npc-combat-chip">
            <span class="npc-combat-chip__label">Bewegung / Runde</span>
            <input type="number" name="system.npcMovementSlots" value="{{default system.npcMovementSlots 1}}" min="1" max="10" step="1" data-dtype="Number" title="Movement-Aktionen pro Runde"/>
          </div>
        </div>
      </section>

      {{!-- Health --}}
      <div class="health-panel npc-section">
        <h3 class="npc-section__title"><i class="fas fa-heart"></i> Trefferpunkte</h3>
        <div class="health-display">
          <label>HP:</label>
          {{#each system.health.bars as |bar index|}}
          <div class="health-bar {{#if (eq ../system.health.currentBar index)}}active{{/if}}">
            <input type="number" name="system.health.bars.{{index}}.current" value="{{bar.current}}" data-dtype="Number"/> / 
            <input type="number" name="system.health.bars.{{index}}.max" value="{{bar.max}}" data-dtype="Number"/>
            <span class="bar-penalty">({{bar.penalty}})</span>
          </div>
          {{/each}}
        </div>
      </div>

      {{!-- Status Effects --}}
      <div class="status-effects-panel npc-section">
        <h3 class="npc-section__title"><i class="fas fa-bolt"></i> Status</h3>
        <div class="status-effects-list">
          {{#if system.statusEffects}}
            {{#each system.statusEffects as |effect index|}}
            <div class="status-effect-item" data-effect-index="{{index}}">
              <span class="effect-name">
                <i class="fas fa-exclamation-triangle"></i>
                {{effect.name}}
                {{#if effect.value}}
                  <span class="effect-value">({{effect.value}})</span>
                {{/if}}
              </span>
              <button type="button" class="effect-remove" data-effect-index="{{index}}" title="Remove Effect">
                <i class="fas fa-times"></i>
              </button>
            </div>
            {{/each}}
          {{else}}
            <div class="no-status-effects">Keine aktiven Effekte</div>
          {{/if}}
        </div>
      </div>

      {{!-- Basis: Waffenangriff --}}
      <div class="attack-values-panel npc-section">
        <h3 class="npc-section__title"><i class="fas fa-sword"></i> Basis: Waffenangriff</h3>
        <p class="hint">Standard-Angriff, immer im Radialmenü. Darunter: Extra-Powers. Erste Zeile: Angriffs-<strong>W8</strong> im Pool, zweite: Schadens-<strong>W8</strong> im Pool.</p>
        <div class="npc-attack-card npc-attack-card--base">
          <div class="npc-attack-card__grid npc-attack-card__grid--simple">
            <div class="npc-attack-field">
              <label>Name</label>
              <input type="text" name="system.npcBaseAttack.name" value="{{default system.npcBaseAttack.name 'Waffenangriff'}}" placeholder="Waffenangriff"/>
            </div>
            <div class="npc-attack-field">
              <label>Angriff (Pool)</label>
              <select name="system.npcBaseAttack.attackDiceCount" data-dtype="Number">
                <option value="">—</option>
                {{#each (range 2 16)}}
                <option value="{{this}}" {{#if (eqNum ../system.npcBaseAttack.attackDiceCount this)}}selected{{/if}}>{{this}}d8</option>
                {{/each}}
              </select>
            </div>
            <div class="npc-attack-field">
              <label>Schaden</label>
              <select name="system.npcBaseAttack.damageDiceCount" data-dtype="Number">
                <option value="">—</option>
                {{#each (range 4 16)}}
                <option value="{{this}}" {{#if (eqNum ../system.npcBaseAttack.damageDiceCount this)}}selected{{/if}}>{{this}}d8</option>
                {{/each}}
              </select>
            </div>
          </div>
          <div class="npc-attack-advanced-grid">
            <p class="npc-attack-advanced-hint">Radial: Reach/Fern; AoE; Split; Spell (8×MR); Angriffe/Runde = Radial-Kopien (Summe = ATK); Stress = W8.</p>
            <div class="npc-attack-field">
              <label>Reichweite</label>
              <select name="system.npcBaseAttack.npcRangeKind">
                <option value="" {{#unless system.npcBaseAttack.npcRangeKind}}selected{{/unless}}>Reach</option>
                <option value="ranged" {{#if (eq system.npcBaseAttack.npcRangeKind "ranged")}}selected{{/if}}>Fern</option>
              </select>
            </div>
            <div class="npc-attack-field">
              <label>m (Reach 1–8 / Fern-Max 12–24)</label>
              <input type="number" name="system.npcBaseAttack.npcRangeMeters" value="{{default system.npcBaseAttack.npcRangeMeters 2}}" min="1" max="24" step="1" data-dtype="Number" title="Reach: 1–8 m. Fernkampf: maximale Distanz 12–24 m."/>
            </div>
            <div class="npc-attack-field">
              <label>Fern Min. m</label>
              <input type="number" name="system.npcBaseAttack.npcRangeMinMeters" value="{{default system.npcBaseAttack.npcRangeMinMeters 12}}" min="12" max="24" step="1" data-dtype="Number" title="Nur Fernkampf: minimale Distanz (Standard 12 m)"/>
            </div>
            <div class="npc-attack-field">
              <label>AoE-Form</label>
              <select name="system.npcBaseAttack.npcAoeShape">
                <option value="" {{#unless system.npcBaseAttack.npcAoeShape}}selected{{/unless}}>Keine</option>
                <option value="radius" {{#if (eq system.npcBaseAttack.npcAoeShape "radius")}}selected{{/if}}>Radius</option>
                <option value="cone" {{#if (eq system.npcBaseAttack.npcAoeShape "cone")}}selected{{/if}}>Kegel</option>
                <option value="line" {{#if (eq system.npcBaseAttack.npcAoeShape "line")}}selected{{/if}}>Linie</option>
              </select>
            </div>
            <div class="npc-attack-field">
              <label>AoE m</label>
              <input type="number" name="system.npcBaseAttack.npcAoeRadiusM" value="{{default system.npcBaseAttack.npcAoeRadiusM 0}}" min="0" step="1" data-dtype="Number"/>
            </div>
            <div class="npc-attack-field npc-attack-field--check">
              <label>Split</label>
              <label class="npc-attack-checkbox-label"><input type="checkbox" name="system.npcBaseAttack.npcSplitAttack" {{#if system.npcBaseAttack.npcSplitAttack}}checked{{/if}} data-dtype="Boolean"/></label>
            </div>
            <div class="npc-attack-field npc-attack-field--check">
              <label>Spell</label>
              <label class="npc-attack-checkbox-label"><input type="checkbox" name="system.npcBaseAttack.npcIsSpell" {{#if system.npcBaseAttack.npcIsSpell}}checked{{/if}} data-dtype="Boolean" title="Casting TN = 8×MR (nicht Evade)"/></label>
            </div>
            <div class="npc-attack-field">
              <label>Angriffe/Runde</label>
              <select name="system.npcBaseAttack.npcAttacksPerRound" data-dtype="Number" title="So oft erscheint diese Power im Radialmenü (1–5). Summe aller Powers = ATK.">
                {{#each (range 1 5)}}
                <option value="{{this}}" {{#if (eqNum ../system.npcBaseAttack.npcAttacksPerRound this)}}selected{{/if}}>{{this}}</option>
                {{/each}}
              </select>
            </div>
            <div class="npc-attack-field">
              <label>Stress-Schaden (W8)</label>
              <select name="system.npcBaseAttack.npcStressD8" data-dtype="Number" data-tooltip="Stress-Schaden bei Treffer (Stress-Rüstung mindert)">
                <option value="" {{#unless system.npcBaseAttack.npcStressD8}}selected{{/unless}}>—</option>
                {{#each (range 1 4)}}
                <option value="{{this}}" {{#if (eqNum ../system.npcBaseAttack.npcStressD8 this)}}selected{{/if}}>{{this}}d8</option>
                {{/each}}
              </select>
            </div>
          </div>
          <div class="npc-attack-specials-block">
            <div class="npc-attack-specials-header">
              <span>Speziale</span>
              <button type="button" class="npc-power-special-add" data-scope="base" title="Spezial hinzufügen"><i class="fas fa-plus"></i></button>
            </div>
            {{#each system.npcBaseAttack.specials as |sp si|}}
            <div class="npc-attack-special-row">
              <select name="system.npcBaseAttack.specials.{{si}}.special" class="special-select">
                <option value="">—</option>
                {{#each @root.npcSpecialSelectGroups as |grp|}}
                  <optgroup label="{{grp.label}}">
                    {{#each grp.options as |opt|}}
                    <option value="{{opt.value}}" {{#if (eq sp.special opt.value)}}selected{{/if}}>{{opt.label}}</option>
                    {{/each}}
                  </optgroup>
                  {{/each}}
              </select>
              <select name="system.npcBaseAttack.specials.{{si}}.specialValue" data-dtype="Number">
                <option value="">—</option>
                {{#each (range 1 10)}}
                <option value="{{this}}" {{#if (eqNum sp.specialValue this)}}selected{{/if}}>{{this}}</option>
                {{/each}}
              </select>
              <button type="button" class="npc-power-special-del" data-scope="base" data-special-index="{{si}}"><i class="fas fa-trash"></i></button>
            </div>
            {{/each}}
          </div>
        </div>
      </div>

      {{!-- Extra-Powers --}}
      <div class="attack-values-panel npc-section">
        <div class="attack-values-header">
          <h3 class="npc-section__title"><i class="fas fa-khanda"></i> Weitere Powers (Extras)</h3>
          <button type="button" class="attack-value-add"><i class="fas fa-plus"></i> Power</button>
        </div>
        <div class="attack-values-list">
          {{#if system.attackValues}}
            {{#each system.attackValues as |attack index|}}
            <div class="npc-attack-card attack-value-item" data-attack-index="{{index}}">
              <div class="npc-attack-card__head">
                <input type="text" class="npc-attack-name" name="system.attackValues.{{index}}.name" value="{{attack.name}}" placeholder="Power-Name"/>
                <button type="button" class="attack-value-delete npc-attack-delete" data-attack-index="{{index}}" title="Entfernen">
                  <i class="fas fa-trash"></i>
                </button>
              </div>
              <div class="npc-attack-card__grid npc-attack-card__grid--simple">
                <div class="npc-attack-field">
                  <label>Angriff (Pool)</label>
                  <select name="system.attackValues.{{index}}.attackDiceCount" data-dtype="Number">
                    <option value="">—</option>
                    {{#each (range 2 16)}}
                    <option value="{{this}}" {{#if (eqNum ../attack.attackDiceCount this)}}selected{{/if}}>{{this}}d8</option>
                    {{/each}}
                  </select>
                </div>
                <div class="npc-attack-field">
                  <label>Schaden</label>
                  <select name="system.attackValues.{{index}}.damageDiceCount" data-dtype="Number">
                    <option value="">—</option>
                    {{#each (range 4 16)}}
                    <option value="{{this}}" {{#if (eqNum ../attack.damageDiceCount this)}}selected{{/if}}>{{this}}d8</option>
                    {{/each}}
                  </select>
                </div>
              </div>
              <div class="npc-attack-advanced-grid">
                <p class="npc-attack-advanced-hint">Radial: Reach/Fern; AoE; Split; Spell (8×MR); Angriffe/Runde = Radial-Kopien (Summe = ATK); Stress = W8.</p>
                <div class="npc-attack-field">
                  <label>Reichweite</label>
                  <select name="system.attackValues.{{index}}.npcRangeKind">
                    <option value="" {{#unless attack.npcRangeKind}}selected{{/unless}}>Reach</option>
                    <option value="ranged" {{#if (eq attack.npcRangeKind "ranged")}}selected{{/if}}>Fern</option>
                  </select>
                </div>
                <div class="npc-attack-field">
                  <label>m (Reach / Fern-Max)</label>
                  <input type="number" name="system.attackValues.{{index}}.npcRangeMeters" value="{{default attack.npcRangeMeters 2}}" min="1" max="24" step="1" data-dtype="Number" title="Reach 1–8 m oder Fern-Max 12–24 m"/>
                </div>
                <div class="npc-attack-field">
                  <label>Fern Min. m</label>
                  <input type="number" name="system.attackValues.{{index}}.npcRangeMinMeters" value="{{default attack.npcRangeMinMeters 12}}" min="12" max="24" step="1" data-dtype="Number" title="Nur Fernkampf: Min. 12–24 m"/>
                </div>
                <div class="npc-attack-field">
                  <label>AoE-Form</label>
                  <select name="system.attackValues.{{index}}.npcAoeShape">
                    <option value="" {{#unless attack.npcAoeShape}}selected{{/unless}}>Keine</option>
                    <option value="radius" {{#if (eq attack.npcAoeShape "radius")}}selected{{/if}}>Radius</option>
                    <option value="cone" {{#if (eq attack.npcAoeShape "cone")}}selected{{/if}}>Kegel</option>
                    <option value="line" {{#if (eq attack.npcAoeShape "line")}}selected{{/if}}>Linie</option>
                  </select>
                </div>
                <div class="npc-attack-field">
                  <label>AoE m</label>
                  <input type="number" name="system.attackValues.{{index}}.npcAoeRadiusM" value="{{default attack.npcAoeRadiusM 0}}" min="0" step="1" data-dtype="Number"/>
                </div>
                <div class="npc-attack-field npc-attack-field--check">
                  <label>Split</label>
                  <label class="npc-attack-checkbox-label"><input type="checkbox" name="system.attackValues.{{index}}.npcSplitAttack" {{#if attack.npcSplitAttack}}checked{{/if}} data-dtype="Boolean"/></label>
                </div>
                <div class="npc-attack-field npc-attack-field--check">
                  <label>Spell</label>
                  <label class="npc-attack-checkbox-label"><input type="checkbox" name="system.attackValues.{{index}}.npcIsSpell" {{#if attack.npcIsSpell}}checked{{/if}} data-dtype="Boolean" title="Casting TN = 8×MR (nicht Evade)"/></label>
                </div>
                <div class="npc-attack-field">
                  <label>Angriffe/Runde</label>
                  <select name="system.attackValues.{{index}}.npcAttacksPerRound" data-dtype="Number" title="So oft erscheint diese Power im Radialmenü (1–5). Summe aller Powers = ATK.">
                    {{#each (range 1 5)}}
                    <option value="{{this}}" {{#if (eqNum ../attack.npcAttacksPerRound this)}}selected{{/if}}>{{this}}</option>
                    {{/each}}
                  </select>
                </div>
                <div class="npc-attack-field">
                  <label>Stress-Schaden (W8)</label>
                  <select name="system.attackValues.{{index}}.npcStressD8" data-dtype="Number" data-tooltip="Stress-Schaden bei Treffer (Stress-Rüstung mindert)">
                    <option value="" {{#unless attack.npcStressD8}}selected{{/unless}}>—</option>
                    {{#each (range 1 4)}}
                    <option value="{{this}}" {{#if (eqNum ../attack.npcStressD8 this)}}selected{{/if}}>{{this}}d8</option>
                    {{/each}}
                  </select>
                </div>
              </div>
              <div class="npc-attack-specials-block">
                <div class="npc-attack-specials-header">
                  <span>Speziale</span>
                  <button type="button" class="npc-power-special-add" data-scope="extra" data-attack-index="{{index}}"><i class="fas fa-plus"></i></button>
                </div>
                {{#each attack.specials as |sp si|}}
                <div class="npc-attack-special-row">
                  <select name="system.attackValues.{{../index}}.specials.{{si}}.special" class="special-select">
                    <option value="">—</option>
                    {{#each @root.npcSpecialSelectGroups as |grp|}}
                  <optgroup label="{{grp.label}}">
                    {{#each grp.options as |opt|}}
                    <option value="{{opt.value}}" {{#if (eq sp.special opt.value)}}selected{{/if}}>{{opt.label}}</option>
                    {{/each}}
                  </optgroup>
                  {{/each}}
                  </select>
                  <select name="system.attackValues.{{../index}}.specials.{{si}}.specialValue" data-dtype="Number">
                    <option value="">—</option>
                    {{#each (range 1 10)}}
                    <option value="{{this}}" {{#if (eqNum sp.specialValue this)}}selected{{/if}}>{{this}}</option>
                    {{/each}}
                  </select>
                  <button type="button" class="npc-power-special-del" data-scope="extra" data-attack-index="{{../index}}" data-special-index="{{si}}"><i class="fas fa-trash"></i></button>
                </div>
                {{/each}}
              </div>
            </div>
            {{/each}}
          {{else}}
            <div class="no-attack-values">Noch keine Extra-Powers.</div>
          {{/if}}
        </div>
      </div>
    {{/if}}

    <div class="npc-section npc-special-lists">
      <h3 class="npc-section__title"><i class="fas fa-list"></i> Spezial-Listen (Schaden / Raises)</h3>
      <p class="hint">Freitext-Zeilen für den <strong>Schadensdialog</strong> (nicht „Races“ — gemeint sind <strong>Raises</strong>, also übrige Erfolgsgrade). <strong>Name</strong> = Kurzbezeichnung in der Liste; <strong>Wert</strong> = Beschreibung oder Zahl, die beim Anwenden übernommen wird (je nach Dialog-Logik). <strong>Auto</strong>: wird beim Schaden automatisch mit angeboten bzw. vorgeschlagen, <em>ohne</em> dass du einen Raise dafür „kaufst“. Ohne Auto erscheint der Eintrag in der Auswahl, wenn Raises ausgegeben werden. Zwei Blöcke: <strong>NSC-Speziale</strong> (Kampf/Schaden-Kontext) und <strong>Raise-Speziale</strong> (nur Raise-Liste).</p>
      <div class="npc-special-list-block">
        <div class="npc-special-list-header">
          <span>NSC-Speziale</span>
          <button type="button" class="npc-combat-special-add" title="Eintrag hinzufügen"><i class="fas fa-plus"></i></button>
        </div>
        <div class="npc-special-list-rows">
          {{#each system.npcCombatSpecials as |row i|}}
          <div class="npc-special-row" data-special-index="{{i}}">
            <input type="text" name="system.npcCombatSpecials.{{i}}.name" value="{{row.name}}" placeholder="Name"/>
            <input type="text" name="system.npcCombatSpecials.{{i}}.value" value="{{row.value}}" placeholder="Wert"/>
            <label class="npc-special-auto"><input type="checkbox" name="system.npcCombatSpecials.{{i}}.auto" {{#if row.auto}}checked{{/if}} data-dtype="Boolean"/> Auto</label>
            <button type="button" class="npc-combat-special-del" data-special-index="{{i}}" title="Entfernen"><i class="fas fa-trash"></i></button>
          </div>
          {{else}}
          <p class="hint">Noch keine Einträge.</p>
          {{/each}}
        </div>
      </div>
      <div class="npc-special-list-block">
        <div class="npc-special-list-header">
          <span>Raise-Speziale</span>
          <button type="button" class="npc-raise-special-add" title="Eintrag hinzufügen"><i class="fas fa-plus"></i></button>
        </div>
        <div class="npc-special-list-rows">
          {{#each system.npcRaiseSpecials as |row i|}}
          <div class="npc-special-row" data-raise-index="{{i}}">
            <input type="text" name="system.npcRaiseSpecials.{{i}}.name" value="{{row.name}}" placeholder="Name"/>
            <input type="text" name="system.npcRaiseSpecials.{{i}}.value" value="{{row.value}}" placeholder="Wert"/>
            <label class="npc-special-auto"><input type="checkbox" name="system.npcRaiseSpecials.{{i}}.auto" {{#if row.auto}}checked{{/if}} data-dtype="Boolean"/> Auto</label>
            <button type="button" class="npc-raise-special-del" data-raise-index="{{i}}" title="Entfernen"><i class="fas fa-trash"></i></button>
          </div>
          {{else}}
          <p class="hint">Noch keine Einträge.</p>
          {{/each}}
        </div>
      </div>
    </div>

    {{!-- Notes --}}
    <div class="notes-panel npc-section npc-section--notes">
      <div class="form-group">
        <label>Blood Color (Blutfarbe):</label>
        <div class="blood-color-input-group">
          <input type="color" name="system.bloodColor" class="blood-color-picker" value="{{default system.bloodColor '#8b0000'}}" title="Choose the color for blood pools when this NPC takes damage"/>
          <input type="text" class="blood-color-text" value="{{default system.bloodColor '#8b0000'}}" placeholder="#8b0000" pattern="^#[0-9A-Fa-f]{6}$" title="Hex color code (e.g., #8b0000 for dark red, #ff0000 for red, #0000ff for blue)"/>
        </div>
        <p class="hint"><i class="fas fa-info-circle"></i> This color will be used for blood pools when this NPC takes damage.</p>
      </div>
      
      <label>Description:</label>
      {{#if editable}}
          <prose-mirror name="system.bio.description" value="{{system.bio.description}}" toggled document-uuid="{{actor.uuid}}">{{{enrichedBio.description}}}</prose-mirror>
          {{else}}
          {{{enrichedBio.description}}}
          {{/if}}
      
      <label>Notes:</label>
      <textarea name="system.notes">{{system.notes}}</textarea>
    </div>

  </section>
</div>

































