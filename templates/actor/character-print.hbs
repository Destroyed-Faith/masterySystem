{{!-- Printable character sheet (5 pages; page 5 = Battle Cheat, landscape). Populated by buildCharacterPrintContext(). --}}

{{!-- ============================ PAGE 1 ============================ --}}
<section class="print-page print-page-1">

  <div class="cp-row cp-identity">
    <div class="cp-field cp-name"><span class="cp-field-label">Name</span><span class="cp-field-value">{{name}}</span></div>
    <div class="cp-field cp-player"><span class="cp-field-label">Player</span><span class="cp-field-value">{{player}}</span></div>
  </div>

  <div class="cp-row cp-meta">
    <div class="cp-meta-box"><span class="cp-meta-label">Echo</span><span class="cp-meta-value">{{echo}}</span></div>
    <div class="cp-meta-box"><span class="cp-meta-label">Master Rank</span><span class="cp-meta-value">{{masteryRank}}</span></div>
    <div class="cp-meta-box"><span class="cp-meta-label">Faith Fractures</span><span class="cp-meta-value">{{faithFractures.current}} / {{faithFractures.maximum}}</span></div>
  </div>

  <div class="cp-columns">

    {{!-- Left column: Abilities + Stone Powers --}}
    <div class="cp-col cp-col-left">
      <h2 class="cp-section-title">Abilities <span class="cp-subtle">Stone Powers</span></h2>
      <div class="cp-abilities">
        {{#each abilities}}
        <div class="cp-ability" data-attr="{{key}}">
          <div class="cp-ability-head">
            <span class="cp-ability-name">{{label}}</span>
            <span class="cp-ability-value">{{value}}</span>
          </div>
          <div class="cp-ability-ladder">
            {{#each ladder}}
            <span class="cp-ladder-cell{{#if filled}} is-filled{{/if}}">{{n}}</span>
            {{/each}}
          </div>
          <div class="cp-stone-overview">
            <span class="cp-stone-label">Stones</span>
            <span class="cp-stone-pips">
              {{#each slots}}<span class="cp-stone-pip"></span>{{/each}}
            </span>
            <span class="cp-stone-count">{{stoneAvailable}} / {{stoneCapacity}}</span>
          </div>
          {{#if blocked}}
          <div class="cp-stone-blocked">Blocked by Artifact: {{blockedBy}}</div>
          {{/if}}
        </div>
        {{/each}}
      </div>
    </div>

    {{!-- Right column: Saves, defenses, health, stress --}}
    <div class="cp-col cp-col-right">

      <div class="cp-block cp-saves">
        <h3 class="cp-block-title">Saving Throws</h3>
        <div class="cp-saves-grid">
          {{#each savingThrows}}
          <div class="cp-save-box">
            <div class="cp-save-label">{{label}}</div>
            <div class="cp-save-sub">{{sub}}</div>
            <div class="cp-save-values">
              {{#each values}}<span class="cp-save-value">{{this}}</span>{{/each}}
            </div>
            <div class="cp-save-pool">{{pool}}</div>
          </div>
          {{/each}}
        </div>
        <div class="cp-vitality">Vitality <span class="cp-vitality-value">{{vitalitySave}}</span></div>
      </div>

      <div class="cp-block cp-defense">
        <div class="cp-defense-names">
          <div class="cp-field"><span class="cp-field-label">Armor Name</span><span class="cp-field-value">{{defense.armorName}}</span></div>
          <div class="cp-field"><span class="cp-field-label">Shield Name</span><span class="cp-field-value">{{defense.shieldName}}</span></div>
        </div>
        <div class="cp-defense-grid">
          <div class="cp-defense-cell"><span class="cp-defense-label">Evade (MR x4)</span><span class="cp-defense-value">{{defense.evadeBase}}</span></div>
          <div class="cp-defense-cell"><span class="cp-defense-label">Total Evade</span><span class="cp-defense-value">{{defense.evadeTotal}}</span></div>
          <div class="cp-defense-cell"><span class="cp-defense-label">Total Initiative</span><span class="cp-defense-value">{{defense.initiative}}</span></div>
          <div class="cp-defense-cell"><span class="cp-defense-label">Armor Value</span><span class="cp-defense-value">{{defense.armorValue}}</span></div>
          <div class="cp-defense-cell"><span class="cp-defense-label">Shield Value</span><span class="cp-defense-value">{{defense.shieldValue}}</span></div>
          <div class="cp-defense-cell"><span class="cp-defense-label">Total Armor</span><span class="cp-defense-value">{{defense.armorTotal}}</span></div>
        </div>
        {{#if defense.armorBreakdown.length}}
        <div class="cp-armor-breakdown">
          <span class="cp-armor-breakdown-title">Armor sources</span>
          <ul class="cp-armor-breakdown-list">
            {{#each defense.armorBreakdown}}
            <li><span class="cp-armor-src">{{label}}{{#if detail}} <em>{{detail}}</em>{{/if}}</span><span class="cp-armor-amt">{{display}}</span></li>
            {{/each}}
            <li class="cp-armor-breakdown-total"><span class="cp-armor-src">Total Armor</span><span class="cp-armor-amt">{{defense.armorTotal}}</span></li>
          </ul>
        </div>
        {{/if}}
        {{#if defense.evadeBreakdown.length}}
        <div class="cp-armor-breakdown cp-evade-breakdown">
          <span class="cp-armor-breakdown-title">Evade sources</span>
          <ul class="cp-armor-breakdown-list">
            {{#each defense.evadeBreakdown}}
            <li><span class="cp-armor-src">{{label}}{{#if detail}} <em>{{detail}}</em>{{/if}}</span><span class="cp-armor-amt">{{display}}</span></li>
            {{/each}}
            <li class="cp-armor-breakdown-total"><span class="cp-armor-src">Total Evade</span><span class="cp-armor-amt">{{defense.evadeTotal}}</span></li>
          </ul>
        </div>
        {{/if}}
      </div>

      <div class="cp-block cp-vitals">
        <div class="cp-health">
          <h3 class="cp-block-title">Health <span class="cp-temphp">Temp HP <span class="cp-temphp-box"></span></span></h3>
          <div class="cp-health-track">
            {{#each healthBars}}
            <div class="cp-health-level">
              <div class="cp-health-level-head">
                <span class="cp-health-level-name">{{name}}</span>
                <span class="cp-health-level-penalty">{{penaltyLabel}}</span>
              </div>
              <div class="cp-health-boxes">
                {{#each boxes}}
                <span class="cp-health-box {{#if filled}}is-filled{{/if}}"></span>
                {{/each}}
              </div>
            </div>
            {{/each}}
          </div>
        </div>
        <div class="cp-stress">
          <h3 class="cp-block-title">Stress</h3>
          {{#if stressBars.length}}
          <div class="cp-health-track">
            {{#each stressBars}}
            <div class="cp-health-level">
              <div class="cp-health-level-head">
                <span class="cp-health-level-name">{{name}}</span>
                <span class="cp-health-level-penalty">{{penaltyLabel}}</span>
              </div>
              <div class="cp-health-boxes">
                {{#each boxes}}
                <span class="cp-health-box {{#if filled}}is-filled{{/if}}"></span>
                {{/each}}
              </div>
            </div>
            {{/each}}
            <div class="cp-health-level">
              <div class="cp-health-level-head">
                <span class="cp-health-level-name">{{stressBreakdown.name}}</span>
              </div>
              <div class="cp-health-boxes">
                {{#each stressBreakdown.boxes}}
                <span class="cp-health-box {{#if filled}}is-filled{{/if}}"></span>
                {{/each}}
              </div>
            </div>
          </div>
          {{else}}
          <div class="cp-stress-scalar">
            <span class="cp-defense-label">Current / Max</span>
            <span class="cp-defense-value">{{stress.current}} / {{stress.maximum}}</span>
          </div>
          {{/if}}
        </div>
      </div>

    </div>
  </div>

  {{#if hasMinorExpressions}}
  <div class="cp-block cp-minor-expressions">
    <h3 class="cp-block-title">Minor Expressions</h3>
    <ul class="cp-minor-list">
      {{#each minorExpressions}}
      <li class="cp-minor-item">
        <span class="cp-minor-name">{{name}} <em class="cp-minor-attr">{{attribute}}</em></span>
        <span class="cp-minor-body">{{body}}</span>
      </li>
      {{/each}}
    </ul>
  </div>
  {{/if}}

  <div class="cp-block cp-disadvantages">
    <h3 class="cp-block-title">Disadvantages <span class="cp-subtle">Points: {{disadvantagePoints}}</span></h3>
    <table class="cp-disadv-table">
      <thead><tr><th>Disadvantage</th><th>Points</th></tr></thead>
      <tbody>
        {{#each disadvantages}}
        <tr><td>{{label}}</td><td>{{points}}</td></tr>
        {{/each}}
      </tbody>
    </table>
    <div class="cp-rerolls">
      <span class="cp-defense-label">Total Rerolls / Used</span>
      <span class="cp-reroll-boxes">
        {{#each rerollBoxes}}<span class="cp-use-box"></span>{{/each}}
        {{#unless rerollBoxes.length}}<span class="cp-reroll-empty">—</span>{{/unless}}
      </span>
    </div>
  </div>

  <div class="cp-block cp-weapons">
    <h3 class="cp-block-title">Weapons</h3>
    <table class="cp-weapons-table">
      <thead><tr><th>Weapon</th><th>Type</th><th>Damage Dice</th><th>Range</th><th>Innate / Specials</th></tr></thead>
      <tbody>
        {{#each artifactWeapons}}
        <tr>
          <td>{{name}}</td>
          <td>{{type}}</td>
          <td>{{damage}}</td>
          <td>{{#if this.range}}{{this.range}}{{else}}—{{/if}}</td>
          <td>{{#if tags}}{{tags}}{{else}}—{{/if}}</td>
        </tr>
        {{/each}}
        {{#unless hasArtifactWeapons}}
        <tr><td colspan="5" class="cp-tech-empty">No weapons.</td></tr>
        {{/unless}}
      </tbody>
    </table>
  </div>

  <div class="cp-page-footer">-- 1 of {{pageTotal}} --</div>
</section>

{{!-- ============================ PAGE 2 ============================ --}}
<section class="print-page print-page-2">

  <div class="cp-block cp-initiative">
    <h3 class="cp-block-title">Initiative <span class="cp-subtle">Roll your Mastery Dice — spend Combat Reflexes to add</span></h3>
    <div class="cp-init-ladder">
      <span class="cp-init-cell">4</span><span class="cp-init-cell">8</span><span class="cp-init-cell">12</span><span class="cp-init-cell">16</span><span class="cp-init-cell">20</span><span class="cp-init-cell">24</span><span class="cp-init-cell">28</span><span class="cp-init-cell">32</span><span class="cp-init-cell">36</span><span class="cp-init-cell">40</span><span class="cp-init-cell">44</span><span class="cp-init-cell">48</span><span class="cp-init-cell">52</span><span class="cp-init-cell">56</span><span class="cp-init-cell">60</span><span class="cp-init-cell">64</span><span class="cp-init-cell">68</span><span class="cp-init-cell">72</span>
    </div>
    <div class="cp-init-actions">
      <span>+2 Move <b>4</b></span><span>Ini Swap <b>8</b></span><span>Extra Reaction <b>12</b></span><span>Remove 2d8 Stress <b>16</b></span><span>Extra Attack <b>20</b></span>
    </div>
  </div>

  {{#each skillsByGroup}}
  {{#unless (eq key "social")}}
  <div class="cp-block cp-skills cp-skills-{{key}}">
    <h3 class="cp-block-title">{{label}}</h3>
    <div class="cp-skill-list">
      {{#each skills}}
      <div class="cp-skill-row">
        <div class="cp-skill-name">{{name}} <span class="cp-skill-attr">({{attrs}})</span></div>
        <div class="cp-skill-uses" title="4 uses per Safe Haven Rest — each use applies MR">
          {{#each uses}}<span class="cp-skill-use">{{this}}</span>{{/each}}
        </div>
      </div>
      {{/each}}
    </div>
  </div>
  {{/unless}}
  {{/each}}

  <div class="cp-block cp-social-combat">
    <h3 class="cp-block-title">Social Combat <span class="cp-subtle">Phase Support Used? <span class="cp-use-box"></span></span></h3>
    <div class="cp-success-counter">
      {{#each (range -4 10)}}<span class="cp-success-cell">{{this}}</span>{{/each}}
      <span class="cp-success-cell">11+</span>
    </div>
  </div>

  {{#if hasEchoCards}}
  <div class="cp-block cp-echo-cards">
    <h3 class="cp-block-title">Echo Cards <span class="cp-subtle">once per Safe Haven Rest <span class="cp-use-box"></span></span></h3>
    <div class="cp-echo-card-grid">
      {{#each echoCards}}
      <div class="cp-echo-card">
        <div class="cp-echo-card-head">
          <span class="cp-echo-card-name">{{name}}</span>
          <span class="cp-echo-card-trigger">{{trigger}}</span>
        </div>
        <ol class="cp-echo-card-options">
          {{#each options}}
          <li><span class="cp-echo-opt-label">{{label}}</span> <em class="cp-echo-opt-skill">{{skill}}</em><span class="cp-echo-opt-desc">{{description}}</span></li>
          {{/each}}
        </ol>
      </div>
      {{/each}}
    </div>
  </div>
  {{/if}}

  {{#each skillsByGroup}}
  {{#if (eq key "social")}}
  <div class="cp-block cp-skills cp-skills-social">
    <h3 class="cp-block-title">Social Skills</h3>
    <div class="cp-skill-list cp-skill-list-2col">
      {{#each skills}}
      <div class="cp-skill-row">
        <div class="cp-skill-name">{{name}} <span class="cp-skill-attr">({{attrs}})</span></div>
        <div class="cp-skill-uses" title="4 uses per Safe Haven Rest — each use applies MR">
          {{#each uses}}<span class="cp-skill-use">{{this}}</span>{{/each}}
        </div>
      </div>
      {{/each}}
    </div>
  </div>
  {{/if}}
  {{/each}}

  <div class="cp-page-footer">-- 2 of {{pageTotal}} --</div>
</section>

{{!-- ===================== PAGE 3 — EQUIPMENT ======================= --}}
<section class="print-page print-page-equipment">

  <div class="cp-block cp-equipment">
    <h3 class="cp-block-title">Equipment</h3>
    <div class="cp-equipped-row">
      {{#each equipment.slots}}
      <div class="cp-equip-slot{{#if this.item}} cp-equip-slot--filled{{/if}}">
        <div class="cp-equip-slot-label">{{this.label}}</div>
        <div class="cp-equip-token">
          {{#if this.item}}
            {{#if this.item.img}}<img class="cp-equip-img" src="{{this.item.img}}" alt="" />{{/if}}
            <span class="cp-equip-name">{{this.item.name}}</span>
          {{/if}}
        </div>
      </div>
      {{/each}}
    </div>
    <div class="cp-encumbrance-head"><span>Not Encumbered</span><span>Encumbered</span><span>Heavily Encumbered</span></div>
    <div class="cp-equip-grid" style="grid-template-columns: repeat({{equipment.cols}}, 1fr);">
      {{#each equipment.cells}}
      <div class="cp-grid-cell{{#if this.occupied}} cp-grid-cell--occupied{{/if}}{{#if this.item}} cp-grid-cell--item{{/if}}" style="grid-column: {{this.col}} / span {{this.spanW}}; grid-row: {{this.row}} / span {{this.spanH}};">
        {{#if this.item}}
        <div class="cp-grid-tile" title="{{this.item.name}}">
          {{#if this.item.img}}<img class="cp-grid-img" src="{{this.item.img}}" alt="" />{{/if}}
          <span class="cp-grid-name">{{this.item.name}}</span>
          {{#if this.item.isGear}}<span class="cp-grid-qty">x{{this.item.qty}}</span>{{/if}}
        </div>
        {{/if}}
      </div>
      {{/each}}
    </div>
  </div>

  <div class="cp-page-footer">-- 3 of {{pageTotal}} --</div>
</section>

{{!-- ===================== PAGE 4 — STONE POWERS ==================== --}}
<section class="print-page print-page-technical">

  <h2 class="cp-section-title">Stone Powers <span class="cp-subtle">available — General + attribute pools</span></h2>

  {{!-- Stone Powers — available pools only (0-stone pools hidden) --}}
  <div class="cp-block cp-tech-stone">
    <h3 class="cp-block-title">Available Stone Powers</h3>
    {{#if technical.hasStonePowers}}
    <div class="cp-stone-groups">
      {{#each technical.stonePowerGroups}}
      <div class="cp-stone-group">
        <div class="cp-stone-group-head">
          <span class="cp-stone-group-name">{{label}}</span>
          {{#unless isGeneral}}<span class="cp-stone-count">{{freeStones}}</span>{{/unless}}
          {{#each boosts}}<span class="cp-stone-boost">{{kind}} +{{value}} <em>{{source}}</em></span>{{/each}}
        </div>
        {{#if isGeneral}}<div class="cp-stone-anypool">Pay from any pool</div>{{/if}}
        <div class="cp-stone-list">
          {{#each powers}}
          <div class="cp-stone-power{{#if supported}} is-supported{{/if}}">
            <div class="cp-stone-power-info">
              <span class="cp-stone-name">{{name}} <span class="cp-stone-cat">({{category}})</span>{{#if supported}} <span class="cp-tech-tier">Support T{{tier}}</span>{{/if}}</span>
              <span class="cp-stone-eff">{{effect}}{{#if supported}} <span class="cp-stone-src">— {{source}}</span>{{/if}}</span>
            </div>
            <div class="cp-stone-tiers">
              {{#each tiers}}
              <span class="cp-tier-group">
                <span class="cp-tier-lbl">{{label}}</span>
                {{#each boxes}}<span class="cp-tier-box{{#if filled}} is-filled{{/if}}"></span>{{/each}}
              </span>
              {{/each}}
            </div>
          </div>
          {{/each}}
        </div>
      </div>
      {{/each}}
    </div>
    {{else}}
    <div class="cp-tech-empty">No stones available — all pools are 0 (attributes below 8 or stones bound into artifacts).</div>
    {{/if}}
  </div>

  <div class="cp-page-footer">-- 4 of {{pageTotal}} --</div>
</section>

{{!-- ============ PAGE 5 — SUMMONS (only if a summon was bought) ===== --}}
{{#if hasFamiliars}}
<section class="print-page print-page-summons">

  <div class="cp-block cp-summons">
    <h3 class="cp-block-title">Summons &amp; Familiars</h3>
    {{#if familiars.length}}
    <ul class="cp-familiar-list">
      {{#each familiars}}<li>{{this}}</li>{{/each}}
    </ul>
    {{else}}
    <div class="cp-familiar-empty">Familiar Name: ____________________</div>
    {{/if}}
    <table class="cp-summon-table">
      <thead><tr><th></th><th>Base</th><th>Tiny</th><th>Small</th><th>Medium</th><th>Large</th></tr></thead>
      <tbody>
        <tr><td>Hit Points</td><td>10</td><td>10</td><td>22-46</td><td>58-82</td><td>94-106</td></tr>
        <tr><td>Armor</td><td>0</td><td>0</td><td>3-9</td><td>12-18</td><td>21-24</td></tr>
        <tr><td>Evade</td><td>4</td><td>4</td><td>8-16</td><td>24-28</td><td>32-36</td></tr>
        <tr><td>Attack</td><td>2</td><td>2</td><td>4-8</td><td>10-14</td><td>16-18</td></tr>
        <tr><td>Damage</td><td>1</td><td>1</td><td>2-4</td><td>5-7</td><td>8-9</td></tr>
        <tr><td>Movement (Walk)</td><td>8</td><td>8</td><td>10-14</td><td>16-20</td><td>22-24</td></tr>
        <tr><td>Movement (Fly)</td><td>4</td><td>4</td><td>5-7</td><td>8-10</td><td>11-12</td></tr>
      </tbody>
    </table>
  </div>

  <div class="cp-page-footer">-- 5 of {{pageTotal}} --</div>
</section>
{{/if}}

{{!-- ================ BATTLE CHEAT (landscape) ===================== --}}
<section class="print-page print-page-battle">

  <h2 class="cp-section-title cp-battle-title">Battle Cheat <span class="cp-subtle">plan your rotation — tick each step as you spend it</span></h2>

  {{!-- One rotation line, vertically centered:
        Movement → [Attack Action: Active | Active Buffs] → Reactions --}}
  <div class="cp-battle-flow">

    <div class="cp-battle-col cp-battle-col-movement">
      <div class="cp-battle-col-title">Movement</div>
      <div class="cp-battle-cards cp-battle-cards-stack">
        {{#each battle.movement}}
        <div class="cp-battle-card{{#if baseline}} is-baseline{{/if}}">
          <span class="cp-use-box"></span>
          <span class="cp-battle-card-body">
            <span class="cp-battle-card-name">{{name}}{{#unless baseline}}{{#if rank}} <span class="cp-battle-card-rank">Stufe {{rank}}</span>{{/if}}{{/unless}}</span>
            {{#if effect}}<span class="cp-battle-card-eff">{{effect}}</span>{{/if}}
          </span>
        </div>
        {{/each}}
      </div>
    </div>

    <div class="cp-battle-arrow">&#10142;</div>

    {{!-- Attack Action: heading spans both Active and Active Buffs columns --}}
    <div class="cp-battle-attack">
      <div class="cp-battle-group-title">Attack Action</div>
      <div class="cp-battle-attack-cols">

        <div class="cp-battle-col cp-battle-col-active">
          <div class="cp-battle-col-title">Active</div>
          {{#if battle.hasActive}}
          <div class="cp-battle-cards cp-battle-cards-active">
            {{#each battle.active}}
            <div class="cp-battle-card">
              <span class="cp-use-box"></span>
              <span class="cp-battle-card-body">
                <span class="cp-battle-card-name">{{name}}{{#unless fromArtifact}}{{#if rank}} <span class="cp-battle-card-rank">Stufe {{rank}}</span>{{/if}}{{/unless}}{{#if fromArtifact}} <span class="cp-power-artifact" title="From artifact: {{source}}">&#9733; {{source}}</span>{{/if}}</span>
                {{#if effect}}<span class="cp-battle-card-eff">{{effect}}</span>{{/if}}
              </span>
            </div>
            {{/each}}
          </div>
          {{else}}
          <div class="cp-battle-empty">No active powers.</div>
          {{/if}}
        </div>

        <div class="cp-battle-col cp-battle-col-buffs">
          <div class="cp-battle-col-title">Active Buffs</div>
          {{#if battle.hasBuffs}}
          <div class="cp-battle-cards cp-battle-cards-stack">
            {{#each battle.activeBuffs}}
            <div class="cp-battle-card cp-battle-card-buff">
              <span class="cp-use-box"></span>
              <span class="cp-battle-card-body">
                <span class="cp-battle-card-name">{{name}}{{#unless fromArtifact}}{{#if rank}} <span class="cp-battle-card-rank">Stufe {{rank}}</span>{{/if}}{{/unless}}{{#if fromArtifact}} <span class="cp-power-artifact" title="From artifact: {{source}}">&#9733; {{source}}</span>{{/if}}</span>
                {{#if effect}}<span class="cp-battle-card-eff">{{effect}}</span>{{/if}}
              </span>
            </div>
            {{/each}}
          </div>
          {{else}}
          <div class="cp-battle-empty">No active buffs.</div>
          {{/if}}
        </div>

      </div>
    </div>

    <div class="cp-battle-arrow">&#10142;</div>

    <div class="cp-battle-col cp-battle-col-reactions">
      <div class="cp-battle-col-title">Reactions</div>
      {{#if battle.hasReactions}}
      <div class="cp-battle-cards cp-battle-cards-stack">
        {{#each battle.reactions}}
        <div class="cp-battle-card cp-battle-card-reaction">
          <span class="cp-use-box"></span>
          <span class="cp-battle-card-body">
            <span class="cp-battle-card-name">{{name}}{{#unless fromArtifact}}{{#if rank}} <span class="cp-battle-card-rank">Stufe {{rank}}</span>{{/if}}{{/unless}}{{#if fromArtifact}} <span class="cp-power-artifact" title="From artifact: {{source}}">&#9733; {{source}}</span>{{/if}}</span>
            {{#if effect}}<span class="cp-battle-card-eff">{{effect}}</span>{{/if}}
          </span>
        </div>
        {{/each}}
      </div>
      {{else}}
      <div class="cp-battle-empty">No reactions.</div>
      {{/if}}
    </div>

  </div>

  {{!-- Passives — own area below the rotation flow, always-on (no tick box) --}}
  <div class="cp-battle-passives">
    <div class="cp-battle-group-title">Passives</div>
    {{#if battle.hasPassives}}
    <div class="cp-battle-passive-cards">
      {{#each battle.passives}}
      <div class="cp-battle-card cp-battle-card-passive">
        <span class="cp-battle-card-body">
          <span class="cp-battle-card-name">{{name}}{{#unless fromArtifact}}{{#if rank}} <span class="cp-battle-card-rank">Stufe {{rank}}</span>{{/if}}{{/unless}}{{#if fromArtifact}} <span class="cp-power-artifact" title="From artifact: {{source}}">&#9733; {{source}}</span>{{/if}}</span>
          {{#if effect}}<span class="cp-battle-card-eff">{{effect}}</span>{{/if}}
        </span>
      </div>
      {{/each}}
    </div>
    {{else}}
    <div class="cp-battle-empty">No passive powers.</div>
    {{/if}}
  </div>

  <div class="cp-page-footer">-- {{pageTotal}} of {{pageTotal}} --</div>
</section>
