{{!-- Destroyed Faith — Table Character Sheet (3 core pages). --}}

{{!-- ============================ PAGE 1 — Portrait ============================ --}}
<section class="print-page print-page-1 print-page-table">

  <header class="cp-table-id">
    {{#if hasPortrait}}
    <img class="cp-table-portrait" src="{{portrait}}" alt="{{name}}" />
    {{/if}}
    <div class="cp-table-id-main">
      <div class="cp-row cp-identity">
        <div class="cp-field cp-name"><span class="cp-field-label">Name</span><span class="cp-field-value">{{name}}</span></div>
        <div class="cp-field cp-player"><span class="cp-field-label">Player</span><span class="cp-field-value">{{player}}</span></div>
      </div>
      <div class="cp-row cp-meta">
        <div class="cp-meta-box"><span class="cp-meta-label">Echo</span><span class="cp-meta-value">{{echo}}</span></div>
        <div class="cp-meta-box"><span class="cp-meta-label">Mastery Rank</span><span class="cp-meta-value">{{masteryRank}}</span></div>
        <div class="cp-meta-box"><span class="cp-meta-label">Faith Fractures</span><span class="cp-meta-value">{{faithFractures.current}} / {{faithFractures.maximum}}</span></div>
      </div>
      <div class="cp-core-combat" aria-label="Core Combat">
        <div class="cp-core-cell">
          <span class="cp-core-label">Attack</span>
          <span class="cp-core-value">{{coreCombat.attack}}</span>
        </div>
        <div class="cp-core-cell">
          <span class="cp-core-label">Damage</span>
          <span class="cp-core-value">{{coreCombat.damage}}</span>
        </div>
        <div class="cp-core-cell">
          <span class="cp-core-label">Evade</span>
          <span class="cp-core-value">{{coreCombat.evade}}</span>
        </div>
        <div class="cp-core-cell">
          <span class="cp-core-label">Armor</span>
          <span class="cp-core-value">{{coreCombat.armor}}</span>
        </div>
        <div class="cp-core-cell">
          <span class="cp-core-label">Movement</span>
          <span class="cp-core-value">{{coreCombat.movement}}</span>
        </div>
      </div>
    </div>
  </header>

  <div class="cp-columns cp-table-main">

    <div class="cp-col cp-col-left">
      <h2 class="cp-section-title">Attributes</h2>
      <div class="cp-abilities">
        {{#each abilities}}
        <div class="cp-ability" data-attr="{{key}}">
          <div class="cp-ability-head">
            <span class="cp-ability-name">{{label}}</span>
            <span class="cp-ability-value-row">
              <span class="cp-ability-value cp-ability-value-full">
                <span class="cp-pool-pct">0%</span> {{value}}
              </span>
              {{#each poolTiers}}
              <span class="cp-ability-value cp-ability-value-wound">
                <span class="cp-pool-pct">{{label}}</span> {{pool}}
              </span>
              {{/each}}
            </span>
          </div>
          <div class="cp-ability-ladder">
            {{#each ladder}}
            <span class="cp-ladder-cell{{#if filled}} is-filled{{/if}}">{{n}}</span>
            {{/each}}
          </div>
        </div>
        {{/each}}
      </div>

      <div class="cp-block cp-learned-skills">
        <h3 class="cp-block-title">Learned Skills</h3>
        {{#if hasLearnedSkills}}
        <ul class="cp-learned-list">
          {{#each learnedSkills}}
          <li>
            <span class="cp-sk-name">{{name}} <em>({{attrs}})</em></span>
            <span class="cp-sk-keep">{{pool}}{{keep}}</span>
            <span class="cp-sk-boxes">
              {{#each boxes}}<i class="cp-sk-box is-{{state}}">{{#if size}}{{size}}{{/if}}</i>{{/each}}
            </span>
          </li>
          {{/each}}
        </ul>
        {{else}}
        <p class="cp-learned-empty">No trained skills yet.</p>
        {{/if}}
        <p class="cp-skill-reminder">Unlearned Skills use half the relevant Attribute.</p>
      </div>
    </div>

    <div class="cp-col cp-col-right">
      <div class="cp-block cp-vitals cp-vitals-large">
        <div class="cp-health">
          <h3 class="cp-block-title">Health <span class="cp-temphp">Temp HP <span class="cp-temphp-box">{{#if tempHP}}{{tempHP}}{{/if}}</span></span></h3>
          <div class="cp-health-track">
            {{#each healthBars}}
            <div class="cp-health-level">
              <div class="cp-health-level-head">
                <span class="cp-health-level-name">{{name}}</span>
                <span class="cp-health-level-penalty">{{penaltyLabel}}</span>
              </div>
              <div class="cp-health-boxes">
                {{#each boxes}}
                <span class="cp-health-box"></span>
                {{/each}}
              </div>
            </div>
            {{/each}}
          </div>
        </div>
        <div class="cp-stress">
          <h3 class="cp-block-title">Stress</h3>
          {{#if stressBars.length}}
          <div class="cp-health-track">
            {{#each stressBars}}
            <div class="cp-health-level">
              <div class="cp-health-level-head">
                <span class="cp-health-level-name">{{name}}</span>
                <span class="cp-health-level-penalty">{{penaltyLabel}}</span>
              </div>
              <div class="cp-health-boxes">
                {{#each boxes}}
                <span class="cp-health-box"></span>
                {{/each}}
              </div>
            </div>
            {{/each}}
            <div class="cp-health-level">
              <div class="cp-health-level-head">
                <span class="cp-health-level-name">{{stressBreakdown.name}}</span>
              </div>
              <div class="cp-health-boxes">
                {{#each stressBreakdown.boxes}}
                <span class="cp-health-box"></span>
                {{/each}}
              </div>
            </div>
          </div>
          {{else}}
          <div class="cp-stress-scalar">
            <span class="cp-defense-label">Current / Max</span>
            <span class="cp-defense-value">{{stress.current}} / {{stress.maximum}}</span>
          </div>
          {{/if}}
        </div>
      </div>

      {{#if hasMinorExpressions}}
      <div class="cp-block cp-minor-expressions">
        <div class="cp-minor-header">
          <h3 class="cp-block-title">Minor Expressions</h3>
          <span class="cp-minor-uses">
            <span class="cp-minor-uses-label">Uses / Rest</span>
            <span class="cp-minor-uses-boxes">
              {{#each minorExpressionUseBoxes}}<span class="cp-use-box"></span>{{/each}}
            </span>
          </span>
        </div>
        <ul class="cp-minor-list">
          {{#each minorExpressions}}
          <li class="cp-minor-item">
            <span class="cp-minor-name">{{name}} <em class="cp-minor-attr">{{attribute}}</em></span>
            <span class="cp-minor-body">{{body}}</span>
          </li>
          {{/each}}
        </ul>
      </div>
      {{/if}}

      <div class="cp-block cp-disadvantages cp-disadvantages-compact">
        <h3 class="cp-block-title">Disadvantages <span class="cp-subtle">{{disadvantagePoints}} pts</span></h3>
        {{#if disadvantages.length}}
        <ul class="cp-disadv-compact-list">
          {{#each disadvantages}}
          <li>
            <strong>{{label}}</strong>{{#if points}} <span class="cp-disadv-pts">{{points}}</span>{{/if}}
            {{#if description}}<span class="cp-disadv-desc">{{description}}</span>{{/if}}
          </li>
          {{/each}}
        </ul>
        {{else}}
        <p class="cp-learned-empty">None.</p>
        {{/if}}
        <div class="cp-rerolls">
          <span class="cp-defense-label">Rerolls</span>
          <span class="cp-reroll-boxes">
            {{#each rerollBoxes}}<span class="cp-use-box"></span>{{/each}}
            {{#unless rerollBoxes.length}}<span class="cp-reroll-empty">—</span>{{/unless}}
          </span>
        </div>
      </div>
    </div>
  </div>

  <div class="cp-page-footer">Character Sheet · 1 of 3</div>
</section>

{{!-- ====================== PAGE 2 — Stone Dashboard (landscape) ====================== --}}
<section class="print-page print-page-stones print-page-table">

  <h2 class="cp-section-title cp-stones-title">Stones <span class="cp-subtle">move cubes — do not track stones on paper</span></h2>

  <div class="cp-stone-zones" aria-label="Stone cube zones">
    <div class="cp-stone-zone cp-stone-zone-ready">
      <div class="cp-stone-zone-head">Available / Ready</div>
      <div class="cp-stone-zone-drop"></div>
    </div>
    <div class="cp-stone-zone cp-stone-zone-exhausted">
      <div class="cp-stone-zone-head">Exhausted / Regenerating</div>
      <div class="cp-stone-zone-drop"></div>
      <p class="cp-stone-zone-note">End of round: regenerate {{stoneDashboard.regeneration}} (MR).</p>
    </div>
    <div class="cp-stone-zone cp-stone-zone-burned">
      <div class="cp-stone-zone-head">Burned</div>
      <div class="cp-stone-zone-drop"></div>
      <p class="cp-stone-zone-note">{{stoneDashboard.burnedHint}}</p>
    </div>
    <div class="cp-stone-zone cp-stone-zone-sealed">
      <div class="cp-stone-zone-head">Sealed</div>
      <div class="cp-stone-zone-drop"></div>
      <p class="cp-stone-zone-note">{{stoneDashboard.sealedHint}}</p>
    </div>
    <div class="cp-stone-zone cp-stone-zone-colorless">
      <div class="cp-stone-zone-head">Colorless</div>
      <div class="cp-stone-zone-drop"></div>
      <p class="cp-stone-zone-note">Temporary. Spend → gone. Vanish at end of combat.</p>
    </div>
  </div>

  <div class="cp-stone-dash-lower">
    <div class="cp-block cp-attr-pools">
      <h3 class="cp-block-title">Attribute Stone Pools</h3>
      <div class="cp-attr-pool-grid">
        {{#each stoneDashboard.pools}}
        <div class="cp-attr-pool" data-attr="{{key}}">
          <span class="cp-attr-pool-name">{{label}}</span>
          <span class="cp-attr-pool-val">{{value}}</span>
          <span class="cp-attr-pool-cap">Pool {{max}}</span>
          <span class="cp-attr-pool-gen">Gen {{generation}}</span>
        </div>
        {{/each}}
      </div>
      <p class="cp-stone-limits">Stone limit per Attribute = floor(Attribute ÷ 8). Bound Stones are invested off-sheet and do not sit in these zones.</p>
    </div>

    <div class="cp-block cp-stone-rules">
      <h3 class="cp-block-title">Generation · Regeneration · Limits</h3>
      <ul class="cp-stone-rule-list">
        <li><strong>Generation:</strong> Pool capacity = Attribute ÷ 8 (floor).</li>
        <li><strong>Regeneration:</strong> {{stoneDashboard.regeneration}} Exhausted → Ready at end of each round (any pools).</li>
        <li><strong>Burned:</strong> {{stoneDashboard.burnedHint}}</li>
        <li><strong>Sealed:</strong> {{stoneDashboard.sealedHint}}</li>
        <li><strong>Colorless:</strong> Pay any pool; disappear when spent or at combat end.</li>
      </ul>
    </div>

    <div class="cp-block cp-ini-panel">
      <h3 class="cp-block-title">Initiative</h3>
      <div class="cp-ini-roll">
        <span class="cp-ini-roll-label">Roll</span>
        <span class="cp-ini-roll-value">{{stoneDashboard.initiative}}</span>
      </div>
      <div class="cp-ini-exchange">
        <h4 class="cp-ini-exchange-title">Initiative Exchange</h4>
        <p class="cp-ini-exchange-rate">{{stoneDashboard.iniStoneCost}} Initiative = 1 Colorless Stone (4 × MR {{masteryRank}})</p>
        <div class="cp-ini-exchange-row">
          <div class="cp-ini-exchange-field">
            <span class="cp-ini-exchange-label">Initiative left</span>
            <span class="cp-ini-writein"></span>
          </div>
          <div class="cp-ini-exchange-field cp-ini-exchange-field--stones">
            <span class="cp-ini-exchange-label">Convert → Colorless</span>
            <span class="cp-ini-exchange-boxes">
              {{#each stoneDashboard.colorlessBoxes}}<span class="cp-use-box"></span>{{/each}}
            </span>
          </div>
        </div>
        <p class="cp-ini-exchange-hint">Place converted Colorless cubes in the Colorless zone above.</p>
      </div>
    </div>
  </div>

  <div class="cp-page-footer">Stone Dashboard · 2 of 3</div>
</section>

{{!-- ====================== PAGE 3 — Powers & Combat (landscape) ====================== --}}
<section class="print-page print-page-battle print-page-table">

  <h2 class="cp-section-title cp-battle-title">Powers &amp; Combat <span class="cp-subtle">tick each step as you spend it</span></h2>

  <div class="cp-battle-flow">

    <div class="cp-battle-col cp-battle-col-movement">
      <div class="cp-battle-col-spacer" aria-hidden="true"></div>
      <div class="cp-battle-col-title">Movement</div>
      <div class="cp-battle-cards cp-battle-cards-stack">
        {{#each battle.movement}}
        <div class="cp-battle-card{{#if baseline}} is-baseline{{/if}}">
          <span class="cp-use-box"></span>
          <span class="cp-battle-card-body">
            <span class="cp-battle-card-name">{{name}}{{#unless baseline}}{{#if rank}} <span class="cp-battle-card-rank">Stufe {{rank}}</span>{{/if}}{{/unless}}</span>
            {{#if effect}}<span class="cp-battle-card-eff">{{effect}}</span>{{/if}}
          </span>
        </div>
        {{/each}}
      </div>
    </div>

    <div class="cp-battle-arrow">&#8596;</div>

    <div class="cp-battle-attack">
      <div class="cp-battle-group-title">Active / Attack Actions</div>
      <div class="cp-battle-attack-cols">

        <div class="cp-battle-col cp-battle-col-active">
          <div class="cp-battle-col-title">Active</div>
          {{#if battle.hasActive}}
          <div class="cp-battle-cards cp-battle-cards-active">
            {{#each battle.active}}
            <div class="cp-battle-card{{#if baseline}} is-baseline{{/if}}">
              <span class="cp-use-box"></span>
              <span class="cp-battle-card-body">
                <span class="cp-battle-card-name">{{name}}{{#unless fromArtifact}}{{#unless hideRank}}{{#if rank}} <span class="cp-battle-card-rank">Stufe {{rank}}</span>{{/if}}{{/unless}}{{/unless}}{{#if isSpell}} <span class="cp-power-spell" title="{{spellLabel}}">Spell</span>{{/if}}{{#if fromArtifact}} <span class="cp-power-artifact" title="From artifact: {{source}}">&#9733; {{source}}</span>{{/if}}{{#if baseline}} <span class="cp-power-baseline" title="Standardmanöver">Basis</span>{{/if}}</span>
                {{#if attackKind}}<span class="cp-battle-card-kind">{{attackKind}}</span>{{/if}}
                {{#unless battleCompact}}{{#if effect}}<span class="cp-battle-card-eff">{{effect}}</span>{{/if}}{{/unless}}
                {{#if attackRoll}}<span class="cp-battle-card-roll"><strong>Attack:</strong> {{attackRoll}}</span>{{/if}}
                {{#if damageRoll}}{{#if (eq rollKind "heal")}}<span class="cp-battle-card-roll"><strong>Heal:</strong> {{damageRoll}}</span>{{else}}<span class="cp-battle-card-roll"><strong>{{#if rollLabel}}{{rollLabel}}{{else}}Damage{{/if}}:</strong> {{damageRoll}}</span>{{/if}}{{/if}}
                {{#if fromConsumable}}<span class="cp-power-consumable" title="{{localize "MASTERY.consumable.badge"}}">{{localize "MASTERY.consumable.badge"}}</span>{{/if}}
                {{#if battleFootnote}}<span class="cp-battle-card-footnote">{{battleFootnote}}</span>{{/if}}
              </span>
            </div>
            {{/each}}
          </div>
          {{else}}
          <div class="cp-battle-empty">No active powers.</div>
          {{/if}}
        </div>

        <div class="cp-battle-col cp-battle-col-buffs">
          <div class="cp-battle-col-title">Active Buffs</div>
          <div class="cp-active-marker" aria-label="Active buff marker">
            <span class="cp-active-marker-label">ACTIVE</span>
            <span class="cp-active-marker-slot"></span>
          </div>
          {{#if battle.hasBuffs}}
          <div class="cp-battle-cards cp-battle-cards-stack">
            {{#each battle.activeBuffs}}
            <div class="cp-battle-card cp-battle-card-buff">
              <span class="cp-use-box"></span>
              <span class="cp-battle-card-body">
                <span class="cp-battle-card-name">{{name}}{{#unless fromArtifact}}{{#unless hideRank}}{{#if rank}} <span class="cp-battle-card-rank">Stufe {{rank}}</span>{{/if}}{{/unless}}{{/unless}}{{#if isSpell}} <span class="cp-power-spell" title="{{spellLabel}}">Spell</span>{{/if}}{{#if fromArtifact}} <span class="cp-power-artifact" title="From artifact: {{source}}">&#9733; {{source}}</span>{{/if}}</span>
                {{#if effect}}<span class="cp-battle-card-eff"><strong>Effect:</strong> {{effect}}</span>{{/if}}
                {{#if attackRoll}}<span class="cp-battle-card-roll"><strong>Attack:</strong> {{attackRoll}}</span>{{/if}}
                {{#if damageRoll}}<span class="cp-battle-card-roll"><strong>Damage:</strong> {{damageRoll}}</span>{{/if}}
              </span>
            </div>
            {{/each}}
          </div>
          {{else}}
          <div class="cp-battle-empty">No active buffs.</div>
          {{/if}}
        </div>

      </div>
    </div>

    <div class="cp-battle-arrow">&#8596;</div>

    <div class="cp-battle-col cp-battle-col-reactions">
      <div class="cp-battle-col-spacer" aria-hidden="true"></div>
      <div class="cp-battle-col-title">Reactions</div>
      {{#if battle.hasReactions}}
      <div class="cp-battle-cards cp-battle-cards-stack">
        {{#each battle.reactions}}
        <div class="cp-battle-card cp-battle-card-reaction{{#if baseline}} is-baseline{{/if}}">
          <span class="cp-use-box"></span>
          <span class="cp-battle-card-body">
            <span class="cp-battle-card-name">{{name}}{{#unless fromArtifact}}{{#unless hideRank}}{{#if rank}} <span class="cp-battle-card-rank">Stufe {{rank}}</span>{{/if}}{{/unless}}{{/unless}}{{#if isSpell}} <span class="cp-power-spell" title="{{spellLabel}}">Spell</span>{{/if}}{{#if fromArtifact}} <span class="cp-power-artifact" title="From artifact: {{source}}">&#9733; {{source}}</span>{{/if}}{{#if baseline}} <span class="cp-power-baseline" title="Standardmanöver">Basis</span>{{/if}}</span>
            {{#if attackKind}}<span class="cp-battle-card-kind">{{attackKind}}</span>{{/if}}
            {{#unless battleCompact}}{{#if effect}}<span class="cp-battle-card-eff">{{effect}}</span>{{/if}}{{/unless}}
            {{#if attackRoll}}<span class="cp-battle-card-roll"><strong>Attack:</strong> {{attackRoll}}</span>{{/if}}
            {{#if damageRoll}}{{#if (eq rollKind "heal")}}<span class="cp-battle-card-roll"><strong>Heal:</strong> {{damageRoll}}</span>{{else}}<span class="cp-battle-card-roll"><strong>{{#if rollLabel}}{{rollLabel}}{{else}}Damage{{/if}}:</strong> {{damageRoll}}</span>{{/if}}{{/if}}
            {{#if battleFootnote}}<span class="cp-battle-card-footnote">{{battleFootnote}}</span>{{/if}}
          </span>
        </div>
        {{/each}}
      </div>
      {{else}}
      <div class="cp-battle-empty">No reactions.</div>
      {{/if}}
    </div>

  </div>

  <div class="cp-battle-secondary">
    <section class="cp-status-tray cp-specials-tray" aria-label="Specials affecting you">
      <div class="cp-status-tray-head">Specials Affecting You</div>
      <div class="cp-status-tray-drop">
        <p class="cp-status-tray-hint">Place Special tokens here (e.g. Ruin ×3 → three Ruin tokens). No extra numbers needed.</p>
      </div>
      <p class="cp-special-recovery"><strong>Natural Special Recovery:</strong> {{specialRecovery}}</p>
    </section>

    <div class="cp-battle-reminders">
      <div class="cp-battle-group-title">Combat Reminders</div>
      <ul class="cp-reminder-list">
        <li>Start of turn: Tick → Natural Special Recovery {{specialRecovery}} → Decay 1.</li>
        <li>Same Special this Round: max {{specialCap}} (4 × MR).</li>
        {{#if combatSensesDisplay.primary}}
        <li>{{combatSensesDisplay.primary.label}}: {{combatSensesDisplay.primary.rangeM}} m — {{combatSensesDisplay.primary.summary}}</li>
        {{/if}}
        {{#if combatSensesDisplay.darkvision}}
        <li>{{combatSensesDisplay.darkvision.label}}: {{combatSensesDisplay.darkvision.rangeM}} m</li>
        {{/if}}
      </ul>
    </div>

    <div class="cp-battle-passives">
      <div class="cp-battle-group-title">Passives</div>
      {{#if battle.hasPassives}}
      <div class="cp-battle-passive-cards">
        {{#each battle.passives}}
        <div class="cp-battle-card cp-battle-card-passive">
          <span class="cp-battle-card-body">
            <span class="cp-battle-card-name">{{name}}{{#unless fromArtifact}}{{#unless hideRank}}{{#if rank}} <span class="cp-battle-card-rank">Stufe {{rank}}</span>{{/if}}{{/unless}}{{/unless}}{{#if isSpell}} <span class="cp-power-spell" title="{{spellLabel}}">Spell</span>{{/if}}{{#if fromArtifact}} <span class="cp-power-artifact" title="From artifact: {{source}}">&#9733; {{source}}</span>{{/if}}</span>
            {{#if effect}}<span class="cp-battle-card-eff">{{effect}}</span>{{/if}}
          </span>
        </div>
        {{/each}}
      </div>
      {{else}}
      <div class="cp-battle-empty">No passive powers.</div>
      {{/if}}
    </div>
  </div>

  <div class="cp-page-footer">Powers &amp; Combat · 3 of 3</div>
</section>

{{!-- Optional modules (Equipment / Summons) — not part of the three core pages --}}
{{#if includeModules}}
<section class="print-page print-page-equipment">
  <div class="cp-block cp-equipment">
    <h3 class="cp-block-title">Equipment &amp; Artifacts <span class="cp-subtle">optional module</span></h3>
    <div class="cp-equipped-row">
      {{#each equipment.slots}}
      <div class="cp-equip-slot{{#if this.item}} cp-equip-slot--filled{{/if}}">
        <div class="cp-equip-slot-label">{{this.label}}</div>
        <div class="cp-equip-token">
          {{#if this.item}}
            {{#if this.item.img}}<img class="cp-equip-img" src="{{this.item.img}}" alt="" />{{/if}}
            <span class="cp-equip-name">{{this.item.name}}</span>
            {{#if this.item.ammoLabel}}<span class="cp-equip-ammo">{{this.item.ammoLabel}}</span>{{/if}}
          {{/if}}
        </div>
      </div>
      {{/each}}
    </div>
    {{#if consumableSlots.length}}
    <div class="cp-consumable-head">{{localize "MASTERY.consumable.title"}}</div>
    <div class="cp-consumable-row">
      {{#each consumableSlots}}
      <div class="cp-equip-slot{{#unless this.empty}} cp-equip-slot--filled{{/unless}}">
        <div class="cp-equip-slot-label">{{this.label}}</div>
        <div class="cp-equip-token">
          {{#unless this.empty}}
            {{#if this.img}}<img class="cp-equip-img" src="{{this.img}}" alt="" />{{/if}}
            <span class="cp-equip-name">{{this.name}}</span>
            {{#if this.powerName}}<span class="cp-consumable-power">{{localize "MASTERY.consumable.powerLabel"}}: {{this.powerName}}</span>{{/if}}
            {{#if this.summary}}<span class="cp-consumable-summary">{{this.summary}}</span>{{/if}}
          {{else}}
            <span class="cp-equip-name">{{localize "MASTERY.consumable.empty"}}</span>
          {{/unless}}
        </div>
      </div>
      {{/each}}
    </div>
    {{/if}}
    <div class="cp-equip-grid" style="grid-template-columns: repeat({{equipment.cols}}, 1fr);">
      {{#each equipment.cells}}
      <div class="cp-grid-cell{{#if this.occupied}} cp-grid-cell--occupied{{/if}}{{#if this.item}} cp-grid-cell--item{{/if}}" style="grid-column: {{this.col}} / span {{this.spanW}}; grid-row: {{this.row}} / span {{this.spanH}};">
        {{#if this.item}}
        <div class="cp-grid-tile" title="{{this.item.name}}">
          {{#if this.item.img}}<img class="cp-grid-img" src="{{this.item.img}}" alt="" />{{/if}}
          <span class="cp-grid-name">{{this.item.name}}</span>
          {{#if this.item.ammoLabel}}<span class="cp-grid-qty">{{this.item.ammoLabel}}</span>{{else if this.item.isAmmo}}<span class="cp-grid-qty">x{{this.item.qty}}</span>{{else if this.item.isGear}}<span class="cp-grid-qty">x{{this.item.qty}}</span>{{/if}}
        </div>
        {{/if}}
      </div>
      {{/each}}
    </div>
  </div>
  <div class="cp-block cp-weapons">
    <h3 class="cp-block-title">Weapons</h3>
    <table class="cp-weapons-table">
      <thead><tr><th>Weapon</th><th>Type</th><th>Damage Dice</th><th>Range</th><th>Innate / Special Effects</th></tr></thead>
      <tbody>
        {{#each artifactWeapons}}
        <tr>
          <td>{{name}}</td>
          <td>{{type}}</td>
          <td>{{damage}}</td>
          <td>{{#if this.range}}{{this.range}}{{else}}—{{/if}}</td>
          <td>{{#if tags}}{{tags}}{{else}}—{{/if}}</td>
        </tr>
        {{/each}}
        {{#unless hasArtifactWeapons}}
        <tr><td colspan="5" class="cp-tech-empty">No weapons.</td></tr>
        {{/unless}}
      </tbody>
    </table>
  </div>
  <div class="cp-page-footer">Equipment Module</div>
</section>

{{#if hasFamiliars}}
<section class="print-page print-page-summons">
  <div class="cp-block cp-summons">
    <h3 class="cp-block-title">Summons &amp; Familiars <span class="cp-subtle">optional module</span></h3>
    <ul class="cp-familiar-list">
      {{#each familiars}}<li>{{this}}</li>{{/each}}
    </ul>
  </div>
  <div class="cp-page-footer">Summons Module</div>
</section>
{{/if}}
{{/if}}
