<div class="tower-wizard-dialog">
  <header class="tower-wizard-header">
    <p class="tower-wizard-progress">{{progressLabel}}</p>
  </header>

  <div class="tower-wizard-body">
    {{#if isDefense}}
    <section class="tower-wizard-step">
      <h3>{{copy.defense.question}}</h3>
      <div class="tower-wizard-cards">
        {{#each defensePackages}}
        <button type="button" class="tower-wizard-card js-tw-select-defense{{#if (eq ../selection.defenseId this.id)}} is-selected{{/if}}" data-defense-id="{{this.id}}">
          <strong>{{this.label}}</strong>
          <p class="tower-wizard-card-text">{{this.explanation}}</p>
          {{#if this.warning}}<p class="tower-wizard-warn">{{this.warning}}</p>{{/if}}
        </button>
        {{/each}}
      </div>
    </section>
    {{/if}}

    {{#if isPassive2}}
    <section class="tower-wizard-step">
      <h3>{{copy.passive2.heading}}</h3>
      <p class="tower-wizard-prose">{{copy.passive2.body}}</p>
      {{#if recommendedPassives.length}}
      <h4>{{copy.passive2.recommended}}</h4>
      <div class="tower-wizard-passive-grid">
        {{#each recommendedPassives}}
        <button type="button" class="tower-wizard-passive-card js-tw-select-passive2{{#if (eq ../selection.secondPassiveTemplateId this.id)}} is-selected{{/if}}" data-passive-id="{{this.id}}">
          <span class="chip-label">{{this.label}}</span>
          <span class="chip-mechanical">{{this.mechanical}}</span>
        </button>
        {{/each}}
      </div>
      {{/if}}
      <h4>{{copy.passive2.allOptions}}</h4>
      <div class="tower-wizard-passive-grid">
        {{#each allPassives}}
        <button type="button" class="tower-wizard-passive-card js-tw-select-passive2{{#if (eq ../selection.secondPassiveTemplateId this.id)}} is-selected{{/if}}" data-passive-id="{{this.id}}">
          <span class="chip-label">{{this.label}}</span>
          <span class="chip-mechanical">{{this.mechanical}}</span>
        </button>
        {{/each}}
      </div>
    </section>
    {{/if}}

    {{#if isOffense}}
    <section class="tower-wizard-step">
      <h3>{{copy.offense.question}}</h3>
      <div class="tower-wizard-cards">
        {{#each offensePackages}}
        <button type="button" class="tower-wizard-card js-tw-select-offense{{#if (eq ../selection.offenseId this.id)}} is-selected{{/if}}{{#if this.recommended}} is-recommended{{/if}}{{#if this.thematic}} is-thematic{{/if}}" data-offense-id="{{this.id}}">
          <div class="tower-wizard-card-badges">
            {{#if this.recommended}}<span class="tower-wizard-badge">{{../copy.offense.recommended}}</span>{{/if}}
            {{#if this.thematic}}<span class="tower-wizard-badge is-thematic">{{../copy.offense.thematicMatch}}</span>{{/if}}
          </div>
          <strong>{{this.label}}</strong>
          <p class="tower-wizard-card-text">{{this.explanation}}</p>
          {{#if this.warning}}<p class="tower-wizard-warn">{{this.warning}}</p>{{/if}}
        </button>
        {{/each}}
      </div>
    </section>
    {{/if}}

    {{#if isWeakenSave}}
    <section class="tower-wizard-step">
      <h3>{{copy.weakenSave.question}}</h3>
      <div class="tower-wizard-choice-row">
        <button type="button" class="tower-wizard-choice js-tw-weaken-save{{#if (eq selection.weakenSave 'body')}} is-selected{{/if}}" data-save="body">{{copy.weakenSave.options.body}}</button>
        <button type="button" class="tower-wizard-choice js-tw-weaken-save{{#if (eq selection.weakenSave 'mind')}} is-selected{{/if}}" data-save="mind">{{copy.weakenSave.options.mind}}</button>
        <button type="button" class="tower-wizard-choice js-tw-weaken-save{{#if (eq selection.weakenSave 'spirit')}} is-selected{{/if}}" data-save="spirit">{{copy.weakenSave.options.spirit}}</button>
        <button type="button" class="tower-wizard-choice js-tw-weaken-save{{#unless selection.weakenSave}} is-selected{{/unless}}" data-save="">{{copy.weakenSave.options.unsure}}</button>
      </div>
    </section>
    {{/if}}

    {{#if isDelivery}}
    <section class="tower-wizard-step">
      <h3>{{copy.delivery.question}}</h3>
      <div class="tower-wizard-choice-row">
        <button type="button" class="tower-wizard-choice js-tw-delivery{{#if (eq selection.delivery 'melee')}} is-selected{{/if}}" data-delivery="melee">{{copy.delivery.melee}}</button>
        <button type="button" class="tower-wizard-choice js-tw-delivery{{#if (eq selection.delivery 'ranged')}} is-selected{{/if}}" data-delivery="ranged">{{copy.delivery.ranged}}</button>
      </div>
    </section>
    {{/if}}

    {{#if isReview}}
    <section class="tower-wizard-step tower-wizard-review">
      <h3>{{copy.review.heading}}</h3>

      {{#if warnings.length}}
      <ul class="tower-wizard-warnings">
        {{#each warnings}}
        <li>{{this}}</li>
        {{/each}}
      </ul>
      {{/if}}

      <h4>{{copy.review.defense}}</h4>
      <ul class="tower-wizard-summary-list">
        {{#each defenseSummaryRows}}
        <li><strong>{{this.role}}:</strong> {{this.label}} <span class="mechanical">({{this.mechanical}} · Rank {{this.rank}})</span></li>
        {{/each}}
      </ul>

      <h4>{{copy.review.offense}}</h4>
      <ul class="tower-wizard-summary-list">
        {{#each review.offenseRows}}
        <li><strong>{{this.role}}:</strong> {{this.displayName}} <span class="mechanical">({{this.mechanicalName}} · Rank {{this.rank}})</span></li>
        {{/each}}
      </ul>

      <h4>{{copy.review.configureActives}}</h4>
      {{#each reviewOffenseConfig}}
      <div class="tower-wizard-active-config" data-grant-key="{{this.grantKey}}">
        <div class="tower-wizard-active-config-header">
          <strong>{{this.role}}:</strong> {{this.displayName}}
        </div>
        {{#if this.variantOptions.length}}
        <label class="tower-wizard-field">
          <span>{{../copy.review.variant}}</span>
          <select class="js-tw-variant" data-grant-key="{{this.grantKey}}">
            {{#each this.variantOptions}}
            <option value="{{this.id}}" {{#if (eq this.id ../override.variant)}}selected{{/if}}>{{this.label}}</option>
            {{/each}}
          </select>
        </label>
        {{/if}}
        <label class="tower-wizard-field tower-wizard-checkbox">
          <input type="checkbox" class="js-tw-is-spell" data-grant-key="{{this.grantKey}}" {{#if this.override.isSpell}}checked{{/if}} />
          <span>{{../copy.review.castAsSpell}}</span>
        </label>
        <label class="tower-wizard-field js-tw-spell-fields" data-grant-key="{{this.grantKey}}" {{#unless this.override.isSpell}}style="display:none"{{/unless}}>
          <span>{{../copy.review.castingAttribute}}</span>
          <select class="js-tw-casting-attr" data-grant-key="{{this.grantKey}}">
            <option value="intellect" {{#if (eq this.override.castingAttribute 'intellect')}}selected{{/if}}>Intellect</option>
            <option value="resolve" {{#if (eq this.override.castingAttribute 'resolve')}}selected{{/if}}>Resolve</option>
          </select>
        </label>
        <label class="tower-wizard-field js-tw-spell-fields" data-grant-key="{{this.grantKey}}" {{#unless this.override.isSpell}}style="display:none"{{/unless}}>
          <span>{{../copy.review.resolution}}</span>
          <select class="js-tw-spell-resolution" data-grant-key="{{this.grantKey}}">
            <option value="spellAttack" {{#if (eq this.override.spellResolution 'spellAttack')}}selected{{/if}}>Spell Attack</option>
            <option value="saveSpell" {{#if (eq this.override.spellResolution 'saveSpell')}}selected{{/if}}>Save Spell</option>
          </select>
        </label>
      </div>
      {{/each}}

      {{#unless review.allOk}}
      <p class="tower-wizard-warn">Some catalog entries are missing — cannot apply yet.</p>
      {{/unless}}
    </section>
    {{/if}}
  </div>

  <footer class="tower-wizard-footer">
    {{#if showBack}}<button type="button" class="tower-wizard-btn js-tw-back">{{copy.buttons.back}}</button>{{/if}}
    {{#if showNext}}<button type="button" class="tower-wizard-btn is-primary js-tw-next" {{#unless canAdvance}}disabled{{/unless}}>{{copy.buttons.next}}</button>{{/if}}
    {{#if isReview}}
    <button type="button" class="tower-wizard-btn js-tw-restart">{{copy.review.back}}</button>
    <button type="button" class="tower-wizard-btn is-primary js-tw-apply" {{#unless review.allOk}}disabled{{/unless}}>{{copy.review.apply}}</button>
    {{/if}}
  </footer>
</div>
