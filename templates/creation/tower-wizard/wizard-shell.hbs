<div class="tower-wizard-dialog">
  <header class="tower-wizard-header">
    <p class="tower-wizard-progress">{{progressLabel}}</p>
  </header>

  <div class="tower-wizard-body">
    {{#unless echoContext.hasEcho}}
    <div class="tower-wizard-echo-banner tower-wizard-warn">
      <strong>Echo required.</strong> {{copy.echo.missingBanner}}
    </div>
    {{/unless}}
    {{#if echoAdvisorSummary}}
    <div class="tower-wizard-echo-summary">
      <h4>{{copy.echo.summaryHeading}}</h4>
      <p class="tower-wizard-prose">{{echoAdvisorSummary}}</p>
      {{#if echoContext.artifactActiveBuffs.length}}
      <p class="tower-wizard-prose tower-wizard-echo-artifact-note">{{copy.echo.artifactBuffNote}}</p>
      {{/if}}
    </div>
    {{/if}}

    {{#if isDefense}}
    <section class="tower-wizard-step">
      <h3>{{copy.defense.question}}</h3>
      <div class="tower-wizard-cards">
        {{#each defensePackagesWithEcho}}
        <button type="button" class="tower-wizard-card tower-wizard-defense-card js-tw-select-defense{{#if (eq ../selection.defenseId this.id)}} is-selected{{/if}}{{#if this.echoConflict}} has-echo-conflict{{/if}}{{#if this.echoRecommended}} is-echo-recommended{{/if}}" data-defense-id="{{this.id}}">
          <span class="tower-wizard-defense-copy">
            <span class="tower-wizard-card-title">{{this.label}}</span>
            <span class="tower-wizard-card-text">{{this.explanation}}</span>
          </span>
          <span class="tower-wizard-defense-name">{{this.mechanicLabel}}</span>
          {{#if this.echoRecommended}}<span class="tower-wizard-chip">{{../copy.echo.defenseRecommended}}</span>{{/if}}
          {{#if this.echoConflict}}<span class="tower-wizard-warn">{{../copy.echo.defenseConflict}}: {{this.echoConflict.artifactName}} ({{this.echoConflict.displayName}})</span>{{/if}}
          {{#if this.warning}}<span class="tower-wizard-warn">{{this.warning}}</span>{{/if}}
        </button>
        {{/each}}
      </div>
    </section>
    {{/if}}

    {{#if isDefensePassiveVariant}}
    <section class="tower-wizard-step">
      <h3>{{copy.defensePassiveVariant.heading}}</h3>
      <p class="tower-wizard-prose">{{copy.defensePassiveVariant.body}}</p>
      {{#if defensePackagePreview}}
      <div class="tower-wizard-package-preview">
        <h4>{{copy.defensePassiveVariant.previewHeading}}</h4>
        <ul class="tower-wizard-package-preview-list">
          {{#each defensePackagePreview.rows}}
          <li class="tower-wizard-package-preview-row">
            <span class="tower-wizard-package-preview-key">{{this.label}}</span>
            <span class="tower-wizard-package-preview-value">{{this.value}}</span>
          </li>
          {{/each}}
        </ul>
      </div>
      {{/if}}
      <div class="tower-wizard-cards tower-wizard-passive1-variant-cards">
        {{#each passive1Variants}}
        <button type="button" class="tower-wizard-card js-tw-select-passive1-variant{{#if (eq ../../selection.passive1TemplateId this.templateId)}} is-selected{{/if}}{{#if this.isLocked}} is-locked{{/if}}" data-passive-id="{{this.templateId}}">
          <div class="tower-wizard-card-head">
            <span class="tower-wizard-card-title">{{this.label}}</span>
            {{#if this.isRecommended}}
            <span class="tower-wizard-chip">{{#if this.isLocked}}{{../../copy.defensePassiveVariant.locked}}{{else}}{{../../copy.defensePassiveVariant.recommended}}{{/if}}</span>
            {{/if}}
          </div>
          <span class="tower-wizard-card-text">{{this.description}}</span>
          <span class="tower-wizard-card-meta">{{this.mechanicsPreview}}</span>
        </button>
        {{/each}}
      </div>
    </section>
    {{/if}}

    {{#if isPassive2}}
    <section class="tower-wizard-step">
      <h3>{{copy.passive2.heading}}</h3>
      <p class="tower-wizard-prose">{{passive2Subtitle}}</p>
      {{#if secondPassivePreviewRows.length}}
      <div class="tower-wizard-package-preview">
        <h4>{{copy.passive2.alreadySelected}}</h4>
        <ul class="tower-wizard-package-preview-list">
          {{#each secondPassivePreviewRows}}
          <li class="tower-wizard-package-preview-row">
            <span class="tower-wizard-package-preview-key">{{this.label}}</span>
            <span class="tower-wizard-package-preview-value">{{this.value}}</span>
          </li>
          {{/each}}
        </ul>
      </div>
      {{/if}}
      <h4>{{copy.passive2.nowChoose}}</h4>
      {{#each secondPassiveIntentGroups}}
      <div class="tower-wizard-passive-intent-group">
        <h4>{{this.intentLabel}}</h4>
        {{#if this.intentHint}}<p class="tower-wizard-prose tower-wizard-intent-hint">{{this.intentHint}}</p>{{/if}}
        {{#if this.warning}}<p class="tower-wizard-warn">{{this.warning}}</p>{{/if}}
        <div class="tower-wizard-passive-grid">
          {{#each this.passives}}
          <button type="button" class="tower-wizard-passive-card js-tw-select-passive2{{#if (eq ../../../selection.secondPassiveTemplateId this.id)}} is-selected{{/if}}" data-passive-id="{{this.id}}">
            <span class="chip-label">{{this.label}}</span>
            <span class="chip-mechanical">{{this.hint}}</span>
            {{#if this.mechanicsPreview}}<span class="tower-wizard-card-meta">{{this.mechanicsPreview}}</span>{{/if}}
          </button>
          {{/each}}
        </div>
      </div>
      {{/each}}
    </section>
    {{/if}}

    {{#if isActiveBuffChoice}}
    <section class="tower-wizard-step">
      <h3>{{copy.activeBuffChoice.heading}}</h3>
      <p class="tower-wizard-prose">{{copy.activeBuffChoice.body}}</p>
      {{#if echoContext.artifactActiveBuffs.length}}
      <ul class="tower-wizard-warnings">
        {{#each echoContext.artifactActiveBuffs}}
        <li>{{this.artifactName}} already grants <strong>{{this.displayName}}</strong> — only one maintained Active Buff at a time.</li>
        {{/each}}
      </ul>
      {{/if}}
      {{#if defaultActiveBuffPreview}}
      <div class="tower-wizard-buff-preview">
        <h4>{{copy.activeBuffChoice.defaultHeading}}</h4>
        <p class="tower-wizard-buff-preview-name">{{defaultActiveBuffPreview.name}}</p>
        <p class="tower-wizard-buff-preview-meta">{{copy.activeBuffChoice.rankNote}}</p>
        <p class="tower-wizard-buff-preview-effect">{{defaultActiveBuffPreview.rankPreview}}</p>
        {{#if defaultActiveBuffPreview.fluff}}<p class="tower-wizard-buff-preview-fluff">{{defaultActiveBuffPreview.fluff}}</p>{{/if}}
      </div>
      {{/if}}
      <div class="tower-wizard-cards tower-wizard-buff-mode-cards">
        <button type="button" class="tower-wizard-card js-tw-active-buff-mode{{#if (eq selection.activeBuffMode 'defensive')}} is-selected{{/if}}" data-buff-mode="defensive">
          <span class="tower-wizard-card-title">{{copy.activeBuffChoice.defensiveTitle}}</span>
          <span class="tower-wizard-card-text">{{copy.activeBuffChoice.defensiveBody}}</span>
          {{#if defensiveActiveBuffChoiceBody}}<span class="tower-wizard-card-meta">{{defensiveActiveBuffChoiceBody}}</span>{{/if}}
        </button>
        <button type="button" class="tower-wizard-card js-tw-active-buff-mode{{#if (eq selection.activeBuffMode 'offensive')}} is-selected{{/if}}" data-buff-mode="offensive">
          <span class="tower-wizard-card-title">{{copy.activeBuffChoice.offensiveTitle}}</span>
          <span class="tower-wizard-card-text">{{copy.activeBuffChoice.offensiveBody}}</span>
        </button>
        <button type="button" class="tower-wizard-card js-tw-active-buff-mode{{#if (eq selection.activeBuffMode 'support')}} is-selected{{/if}}" data-buff-mode="support">
          <span class="tower-wizard-card-title">{{copy.activeBuffChoice.supportTitle}}</span>
          <span class="tower-wizard-card-text">{{copy.activeBuffChoice.supportBody}}</span>
        </button>
      </div>
    </section>
    {{/if}}

    {{#if isOffensiveBuff}}
    <section class="tower-wizard-step">
      <h3>{{#if (eq selection.activeBuffMode 'support')}}{{copy.offensiveBuff.supportHeading}}{{else}}{{copy.offensiveBuff.heading}}{{/if}}</h3>
      <p class="tower-wizard-prose">{{copy.offensiveBuff.body}}</p>
      {{#if defaultActiveBuffPreview}}
      <div class="tower-wizard-buff-preview tower-wizard-buff-preview-compact">
        <p class="tower-wizard-buff-replace-label">{{copy.offensiveBuff.replacing}}: <strong>{{defaultActiveBuffPreview.name}}</strong></p>
        <p class="tower-wizard-buff-preview-effect">{{defaultActiveBuffPreview.rankPreview}}</p>
      </div>
      {{/if}}
      {{#if (eq selection.activeBuffMode 'support')}}
      {{#each supportActiveBuffGroups}}
      <h4>{{this.groupLabel}}</h4>
      <div class="tower-wizard-cards tower-wizard-buff-option-cards">
        {{#each this.buffs}}
        <button type="button" class="tower-wizard-card js-tw-select-offensive-buff{{#if (eq ../../selection.offensiveActiveBuffId this.id)}} is-selected{{/if}}" data-buff-id="{{this.id}}">
          <span class="tower-wizard-card-title">{{this.label}}</span>
          <span class="tower-wizard-card-detail">{{../../copy.offensiveBuff.rankPreview}}: {{this.rankPreview}}</span>
          <span class="tower-wizard-card-text">{{this.explanation}}</span>
          <span class="tower-wizard-card-meta">{{this.durationNote}}</span>
        </button>
        {{/each}}
      </div>
      {{/each}}
      {{else}}
      {{#each offensiveActiveBuffGroups}}
      <h4>{{this.groupLabel}}</h4>
      <div class="tower-wizard-cards tower-wizard-buff-option-cards">
        {{#each this.buffs}}
        <button type="button" class="tower-wizard-card js-tw-select-offensive-buff{{#if (eq ../../selection.offensiveActiveBuffId this.id)}} is-selected{{/if}}" data-buff-id="{{this.id}}">
          <span class="tower-wizard-card-title">{{this.label}}</span>
          <span class="tower-wizard-card-detail">{{../../copy.offensiveBuff.rankPreview}}: {{this.rankPreview}}</span>
          <span class="tower-wizard-card-text">{{this.explanation}}</span>
          <span class="tower-wizard-card-meta">{{this.durationNote}}</span>
        </button>
        {{/each}}
      </div>
      {{/each}}
      {{/if}}
    </section>
    {{/if}}

    {{#if isOffenseDelivery}}
    <section class="tower-wizard-step">
      <h3>{{copy.offenseDelivery.heading}}</h3>
      <p class="tower-wizard-prose">{{copy.offenseDelivery.body}}</p>
      <div class="tower-wizard-cards">
        {{#each guidedDeliveryOptions}}
        <button type="button" class="tower-wizard-card js-tw-select-delivery{{#if (eq ../selection.guidedAttackDelivery this.id)}} is-selected{{/if}}" data-delivery-mode="{{this.id}}">
          <span class="tower-wizard-card-title">{{this.label}}</span>
          <span class="tower-wizard-card-text">{{this.explanation}}</span>
        </button>
        {{/each}}
      </div>
      {{#if guidedCoreAttackPreview}}
      <p class="tower-wizard-prose tower-wizard-core-attack-note">{{copy.offenseDelivery.coreNote}}</p>
      {{/if}}
    </section>
    {{/if}}

    {{#if isOffenseSpecial}}
    <section class="tower-wizard-step tower-wizard-offense-special-step">
      <h3>{{copy.offenseSpecial.heading}}</h3>
      <p class="tower-wizard-prose">{{copy.offenseSpecial.body}}</p>
      {{#unless guidedSpecialFocusGroups.length}}
      <p class="tower-wizard-warn">{{copy.offenseSpecial.emptyCatalog}}</p>
      {{/unless}}
      {{#each guidedSpecialFocusGroups}}
      <div class="tower-wizard-special-purpose-group{{#if this.isAdvanced}} is-advanced{{/if}}">
        <h4>{{this.label}}</h4>
        <p class="tower-wizard-prose tower-wizard-intent-hint">{{this.explanation}}</p>
        <div class="tower-wizard-passive-grid">
          {{#each this.cards}}
          <button type="button" class="tower-wizard-passive-card js-tw-select-special-focus{{#if this.isSelected}} is-selected{{/if}}" data-pick-id="{{this.pickId}}" data-template-id="{{this.templateId}}" data-special="{{this.special}}">
            <span class="chip-label">{{this.playerTitle}}</span>
            <span class="chip-mechanical">{{this.explanation}}</span>
            {{#if this.mechanicsPreview}}<span class="tower-wizard-card-meta">{{this.mechanicsPreview}}</span>{{/if}}
          </button>
          {{/each}}
        </div>
      </div>
      {{/each}}
    </section>
    {{/if}}

    {{#if isOffense}}
    <section class="tower-wizard-step tower-wizard-offense-step">
      <h3>{{copy.offense.heading}}</h3>
      <p class="tower-wizard-prose">{{copy.offense.body}}</p>
      <p class="tower-wizard-offense-pick-status">{{offensePickLabel}}</p>
      {{#unless offenseSpecialGroups.length}}
      <p class="tower-wizard-warn">{{copy.offense.emptyCatalog}}</p>
      {{/unless}}
      {{#each offenseSpecialGroups}}
      <details class="tower-wizard-offense-special-details"{{#if this.hasSelection}} open{{/if}}>
        <summary class="tower-wizard-offense-special-summary">
          <span class="tower-wizard-offense-special-title-wrap">
            <span class="tower-wizard-offense-special-title">{{this.groupLabel}}</span>
            {{#if this.groupTooltip}}
            <span class="tower-wizard-special-tooltip" role="tooltip">{{this.groupTooltip}}</span>
            {{/if}}
          </span>
        </summary>
        <div class="tower-wizard-offense-special-body">
          {{#each this.patterns}}
          <div class="tower-wizard-offense-pattern">
            <div class="tower-wizard-offense-pattern-head">
              <span class="tower-wizard-offense-pattern-label">{{this.label}}</span>
              <span class="tower-wizard-offense-pattern-hint">{{this.hint}}</span>
            </div>
            <div class="tower-wizard-offense-variants">
              {{#each this.variants}}
              <button type="button" class="tower-wizard-offense-variant js-tw-select-offense-variant{{#if this.isSelected}} is-selected{{/if}}" data-pick-id="{{this.pickId}}" data-template-id="{{this.templateId}}" data-special="{{this.special}}" title="{{this.deliveryLabel}} — {{../label}}">
                {{this.deliveryLabel}}
              </button>
              {{/each}}
            </div>
          </div>
          {{/each}}
        </div>
      </details>
      {{/each}}
      {{#if (lt offensePickCount 2)}}
      <p class="tower-wizard-prose tower-wizard-offense-hint">{{copy.offense.pickHint}}</p>
      {{/if}}
    </section>
    {{/if}}

    {{#if isWeakenSave}}
    <section class="tower-wizard-step">
      <h3>{{copy.weakenSave.question}}</h3>
      <div class="tower-wizard-choice-row">
        <button type="button" class="tower-wizard-choice js-tw-weaken-save{{#if (eq selection.weakenSave 'body')}} is-selected{{/if}}" data-save="body">{{copy.weakenSave.options.body}}</button>
        <button type="button" class="tower-wizard-choice js-tw-weaken-save{{#if (eq selection.weakenSave 'mind')}} is-selected{{/if}}" data-save="mind">{{copy.weakenSave.options.mind}}</button>
        <button type="button" class="tower-wizard-choice js-tw-weaken-save{{#if (eq selection.weakenSave 'spirit')}} is-selected{{/if}}" data-save="spirit">{{copy.weakenSave.options.spirit}}</button>
        <button type="button" class="tower-wizard-choice js-tw-weaken-save{{#unless selection.weakenSave}} is-selected{{/unless}}" data-save="">{{copy.weakenSave.options.unsure}}</button>
      </div>
    </section>
    {{/if}}

    {{#if isDelivery}}
    <section class="tower-wizard-step">
      <h3>{{copy.delivery.question}}</h3>
      <div class="tower-wizard-choice-row">
        <button type="button" class="tower-wizard-choice js-tw-delivery{{#if (eq selection.delivery 'melee')}} is-selected{{/if}}" data-delivery="melee">{{copy.delivery.melee}}</button>
        <button type="button" class="tower-wizard-choice js-tw-delivery{{#if (eq selection.delivery 'ranged')}} is-selected{{/if}}" data-delivery="ranged">{{copy.delivery.ranged}}</button>
      </div>
    </section>
    {{/if}}

    {{#if isReview}}
    <section class="tower-wizard-step tower-wizard-review">
      <h3>{{copy.review.heading}}</h3>
      {{#if manualBuildMode}}
      <p class="tower-wizard-prose">{{copy.review.manualIntro}}</p>
      {{/if}}

      {{#if warnings.length}}
      <ul class="tower-wizard-warnings">
        {{#each warnings}}
        <li>{{this}}</li>
        {{/each}}
      </ul>
      {{/if}}

      {{#if review.customizationNotes.length}}
      <ul class="tower-wizard-customization-notes">
        {{#each review.customizationNotes}}
        <li>
          {{#if (eq this.kind 'passive1-variant')}}{{../copy.review.passive1VariantChanged}}{{/if}}
          {{#if (eq this.kind 'active-buff-replaced')}}{{../copy.review.activeBuffReplaced}}{{/if}}
          — {{../copy.review.recommendedLabel}}: {{this.recommended}}; {{../copy.review.currentLabel}}: {{this.current}}
        </li>
        {{/each}}
      </ul>
      {{/if}}

      {{#if review.guidedBuildSummary}}
      <section class="tower-wizard-guided-summary">
        <h4>{{copy.review.whatYouBuilt}}</h4>
        {{#each review.guidedBuildSummary.slots}}
        <p class="tower-wizard-prose"><strong>{{this.role}}:</strong> {{this.text}}</p>
        {{/each}}
        <h4>{{copy.review.simpleRotation}}</h4>
        <ol class="tower-wizard-rotation-list">
          {{#each review.guidedBuildSummary.rotationSteps}}
          <li>{{this}}</li>
          {{/each}}
        </ol>
      </section>
      {{/if}}

      <h4>{{copy.review.mainDefensePackage}}</h4>
      {{#if review.defensePackagePreview}}
      <p class="tower-wizard-prose"><strong>{{copy.review.mainDefensePackage}}:</strong> {{review.defensePackagePreview.mainDefenseLabel}}</p>
      {{/if}}
      {{#each review.mainDefensePackageRows}}
      <div class="tower-wizard-review-power" data-grant-key="{{this.grantKey}}">
        <div class="tower-wizard-review-power-header">
          <div class="tower-wizard-review-power-title">
            <strong>{{this.role}}:</strong> {{this.playerName}}
            <span class="mechanical">(Rank {{this.rank}})</span>
            {{#if this.hasCatalogOverride}}<span class="tower-wizard-chip">{{../copy.review.customPower}}</span>{{/if}}
          </div>
          <div class="tower-wizard-review-power-actions">
            <button type="button" class="tower-wizard-btn js-tw-change-power" data-grant-key="{{this.grantKey}}">{{../copy.review.changePower}}</button>
            {{#if this.showResetToDefault}}
            <button type="button" class="tower-wizard-btn js-tw-reset-power" data-grant-key="{{this.grantKey}}">{{../copy.review.resetPower}}</button>
            {{/if}}
          </div>
        </div>
      </div>
      {{/each}}

      <h4>{{copy.review.secondPassive}}</h4>
      {{#if review.secondPassiveRow}}
      {{#with review.secondPassiveRow}}
      <div class="tower-wizard-review-power" data-grant-key="{{this.grantKey}}">
        <div class="tower-wizard-review-power-header">
          <div class="tower-wizard-review-power-title">
            <strong>{{this.role}}:</strong> {{this.playerName}}
            <span class="mechanical">(Rank {{this.rank}})</span>
            {{#if this.hasCatalogOverride}}<span class="tower-wizard-chip">{{../copy.review.customPower}}</span>{{/if}}
          </div>
          <div class="tower-wizard-review-power-actions">
            <button type="button" class="tower-wizard-btn js-tw-change-power" data-grant-key="{{this.grantKey}}">{{../copy.review.changePower}}</button>
            {{#if this.hasCatalogOverride}}
            <button type="button" class="tower-wizard-btn js-tw-reset-power" data-grant-key="{{this.grantKey}}">{{../copy.review.resetPower}}</button>
            {{else}}
            {{#if this.showResetToDefault}}
            <button type="button" class="tower-wizard-btn js-tw-reset-power" data-grant-key="{{this.grantKey}}">{{../copy.review.resetPower}}</button>
            {{/if}}
            {{/if}}
          </div>
        </div>
      </div>
      {{/with}}
      {{/if}}

      <h4>{{copy.review.offense}}</h4>
      {{#each review.offenseReviewRows}}
      <div class="tower-wizard-review-power" data-grant-key="{{this.grantKey}}">
        <div class="tower-wizard-review-power-header">
          <div class="tower-wizard-review-power-title">
            <strong>{{this.role}}:</strong> {{this.playerName}}
            <span class="mechanical">(Rank {{this.rank}})</span>
            {{#if this.hasCatalogOverride}}<span class="tower-wizard-chip">{{../copy.review.customPower}}</span>{{/if}}
          </div>
          <div class="tower-wizard-review-power-actions">
            {{#unless this.locked}}
            <button type="button" class="tower-wizard-btn js-tw-change-power" data-grant-key="{{this.grantKey}}">{{../copy.review.changePower}}</button>
            {{#if this.hasCatalogOverride}}
            <button type="button" class="tower-wizard-btn js-tw-reset-power" data-grant-key="{{this.grantKey}}">{{../copy.review.resetPower}}</button>
            {{else}}
            {{#if this.showResetToDefault}}
            <button type="button" class="tower-wizard-btn js-tw-reset-power" data-grant-key="{{this.grantKey}}">{{../copy.review.resetPower}}</button>
            {{/if}}
            {{/if}}
            {{else}}
            <span class="tower-wizard-chip">Locked</span>
            {{/unless}}
          </div>
        </div>
        {{#if this.showSpellConfig}}
        <div class="tower-wizard-active-config tower-wizard-review-power-config">
          {{#if this.variantOptions.length}}
          <label class="tower-wizard-field">
            <span>{{../copy.review.variant}}</span>
            <select class="js-tw-variant" data-grant-key="{{this.grantKey}}">
              {{#each this.variantOptions}}
              <option value="{{this.id}}" {{#if (eq this.id ../override.variant)}}selected{{/if}}>{{this.label}}</option>
              {{/each}}
            </select>
          </label>
          {{/if}}
          <label class="tower-wizard-field tower-wizard-checkbox">
            <input type="checkbox" class="js-tw-is-spell" data-grant-key="{{this.grantKey}}" {{#if this.override.isSpell}}checked{{/if}} />
            <span>{{../copy.review.castAsSpell}}</span>
          </label>
          <label class="tower-wizard-field js-tw-spell-fields" data-grant-key="{{this.grantKey}}" {{#unless this.override.isSpell}}style="display:none"{{/unless}}>
            <span>{{../copy.review.castingAttribute}}</span>
            <select class="js-tw-casting-attr" data-grant-key="{{this.grantKey}}">
              <option value="intellect" {{#if (eq this.override.castingAttribute 'intellect')}}selected{{/if}}>Intellect</option>
              <option value="resolve" {{#if (eq this.override.castingAttribute 'resolve')}}selected{{/if}}>Resolve</option>
            </select>
          </label>
          <label class="tower-wizard-field js-tw-spell-fields" data-grant-key="{{this.grantKey}}" {{#unless this.override.isSpell}}style="display:none"{{/unless}}>
            <span>{{../copy.review.resolution}}</span>
            <select class="js-tw-spell-resolution" data-grant-key="{{this.grantKey}}">
              <option value="spellAttack" {{#if (eq this.override.spellResolution 'spellAttack')}}selected{{/if}}>Spell Attack</option>
            </select>
          </label>
        </div>
        {{/if}}
      </div>
      {{/each}}

      {{#if manualBuildMode}}
      <h4>{{copy.review.powers}}</h4>
      {{#each review.reviewPowerRows}}
      <div class="tower-wizard-review-power" data-grant-key="{{this.grantKey}}">
        <div class="tower-wizard-review-power-header">
          <div class="tower-wizard-review-power-title">
            <strong>{{this.role}}:</strong> {{this.playerName}}
            <span class="mechanical">(Rank {{this.rank}})</span>
            {{#if this.hasCatalogOverride}}<span class="tower-wizard-chip">{{../copy.review.customPower}}</span>{{/if}}
          </div>
          <div class="tower-wizard-review-power-actions">
            <button type="button" class="tower-wizard-btn js-tw-change-power" data-grant-key="{{this.grantKey}}">{{../copy.review.changePower}}</button>
            {{#if this.hasCatalogOverride}}
            <button type="button" class="tower-wizard-btn js-tw-reset-power" data-grant-key="{{this.grantKey}}">{{../copy.review.resetPower}}</button>
            {{else}}
            {{#if this.showResetToDefault}}
            <button type="button" class="tower-wizard-btn js-tw-reset-power" data-grant-key="{{this.grantKey}}">{{../copy.review.resetPower}}</button>
            {{/if}}
            {{/if}}
          </div>
        </div>
        {{#if this.showSpellConfig}}
        <div class="tower-wizard-active-config tower-wizard-review-power-config">
          {{#if this.variantOptions.length}}
          <label class="tower-wizard-field">
            <span>{{../copy.review.variant}}</span>
            <select class="js-tw-variant" data-grant-key="{{this.grantKey}}">
              {{#each this.variantOptions}}
              <option value="{{this.id}}" {{#if (eq this.id ../override.variant)}}selected{{/if}}>{{this.label}}</option>
              {{/each}}
            </select>
          </label>
          {{/if}}
          <label class="tower-wizard-field tower-wizard-checkbox">
            <input type="checkbox" class="js-tw-is-spell" data-grant-key="{{this.grantKey}}" {{#if this.override.isSpell}}checked{{/if}} />
            <span>{{../copy.review.castAsSpell}}</span>
          </label>
          <label class="tower-wizard-field js-tw-spell-fields" data-grant-key="{{this.grantKey}}" {{#unless this.override.isSpell}}style="display:none"{{/unless}}>
            <span>{{../copy.review.castingAttribute}}</span>
            <select class="js-tw-casting-attr" data-grant-key="{{this.grantKey}}">
              <option value="intellect" {{#if (eq this.override.castingAttribute 'intellect')}}selected{{/if}}>Intellect</option>
              <option value="resolve" {{#if (eq this.override.castingAttribute 'resolve')}}selected{{/if}}>Resolve</option>
            </select>
          </label>
          <label class="tower-wizard-field js-tw-spell-fields" data-grant-key="{{this.grantKey}}" {{#unless this.override.isSpell}}style="display:none"{{/unless}}>
            <span>{{../copy.review.resolution}}</span>
            <select class="js-tw-spell-resolution" data-grant-key="{{this.grantKey}}">
              <option value="spellAttack" {{#if (eq this.override.spellResolution 'spellAttack')}}selected{{/if}}>Spell Attack</option>
            </select>
          </label>
        </div>
        {{/if}}
      </div>
      {{/each}}
      {{/if}}

      {{#if roleRating}}
      <section class="tower-wizard-role-matrix">
        <div class="tower-wizard-role-matrix-header">
          <h4>{{copy.roleMatrix.heading}}</h4>
          <div class="tower-wizard-role-verdict-block">
            <div class="tower-wizard-role-verdict-head">
              <span class="tw-role-direction">{{roleRating.directionLabel}}</span>
              <span class="tw-role-focus tw-role-focus-{{roleRating.focusKey}}">{{roleRating.focusLabel}}</span>
            </div>
            <p class="tw-role-summary">{{roleRating.summary}}</p>
          </div>
        </div>
        <div class="tower-wizard-role-matrix-body">
          <svg class="tower-wizard-radar" viewBox="0 0 {{roleRating.radar.size}} {{roleRating.radar.size}}" role="img" aria-label="{{copy.roleMatrix.heading}}">
            {{#each roleRating.radar.gridPolygons}}<polygon class="tw-radar-grid" points="{{this}}" />{{/each}}
            {{#each roleRating.radar.axisLines}}<line class="tw-radar-axis" x1="{{../roleRating.radar.center}}" y1="{{../roleRating.radar.center}}" x2="{{this.x2}}" y2="{{this.y2}}" />{{/each}}
            <polygon class="tw-radar-data" points="{{roleRating.radar.dataPolygon}}" />
            {{#each roleRating.radar.labels}}<text class="tw-radar-label" x="{{this.x}}" y="{{this.y}}" text-anchor="{{this.anchor}}">{{this.label}} {{this.score}}</text>{{/each}}
          </svg>
        </div>
      </section>
      {{/if}}

      {{#if validationError}}
      <p class="tower-wizard-warn">{{validationError}}</p>
      {{/if}}

      {{#unless review.allOk}}
      <p class="tower-wizard-warn">Some catalog entries are missing — cannot apply yet.</p>
      {{/unless}}
    </section>
    {{/if}}
  </div>

  <footer class="tower-wizard-footer">
    {{#if showBack}}<button type="button" class="tower-wizard-btn js-tw-back">{{#if manualBuildMode}}{{copy.review.manualBack}}{{else}}{{copy.buttons.back}}{{/if}}</button>{{/if}}
    {{#if showNext}}<button type="button" class="tower-wizard-btn is-primary js-tw-next" {{#unless canAdvance}}disabled{{/unless}}>{{copy.buttons.next}}</button>{{/if}}
    {{#if isReview}}
    <button type="button" class="tower-wizard-btn js-tw-restart">{{#if manualBuildMode}}{{copy.review.manualRestart}}{{else}}{{copy.review.back}}{{/if}}</button>
    <button type="button" class="tower-wizard-btn is-primary js-tw-apply" {{#unless canApply}}disabled{{/unless}}>{{copy.review.apply}}</button>
    {{/if}}
  </footer>
</div>
