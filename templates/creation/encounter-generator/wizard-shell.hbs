<div class="encounter-gen-dialog">
  <header class="encounter-gen-header">
    <p class="encounter-gen-progress">{{progressLabel}}</p>
  </header>

  <div class="encounter-gen-body">
    {{!-- Step 1: Party selection --}}
    {{#if isParty}}
    <section class="encounter-gen-step">
      <h3>{{copy.party.heading}}</h3>
      <p class="encounter-gen-prose">{{copy.party.body}}</p>
      {{#if partyActors.length}}
      <div class="encounter-gen-party-grid">
        {{#each partyActors}}
        <button type="button"
          class="encounter-gen-pc js-eg-toggle-pc{{#if this.selected}} is-selected{{/if}}"
          data-actor-id="{{this.id}}">
          <span class="encounter-gen-pc-name">{{this.name}}</span>
          <span class="encounter-gen-pc-meta">MR {{this.mr}} · {{this.hp}} HP · Ausw. {{this.evade}}</span>
        </button>
        {{/each}}
      </div>
      {{#if metrics}}
      <div class="encounter-gen-metrics">
        <h4>{{copy.party.metricsHeading}} ({{selectedLabel}})</h4>
        <ul>
          <li>Median MR: <strong>{{metrics.medianMR}}</strong></li>
          <li>Ø HP: <strong>{{metrics.avgHP}}</strong></li>
          <li>Ø Ausweichen: <strong>{{metrics.avgEvade}}</strong></li>
          <li>Ø Ruestung: <strong>{{metrics.avgArmor}}</strong></li>
        </ul>
      </div>
      {{/if}}
      {{else}}
      <p class="encounter-gen-empty">{{copy.party.empty}}</p>
      {{/if}}
    </section>
    {{/if}}

    {{!-- Step 2: Kampfidee (Konzept) --}}
    {{#if isConcept}}
    <section class="encounter-gen-step">
      <h3>{{copy.concept.heading}}</h3>
      <p class="encounter-gen-prose">{{copy.concept.body}}</p>

      <label class="encounter-gen-field encounter-gen-field--wide">
        <span class="encounter-gen-label-tip" tabindex="0">{{copy.concept.preset}}<span class="encounter-gen-tooltip" role="tooltip">{{copy.concept.presetHint}}</span></span>
        <select class="js-eg-preset">
          {{#each presetOptions}}
          <option value="{{this.value}}"{{#if this.selected}} selected{{/if}} title="{{this.description}}">{{this.label}}</option>
          {{/each}}
        </select>
      </label>
      {{#if presetDescription}}
      <p class="encounter-gen-note">{{presetDescription}}</p>
      {{/if}}

      <h4>{{copy.concept.groupHeading}}</h4>
      <div class="encounter-gen-form">
        <label class="encounter-gen-field">
          <span class="encounter-gen-label-tip" tabindex="0">{{copy.concept.bossCount}}<span class="encounter-gen-tooltip" role="tooltip">{{copy.concept.bossCountHint}}</span></span>
          <input type="number" class="js-eg-concept" data-field="bossCount" min="1" max="6" value="{{concept.bossCount}}"/>
        </label>
        <label class="encounter-gen-field">
          <span class="encounter-gen-label-tip" tabindex="0">{{copy.concept.kitMode}}<span class="encounter-gen-tooltip" role="tooltip">{{copy.concept.kitModeHint}}</span></span>
          <select class="js-eg-concept" data-field="kitMode">
            {{#each kitModeOptions}}
            <option value="{{this.value}}"{{#if this.selected}} selected{{/if}} title="{{this.description}}">{{this.label}}</option>
            {{/each}}
          </select>
        </label>
        <label class="encounter-gen-field">
          <span class="encounter-gen-label-tip" tabindex="0">{{copy.concept.rank}}<span class="encounter-gen-tooltip" role="tooltip">{{copy.concept.rankHint}}</span></span>
          <select class="js-eg-concept" data-field="rank">
            {{#each rankOptions}}
            <option value="{{this.value}}"{{#if this.selected}} selected{{/if}} title="{{this.description}}">{{this.label}}</option>
            {{/each}}
          </select>
        </label>
        <label class="encounter-gen-field">
          <span class="encounter-gen-label-tip" tabindex="0">{{copy.concept.style}}<span class="encounter-gen-tooltip" role="tooltip">{{copy.concept.styleHint}}</span></span>
          <select class="js-eg-concept" data-field="style">
            {{#each styleOptions}}
            <option value="{{this.value}}"{{#if this.selected}} selected{{/if}} title="{{this.description}}">{{this.label}}</option>
            {{/each}}
          </select>
        </label>
        <label class="encounter-gen-field">
          <span class="encounter-gen-label-tip" tabindex="0">{{copy.concept.primarySpecial}}<span class="encounter-gen-tooltip" role="tooltip">{{copy.concept.primarySpecialHint}}</span></span>
          <select class="js-eg-concept" data-field="primarySpecial">
            {{#each specialOptions}}
            <option value="{{this.value}}"{{#if this.selected}} selected{{/if}} title="{{this.description}}">{{this.label}}</option>
            {{/each}}
          </select>
        </label>
        <label class="encounter-gen-field">
          <span class="encounter-gen-label-tip" tabindex="0">{{copy.concept.secondaryStyle}}<span class="encounter-gen-tooltip" role="tooltip">{{copy.concept.secondaryStyleHint}}</span></span>
          <select class="js-eg-concept" data-field="secondaryStyle">
            {{#each secondaryOptions}}
            <option value="{{this.value}}"{{#if this.selected}} selected{{/if}} title="{{this.description}}">{{this.label}}</option>
            {{/each}}
          </select>
        </label>
        <label class="encounter-gen-field">
          <span class="encounter-gen-label-tip" tabindex="0">{{copy.concept.actions}}<span class="encounter-gen-tooltip" role="tooltip">{{copy.concept.actionsHint}}</span></span>
          <input type="number" class="js-eg-concept" data-field="actionsPerRound" min="1" max="6" value="{{concept.actionsPerRound}}"/>
        </label>
        <label class="encounter-gen-field">
          <span class="encounter-gen-label-tip" tabindex="0">{{copy.concept.targeting}}<span class="encounter-gen-tooltip" role="tooltip">{{copy.concept.targetingHint}}</span></span>
          <select class="js-eg-concept" data-field="targeting">
            {{#each targetingOptions}}
            <option value="{{this.value}}"{{#if this.selected}} selected{{/if}} title="{{this.description}}">{{this.label}}</option>
            {{/each}}
          </select>
        </label>
        <label class="encounter-gen-field">
          <span class="encounter-gen-label-tip" tabindex="0">{{copy.concept.phases}}<span class="encounter-gen-tooltip" role="tooltip">{{copy.concept.phasesHint}}</span></span>
          <input type="number" class="js-eg-concept" data-field="phaseCount" min="1" max="5" value="{{concept.phaseCount}}"/>
        </label>
        <label class="encounter-gen-field">
          <span class="encounter-gen-label-tip" tabindex="0">{{copy.concept.cycleLength}}<span class="encounter-gen-tooltip" role="tooltip">{{copy.concept.cycleLengthHint}}</span></span>
          <input type="number" class="js-eg-concept" data-field="cycleLength" min="2" max="6" value="{{concept.cycleLength}}"/>
        </label>
        <label class="encounter-gen-field">
          <span class="encounter-gen-label-tip" tabindex="0">{{copy.concept.cycleStyle}}<span class="encounter-gen-tooltip" role="tooltip">{{copy.concept.cycleStyleHint}}</span></span>
          <select class="js-eg-concept" data-field="cycleStyle">
            {{#each cycleStyleOptions}}
            <option value="{{this.value}}"{{#if this.selected}} selected{{/if}} title="{{this.description}}">{{this.label}}</option>
            {{/each}}
          </select>
        </label>
        {{#if isEnvironmental}}
        <label class="encounter-gen-field">
          <span class="encounter-gen-label-tip" tabindex="0">{{copy.concept.envActions}}<span class="encounter-gen-tooltip" role="tooltip">{{copy.concept.envActionsHint}}</span></span>
          <input type="number" class="js-eg-concept" data-field="environmentActionsPerRound" min="1" max="4" value="{{concept.environmentActionsPerRound}}"/>
        </label>
        {{/if}}
      </div>

      <h4>{{copy.concept.loadoutHeading}}</h4>
      <div class="encounter-gen-form">
        <label class="encounter-gen-field">
          <span class="encounter-gen-label-tip" tabindex="0">{{copy.concept.weaponProfile}}<span class="encounter-gen-tooltip" role="tooltip">{{copy.concept.weaponProfileHint}}</span></span>
          <select class="js-eg-concept" data-field="weaponProfile">
            {{#each weaponProfileOptions}}
            <option value="{{this.value}}"{{#if this.selected}} selected{{/if}} title="{{this.description}}">{{this.label}}</option>
            {{/each}}
          </select>
        </label>
        <label class="encounter-gen-field">
          <span class="encounter-gen-label-tip" tabindex="0">{{copy.concept.attackShape}}<span class="encounter-gen-tooltip" role="tooltip">{{copy.concept.attackShapeHint}}</span></span>
          <select class="js-eg-concept" data-field="attackShape">
            {{#each attackShapeOptions}}
            <option value="{{this.value}}"{{#if this.selected}} selected{{/if}} title="{{this.description}}">{{this.label}}</option>
            {{/each}}
          </select>
        </label>
        <label class="encounter-gen-field">
          <span class="encounter-gen-label-tip" tabindex="0">{{copy.concept.baseDamage}}<span class="encounter-gen-tooltip" role="tooltip">{{copy.concept.baseDamageHint}}</span></span>
          <input type="number" class="js-eg-concept" data-field="baseDamageDice" min="0" max="80" value="{{concept.baseDamageDice}}"/>
        </label>
      </div>

      <h4>{{copy.concept.valuesHeading}}</h4>
      <p class="encounter-gen-note">{{copy.concept.valuesHint}}</p>
      <p class="encounter-gen-caution">{{mrRule}}</p>
      <div class="encounter-gen-form">
        <label class="encounter-gen-field">
          <span class="encounter-gen-label-tip" tabindex="0">{{copy.concept.hpOverride}}<span class="encounter-gen-tooltip" role="tooltip">0 = automatisch</span></span>
          <input type="number" class="js-eg-concept" data-field="hpOverride" min="0" max="9999" value="{{concept.hpOverride}}"/>
        </label>
        <label class="encounter-gen-field">
          <span class="encounter-gen-label-tip" tabindex="0">{{copy.concept.armorOverride}}<span class="encounter-gen-tooltip" role="tooltip">Echte Rüstung auf dem NSC (nicht MR). 0 = automatisch aus der Gruppe.</span></span>
          <input type="number" class="js-eg-concept" data-field="armorOverride" min="0" max="40" value="{{concept.armorOverride}}"/>
        </label>
        <label class="encounter-gen-field">
          <span class="encounter-gen-label-tip" tabindex="0">{{copy.concept.evadeOverride}}<span class="encounter-gen-tooltip" role="tooltip">0 = automatisch</span></span>
          <input type="number" class="js-eg-concept" data-field="evadeOverride" min="0" max="40" value="{{concept.evadeOverride}}"/>
        </label>
      </div>

      <h4>{{copy.concept.reactionsHeading}}</h4>
      <p class="encounter-gen-note">{{copy.concept.reactionsBody}}</p>
      <div class="encounter-gen-reactions">
        {{#each reactionRows}}
        <div class="encounter-gen-reaction-row">
          <label class="encounter-gen-field">
            <span>{{this.label}}</span>
            <select class="js-eg-reaction" data-index="{{this.index}}" data-field="kind">
              {{#each this.kindOptions}}
              <option value="{{this.value}}"{{#if this.selected}} selected{{/if}} title="{{this.description}}">{{this.label}}</option>
              {{/each}}
            </select>
          </label>
          {{#if this.showName}}
          <label class="encounter-gen-field encounter-gen-field--wide">
            <span>Name</span>
            <input type="text" class="js-eg-reaction" data-index="{{this.index}}" data-field="name" value="{{this.name}}" placeholder="z.B. Schildwall"/>
          </label>
          {{/if}}
        </div>
        {{/each}}
      </div>

      {{#if conceptPreview}}
      <div class="encounter-gen-preview">
        <h4>{{copy.concept.previewHeading}}</h4>
        <ul>
          <li>{{conceptPreview.countLabel}}</li>
          <li>MR <strong>{{conceptPreview.mr}}</strong> · HP <strong>{{conceptPreview.hp}}</strong> · Rüstung <strong>{{conceptPreview.armor}}</strong> · Ausweichen <strong>{{conceptPreview.evade}}</strong></li>
          <li>{{conceptPreview.attacks}}</li>
          <li>{{conceptPreview.reactions}}</li>
          <li class="encounter-gen-caution-line">{{conceptPreview.mrCaution}}</li>
        </ul>
        <p class="encounter-gen-note">{{copy.concept.previewNote}}</p>
      </div>
      {{else}}
      <p class="encounter-gen-note">{{copy.concept.previewNone}}</p>
      {{/if}}
    </section>
    {{/if}}

    {{!-- Step 3: Adds --}}
    {{#if isAdds}}
    <section class="encounter-gen-step">
      <h3>{{copy.adds.heading}}</h3>
      <p class="encounter-gen-prose">{{copy.adds.body}}</p>

      <label class="encounter-gen-field encounter-gen-field--checkbox">
        <input type="checkbox" class="js-eg-adds" data-field="enabled"{{#if adds.enabled}} checked{{/if}}/>
        <span class="encounter-gen-label-tip" tabindex="0">{{copy.adds.enabled}}<span class="encounter-gen-tooltip" role="tooltip">{{copy.adds.enabledHint}}</span></span>
      </label>

      {{#if adds.enabled}}
      <div class="encounter-gen-form">
        <label class="encounter-gen-field">
          <span class="encounter-gen-label-tip" tabindex="0">{{copy.adds.durability}}<span class="encounter-gen-tooltip" role="tooltip">{{copy.adds.durabilityHint}}</span></span>
          <select class="js-eg-adds" data-field="durability">
            {{#each durabilityOptions}}
            <option value="{{this.value}}"{{#if this.selected}} selected{{/if}} title="{{this.description}}">{{this.label}}</option>
            {{/each}}
          </select>
        </label>
        <label class="encounter-gen-field">
          <span class="encounter-gen-label-tip" tabindex="0">{{copy.adds.pressure}}<span class="encounter-gen-tooltip" role="tooltip">{{copy.adds.pressureHint}}</span></span>
          <select class="js-eg-adds" data-field="pressure">
            {{#each pressureOptions}}
            <option value="{{this.value}}"{{#if this.selected}} selected{{/if}} title="{{this.description}}">{{this.label}}</option>
            {{/each}}
          </select>
        </label>
        <label class="encounter-gen-field">
          <span class="encounter-gen-label-tip" tabindex="0">{{copy.adds.targetActive}}<span class="encounter-gen-tooltip" role="tooltip">{{copy.adds.targetActiveHint}}</span></span>
          <input type="number" class="js-eg-adds" data-field="targetActive" min="1" max="12" value="{{adds.targetActive}}"/>
        </label>
        <label class="encounter-gen-field">
          <span class="encounter-gen-label-tip" tabindex="0">{{copy.adds.maxActive}}<span class="encounter-gen-tooltip" role="tooltip">{{copy.adds.maxActiveHint}}</span></span>
          <input type="number" class="js-eg-adds" data-field="maxActive" min="0" max="16" value="{{adds.maxActive}}"/>
        </label>
        <label class="encounter-gen-field">
          <span class="encounter-gen-label-tip" tabindex="0">{{copy.adds.spawnPerRound}}<span class="encounter-gen-tooltip" role="tooltip">{{copy.adds.spawnPerRoundHint}}</span></span>
          <input type="number" class="js-eg-adds" data-field="spawnPerRound" min="1" max="6" value="{{adds.spawnPerRound}}"/>
        </label>
        <label class="encounter-gen-field">
          <span class="encounter-gen-label-tip" tabindex="0">{{copy.adds.spawnPattern}}<span class="encounter-gen-tooltip" role="tooltip">{{copy.adds.spawnPatternHint}}</span></span>
          <select class="js-eg-adds" data-field="spawnPattern">
            {{#each spawnPatternOptions}}
            <option value="{{this.value}}"{{#if this.selected}} selected{{/if}} title="{{this.description}}">{{this.label}}</option>
            {{/each}}
          </select>
        </label>
        <label class="encounter-gen-field encounter-gen-field--checkbox">
          <input type="checkbox" class="js-eg-adds" data-field="summonCostsBossAction"{{#if adds.summonCostsBossAction}} checked{{/if}}/>
          <span class="encounter-gen-label-tip" tabindex="0">{{copy.adds.summonCost}}<span class="encounter-gen-tooltip" role="tooltip">{{copy.adds.summonCostHint}}</span></span>
        </label>
      </div>
      {{else}}
      <p class="encounter-gen-note">{{copy.adds.disabledNote}}</p>
      {{/if}}
    </section>
    {{/if}}

    {{!-- Step 4: Review — Threat Report + editierbare Werte --}}
    {{#if isReview}}
    {{#if review}}
    <section class="encounter-gen-step">
      <h3>{{copy.review.heading}}</h3>
      <p class="encounter-gen-prose">{{copy.review.body}}</p>

      {{#if review.showKits}}
      <div class="encounter-gen-kit-bar">
        {{#each review.kitTabs}}
        <button type="button" class="encounter-gen-kit-tab js-eg-kit-tab{{#if this.active}} is-active{{/if}}" data-kit="{{this.index}}">{{this.name}}</button>
        {{/each}}
      </div>
      <label class="encounter-gen-field encounter-gen-field--wide">
        <span>{{copy.review.kitName}}</span>
        <input type="text" class="js-eg-kit-name" value="{{review.activeKitName}}"/>
      </label>
      {{else}}
      {{#if review.copiesLabel}}
      <p class="encounter-gen-note">{{review.copiesLabel}}</p>
      {{/if}}
      {{/if}}

      {{#if review.reactions.length}}
      <h4>{{copy.review.reactionsHeading}}</h4>
      <div class="encounter-gen-reactions">
        {{#each review.reactions}}
        <div class="encounter-gen-reaction-row">
          <label class="encounter-gen-field">
            <span>{{this.label}}</span>
            <select class="js-eg-review-reaction" data-index="{{this.index}}" data-field="kind">
              {{#each this.kindOptions}}
              <option value="{{this.value}}"{{#if this.selected}} selected{{/if}} title="{{this.description}}">{{this.label}}</option>
              {{/each}}
            </select>
          </label>
          {{#if this.showName}}
          <label class="encounter-gen-field encounter-gen-field--wide">
            <span>Name</span>
            <input type="text" class="js-eg-review-reaction" data-index="{{this.index}}" data-field="name" value="{{this.name}}"/>
          </label>
          {{/if}}
        </div>
        {{/each}}
      </div>
      {{/if}}

      {{#each review.phases}}
      <div class="encounter-gen-statblock">
        <div class="encounter-gen-statblock-head">
          {{this.name}} · MR {{@root.review.mr}} · {{this.actionsPerRound}} Aktionen/Runde
          {{#unless this.addsActive}}<span class="encounter-gen-tag">keine neuen Adds</span>{{/unless}}
        </div>
        {{#if this.changes}}
        <p class="encounter-gen-note">{{../copy.threat.phaseChangesLabel}}: {{this.changes}}</p>
        {{/if}}
        <div class="encounter-gen-form encounter-gen-form--inline">
          <label class="encounter-gen-field">
            <span>{{../copy.review.col.hp}}</span>
            <input type="number" class="js-eg-phase-stat" data-phase="{{this.index}}" data-field="hp" value="{{this.stat.hp}}" min="1"/>
          </label>
          <label class="encounter-gen-field">
            <span>{{../copy.review.col.evade}}</span>
            <input type="number" class="js-eg-phase-stat" data-phase="{{this.index}}" data-field="evade" value="{{this.stat.evade}}" min="1"/>
          </label>
          <label class="encounter-gen-field">
            <span>{{../copy.review.col.armor}}</span>
            <input type="number" class="js-eg-phase-stat" data-phase="{{this.index}}" data-field="armor" value="{{this.stat.armor}}" min="0"/>
          </label>
        </div>
        <table class="encounter-gen-table">
          <thead>
            <tr>
              <th>#</th>
              <th>Power</th>
              <th>{{../copy.review.col.attackDice}}</th>
              <th>{{../copy.review.col.damageDice}}</th>
              <th>Special</th>
              <th>Spell</th>
              <th>Angriffe/Runde</th>
              <th>Reichweite</th>
              <th>Hinweis</th>
            </tr>
          </thead>
          <tbody>
            {{#each this.cycle}}
            <tr>
              <td>{{this.slot}}</td>
              <td>{{this.name}}</td>
              {{#if this.isSummon}}
              <td>—</td>
              <td>—</td>
              <td>—</td>
              <td>—</td>
              <td>—</td>
              {{else}}
              <td><input type="number" class="js-eg-cycle" data-phase="{{@../index}}" data-slot="{{this.cycleIndex}}" data-field="attackDiceCount" value="{{this.attackDiceCount}}" min="1" max="80"/></td>
              <td><input type="number" class="js-eg-cycle" data-phase="{{@../index}}" data-slot="{{this.cycleIndex}}" data-field="damageDiceCount" value="{{this.damageDiceCount}}" min="0" max="80"/></td>
              <td>
                {{#if this.special}}
                <input type="number" class="js-eg-cycle encounter-gen-input--small" data-phase="{{@../index}}" data-slot="{{this.cycleIndex}}" data-field="specialValue" value="{{this.specialValue}}" min="0" max="8"/>
                {{this.specialText}}
                {{else}}—{{/if}}
              </td>
              <td>
                <label class="encounter-gen-check" title="Casting TN = 8×MR (nicht Evade)">
                  <input type="checkbox" class="js-eg-cycle" data-phase="{{@../index}}" data-slot="{{this.cycleIndex}}" data-field="isSpell" {{#if this.isSpell}}checked{{/if}}/>
                </label>
              </td>
              <td>
                <select class="js-eg-cycle encounter-gen-input--small" data-phase="{{@../index}}" data-slot="{{this.cycleIndex}}" data-field="attacksPerRound" title="So oft erscheint diese Power im Radial (Summe = ATK)">
                  {{#each (range 1 5)}}
                  <option value="{{this}}" {{#if (eqNum ../attacksPerRound this)}}selected{{/if}}>{{this}}</option>
                  {{/each}}
                </select>
              </td>
              {{/if}}
              <td>{{this.rangeText}}</td>
              <td>{{this.extraText}}</td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
      {{/each}}

      {{#if review.adds}}
      <h4>{{copy.threat.addsHeading}}</h4>
      <table class="encounter-gen-table">
        <tbody>
          <tr><td>Add-Werte</td><td>HP {{review.adds.design.hp}} · Rüstung {{review.adds.design.armor}} · Ausweichen {{review.adds.design.evade}} · {{review.adds.design.attackDiceCount}} Angriffs-W8 / {{review.adds.design.damageDiceCount}} Schadens-W8</td></tr>
          <tr><td>Spawn</td><td>{{review.adds.spawnPerRound}}/Runde · max. {{review.adds.maxActive}} aktiv{{#if review.adds.summonCostsBossAction}} · kostet je 1 Boss-Aktion{{/if}}</td></tr>
          <tr><td>Aktive Adds (R1→R5)</td><td>{{review.addsProjection.active}}</td></tr>
          <tr><td>Add-Angriffe (R1→R5)</td><td>{{review.addsProjection.attacks}}</td></tr>
          <tr><td>Add Threat</td><td>{{review.adds.design.expectedLifetimeRounds}} Runden × {{review.adds.design.threatPerAction}} Schaden ≈ <strong>{{review.adds.design.addThreat}}</strong></td></tr>
          <tr><td>Gruppenschaden bei voller Population</td><td>{{review.adds.groupDamageAtFullPop}} pro Runde</td></tr>
          <tr><td>Spieler-Aktionen zum Räumen</td><td>{{review.adds.playerActionsToClear.min}}–{{review.adds.playerActionsToClear.max}}</td></tr>
        </tbody>
      </table>
      {{/if}}

      {{#if review.environment}}
      <h4>{{copy.threat.envHeading}}</h4>
      <p class="encounter-gen-prose">{{review.environment.description}}</p>
      {{/if}}

      <h4>{{copy.threat.heading}}</h4>
      <table class="encounter-gen-table">
        <tbody>
          <tr><td>{{copy.threat.hitChances}}</td><td>{{review.report.hitChanceLowEvade}}% / {{review.report.hitChanceAvgEvade}}% / {{review.report.hitChanceHighEvade}}%</td></tr>
          {{#if review.report.areaTn}}
          <tr><td>{{copy.threat.aoeHitChance}}</td><td>{{review.report.hitChanceAreaTn}}% (Area TN {{review.report.areaTn}})</td></tr>
          {{/if}}
          <tr><td>{{copy.threat.rawDamage}}</td><td>{{review.report.expectedHitDamageRaw}}</td></tr>
          <tr><td>{{copy.threat.afterArmor}}</td><td>{{review.report.expectedHitDamageAfterArmor}}</td></tr>
          <tr><td>{{copy.threat.persistent}}</td><td>{{review.report.persistentDamagePerRound}}</td></tr>
          <tr><td>{{copy.threat.burst}}</td><td>{{review.report.firstRoundBurstOneTarget}} (≈ {{review.report.firstRoundBurstHealthLevels}} Health Levels)</td></tr>
          <tr><td>{{copy.threat.groupDamage}}</td><td>{{review.report.expectedGroupDamagePerRound}} (≈ {{review.report.expectedGroupDamageHealthLevels}} Health Levels)</td></tr>
          {{#if review.environment}}
          <tr><td>{{copy.threat.envDamage}}</td><td>{{review.report.environmentDamagePerRound}}</td></tr>
          {{/if}}
          <tr><td>{{copy.threat.actions}}</td><td>{{#each review.report.enemyActionsByRound}}{{#if @index}} → {{/if}}{{this}}{{/each}}</td></tr>
          <tr><td>{{copy.threat.duration}}</td><td>~{{review.report.expectedDurationRounds}} Runden</td></tr>
          <tr><td>{{copy.threat.hlSize}}</td><td>{{review.report.avgHealthLevelSize}} HP</td></tr>
          <tr><td>{{copy.threat.round1Lowest}}</td><td>≈ {{review.report.round1HealthLevelsLowestPc}} Health Levels</td></tr>
        </tbody>
      </table>

      <h4>{{copy.threat.warningsHeading}}</h4>
      {{#if review.hasWarnings}}
      <ul class="encounter-gen-warnings">
        {{#each review.report.warnings}}
        <li>⚠ {{this}}</li>
        {{/each}}
      </ul>
      {{else}}
      <p class="encounter-gen-note">{{copy.threat.noWarnings}}</p>
      {{/if}}

      {{#if review.notes.length}}
      <ul class="encounter-gen-notes">
        {{#each review.notes}}
        <li>{{this}}</li>
        {{/each}}
      </ul>
      {{/if}}
    </section>
    {{/if}}
    {{/if}}

    {{!-- Step 5: Name + generate --}}
    {{#if isName}}
    <section class="encounter-gen-step">
      <h3>{{copy.name.heading}}</h3>
      <p class="encounter-gen-prose">{{copy.name.body}}</p>
      <label class="encounter-gen-field encounter-gen-field--wide">
        <span>{{copy.name.label}}</span>
        <input type="text" class="js-eg-name" value="{{selection.folderName}}" placeholder="{{copy.name.placeholder}}"/>
      </label>
    </section>
    {{/if}}
  </div>

  <footer class="encounter-gen-footer">
    {{#if showBack}}
    <button type="button" class="encounter-gen-btn js-eg-back">{{copy.nav.back}}</button>
    {{/if}}
    {{#if isName}}
    <button type="button" class="encounter-gen-btn encounter-gen-btn--primary js-eg-generate"{{#unless canGenerate}} disabled{{/unless}}>{{copy.nav.generate}}</button>
    {{else}}
    <button type="button" class="encounter-gen-btn encounter-gen-btn--primary js-eg-next"{{#unless canNext}} disabled{{/unless}}>{{copy.nav.next}}</button>
    {{/if}}
  </footer>
</div>
