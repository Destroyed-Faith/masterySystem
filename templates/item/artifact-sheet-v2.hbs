<div class="artifact-sheet-v2 {{cssClass}}">
  <header class="artifact-card-header">
    <img class="profile-img" src="{{item.img}}" title="{{item.name}}" height="56" width="56" data-action="popout-img"/>
    {{#if imgAlt}}
    <img class="profile-img profile-img-alt" src="{{imgAlt}}" title="{{labels.imgAlt}}" height="56" width="56" data-action="popout-img-alt"/>
    {{else if isGM}}
    <button type="button" class="artifact-card-img-alt-add" data-action="edit-img-alt" title="{{labels.imgAlt}}">+</button>
    {{/if}}
    <div class="artifact-card-title">
      <h1 class="artifact-card-name">{{item.name}}</h1>
      <div class="artifact-summary-meta">
        {{#if summary.slotLabel}}<span class="artifact-chip">{{summary.slotLabel}}</span>{{/if}}
        {{#if summary.baseProfileLabel}}<span class="artifact-chip">{{summary.baseProfileLabel}}</span>{{/if}}
        <span class="artifact-chip">Level {{summary.currentLevel}}</span>
      </div>
    </div>
  </header>

  <section class="artifact-card-body">
    {{#unless mechanicallyActive}}
    <div class="artifact-card-section">
      <span class="artifact-chip artifact-chip-inactive">{{labels.inactive}}</span>
    </div>
    {{/unless}}

    {{#if hasActivationPreview}}
    <div class="artifact-card-section artifact-card-preview">
      <h3 class="artifact-card-head">{{labels.whenActivated}}</h3>
      <p class="artifact-card-preview-hint">{{labels.whenActivatedHint}}</p>
      {{#if summary.hasBaseValues}}
      <h4 class="artifact-card-subhead">Base Values</h4>
      <ul class="artifact-basevalues">
        {{#each summary.baseValues}}
        <li>
          <span class="artifact-bv-slot">{{slot}}</span>
          <span class="artifact-bv-label">{{label}}</span>
          {{#if value}}<span class="artifact-bv-value">{{value}}</span>{{/if}}
        </li>
        {{/each}}
      </ul>
      {{/if}}
      {{#if summary.hasAbilities}}
      <h4 class="artifact-card-subhead">Abilities</h4>
      <ul class="artifact-abilities">
        {{#each summary.abilities}}
        <li class="artifact-ability">
          <div class="artifact-ability-line">
            <span class="artifact-ability-name">{{name}}</span>
            {{#if type}}<span class="artifact-ability-type">{{type}}</span>{{/if}}
          </div>
          {{#if effect}}<div class="artifact-ability-effect">{{effect}}</div>{{/if}}
          {{#if special}}<div class="artifact-ability-special">Special Effect: {{special}}</div>{{/if}}
        </li>
        {{/each}}
      </ul>
      {{/if}}
    </div>
    {{/if}}

    {{#if mechanicallyActive}}
    {{#if summary.hasBaseValues}}
    <div class="artifact-card-section">
      <h3 class="artifact-card-head">Base Values</h3>
      <ul class="artifact-basevalues">
        {{#each summary.baseValues}}
        <li>
          <span class="artifact-bv-slot">{{slot}}</span>
          <span class="artifact-bv-label">{{label}}</span>
          {{#if value}}<span class="artifact-bv-value">{{value}}</span>{{/if}}
        </li>
        {{/each}}
      </ul>
    </div>
    {{/if}}

    {{#if summary.hasAbilities}}
    <div class="artifact-card-section">
      <h3 class="artifact-card-head">Abilities</h3>
      <ul class="artifact-abilities">
        {{#each summary.abilities}}
        <li class="artifact-ability">
          <div class="artifact-ability-line">
            <span class="artifact-ability-name">{{name}}</span>
            {{#if type}}<span class="artifact-ability-type">{{type}}</span>{{/if}}
          </div>
          {{#if effect}}<div class="artifact-ability-effect">{{effect}}</div>{{/if}}
          {{#if special}}<div class="artifact-ability-special">Special Effect: {{special}}</div>{{/if}}
        </li>
        {{/each}}
      </ul>
    </div>
    {{/if}}
    {{/if}}

    {{#each nextPreviews}}
    <div class="artifact-card-section artifact-card-preview">
      <h3 class="artifact-card-head">{{title}}{{#if label}} — {{label}}{{/if}}</h3>
      <p class="artifact-card-preview-hint">{{../labels.nextLevelHint}}</p>
      {{#if hasAbilities}}
      <ul class="artifact-abilities">
        {{#each abilities}}
        <li class="artifact-ability">
          <div class="artifact-ability-line">
            <span class="artifact-ability-name">{{name}}</span>
            {{#if type}}<span class="artifact-ability-type">{{type}}</span>{{/if}}
          </div>
          {{#if effect}}<div class="artifact-ability-effect">{{effect}}</div>{{/if}}
          {{#if special}}<div class="artifact-ability-special">Special Effect: {{special}}</div>{{/if}}
        </li>
        {{/each}}
      </ul>
      {{/if}}
    </div>
    {{/each}}
  </section>

  {{#if isGM}}
  <footer class="artifact-card-footer">
    <button type="button" class="artifact-card-edit" data-action="open-node-editor" title="Edit this artifact in the Node Editor (GM only).">
      <i class="fas fa-pen"></i> Edit in Node Editor
    </button>
  </footer>
  {{/if}}
</div>
