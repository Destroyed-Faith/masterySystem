<form class="artifact-sheet-v2 {{cssClass}}" autocomplete="off">
  {{!-- Sheet Header --}}
  <header class="sheet-header">
    <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" height="64" width="64"/>
    <div class="header-fields">
      <h1 class="charname">
        <input name="name" type="text" value="{{item.name}}" placeholder="Artifact Name" {{#unless isEditable}}disabled{{/unless}}/>
      </h1>
    </div>
  </header>

  {{!-- Sheet Tab Navigation --}}
  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="description">Description</a>
    <a class="item" data-tab="bonuses">Bonuses</a>
    <a class="item" data-tab="powers">Powers</a>
    <a class="item" data-tab="requirements">Requirements</a>
  </nav>

  {{!-- Sheet Body --}}
  <section class="sheet-body">
    {{!-- Description Tab --}}
    <div class="tab" data-group="primary" data-tab="description">
      {{!-- Read summary: what this artifact is + what it does --}}
      <div class="artifact-summary">
        <div class="artifact-summary-meta">
          {{#if summary.slotLabel}}<span class="artifact-chip">{{summary.slotLabel}}</span>{{/if}}
          {{#if summary.baseProfileLabel}}<span class="artifact-chip">{{summary.baseProfileLabel}}</span>{{/if}}
          <span class="artifact-chip">Level {{summary.currentLevel}}</span>
        </div>

        {{#if summary.hasBaseValues}}
        <div class="artifact-summary-section">
          <h4>Base Values</h4>
          <ul class="artifact-basevalues">
            {{#each summary.baseValues}}
            <li><strong>{{slot}}</strong> {{label}} <span class="artifact-bv-type">({{typeLabel}})</span>{{#if value}} — <span class="artifact-bv-value">{{value}}</span>{{/if}}</li>
            {{/each}}
          </ul>
        </div>
        {{/if}}

        {{#if summary.hasAbilities}}
        <div class="artifact-summary-section">
          <h4>Abilities by Level</h4>
          <ul class="artifact-abilities">
            {{#each summary.abilities}}
            <li class="artifact-ability {{#unless unlocked}}artifact-ability-locked{{/unless}}">
              <span class="artifact-ability-lvl">L{{level}}</span>
              <span class="artifact-ability-name">{{name}}</span>
              {{#if type}}<span class="artifact-ability-type">{{type}}</span>{{/if}}
              {{#if effect}}<div class="artifact-ability-effect">{{effect}}</div>{{/if}}
              {{#if special}}<div class="artifact-ability-special">Special: {{special}}</div>{{/if}}
            </li>
            {{/each}}
          </ul>
        </div>
        {{/if}}
      </div>

      <div class="form-group">
        <label>Level</label>
        <input type="number" name="system.level" value="{{system.level}}" min="1" {{#unless isEditable}}disabled{{/unless}}/>
      </div>
      <div class="form-group">
        <label>Description</label>
        <textarea name="system.description" rows="5" {{#unless isEditable}}disabled{{/unless}}>{{system.description}}</textarea>
      </div>
      <div class="form-group">
        <label>Lore</label>
        <textarea name="system.lore" rows="5" {{#unless isEditable}}disabled{{/unless}}>{{system.lore}}</textarea>
      </div>
    </div>

    {{!-- Bonuses Tab --}}
    <div class="tab" data-group="primary" data-tab="bonuses">
      <div class="form-group">
        <label>Attack Bonus</label>
        <input type="number" name="system.bonuses.attack" value="{{system.bonuses.attack}}" {{#unless isEditable}}disabled{{/unless}}/>
      </div>
      <div class="form-group">
        <label>Defense Bonus</label>
        <input type="number" name="system.bonuses.defense" value="{{system.bonuses.defense}}" {{#unless isEditable}}disabled{{/unless}}/>
      </div>
      <div class="form-group">
        <label>Damage</label>
        <input type="text" name="system.bonuses.damage" value="{{system.bonuses.damage}}" placeholder="e.g., +1d6" {{#unless isEditable}}disabled{{/unless}}/>
      </div>
      <div class="form-group">
        <label>Specials (one per line)</label>
        <textarea name="system.bonuses.specials" rows="5" {{#unless isEditable}}disabled{{/unless}}>{{#each system.bonuses.specials}}{{this}}{{#unless @last}}{{/unless}}{{/each}}</textarea>
      </div>
    </div>

    {{!-- Powers Tab --}}
    <div class="tab" data-group="primary" data-tab="powers">
      {{#if isEditable}}
      <div class="powers-header">
        <h3>Powers</h3>
        <button type="button" class="power-action" data-action="add-power">Add Power</button>
      </div>
      {{/if}}
      
      <div class="powers-list">
        {{#each powers}}
        <div class="power-item" data-power-index="{{index}}">
          <div class="power-header">
            <button type="button" class="power-toggle" data-action="toggle-power" data-index="{{index}}">
              <span class="power-name">{{name}}</span>
              <span class="power-category">({{category}})</span>
            </button>
            {{#if ../isEditable}}
            <div class="power-actions">
              <button type="button" class="power-action" data-action="duplicate-power" data-index="{{index}}" title="Duplicate">📋</button>
              <button type="button" class="power-action" data-action="delete-power" data-index="{{index}}" title="Delete">🗑️</button>
            </div>
            {{/if}}
          </div>
          
          <div class="power-editor" style="display: none;">
            <div class="power-basic-fields">
              <div class="form-group">
                <label>Name</label>
                <input type="text" name="system.powers.{{index}}.name" value="{{name}}" />
              </div>
              <div class="form-group">
                <label>Category</label>
                <select name="system.powers.{{index}}.category">
                  {{#each ../categories}}
                  <option value="{{this}}" {{#if (eq ../category this)}}selected{{/if}}>{{this}}</option>
                  {{/each}}
                </select>
              </div>
              <div class="form-group">
                <label>Tags (comma-separated)</label>
                <input type="text" name="system.powers.{{index}}.tags" value="{{tagsString}}" placeholder="spell, charged" />
              </div>
              <div class="form-group">
                <label>Action Cost</label>
                <select name="system.powers.{{index}}.cost.action">
                  {{#each ../actionCosts}}
                  <option value="{{this}}" {{#if (eq ../cost.action this)}}selected{{/if}}>{{this}}</option>
                  {{/each}}
                </select>
              </div>
              <div class="form-group">
                <label>Stones</label>
                <input type="number" name="system.powers.{{index}}.cost.stones" value="{{cost.stones}}" min="0" />
              </div>
              <div class="form-group">
                <label>Charges</label>
                <input type="number" name="system.powers.{{index}}.cost.charges" value="{{cost.charges}}" min="0" />
              </div>
              {{#if (or (eq category 'reaction') (eq category 'passive'))}}
              <div class="form-group">
                <label>Trigger</label>
                <input type="text" name="system.powers.{{index}}.trigger" value="{{trigger}}" placeholder="When..." />
              </div>
              {{/if}}
            </div>
            
            <div class="power-levels-table">
              <h4>Power Levels</h4>
              <table class="power-levels">
                <thead>
                  <tr>
                    <th>Level</th>
                    <th>Type</th>
                    <th>Range</th>
                    <th>AoE</th>
                    <th>Duration</th>
                    <th>Effect</th>
                    <th>Specials</th>
                  </tr>
                </thead>
                <tbody>
                  {{#each levelsArray}}
                  <tr data-level="{{key}}">
                    <td><strong>{{key}}</strong></td>
                    <td>
                      <input type="text" name="system.powers.{{../index}}.levels.{{key}}.type" value="{{data.type}}" placeholder="Melee, Ranged, Buff..." />
                    </td>
                    <td>
                      <select name="system.powers.{{../index}}.levels.{{key}}.range.kind">
                        <option value="">None</option>
                        {{#each ../../rangeKinds}}
                        <option value="{{this}}" {{#if (eq ../data.range.kind this)}}selected{{/if}}>{{this}}</option>
                        {{/each}}
                      </select>
                      {{#if data.range}}
                      <input type="number" name="system.powers.{{../index}}.levels.{{key}}.range.m" value="{{data.range.m}}" placeholder="m" min="0" />
                      <input type="text" name="system.powers.{{../index}}.levels.{{key}}.range.note" value="{{data.range.note}}" placeholder="note" />
                      {{/if}}
                    </td>
                    <td>
                      <select name="system.powers.{{../index}}.levels.{{key}}.aoe.shape">
                        {{#each ../../aoeShapes}}
                        <option value="{{this}}" {{#if (eq ../data.aoe.shape this)}}selected{{/if}}>{{this}}</option>
                        {{/each}}
                      </select>
                      {{#if data.aoe}}
                      <input type="number" name="system.powers.{{../index}}.levels.{{key}}.aoe.m" value="{{data.aoe.m}}" placeholder="m" min="0" />
                      <input type="text" name="system.powers.{{../index}}.levels.{{key}}.aoe.note" value="{{data.aoe.note}}" placeholder="note" />
                      {{/if}}
                    </td>
                    <td>
                      <select name="system.powers.{{../index}}.levels.{{key}}.duration.kind">
                        {{#each ../../durationKinds}}
                        <option value="{{this}}" {{#if (eq ../data.duration.kind this)}}selected{{/if}}>{{this}}</option>
                        {{/each}}
                      </select>
                      {{#if (contains (array "rounds" "masteryRounds" "masteryRankRounds") data.duration.kind)}}
                      <input type="number" name="system.powers.{{../index}}.levels.{{key}}.duration.rounds" value="{{data.duration.rounds}}" placeholder="rounds" min="1" />
                      {{/if}}
                      <input type="text" name="system.powers.{{../index}}.levels.{{key}}.duration.note" value="{{data.duration.note}}" placeholder="note" />
                    </td>
                    <td>
                      <textarea name="system.powers.{{../index}}.levels.{{key}}.effect.text" rows="2" placeholder="Effect description">{{data.effect.text}}</textarea>
                      <input type="text" name="system.powers.{{../index}}.levels.{{key}}.effect.dice" value="{{data.effect.dice}}" placeholder="dice (e.g., 4d8)" />
                    </td>
                    <td>
                      <div class="specials-list">
                        {{#each data.specials}}
                        <div class="special-item">
                          <span>{{key}}{{#if rank}}({{rank}}){{/if}}</span>
                          {{#if ../../../../isEditable}}
                          <button type="button" class="special-remove" data-action="remove-special" data-power-index="{{../../index}}" data-level-key="{{../../key}}" data-special-index="{{@index}}">×</button>
                          {{/if}}
                        </div>
                        {{/each}}
                        {{#if ../../../isEditable}}
                        <button type="button" class="special-add" data-action="add-special" data-power-index="{{../index}}" data-level-key="{{key}}">+ Add</button>
                        {{/if}}
                      </div>
                    </td>
                  </tr>
                  {{/each}}
                </tbody>
              </table>
            </div>
          </div>
        </div>
        {{/each}}
      </div>
    </div>

    {{!-- Requirements Tab --}}
    <div class="tab" data-group="primary" data-tab="requirements">
      <div class="form-group">
        <label>Stones Required</label>
        <input type="number" name="system.requirements.stones" value="{{system.requirements.stones}}" min="0" {{#unless isEditable}}disabled{{/unless}}/>
      </div>
      <div class="form-group">
        <label>Mastery Rank Required</label>
        <input type="number" name="system.requirements.masteryRank" value="{{system.requirements.masteryRank}}" min="1" {{#unless isEditable}}disabled{{/unless}}/>
      </div>
    </div>
  </section>
</form>

