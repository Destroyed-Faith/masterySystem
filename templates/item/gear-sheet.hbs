<div class="{{cssClass}} flexcol mastery-item-sheet-gear">
  <header class="sheet-header">
    <img class="profile-img" src="{{item.img}}" data-edit="img" alt="" height="64" width="64" />
    <div class="header-fields">
      <h1 class="item-name"><input name="name" type="text" value="{{item.name}}" placeholder="Gear name" /></h1>
    </div>
  </header>

  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="description">Description</a>
    <a class="item" data-tab="details">Details</a>
  </nav>

  <section class="sheet-body">
    <div class="tab description" data-group="primary" data-tab="description">
      <div class="editor-content">
        {{#if editable}}
          <prose-mirror name="system.description" value="{{system.description}}" toggled document-uuid="{{item.uuid}}">{{{enrichedDescription}}}</prose-mirror>
          {{else}}
          {{{enrichedDescription}}}
          {{/if}}
      </div>
    </div>

    <div class="tab details" data-group="primary" data-tab="details">
      <div class="form-group">
        <label>Inventory size</label>
        <input type="text" name="system.inventorySize" value="{{system.inventorySize}}" placeholder="1x1" />
      </div>
      <div class="form-group">
        <label>Weight</label>
        <input type="number" name="system.weight" value="{{system.weight}}" data-dtype="Number" min="0" step="0.1" />
      </div>
      <div class="form-group">
        <label>Quantity</label>
        <input type="number" name="system.quantity" value="{{system.quantity}}" data-dtype="Number" min="0" step="1" />
      </div>
      {{#if system.ammunition}}
      <div class="form-group">
        <label>{{localize "MASTERY.ammunition.label"}}</label>
        <input type="text" name="system.ammunitionType" value="{{system.ammunitionType}}" />
      </div>
      <div class="form-group">
        <label>Max stack</label>
        <input type="number" name="system.maxStack" value="{{system.maxStack}}" data-dtype="Number" min="1" step="1" />
      </div>
      {{/if}}
      {{#if system.ammoContainer}}
      <div class="form-group">
        <label>{{localize "MASTERY.ammunition.label"}}</label>
        <div>{{localize "MASTERY.ammunition.display" current=system.currentAmmunition max=system.capacity}}</div>
      </div>
      <div class="form-group">
        <label>{{localize "MASTERY.ammunition.capacity"}}</label>
        <input type="number" name="system.capacity" value="{{system.capacity}}" data-dtype="Number" min="1" step="1" />
      </div>
      <div class="form-group">
        <label>{{localize "MASTERY.ammunition.label"}} (current)</label>
        <input type="number" name="system.currentAmmunition" value="{{system.currentAmmunition}}" data-dtype="Number" min="0" step="1" />
      </div>
      <div class="form-group">
        <label>{{localize "MASTERY.ammunition.label"}} type</label>
        <input type="text" name="system.ammunitionType" value="{{system.ammunitionType}}" />
      </div>
      {{/if}}
    </div>
  </section>
</div>
