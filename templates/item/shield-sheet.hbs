<form class="{{cssClass}} flexcol mastery-item-sheet-shield" autocomplete="off">
  <header class="sheet-header">
    <img class="profile-img" src="{{item.img}}" data-edit="img" alt="" height="64" width="64" />
    <div class="header-fields">
      <h1 class="item-name"><input name="name" type="text" value="{{item.name}}" placeholder="Shield name" /></h1>
    </div>
  </header>

  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="description">Description</a>
    <a class="item" data-tab="mechanics">Mechanics</a>
  </nav>

  <section class="sheet-body">
    <div class="tab description" data-group="primary" data-tab="description">
      <div class="editor-content">
        {{editor system.description target="system.description" button=true owner=owner editable=editable}}
      </div>
    </div>

    <div class="tab mechanics" data-group="primary" data-tab="mechanics">
      <div class="form-group">
        <label>Shield type</label>
        <select name="system.type" data-dtype="String">
          <option value="parry" {{#if (eq shieldTypeUi "parry")}}selected{{/if}}>Parry</option>
          <option value="medium" {{#if (eq shieldTypeUi "medium")}}selected{{/if}}>Medium</option>
          <option value="tower" {{#if (eq shieldTypeUi "tower")}}selected{{/if}}>Tower</option>
        </select>
      </div>
      <div class="form-group">
        <label>Shield value</label>
        <input type="number" name="system.shieldValue" value="{{system.shieldValue}}" data-dtype="Number" min="0" step="1" />
      </div>
      <div class="form-group">
        <label>Evade modifier</label>
        <input type="number" name="system.evadeBonus" value="{{system.evadeBonus}}" data-dtype="Number" step="1" />
      </div>
      <p class="notes">Stores <strong>parry</strong>, <strong>medium</strong>, or <strong>tower</strong> (legacy items with light/heavy are still recognized).</p>
    </div>
  </section>
</form>
