<form class="{{cssClass}} flexcol" autocomplete="off">
  {{!-- Sheet Header --}}
  <header class="sheet-header">
    <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" height="64" width="64"/>
    <div class="header-fields">
      <h1 class="charname"><input name="name" type="text" value="{{item.name}}" placeholder="Artifact Name"/></h1>
    </div>
  </header>

  {{!-- Sheet Tab Navigation --}}
  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="description">Description</a>
    <a class="item" data-tab="bonuses">Bonuses</a>
    <a class="item" data-tab="requirements">Requirements</a>
  </nav>

  {{!-- Sheet Body --}}
  <section class="sheet-body">
    {{!-- Description Tab --}}
    <div class="tab" data-group="primary" data-tab="description">
      <div class="form-group">
        <label>Level</label>
        <input type="number" name="system.level" value="{{system.level}}" min="1"/>
      </div>
      <div class="form-group">
        <label>Description</label>
        <textarea name="system.description" rows="5">{{system.description}}</textarea>
      </div>
      <div class="form-group">
        <label>Lore</label>
        <textarea name="system.lore" rows="5">{{system.lore}}</textarea>
      </div>
    </div>

    {{!-- Bonuses Tab --}}
    <div class="tab" data-group="primary" data-tab="bonuses">
      <div class="form-group">
        <label>Attack Bonus</label>
        <input type="number" name="system.bonuses.attack" value="{{system.bonuses.attack}}"/>
      </div>
      <div class="form-group">
        <label>Defense Bonus</label>
        <input type="number" name="system.bonuses.defense" value="{{system.bonuses.defense}}"/>
      </div>
      <div class="form-group">
        <label>Damage</label>
        <input type="text" name="system.bonuses.damage" value="{{system.bonuses.damage}}" placeholder="e.g., +1d6"/>
      </div>
      <div class="form-group">
        <label>Specials (one per line)</label>
        <textarea name="system.bonuses.specials" rows="5">{{#each system.bonuses.specials}}{{this}}{{#unless @last}}{{/unless}}{{/each}}</textarea>
      </div>
    </div>

    {{!-- Requirements Tab --}}
    <div class="tab" data-group="primary" data-tab="requirements">
      <div class="form-group">
        <label>Stones Required</label>
        <input type="number" name="system.requirements.stones" value="{{system.requirements.stones}}" min="0"/>
      </div>
      <div class="form-group">
        <label>Mastery Rank Required</label>
        <input type="number" name="system.requirements.masteryRank" value="{{system.requirements.masteryRank}}" min="1"/>
      </div>
    </div>
  </section>
</form>

