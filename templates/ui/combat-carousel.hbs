<div class="mastery-carousel {{#if active}}is-active{{/if}} {{#if compact}}is-compact{{/if}} {{#if topBar.show}}is-preparing{{/if}}">
  {{#if active}}
    <div class="ms-carousel-toolbar">
      {{#if topBar.show}}
      <div class="ms-carousel-prepare-bar{{#if topBar.isRoundGate}} is-round-gate{{/if}}">
        <span class="ms-carousel-prepare-label">{{topBar.label}}</span>
        {{#if topBar.showPrepareButtons}}
        <button type="button" class="ms-carousel-prepare-btn js-roll-npc-ini" title="{{localize 'MASTERY.encounterSetup.rollNpcIni'}}">
          <i class="fas fa-dice"></i> {{localize "MASTERY.encounterSetup.rollNpcIni"}}
        </button>
        <button type="button" class="ms-carousel-prepare-btn is-start js-start-live-combat" {{#unless canStartLive}}disabled{{/unless}} title="{{startBlockedReason}}">
          <i class="fas fa-play"></i> {{localize "MASTERY.encounterSetup.startCombat"}}
        </button>
        {{/if}}
        {{#if topBar.showStartRound}}
        <button type="button" class="ms-carousel-prepare-btn is-start js-start-round" title="{{localize 'MASTERY.encounterSetup.startRoundHint'}}">
          <i class="fas fa-play"></i> {{topBar.startRoundLabel}}
        </button>
        {{/if}}
        {{#if topBar.showShutdown}}
        <button type="button" class="ms-carousel-prepare-btn is-shutdown js-shutdown-combat" title="{{localize 'MASTERY.combatShutdown.hint'}}">
          <i class="fas fa-power-off"></i> {{localize "MASTERY.combatShutdown.button"}}
        </button>
        {{/if}}
      </div>
      {{else}}
      <div class="ms-carousel-prepare-bar ms-carousel-prepare-bar-spacer" aria-hidden="true"></div>
      {{/if}}
      <div class="carousel-utility-btns">
        {{#if controlsAllowed}}
        <button type="button" class="carousel-settings-cog js-save-combat" title="{{localize 'MASTERY.combatSnapshot.saveHint'}}" aria-label="{{localize 'MASTERY.combatSnapshot.save'}}">
          <i class="fas fa-download"></i>
        </button>
        <button type="button" class="carousel-settings-cog js-load-combat" title="{{localize 'MASTERY.combatSnapshot.loadHint'}}" aria-label="{{localize 'MASTERY.combatSnapshot.load'}}">
          <i class="fas fa-upload"></i>
        </button>
        {{/if}}
        <button type="button" class="carousel-settings-cog js-carousel-settings" title="Carousel settings" aria-label="Carousel settings">
          <i class="fas fa-cog"></i>
        </button>
      </div>
    </div>
    {{#unless preparing}}
    {{#if stonesReady}}
    {{#if controlsAllowed}}
    <!-- Left Controls (shown on hover) — GM only -->
    <div class="carousel-controls carousel-controls-left">
      <button type="button" class="carousel-control-btn js-prev-turn" title="Previous Turn" aria-label="Previous Turn">
        <i class="fas fa-chevron-left"></i>
      </button>
    </div>
    {{/if}}
    {{/if}}
    {{/unless}}

    <!-- Combatants Row -->
    <div class="carousel-combatants">
      {{#each combatants as |combatant|}}
        <div class="carousel-combatant{{#if combatant.isCurrent}} is-current{{/if}}{{#if combatant.isNext}} is-next{{/if}}{{#if combatant.showSideHp}} has-side-hp{{/if}}" data-combatant-id="{{combatant.id}}">
        <div class="carousel-portrait {{#if combatant.isCurrent}}is-current{{/if}}{{#if combatant.isNext}} is-next{{/if}} {{#if combatant.defeated}}is-defeated{{/if}} {{#if combatant.hidden}}is-hidden{{/if}} {{combatant.dispositionClass}}{{#if combatant.showSideHp}} has-side-hp{{/if}}"
             data-combatant-id="{{combatant.id}}">
          <div class="carousel-portrait-body">
          {{#if combatant.richTooltip}}
          <div class="ms-carousel-rich-tip" hidden>
            <strong class="ms-carousel-rich-tip-title">{{combatant.richTooltip.title}}</strong>
            {{#each combatant.richTooltip.lines as |line|}}
              <div class="ms-carousel-rich-tip-line">{{line}}</div>
            {{/each}}
          </div>
          {{/if}}
          <!-- Portrait Image — click opens the character sheet -->
          <div class="portrait-image" title="{{combatant.name}} — open character sheet">
            <img src="{{combatant.img}}" alt="{{combatant.name}}" />
            {{#if combatant.isCurrent}}
              <div class="current-indicator"></div>
            {{/if}}
            {{#if combatant.isNext}}
              <div class="next-indicator" title="Next Turn">Next</div>
            {{/if}}
          </div>

          <!-- Initiative Badge — GM click opens edit dialog for the whole order -->
          <div class="initiative-badge{{#if ../controlsAllowed}} is-editable js-edit-initiative{{/if}}{{#if combatant.stoneReady}} is-stone-ready{{/if}}{{#if combatant.stonePending}} is-stone-pending{{/if}}"
               {{#if ../controlsAllowed}}title="{{localize 'MASTERY.carousel.editInitiativeHint'}}" role="button" tabindex="0"{{/if}}>
            {{#if combatant.stoneReady}}
            <span class="ms-stone-ready-mark" title="Stone assignment confirmed">✓</span>
            {{else if combatant.stonePending}}
            <span class="ms-stone-ready-mark is-pending" title="Stone assignment still open">✗</span>
            {{/if}}
            {{combatant.initiative}}
          </div>

          {{#if combatant.reactionTotal}}
          {{#unless combatant.showGmActionRefund}}
          <div class="ms-carousel-reactions" title="{{localize 'MASTERY.carousel.reactionsHint'}}">
            R <strong>{{combatant.reactionRemaining}}</strong>/{{combatant.reactionTotal}}
          </div>
          {{/unless}}
          {{/if}}

          {{#if combatant.showGmActionRefund}}
          <div class="ms-carousel-action-refund" title="{{localize 'MASTERY.carousel.refundHint'}}">
            <span class="ms-car-act" title="{{localize 'MASTERY.carousel.attackActions'}}">A <strong>{{combatant.attackRemaining}}</strong>/{{combatant.attackTotal}}</span>
            <span class="ms-car-act" title="{{localize 'MASTERY.carousel.movementActions'}}">M <strong>{{combatant.movementRemaining}}</strong>/{{combatant.movementTotal}}</span>
            <span class="ms-car-act" title="{{localize 'MASTERY.carousel.reactionActions'}}">R <strong>{{combatant.reactionRemaining}}</strong>/{{combatant.reactionTotal}}</span>
            <button type="button" class="ms-car-refund js-refund-action" data-kind="attack" {{#unless combatant.canRefundAttack}}disabled{{/unless}} title="{{localize 'MASTERY.carousel.refundAttack'}}" aria-label="{{localize 'MASTERY.carousel.refundAttack'}}">+A</button>
            <button type="button" class="ms-car-refund js-refund-action" data-kind="movement" {{#unless combatant.canRefundMovement}}disabled{{/unless}} title="{{localize 'MASTERY.carousel.refundMovement'}}" aria-label="{{localize 'MASTERY.carousel.refundMovement'}}">+M</button>
            <button type="button" class="ms-car-refund js-refund-action" data-kind="reaction" {{#unless combatant.canRefundReaction}}disabled{{/unless}} title="{{localize 'MASTERY.carousel.refundReaction'}}" aria-label="{{localize 'MASTERY.carousel.refundReaction'}}">+R</button>
          </div>
          {{/if}}

          <!-- Name — opens Stone Powers (Passives live in that dialog) -->
          <div class="portrait-name js-open-stone-powers" title="{{localize 'MASTERY.encounterSetup.stones'}}">{{combatant.name}}</div>

          {{#if combatant.combatStrip}}
          <div class="ms-carousel-combat-strip" title="{{#if combatant.combatStrip.stripTooltip}}{{combatant.combatStrip.stripTooltip}}{{else}}Aktuelle Kampfwerte (Rüstung / Evade / DR%) — Hover für Herkunft{{/if}}">
            <span class="ms-cs ms-cs-arm" title="Armor total">A <strong>{{combatant.combatStrip.armor}}</strong></span>
            <span class="ms-cs ms-cs-ev" title="Evade total">E <strong>{{combatant.combatStrip.evade}}</strong></span>
            <span class="ms-cs ms-cs-dr" title="Damage reduction %">DR <strong>{{combatant.combatStrip.drPct}}%</strong></span>
          </div>
          {{/if}}

          <!-- Status Icons stay under the portrait -->
          {{#if combatant.statusIcons}}
            <div class="status-icons">
              {{#each combatant.statusIcons as |statusIcon|}}
                {{#if (isObject statusIcon)}}
                  <img src="{{statusIcon.icon}}"
                    alt="{{statusIcon.name}}"
                    class="{{#if statusIcon.cssClass}}{{statusIcon.cssClass}}{{else}}status-icon{{/if}}"
                    data-icon-kind="{{statusIcon.kind}}"
                    data-tooltip="{{#if statusIcon.tooltip}}{{statusIcon.tooltip}}{{else}}{{statusIcon.name}}{{/if}}" />
                {{else}}
                <img src="{{statusIcon}}" alt="Status" class="status-icon" />
                {{/if}}
              {{/each}}
            </div>
          {{/if}}

          </div>

          {{#if combatant.showSideHp}}
          <aside class="ms-hp-rail" aria-label="Health">
            {{#if combatant.tempHP}}
            <span class="ms-hp-temp" title="Temporary HP">+{{combatant.tempHP}}</span>
            {{/if}}
            {{#if combatant.hpScarredCount}}
            <span class="ms-hp-scarred-count" title="Scarred Health Bars">{{combatant.hpScarredCount}}</span>
            {{/if}}
            <div class="ms-hp-rail-track">
              {{#each combatant.hpSegments as |seg|}}
                <div class="ms-hp-segment ms-hp-severity-{{seg.severity}}{{#if seg.scarred}} is-scarred{{/if}}"
                     style="flex-grow: {{seg.widthPct}}"
                     title="{{seg.hoverTitle}}: {{seg.current}}/{{seg.max}}">
                  {{#if seg.max}}
                    {{#unless seg.scarred}}
                    {{#with (divide seg.current seg.max)}}
                      <div class="ms-hp-segment-fill" style="height: {{multiply this 100}}%"></div>
                    {{/with}}
                    {{/unless}}
                  {{/if}}
                </div>
              {{/each}}
            </div>
          </aside>
          {{/if}}

          <!-- Above the Health rail so hover controls stay clickable -->
          <div class="portrait-controls">
            {{#if ../controlsAllowed}}
              <button type="button" class="portrait-control-btn js-toggle-defeated" title="{{localize 'MASTERY.carousel.toggleDefeated'}}" aria-label="{{localize 'MASTERY.carousel.toggleDefeated'}}">
                <i class="fas fa-skull"></i>
              </button>
              <button type="button" class="portrait-control-btn js-toggle-hidden" title="{{localize 'MASTERY.carousel.toggleHidden'}}" aria-label="{{localize 'MASTERY.carousel.toggleHidden'}}">
                <i class="fas fa-eye-slash"></i>
              </button>
              <button type="button" class="portrait-control-btn js-remove-combatant" title="{{localize 'MASTERY.carousel.removeCombatant'}}" aria-label="{{localize 'MASTERY.carousel.removeCombatant'}}">
                <i class="fas fa-user-minus"></i>
              </button>
            {{/if}}
            {{#if combatant.hasToken}}
              <button type="button" class="portrait-control-btn js-ping" title="Ping Token" aria-label="Ping Token">
                <i class="fas fa-bullseye"></i>
              </button>
            {{/if}}
          </div>
        </div>

          <!-- Sibling of the portrait so a click ends the turn instead of opening the sheet -->
          {{#if combatant.showEndTurn}}
            <button type="button" class="portrait-end-turn js-end-turn" data-action="msEndTurn" title="Next entry in the Initiative tracker (advance one turn)." aria-label="Next Turn">
              <i class="fas fa-forward"></i>
              <span>Next Turn</span>
            </button>
          {{/if}}

          {{#if combatant.favoritePowers.length}}
          <div class="ms-carousel-favorites" data-combatant-id="{{combatant.id}}">
            {{#each combatant.favoritePowers as |fav|}}
              <button type="button" class="ms-car-fav js-favorite-power{{#if fav.disabled}} is-disabled{{/if}}" data-item-id="{{fav.id}}" title="{{fav.name}}{{#if fav.used}} (used this round){{/if}}" {{#if fav.disabled}}disabled{{/if}}>
                <img src="{{fav.img}}" alt="{{fav.name}}" />
              </button>
            {{/each}}
          </div>
          {{/if}}
        </div>
      {{/each}}
    </div>

    <!-- Right Controls (shown on hover) -->
    <div class="carousel-controls carousel-controls-right">
      {{#unless preparing}}
      {{#if stonesReady}}
      {{#if nextCombatant}}
      <button type="button" class="carousel-next-chip js-pan-next" data-combatant-id="{{nextCombatant.id}}" title="Next: {{nextCombatant.name}}" aria-label="Next: {{nextCombatant.name}}">
        <img src="{{nextCombatant.img}}" alt="" />
        <span>Next</span>
      </button>
      {{/if}}
      {{#if controlsAllowed}}
      <button type="button" class="carousel-control-btn js-next-turn" title="Next Turn" aria-label="Next Turn">
        <i class="fas fa-chevron-right"></i>
      </button>
      <button type="button" class="carousel-control-btn js-next-round" title="Next Round" aria-label="Next Round">
        <i class="fas fa-forward"></i>
      </button>
      {{else if showPlayerEndTurn}}
      <button type="button" class="carousel-control-btn js-next-turn js-end-turn" data-action="msEndTurn" title="Next entry in the Initiative tracker (advance one turn)." aria-label="Next Turn">
        <i class="fas fa-chevron-right"></i>
      </button>
      {{/if}}
      {{/if}}
      {{/unless}}
      {{#if controlsAllowed}}
        <button type="button" class="carousel-control-btn js-add-combatants" title="{{localize 'MASTERY.carousel.addCombatants'}}" aria-label="{{localize 'MASTERY.carousel.addCombatants'}}">
          <i class="fas fa-user-plus"></i>
        </button>
        <button type="button" class="carousel-control-btn js-force-all-setup" data-kind="passives" title="{{localize 'MASTERY.encounterSetup.forceAllPassives'}}" aria-label="{{localize 'MASTERY.encounterSetup.forceAllPassives'}}">
          <i class="fas fa-shield"></i>
        </button>
        <button type="button" class="carousel-control-btn js-force-all-setup" data-kind="stones" title="{{localize 'MASTERY.encounterSetup.forceAllStones'}}" aria-label="{{localize 'MASTERY.encounterSetup.forceAllStones'}}">
          <i class="fas fa-gem"></i>
        </button>
        <button type="button" class="carousel-control-btn js-end-combat" title="{{localize 'MASTERY.carousel.endCombat'}}" aria-label="{{localize 'MASTERY.carousel.endCombat'}}">
          <i class="fas fa-stop"></i>
        </button>
      {{/if}}
    </div>
    <button type="button" class="carousel-resize-handle js-carousel-resize" title="{{localize 'MASTERY.carousel.resizeHint'}}" aria-label="{{localize 'MASTERY.carousel.resizeHint'}}"></button>
  {{/if}}
</div>

