<div class="mastery-carousel {{#if active}}is-active{{/if}} {{#if compact}}is-compact{{/if}} {{#if topBar.show}}is-preparing{{/if}}">
  {{#if active}}
    <button type="button" class="carousel-settings-cog js-carousel-settings" title="Carousel settings" aria-label="Carousel settings">
      <i class="fas fa-cog"></i>
    </button>
    {{#if topBar.show}}
    <div class="ms-carousel-prepare-bar{{#if topBar.isRoundGate}} is-round-gate{{/if}}">
      <span class="ms-carousel-prepare-label">{{topBar.label}}</span>
      {{#if topBar.showPrepareButtons}}
      <button type="button" class="ms-carousel-prepare-btn js-roll-npc-ini" title="{{localize 'MASTERY.encounterSetup.rollNpcIni'}}">
        <i class="fas fa-dice"></i> {{localize "MASTERY.encounterSetup.rollNpcIni"}}
      </button>
      <button type="button" class="ms-carousel-prepare-btn is-start js-start-live-combat" {{#unless canStartLive}}disabled{{/unless}} title="{{startBlockedReason}}">
        <i class="fas fa-play"></i> {{localize "MASTERY.encounterSetup.startCombat"}}
      </button>
      {{/if}}
      {{#if topBar.showStartRound}}
      <button type="button" class="ms-carousel-prepare-btn is-start js-start-round" title="{{localize 'MASTERY.encounterSetup.startRoundHint'}}">
        <i class="fas fa-play"></i> {{topBar.startRoundLabel}}
      </button>
      {{/if}}
      {{#if topBar.showShutdown}}
      <button type="button" class="ms-carousel-prepare-btn is-shutdown js-shutdown-combat" title="{{localize 'MASTERY.combatShutdown.hint'}}">
        <i class="fas fa-power-off"></i> {{localize "MASTERY.combatShutdown.button"}}
      </button>
      {{/if}}
    </div>
    {{/if}}
    {{#unless preparing}}
    {{#if stonesReady}}
    {{#if controlsAllowed}}
    <!-- Left Controls (shown on hover) — GM only -->
    <div class="carousel-controls carousel-controls-left">
      <button type="button" class="carousel-control-btn js-prev-turn" data-tooltip="Previous Turn" aria-label="Previous Turn">
        <i class="fas fa-chevron-left"></i>
      </button>
    </div>
    {{/if}}
    {{/if}}
    {{/unless}}

    <!-- Combatants Row -->
    <div class="carousel-combatants">
      {{#each combatants as |combatant|}}
        <div class="carousel-combatant{{#if combatant.isCurrent}} is-current{{/if}}{{#if combatant.isNext}} is-next{{/if}}" data-combatant-id="{{combatant.id}}">
        <div class="carousel-portrait {{#if combatant.isCurrent}}is-current{{/if}}{{#if combatant.isNext}} is-next{{/if}} {{#if combatant.defeated}}is-defeated{{/if}} {{#if combatant.hidden}}is-hidden{{/if}} {{combatant.dispositionClass}}" 
             data-combatant-id="{{combatant.id}}">
          {{#if combatant.richTooltip}}
          <div class="ms-carousel-rich-tip" hidden>
            <strong class="ms-carousel-rich-tip-title">{{combatant.richTooltip.title}}</strong>
            {{#each combatant.richTooltip.lines as |line|}}
              <div class="ms-carousel-rich-tip-line">{{line}}</div>
            {{/each}}
          </div>
          {{/if}}
          <!-- Portrait Image -->
          <div class="portrait-image">
            <img src="{{combatant.img}}" alt="{{combatant.name}}" />
            {{#if combatant.isCurrent}}
              <div class="current-indicator"></div>
            {{/if}}
            {{#if combatant.isNext}}
              <div class="next-indicator" title="Next Turn">Next</div>
            {{/if}}
          </div>

          <!-- Initiative Badge -->
          <div class="initiative-badge">{{combatant.initiative}}</div>

          {{#if combatant.reactionTotal}}
          {{#unless combatant.showGmActionRefund}}
          <div class="ms-carousel-reactions" title="{{localize 'MASTERY.carousel.reactionsHint'}}">
            R <strong>{{combatant.reactionRemaining}}</strong>/{{combatant.reactionTotal}}
          </div>
          {{/unless}}
          {{/if}}

          {{#if combatant.showGmActionRefund}}
          <div class="ms-carousel-action-refund" title="{{localize 'MASTERY.carousel.refundHint'}}">
            <span class="ms-car-act" title="{{localize 'MASTERY.carousel.attackActions'}}">A <strong>{{combatant.attackRemaining}}</strong>/{{combatant.attackTotal}}</span>
            <span class="ms-car-act" title="{{localize 'MASTERY.carousel.movementActions'}}">M <strong>{{combatant.movementRemaining}}</strong>/{{combatant.movementTotal}}</span>
            <span class="ms-car-act" title="{{localize 'MASTERY.carousel.reactionActions'}}">R <strong>{{combatant.reactionRemaining}}</strong>/{{combatant.reactionTotal}}</span>
            <button type="button" class="ms-car-refund js-refund-action" data-kind="attack" {{#unless combatant.canRefundAttack}}disabled{{/unless}} title="{{localize 'MASTERY.carousel.refundAttack'}}" aria-label="{{localize 'MASTERY.carousel.refundAttack'}}">+A</button>
            <button type="button" class="ms-car-refund js-refund-action" data-kind="movement" {{#unless combatant.canRefundMovement}}disabled{{/unless}} title="{{localize 'MASTERY.carousel.refundMovement'}}" aria-label="{{localize 'MASTERY.carousel.refundMovement'}}">+M</button>
            <button type="button" class="ms-car-refund js-refund-action" data-kind="reaction" {{#unless combatant.canRefundReaction}}disabled{{/unless}} title="{{localize 'MASTERY.carousel.refundReaction'}}" aria-label="{{localize 'MASTERY.carousel.refundReaction'}}">+R</button>
          </div>
          {{/if}}

          <!-- Name — opens Stone Powers (Passives live in that dialog) -->
          <div class="portrait-name js-open-stone-powers" title="{{localize 'MASTERY.encounterSetup.stones'}}">{{combatant.name}}</div>

          {{#if combatant.weaponSets}}
          <div class="ms-carousel-weapon-sets" title="Active weapon set">
            <button type="button" class="ms-car-wset js-weapon-set{{#if combatant.weaponSets.isSet1}} is-active{{/if}}" data-set="1" title="{{combatant.weaponSets.set1Title}}" {{#unless combatant.weaponSets.canSwap}}disabled{{/unless}}>1</button>
            <button type="button" class="ms-car-wset js-weapon-set{{#if combatant.weaponSets.isSet2}} is-active{{/if}}" data-set="2" title="{{combatant.weaponSets.set2Title}}" {{#unless combatant.weaponSets.canSwap}}disabled{{/unless}}>2</button>
          </div>
          {{/if}}

          {{#if combatant.moveStrip}}
          <div class="ms-carousel-move-strip" title="Movement actions and meters">
            <span class="ms-car-move">M <strong>{{combatant.moveStrip.movementRemaining}}</strong>/{{combatant.moveStrip.movementTotal}}</span>
            {{#if combatant.moveStrip.moveActive}}
              <span class="ms-car-move is-live"><strong>{{combatant.moveStrip.remainingMeters}}</strong> m left</span>
            {{else}}
              <span class="ms-car-move">{{combatant.moveStrip.speedMeters}} m</span>
            {{/if}}
            {{#if combatant.moveStrip.safeMeters}}
              <span class="ms-car-move-badge" title="Safe Movement armed">Safe {{combatant.moveStrip.safeMeters}} m</span>
            {{/if}}
            {{#if combatant.moveStrip.slipMeters}}
              <span class="ms-car-move-badge" title="Slip armed">Slip {{combatant.moveStrip.slipMeters}} m</span>
            {{/if}}
          </div>
          {{/if}}

          {{#if combatant.combatStrip}}
          <div class="ms-carousel-combat-strip" title="{{#if combatant.combatStrip.stripTooltip}}{{combatant.combatStrip.stripTooltip}}{{else}}Aktuelle Kampfwerte (Rüstung / Evade / DR%) — Hover für Herkunft{{/if}}">
            <span class="ms-cs ms-cs-arm" title="Armor total">A <strong>{{combatant.combatStrip.armor}}</strong></span>
            <span class="ms-cs ms-cs-ev" title="Evade total">E <strong>{{combatant.combatStrip.evade}}</strong></span>
            <span class="ms-cs ms-cs-dr" title="Damage reduction %">DR <strong>{{combatant.combatStrip.drPct}}%</strong></span>
          </div>
          {{/if}}

          <!-- Segmented HP Bar. Top line is only for cushions (Temp HP, Guard). -->
          {{#if combatant.hpSegments.length}}
            <div class="ms-hp-bar">
              <div class="ms-hp-bar-header">
                {{#unless combatant.hideHpNumbers}}
                {{#if combatant.tempHP}}<span class="ms-hp-temp{{#if combatant.canEditVitals}} js-edit-temp-hp{{/if}}" data-actor-id="{{combatant.actorId}}" data-temp="{{combatant.tempHP}}" title="Temporary HP{{#if combatant.canEditVitals}} — click to edit{{/if}}">+{{combatant.tempHP}}</span>{{/if}}
                {{#if combatant.hpScarredCount}}<span class="ms-hp-scarred-count" title="Scarred Health Bars — empty until Remove Scar">Scarred {{combatant.hpScarredCount}}</span>{{/if}}
                {{/unless}}
              </div>
              <div class="ms-hp-bar-track">
                {{#each combatant.hpSegments as |seg|}}
                  <div class="ms-hp-segment ms-hp-severity-{{seg.severity}}{{#if seg.scarred}} is-scarred{{/if}}{{#if ../canEditVitals}} js-edit-hp-bar{{/if}}"
                       style="flex-basis: {{seg.widthPct}}%"
                       data-actor-id="{{../actorId}}"
                       data-bar-index="{{@index}}"
                       data-current="{{seg.current}}"
                       data-max="{{seg.max}}"
                       data-scarred="{{#if seg.scarred}}1{{else}}0{{/if}}"
                       title="{{#unless ../hideHpNumbers}}{{seg.hoverTitle}}{{else}}{{seg.name}}{{/unless}}{{#if ../canEditVitals}} — click to edit{{/if}}">
                    {{#if seg.max}}
                      {{#unless seg.scarred}}
                      {{#with (divide seg.current seg.max)}}
                        <div class="ms-hp-segment-fill" style="width: {{multiply this 100}}%"></div>
                      {{/with}}
                      {{/unless}}
                    {{/if}}
                  </div>
                {{/each}}
              </div>
              <div class="ms-hp-scar-legend" aria-hidden="true">
                {{#each combatant.hpSegments as |seg|}}
                  <span class="ms-hp-legend-name{{#if seg.scarred}} is-scarred{{/if}}"
                        style="flex-basis: {{seg.widthPct}}%"
                        title="{{#unless ../hideHpNumbers}}{{seg.hoverTitle}}{{else}}{{seg.name}}{{/unless}}">{{seg.penaltyLabel}}</span>
                {{/each}}
              </div>
            </div>
          {{/if}}

          <!-- Segmented Stress Bar (same layout as HP; stress severity colors) -->
          {{#if combatant.stressSegments.length}}
            <div class="ms-hp-bar ms-stress-bar"{{#unless combatant.hideHpNumbers}} title="Stress: {{combatant.stressTotalCurrent}}/{{combatant.stressTotalMax}}"{{else}} title="Stress"{{/unless}}>
              <div class="ms-hp-bar-header">
                <span class="ms-hp-bar-label">Stress</span>
                {{#unless combatant.hideHpNumbers}}
                <span class="ms-hp-bar-totals">
                  {{combatant.stressTotalCurrent}}/{{combatant.stressTotalMax}}
                </span>
                {{/unless}}
              </div>
              <div class="ms-hp-bar-track">
                {{#each combatant.stressSegments as |seg|}}
                  <div class="ms-hp-segment ms-stress-severity-{{seg.severity}}{{#if ../canEditVitals}} js-edit-stress-bar{{/if}}"
                       style="flex-basis: {{seg.widthPct}}%"
                       data-actor-id="{{../actorId}}"
                       data-bar-index="{{@index}}"
                       data-current="{{seg.current}}"
                       data-max="{{seg.max}}"
                       title="{{#unless ../hideHpNumbers}}{{seg.name}}: {{seg.current}}/{{seg.max}}{{else}}{{seg.name}}{{/unless}}{{#if ../canEditVitals}} — click to edit{{/if}}">
                    {{#if seg.max}}
                      {{#with (divide seg.current seg.max)}}
                        <div class="ms-hp-segment-fill" style="width: {{multiply this 100}}%"></div>
                      {{/with}}
                    {{/if}}
                  </div>
                {{/each}}
              </div>
            </div>
          {{/if}}

          <!-- Status Icons -->
          {{#if combatant.statusIcons}}
            <div class="status-icons">
              {{#each combatant.statusIcons as |statusIcon|}}
                {{#if (isObject statusIcon)}}
                  <img src="{{statusIcon.icon}}"
                    alt="{{statusIcon.name}}"
                    class="{{#if statusIcon.cssClass}}{{statusIcon.cssClass}}{{else}}status-icon{{/if}}"
                    data-icon-kind="{{statusIcon.kind}}"
                    data-tooltip="{{#if statusIcon.tooltip}}{{statusIcon.tooltip}}{{else}}{{statusIcon.name}}{{/if}}" />
                {{else}}
                <img src="{{statusIcon}}" alt="Status" class="status-icon" />
                {{/if}}
              {{/each}}
            </div>
          {{/if}}

          <!-- Portrait Controls (shown on hover) -->
          <div class="portrait-controls">
            {{#if ../controlsAllowed}}
              <button type="button" class="portrait-control-btn js-toggle-defeated" data-tooltip="Toggle Defeated" aria-label="Toggle Defeated">
                <i class="fas fa-skull"></i>
              </button>
            {{/if}}
            {{#if ../controlsAllowed}}
              <button type="button" class="portrait-control-btn js-toggle-hidden" data-tooltip="Toggle Hidden" aria-label="Toggle Hidden">
                <i class="fas fa-eye-slash"></i>
              </button>
            {{/if}}
            {{#if combatant.hasToken}}
              <button type="button" class="portrait-control-btn js-ping" data-tooltip="Ping Token" aria-label="Ping Token">
                <i class="fas fa-bullseye"></i>
              </button>
            {{/if}}
          </div>
        </div>

          <!-- Sibling of the portrait so a click ends the turn instead of opening the sheet -->
          {{#if combatant.showEndTurn}}
            <button type="button" class="portrait-end-turn js-end-turn" data-action="msEndTurn" data-tooltip="Next entry in the Initiative tracker (advance one turn)." aria-label="Next Turn">
              <i class="fas fa-forward"></i>
              <span>Next Turn</span>
            </button>
          {{/if}}

          {{#if combatant.favoritePowers.length}}
          <div class="ms-carousel-favorites" data-combatant-id="{{combatant.id}}">
            {{#each combatant.favoritePowers as |fav|}}
              <button type="button" class="ms-car-fav js-favorite-power{{#if fav.disabled}} is-disabled{{/if}}" data-item-id="{{fav.id}}" title="{{fav.name}}{{#if fav.used}} (used this round){{/if}}" {{#if fav.disabled}}disabled{{/if}}>
                <img src="{{fav.img}}" alt="{{fav.name}}" />
              </button>
            {{/each}}
          </div>
          {{/if}}
        </div>
      {{/each}}
    </div>

    <!-- Right Controls (shown on hover) -->
    <div class="carousel-controls carousel-controls-right">
      {{#unless preparing}}
      {{#if stonesReady}}
      {{#if nextCombatant}}
      <button type="button" class="carousel-next-chip js-pan-next" data-combatant-id="{{nextCombatant.id}}" title="Next: {{nextCombatant.name}}" aria-label="Next: {{nextCombatant.name}}">
        <img src="{{nextCombatant.img}}" alt="" />
        <span>Next</span>
      </button>
      {{/if}}
      {{#if controlsAllowed}}
      <button type="button" class="carousel-control-btn js-next-turn" data-tooltip="Next Turn" aria-label="Next Turn">
        <i class="fas fa-chevron-right"></i>
      </button>
      <button type="button" class="carousel-control-btn js-next-round" data-tooltip="Next Round" aria-label="Next Round">
        <i class="fas fa-forward"></i>
      </button>
      {{else if showPlayerEndTurn}}
      <button type="button" class="carousel-control-btn js-next-turn js-end-turn" data-action="msEndTurn" data-tooltip="Next entry in the Initiative tracker (advance one turn)." aria-label="Next Turn">
        <i class="fas fa-chevron-right"></i>
      </button>
      {{/if}}
      {{/if}}
      {{/unless}}
      {{#if controlsAllowed}}
        <button type="button" class="carousel-control-btn js-force-all-setup" data-kind="passives" data-tooltip="{{localize 'MASTERY.encounterSetup.forceAllPassives'}}" aria-label="{{localize 'MASTERY.encounterSetup.forceAllPassives'}}">
          <i class="fas fa-shield"></i>
        </button>
        <button type="button" class="carousel-control-btn js-force-all-setup" data-kind="stones" data-tooltip="{{localize 'MASTERY.encounterSetup.forceAllStones'}}" aria-label="{{localize 'MASTERY.encounterSetup.forceAllStones'}}">
          <i class="fas fa-gem"></i>
        </button>
        <button type="button" class="carousel-control-btn js-end-combat" data-tooltip="End Combat" aria-label="End Combat">
          <i class="fas fa-stop"></i>
        </button>
      {{/if}}
    </div>
    <button type="button" class="carousel-resize-handle js-carousel-resize" data-tooltip="{{localize 'MASTERY.carousel.resizeHint'}}" aria-label="{{localize 'MASTERY.carousel.resizeHint'}}"></button>
  {{/if}}
</div>

