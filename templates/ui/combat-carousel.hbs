<div class="mastery-carousel {{#if active}}is-active{{/if}} {{#if compact}}is-compact{{/if}}">
  {{#if active}}
    <!-- Left Controls (shown on hover) -->
    <div class="carousel-controls carousel-controls-left">
      <button type="button" class="carousel-control-btn js-prev-turn" data-tooltip="Previous Turn" aria-label="Previous Turn">
        <i class="fas fa-chevron-left"></i>
      </button>
    </div>

    <!-- Combatants Row -->
    <div class="carousel-combatants">
      {{#each combatants as |combatant|}}
        <div class="carousel-portrait {{#if combatant.isCurrent}}is-current{{/if}} {{#if combatant.defeated}}is-defeated{{/if}} {{#if combatant.hidden}}is-hidden{{/if}}" 
             data-combatant-id="{{combatant.id}}">
          <!-- Portrait Image -->
          <div class="portrait-image">
            <img src="{{combatant.img}}" alt="{{combatant.name}}" />
            {{#if combatant.isCurrent}}
              <div class="current-indicator"></div>
            {{/if}}
          </div>

          <!-- Initiative Badge -->
          <div class="initiative-badge">{{combatant.initiative}}</div>

          <div class="ms-carousel-reactions" title="Reactions remaining this round (initiative shop / stones may raise total)">
            R <strong>{{combatant.reactionRemaining}}</strong>/{{combatant.reactionTotal}}
          </div>

          <!-- Name -->
          <div class="portrait-name">{{combatant.name}}</div>

          {{#if combatant.setupStatus}}
          <div class="ms-setup-picks" title="Kampf-Setup">
            {{#each combatant.setupStatus.rows as |row|}}
            <div class="ms-setup-row {{#if row.done}}is-done{{else}}is-open{{/if}}" title="{{row.tooltip}}">
              <span class="ms-setup-mark">{{#if row.done}}✓{{else}}—{{/if}}</span>
              <span class="ms-setup-label">{{row.label}}</span>
              <span class="ms-setup-summary">{{row.summary}}</span>
              {{#if ../setupStatus.canForce}}
              <button type="button" class="ms-setup-force js-force-setup" data-kind="{{row.kind}}" data-combatant-id="{{../id}}" title="{{localize 'MASTERY.encounterSetup.openForPlayer'}}">
                <i class="fas fa-share"></i>
              </button>
              {{/if}}
            </div>
            {{/each}}
          </div>
          {{/if}}

          {{#if combatant.combatStrip}}
          <div class="ms-carousel-combat-strip" title="{{#if combatant.combatStrip.stripTooltip}}{{combatant.combatStrip.stripTooltip}}{{else}}Aktuelle Kampfwerte (Rüstung / Evade / DR%) — Hover für Herkunft{{/if}}">
            <span class="ms-cs ms-cs-arm" title="Armor total">A <strong>{{combatant.combatStrip.armor}}</strong></span>
            <span class="ms-cs ms-cs-ev" title="Evade total">E <strong>{{combatant.combatStrip.evade}}</strong></span>
            <span class="ms-cs ms-cs-dr" title="Damage reduction %">DR <strong>{{combatant.combatStrip.drPct}}%</strong></span>
          </div>
          {{/if}}

          <!-- Segmented HP Bar (one segment per wound level, color-graded) -->
          {{#if combatant.hpSegments.length}}
            <div class="ms-hp-bar" title="{{#if combatant.hideHpNumbers}}HP{{else}}HP: {{combatant.hpTotalCurrent}}/{{combatant.hpTotalMax}}{{#if combatant.tempHP}} (+{{combatant.tempHP}} Temp HP){{/if}}{{/if}}">
              <div class="ms-hp-bar-header">
                <span class="ms-hp-bar-label">HP</span>
                {{#unless combatant.hideHpNumbers}}
                <span class="ms-hp-bar-totals">
                  {{combatant.hpTotalCurrent}}/{{combatant.hpTotalMax}}
                  {{#if combatant.tempHP}}<span class="ms-hp-temp" title="Temporary HP">+{{combatant.tempHP}}</span>{{/if}}
                </span>
                {{/unless}}
              </div>
              <div class="ms-hp-bar-track">
                {{#each combatant.hpSegments as |seg|}}
                  <div class="ms-hp-segment ms-hp-severity-{{seg.severity}}"
                       style="flex-basis: {{seg.widthPct}}%"
                       title="{{#if ../hideHpNumbers}}{{seg.name}}{{else}}{{seg.name}}: {{seg.current}}/{{seg.max}}{{/if}}">
                    {{#if seg.max}}
                      {{#with (divide seg.current seg.max)}}
                        <div class="ms-hp-segment-fill" style="width: {{multiply this 100}}%"></div>
                      {{/with}}
                    {{/if}}
                  </div>
                {{/each}}
              </div>
            </div>
          {{/if}}

          <!-- Segmented Stress Bar (same layout as HP; stress severity colors) -->
          {{#if combatant.stressSegments.length}}
            <div class="ms-hp-bar ms-stress-bar" title="Stress: {{combatant.stressTotalCurrent}}/{{combatant.stressTotalMax}}">
              <div class="ms-hp-bar-header">
                <span class="ms-hp-bar-label">Stress</span>
                <span class="ms-hp-bar-totals">
                  {{combatant.stressTotalCurrent}}/{{combatant.stressTotalMax}}
                </span>
              </div>
              <div class="ms-hp-bar-track">
                {{#each combatant.stressSegments as |seg|}}
                  <div class="ms-hp-segment ms-stress-severity-{{seg.severity}}"
                       style="flex-basis: {{seg.widthPct}}%"
                       title="{{seg.name}}: {{seg.current}}/{{seg.max}}">
                    {{#if seg.max}}
                      {{#with (divide seg.current seg.max)}}
                        <div class="ms-hp-segment-fill" style="width: {{multiply this 100}}%"></div>
                      {{/with}}
                    {{/if}}
                  </div>
                {{/each}}
              </div>
            </div>
          {{/if}}

          {{#if combatant.showStonePowersButton}}
            <button type="button"
                    class="portrait-stone-powers js-carousel-stone-powers{{#if combatant.stonePlanLocked}} is-locked{{/if}}"
                    data-combatant-id="{{combatant.id}}"
                    data-tooltip="{{#if combatant.stonePlanLocked}}Stein-Zuordnung gesperrt (Bewegung, Angriff oder Reaktion){{else}}Stone Powers{{/if}}"
                    aria-label="Stone Powers"
                    {{#if combatant.stonePlanLocked}}disabled title="Stein-Zuordnung ist gesperrt, sobald du in dieser Runde Bewegung, einen Angriff oder eine Reaktion nutzt."{{else}}title="Stone Powers: Steine auf Mächte legen"{{/if}}>
              <i class="fas fa-gem" aria-hidden="true"></i>
              <span>Steine</span>
            </button>
          {{/if}}

          {{#if combatant.showInitiativeShopButton}}
            <button type="button"
                    class="portrait-stone-powers portrait-initiative-shop js-carousel-initiative-shop"
                    data-combatant-id="{{combatant.id}}"
                    data-tooltip="{{localize 'MASTERY.startEncounter.shopButton'}}"
                    aria-label="{{localize 'MASTERY.startEncounter.shopButton'}}"
                    title="{{localize 'MASTERY.startEncounter.shopButtonHint'}}">
              <i class="fas fa-shop" aria-hidden="true"></i>
              <span>{{localize "MASTERY.encounterSetup.shop"}}</span>
            </button>
          {{/if}}

          <!-- Status Icons -->
          {{#if combatant.statusIcons}}
            <div class="status-icons">
              {{#each combatant.statusIcons as |statusIcon|}}
                {{#if (isObject statusIcon)}}
                  <img src="{{statusIcon.icon}}"
                    alt="{{statusIcon.name}}"
                    class="{{#if statusIcon.cssClass}}{{statusIcon.cssClass}}{{else}}status-icon{{/if}}"
                    data-icon-kind="{{statusIcon.kind}}"
                    data-tooltip="{{#if statusIcon.tooltip}}{{statusIcon.tooltip}}{{else}}{{statusIcon.name}}{{/if}}" />
                {{else}}
                <img src="{{statusIcon}}" alt="Status" class="status-icon" />
                {{/if}}
              {{/each}}
            </div>
          {{/if}}

          <!-- Advance initiative one step (next combatant) -->
          {{#if combatant.isCurrent}}
            <button type="button" class="portrait-end-turn js-end-turn" data-tooltip="Nächster Eintrag im Initiative-Tracker (ein Zug weiter)." aria-label="Nächster Zug">
              <i class="fas fa-forward"></i>
              <span>Nächster Zug</span>
            </button>
          {{/if}}

          <!-- Portrait Controls (shown on hover) -->
          <div class="portrait-controls">
            {{#if ../controlsAllowed}}
              <button type="button" class="portrait-control-btn js-toggle-defeated" data-tooltip="Toggle Defeated" aria-label="Toggle Defeated">
                <i class="fas fa-skull"></i>
              </button>
            {{/if}}
            {{#if ../controlsAllowed}}
              <button type="button" class="portrait-control-btn js-toggle-hidden" data-tooltip="Toggle Hidden" aria-label="Toggle Hidden">
                <i class="fas fa-eye-slash"></i>
              </button>
            {{/if}}
            {{#if combatant.hasToken}}
              <button type="button" class="portrait-control-btn js-ping" data-tooltip="Ping Token" aria-label="Ping Token">
                <i class="fas fa-bullseye"></i>
              </button>
            {{/if}}
          </div>
        </div>
      {{/each}}
    </div>

    <!-- Right Controls (shown on hover) -->
    <div class="carousel-controls carousel-controls-right">
      <button type="button" class="carousel-control-btn js-next-turn" data-tooltip="Next Turn" aria-label="Next Turn">
        <i class="fas fa-chevron-right"></i>
      </button>
      <button type="button" class="carousel-control-btn js-next-round" data-tooltip="Next Round" aria-label="Next Round">
        <i class="fas fa-forward"></i>
      </button>
      {{#if controlsAllowed}}
        <button type="button" class="carousel-control-btn js-force-all-setup" data-kind="passives" data-tooltip="{{localize 'MASTERY.encounterSetup.forceAllPassives'}}" aria-label="{{localize 'MASTERY.encounterSetup.forceAllPassives'}}">
          <i class="fas fa-shield"></i>
        </button>
        <button type="button" class="carousel-control-btn js-force-all-setup" data-kind="stones" data-tooltip="{{localize 'MASTERY.encounterSetup.forceAllStones'}}" aria-label="{{localize 'MASTERY.encounterSetup.forceAllStones'}}">
          <i class="fas fa-gem"></i>
        </button>
        <button type="button" class="carousel-control-btn js-force-all-setup" data-kind="initiative" data-tooltip="{{localize 'MASTERY.encounterSetup.forceAllShop'}}" aria-label="{{localize 'MASTERY.encounterSetup.forceAllShop'}}">
          <i class="fas fa-shop"></i>
        </button>
        <button type="button" class="carousel-control-btn js-end-combat" data-tooltip="End Combat" aria-label="End Combat">
          <i class="fas fa-stop"></i>
        </button>
      {{/if}}
    </div>
  {{/if}}
</div>

