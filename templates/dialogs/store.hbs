<div class="store-dialog">
  <div class="store-header">
    <h3><i class="fas fa-store"></i> Store (GM Only)</h3>
    <p>Drag items from the store to {{actor.name}}'s inventory</p>
  </div>

  {{#if isGM}}
    <div class="store-content">
      <div class="store-items-panel">
        <h4>Store Items</h4>
        {{#if hasStore}}
          <div class="store-items-grid">
            {{#each storeItems}}
              <div class="store-item df-draggable-item" data-item-id="{{this.id}}" draggable="true" title="{{this.name}}">
                <img class="item-icon" src="{{this.img}}" alt="{{this.name}}" />
                <div class="item-name">{{this.name}}</div>
                <div class="item-type">{{this.type}}</div>
              </div>
            {{/each}}
          </div>
        {{else}}
          <div class="empty-message">
            <p><i class="fas fa-info-circle"></i> No items in Store.</p>
            <p>Create a folder named "Store" and add items to it.</p>
          </div>
        {{/if}}
      </div>

      <div class="inventory-panel">
        <h4>{{actor.name}}'s Inventory</h4>
        <div class="inventory-drop-zone df-dropzone" data-df-drop="inventory">
          <p class="drop-hint"><i class="fas fa-hand-pointer"></i> Drop items here to add them to {{actor.name}}'s inventory</p>
          <div class="current-inventory">
            <p class="info-text">Items will appear in the Equipment tab after being added.</p>
          </div>
        </div>
      </div>
    </div>
  {{else}}
    <div class="access-denied">
      <p><i class="fas fa-lock"></i> Only the GM can access the Store.</p>
    </div>
  {{/if}}
</div>
