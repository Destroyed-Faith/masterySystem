<div class="summon-bond-dialog">
  <header class="sb-header">
    <h3 class="sb-title">{{#if isCreate}}Create Summon Bond{{else}}Bond Ritual — {{draft.name}}{{/if}}</h3>
    <p class="sb-subtitle">Bound Stones × 8 = Summon Tokens. Artifact Summon Stones add +4 Tokens each (bonus only). Bond Ritual takes 1 hour.</p>
  </header>

  {{#if isCreate}}
  <section class="sb-section">
    <h4>Basics</h4>
    <label class="sb-field">Name
      <input type="text" class="js-sb-name" value="{{draft.name}}" placeholder="Summon name" />
    </label>
    <label class="sb-field">Expression
      <input type="text" class="js-sb-expression" value="{{draft.expression}}" placeholder="beast, spirit, construct…" />
    </label>
    <label class="sb-field">Image
      <div class="sb-img-row">
        <input type="text" class="js-sb-img" value="{{draft.img}}" placeholder="icons/creatures/…" />
        <button type="button" class="js-sb-browse-img dialog-btn dialog-btn-secondary" title="Browse files"><i class="fas fa-folder-open"></i> Browse</button>
      </div>
    </label>
    <fieldset class="sb-field">
      <legend>Permanent Movement Mode</legend>
      {{#each movementModes}}
      <label class="sb-radio"><input type="radio" name="sbMovement" value="{{this.value}}" {{#if this.selected}}checked{{/if}} /> {{this.label}} ({{this.hint}})</label>
      {{/each}}
    </fieldset>
    <fieldset class="sb-field">
      <legend>Activation Timing</legend>
      <label class="sb-radio"><input type="radio" name="sbTiming" value="before" {{#if timingBefore}}checked{{/if}} /> Before owner</label>
      <label class="sb-radio"><input type="radio" name="sbTiming" value="after" {{#if timingAfter}}checked{{/if}} /> After owner</label>
    </fieldset>
  </section>

  <section class="sb-section">
    <h4>Bound Stones <span class="sb-meta">(each → 8 Tokens)</span></h4>
    <p class="sb-hint">Click a free pool gem to bind it. Counts show stones still available after your current selection. You cannot bind more stones than you have free.</p>
    <ul class="sb-stone-list">
      {{#each draft.stoneAttributes}}
      <li class="sb-stone-chip" data-index="{{@index}}">
        <span>{{this}}</span>
        <button type="button" class="js-sb-remove-create-stone" data-index="{{@index}}">✕</button>
      </li>
      {{/each}}
    </ul>
    {{#if poolGems.length}}
    <div class="sb-pool-row">
      {{#each poolGems}}
      <button type="button" class="js-sb-add-create-stone sb-pool-gem {{#unless this.available}}is-empty{{/unless}}" data-attr="{{this.attr}}" {{#unless this.available}}disabled{{/unless}} title="{{this.label}}: {{this.spendable}} free">
        <span class="ms-stone-gem-chip is-filled" style="--stone-fill: {{this.fill}}; --stone-stroke: {{this.stroke}};"></span>
        <span class="sb-pool-label">{{this.label}}</span>
        <span class="sb-pool-count">{{this.spendable}} free</span>
      </button>
      {{/each}}
    </div>
    {{else}}
    <p class="sb-warn">No free Attribute Stones in your pool.</p>
    {{/if}}
    <p class="sb-budget">Preview: <strong>{{createStoneCount}}</strong> Bound Stones → <strong>{{createTokenPreview}}</strong> Tokens</p>
    {{#if createErrors.length}}
    <ul class="sb-errors">{{#each createErrors}}<li>{{this}}</li>{{/each}}</ul>
    {{/if}}
    <div class="sb-actions">
      <button type="button" class="js-sb-create dialog-btn dialog-btn-primary" {{#unless canCreate}}disabled{{/unless}}>Create Bond</button>
      <button type="button" class="js-sb-cancel dialog-btn dialog-btn-secondary">Cancel</button>
    </div>
  </section>
  {{/if}}

  {{#if isRitual}}
  <section class="sb-budget-sticky {{#if tokens.over}}is-over{{else if tokens.noneLeft}}is-empty{{/if}}">
    <div class="sb-budget-main">
      <div class="sb-budget-col">
        <div class="sb-budget-left">
          <span class="sb-budget-label">Tokens left</span>
          <strong class="sb-budget-remaining {{#if tokens.over}}is-over{{/if}}">{{tokens.remaining}}</strong>
          <span class="sb-budget-of">of {{tokens.available}}</span>
        </div>
        <div class="sb-budget-breakdown">
          <div>Bound Stones {{draft.boundStoneCount}} × 8 = <strong>{{tokens.boundTotal}}</strong></div>
          <div>Artifact bonus = <strong>+{{tokens.artifactBonus}}</strong></div>
          <div>Spent {{tokens.spent}} · Bond {{tokens.bondSpent}} · Skills {{tokens.skillsSpent}}{{#each tokens.bodySpentViews}} · Body {{this.label}} {{this.spent}}{{/each}}</div>
          <div class="sb-status sb-status-{{bondStatus}}">Status: <strong>{{bondStatusLabel}}</strong> · Skill slots: {{tokens.skillSlots}}</div>
        </div>
      </div>
      <div class="sb-stat-grid">
        <div class="sb-stat"><span class="sb-stat-lbl">Attack</span><span class="sb-stat-val">{{previewStats.attack}}</span></div>
        <div class="sb-stat"><span class="sb-stat-lbl">Damage</span><span class="sb-stat-val">{{previewStats.damage}}</span></div>
        <div class="sb-stat"><span class="sb-stat-lbl">Move</span><span class="sb-stat-val">{{previewStats.move}}</span></div>
        <div class="sb-stat"><span class="sb-stat-lbl">Attacks</span><span class="sb-stat-val">{{previewStats.attacks}}</span></div>
        {{#if previewStats.multiBody}}
        {{#each previewStats.bodyRows}}
        <div class="sb-stat sb-stat-wide"><span class="sb-stat-lbl">Body {{this.n}}</span><span class="sb-stat-val">HP {{this.hp}} · Armor {{this.armor}} · Evade {{this.evade}}</span></div>
        {{/each}}
        {{else}}
        <div class="sb-stat"><span class="sb-stat-lbl">HP</span><span class="sb-stat-val">{{previewStats.hp}}</span></div>
        <div class="sb-stat"><span class="sb-stat-lbl">Armor</span><span class="sb-stat-val">{{previewStats.armor}}</span></div>
        <div class="sb-stat"><span class="sb-stat-lbl">Evade</span><span class="sb-stat-val">{{previewStats.evade}}</span></div>
        {{/if}}
        <div class="sb-stat"><span class="sb-stat-lbl">Bodies</span><span class="sb-stat-val">{{previewStats.bodies}}</span></div>
        {{#if previewStats.showSpecial}}
        <div class="sb-stat"><span class="sb-stat-lbl">Special</span><span class="sb-stat-val">{{previewStats.special}}</span></div>
        {{/if}}
      </div>
    </div>
    {{#if tokens.over}}
    <p class="sb-warn">Over budget. Reduce purchases until Tokens left is 0 or more.</p>
    {{else if tokens.noneLeft}}
    <p class="sb-hint">No Tokens left. Plus buttons and paid options are locked. Use minus to free Tokens.</p>
    {{else}}
    <p class="sb-hint">You can still buy anything that costs {{tokens.remaining}} Tokens or less.</p>
    {{/if}}
    {{#if draft.needsRedistribution}}
    <p class="sb-warn">Needs Ritual — apply the Bond Ritual when the spend is legal.</p>
    {{/if}}
    {{#if illegalSpend}}
    <div class="sb-illegal">
      <p class="sb-warn">This Bond has illegal or over-budget purchases. Preview values are clamped. Apply is disabled until you reset.</p>
      <ul class="sb-errors">{{#each illegalReasons}}<li>{{this}}</li>{{/each}}</ul>
      <button type="button" class="js-sb-reset-illegal dialog-btn dialog-btn-secondary">Reset illegal purchases</button>
    </div>
    {{/if}}
  </section>

  <details class="sb-fold" data-fold="identity" {{#if identityOpen}}open{{/if}}>
    <summary>Identity <span class="sb-meta">{{draft.name}}</span></summary>
    <label class="sb-field">Name <input type="text" class="js-sb-name" value="{{draft.name}}" /></label>
    <label class="sb-field">Expression <input type="text" class="js-sb-expression" value="{{draft.expression}}" /></label>
    <label class="sb-field">Image
      <div class="sb-img-row">
        <input type="text" class="js-sb-img" value="{{draft.img}}" />
        <button type="button" class="js-sb-browse-img dialog-btn dialog-btn-secondary" title="Browse files"><i class="fas fa-folder-open"></i> Browse</button>
      </div>
    </label>
    <fieldset class="sb-field">
      <legend>Movement Mode</legend>
      {{#each movementModes}}
      <label class="sb-radio"><input type="radio" name="sbMovement" value="{{this.value}}" {{#if this.selected}}checked{{/if}} /> {{this.label}} ({{this.hint}})</label>
      {{/each}}
    </fieldset>
    <fieldset class="sb-field">
      <legend>Activation</legend>
      <label class="sb-radio"><input type="radio" name="sbTiming" value="before" {{#if timingBefore}}checked{{/if}} /> Before owner</label>
      <label class="sb-radio"><input type="radio" name="sbTiming" value="after" {{#if timingAfter}}checked{{/if}} /> After owner</label>
    </fieldset>
  </details>

  <details class="sb-fold" data-fold="stones" {{#if stonesOpen}}open{{/if}}>
    <summary>Bound Stones <span class="sb-meta">{{draft.boundStoneCount}} × 8 = {{tokens.boundTotal}} Tokens</span></summary>
    <ul class="sb-stone-list">
      {{#each stoneChips}}
      <li class="sb-stone-chip" data-index="{{@index}}">
        <span>{{this}}</span>
        <button type="button" class="js-sb-remove-stone" data-index="{{@index}}" {{#if @root.onlyOneStone}}disabled title="Keep at least one stone"{{/if}}>✕</button>
      </li>
      {{/each}}
    </ul>
    {{#if poolGems.length}}
    <p class="sb-hint">Add more Bound Stones from your free pool (each +8 Tokens; requires redistributing).</p>
    <div class="sb-pool-row">
      {{#each poolGems}}
      <button type="button" class="js-sb-add-stone sb-pool-gem" data-attr="{{this.attr}}" title="{{this.label}}: {{this.spendable}} free">
        <span class="ms-stone-gem-chip is-filled" style="--stone-fill: {{this.fill}}; --stone-stroke: {{this.stroke}};"></span>
        <span class="sb-pool-label">{{this.label}}</span>
        <span class="sb-pool-count">{{this.spendable}} free</span>
      </button>
      {{/each}}
    </div>
    {{else}}
    <p class="sb-meta">No additional free stones in your pool.</p>
    {{/if}}
    {{#if artifactBonus.detected}}
    <div class="sb-stepper sb-stepper-artifact">
      <div class="sb-stepper-name">Assign Artifact bonus to this Bond</div>
      <p class="sb-hint">Some artifacts generate extra Summon Tokens (+4 each). Assign them here. They raise <strong>Tokens left</strong> at the top. They are not a Bond Upgrade and cannot create a Bond.</p>
      <div class="sb-stepper-row">
        <button type="button" class="js-sb-step sb-step-btn" data-field="bonusTokens" data-delta="-1" {{#unless artifactBonus.canMinus}}disabled{{/unless}} aria-label="Decrease Artifact bonus">−</button>
        <span class="sb-stepper-count" aria-live="polite">{{artifactBonus.value}}</span>
        <button type="button" class="js-sb-step sb-step-btn" data-field="bonusTokens" data-delta="1" {{#unless artifactBonus.canPlus}}disabled{{/unless}} aria-label="Increase Artifact bonus">+</button>
      </div>
      <div class="sb-stepper-meta">{{artifactBonus.stones}} / {{artifactBonus.maxStones}} Artifact Summon Stones assigned</div>
    </div>
    {{else}}
    <p class="sb-meta">No Artifact Summon Stones on this character. If an artifact grants them, +4 Tokens per stone appear in the pool at the top.</p>
    {{/if}}
  </details>

  <section class="sb-section">
    <h4>Upgrades <span class="sb-meta">(spend from the Token pool above)</span></h4>
    <p class="sb-hint">Every plus spends Tokens from the bar at the top. Movement is Bond-wide. Base {{movementBaseM}} m; each purchase +2 m (max 16 m / {{movementMaxPurchases}} purchases). HP, Armor, and Evade are per body.</p>
    <div class="sb-grid sb-grid-wide">
      <div class="sb-stepper">
        <div class="sb-stepper-name">Attack</div>
        <div class="sb-stepper-row">
          <button type="button" class="js-sb-step sb-step-btn" data-field="attackPurchases" data-delta="-1" {{#unless steppers.attack.canMinus}}disabled{{/unless}} aria-label="Decrease Attack">−</button>
          <span class="sb-stepper-count" aria-live="polite">{{steppers.attack.value}}</span>
          <button type="button" class="js-sb-step sb-step-btn" data-field="attackPurchases" data-delta="1" {{#unless steppers.attack.canPlus}}disabled{{/unless}} aria-label="Increase Attack">+</button>
        </div>
        <div class="sb-stepper-meta">{{steppers.attack.cost}} tok · {{steppers.attack.effect}}</div>
      </div>
      <div class="sb-stepper">
        <div class="sb-stepper-name">Damage</div>
        <div class="sb-stepper-row">
          <button type="button" class="js-sb-step sb-step-btn" data-field="damagePurchases" data-delta="-1" {{#unless steppers.damage.canMinus}}disabled{{/unless}} aria-label="Decrease Damage">−</button>
          <span class="sb-stepper-count" aria-live="polite">{{steppers.damage.value}}</span>
          <button type="button" class="js-sb-step sb-step-btn" data-field="damagePurchases" data-delta="1" {{#unless steppers.damage.canPlus}}disabled{{/unless}} aria-label="Increase Damage">+</button>
        </div>
        <div class="sb-stepper-meta">{{steppers.damage.cost}} tok · {{steppers.damage.effect}}</div>
      </div>
      <div class="sb-stepper">
        <div class="sb-stepper-name">Movement</div>
        <div class="sb-stepper-row">
          <button type="button" class="js-sb-step sb-step-btn" data-field="movementPurchases" data-delta="-1" {{#unless steppers.movement.canMinus}}disabled{{/unless}} aria-label="Decrease Movement">−</button>
          <span class="sb-stepper-count" aria-live="polite">{{steppers.movement.value}}</span>
          <button type="button" class="js-sb-step sb-step-btn" data-field="movementPurchases" data-delta="1" {{#unless steppers.movement.canPlus}}disabled{{/unless}} aria-label="Increase Movement">+</button>
        </div>
        <div class="sb-stepper-meta">{{steppers.movement.cost}} tok · {{steppers.movement.effect}} · max {{movementMaxPurchases}}</div>
      </div>
      <div class="sb-stepper">
        <div class="sb-stepper-name">Extra Attack</div>
        <div class="sb-stepper-row">
          <button type="button" class="js-sb-step sb-step-btn" data-field="extraAttackPurchases" data-delta="-1" {{#unless steppers.extraAttack.canMinus}}disabled{{/unless}} aria-label="Decrease Extra Attack">−</button>
          <span class="sb-stepper-count" aria-live="polite">{{steppers.extraAttack.value}}</span>
          <button type="button" class="js-sb-step sb-step-btn" data-field="extraAttackPurchases" data-delta="1" {{#unless steppers.extraAttack.canPlus}}disabled{{/unless}} aria-label="Increase Extra Attack">+</button>
        </div>
        <div class="sb-stepper-meta">{{steppers.extraAttack.cost}} tok · {{steppers.extraAttack.effect}} · max 2 (3 total)</div>
      </div>
      <div class="sb-stepper {{#unless hasEligibleSelected}}is-locked{{/unless}}">
        <div class="sb-stepper-name">Skill Dice</div>
        <div class="sb-stepper-row">
          <button type="button" class="js-sb-step sb-step-btn" data-field="skillDicePurchases" data-delta="-1" {{#unless steppers.skillDice.canMinus}}disabled{{/unless}} aria-label="Decrease Skill Dice">−</button>
          <span class="sb-stepper-count" aria-live="polite">{{steppers.skillDice.value}}</span>
          <button type="button" class="js-sb-step sb-step-btn" data-field="skillDicePurchases" data-delta="1" {{#unless steppers.skillDice.canPlus}}disabled{{/unless}} aria-label="Increase Skill Dice">+</button>
        </div>
        <div class="sb-stepper-meta">{{steppers.skillDice.cost}} tok · {{steppers.skillDice.effect}}</div>
      </div>
      <div class="sb-stepper">
        <div class="sb-stepper-name">Additional Bodies</div>
        <div class="sb-stepper-row">
          <button type="button" class="js-sb-step sb-step-btn" data-field="additionalBodies" data-delta="-1" {{#unless steppers.bodies.canMinus}}disabled{{/unless}} aria-label="Decrease Bodies">−</button>
          <span class="sb-stepper-count" aria-live="polite">{{steppers.bodies.value}}</span>
          <button type="button" class="js-sb-step sb-step-btn" data-field="additionalBodies" data-delta="1" {{#unless steppers.bodies.canPlus}}disabled{{/unless}} aria-label="Increase Bodies">+</button>
        </div>
        <div class="sb-stepper-meta">{{steppers.bodies.cost}} tok · {{steppers.bodies.effect}}</div>
      </div>
      {{#each bodyViews}}
      <div class="sb-stepper">
        <div class="sb-stepper-name">HP{{#if @root.multiBody}} <span class="sb-meta">Body {{this.n}}</span>{{/if}}</div>
        <div class="sb-stepper-row">
          <button type="button" class="js-sb-step sb-step-btn" data-body="{{this.index}}" data-field="hpPurchases" data-delta="-1" {{#unless this.hpStepper.canMinus}}disabled{{/unless}} aria-label="Decrease HP">−</button>
          <span class="sb-stepper-count" aria-live="polite">{{this.hpStepper.value}}</span>
          <button type="button" class="js-sb-step sb-step-btn" data-body="{{this.index}}" data-field="hpPurchases" data-delta="1" {{#unless this.hpStepper.canPlus}}disabled{{/unless}} aria-label="Increase HP">+</button>
        </div>
        <div class="sb-stepper-meta">{{this.hpStepper.cost}} tok · {{this.hpStepper.effect}}</div>
      </div>
      <div class="sb-stepper">
        <div class="sb-stepper-name">Armor{{#if @root.multiBody}} <span class="sb-meta">Body {{this.n}}</span>{{/if}}</div>
        <div class="sb-stepper-row">
          <button type="button" class="js-sb-step sb-step-btn" data-body="{{this.index}}" data-field="armorPurchases" data-delta="-1" {{#unless this.armorStepper.canMinus}}disabled{{/unless}} aria-label="Decrease Armor">−</button>
          <span class="sb-stepper-count" aria-live="polite">{{this.armorStepper.value}}</span>
          <button type="button" class="js-sb-step sb-step-btn" data-body="{{this.index}}" data-field="armorPurchases" data-delta="1" {{#unless this.armorStepper.canPlus}}disabled{{/unless}} aria-label="Increase Armor">+</button>
        </div>
        <div class="sb-stepper-meta">{{this.armorStepper.cost}} tok · {{this.armorStepper.effect}}</div>
      </div>
      <div class="sb-stepper">
        <div class="sb-stepper-name">Evade{{#if @root.multiBody}} <span class="sb-meta">Body {{this.n}}</span>{{/if}}</div>
        <div class="sb-stepper-row">
          <button type="button" class="js-sb-step sb-step-btn" data-body="{{this.index}}" data-field="evadePurchases" data-delta="-1" {{#unless this.evadeStepper.canMinus}}disabled{{/unless}} aria-label="Decrease Evade">−</button>
          <span class="sb-stepper-count" aria-live="polite">{{this.evadeStepper.value}}</span>
          <button type="button" class="js-sb-step sb-step-btn" data-body="{{this.index}}" data-field="evadePurchases" data-delta="1" {{#unless this.evadeStepper.canPlus}}disabled{{/unless}} aria-label="Increase Evade">+</button>
        </div>
        <div class="sb-stepper-meta">{{this.evadeStepper.cost}} tok · {{this.evadeStepper.effect}}</div>
      </div>
      {{/each}}
    </div>
  </section>

  <details class="sb-fold sb-fold-card" data-fold="senses" {{#if sensesOpen}}open{{/if}}>
    <summary>Shared Senses <span class="sb-meta">2 Tokens each · body-specific</span></summary>
    {{#each bodyViews}}
    <div class="sb-fold-block">
      {{#if @root.multiBody}}<h5>Body {{this.n}}{{#if this.dormant}} (Dormant){{/if}}</h5>{{/if}}
      <div class="sb-sense-row">
        {{#each this.senses}}
        <label class="sb-check {{#unless this.canAfford}}is-disabled{{/unless}}">
          <input type="checkbox" class="js-sb-body-sense" data-body="{{../index}}" data-sense="{{this.value}}" {{#if this.checked}}checked{{/if}} {{#unless this.canAfford}}disabled{{/unless}} />
          {{this.label}}
        </label>
        {{/each}}
      </div>
    </div>
    {{/each}}
  </details>

  <details class="sb-fold sb-fold-card" data-fold="powers" {{#if powersOpen}}open{{/if}}>
    <summary>Powers <span class="sb-meta">1 Token per started 10 PP · max L{{maxPowerLevel}}</span></summary>
    <details class="sb-fold sb-fold-nested" data-fold="special" {{#if specialOpen}}open{{/if}}>
      <summary>Special Access</summary>
      <label class="sb-check {{#unless canAffordSpecialAccess}}is-disabled{{/unless}}">
        <input type="checkbox" class="js-sb-special-access" {{#if draft.spend.specialAccess}}checked{{/if}} {{#unless canAffordSpecialAccess}}disabled{{/unless}} />
        Unlock Special Access (4 Tokens → Special(1))
        {{#unless canAffordSpecialAccess}}<span class="sb-meta"> — need 4, {{tokens.remaining}} left</span>{{/unless}}
      </label>
      {{#if draft.spend.specialAccess}}
      <label class="sb-field">Special
        <select class="js-sb-special-key">
          <option value="">— choose —</option>
          {{#each specialOptions}}
          <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
      </label>
      <div class="sb-stepper">
        <div class="sb-stepper-name">Special Value</div>
        <div class="sb-stepper-row">
          <button type="button" class="js-sb-step sb-step-btn" data-field="specialValuePurchases" data-delta="-1" {{#unless steppers.specialValue.canMinus}}disabled{{/unless}} aria-label="Decrease Special Value">−</button>
          <span class="sb-stepper-count" aria-live="polite">{{steppers.specialValue.value}}</span>
          <button type="button" class="js-sb-step sb-step-btn" data-field="specialValuePurchases" data-delta="1" {{#unless steppers.specialValue.canPlus}}disabled{{/unless}} aria-label="Increase Special Value">+</button>
        </div>
        <div class="sb-stepper-meta">{{steppers.specialValue.cost}} tok · {{steppers.specialValue.effect}} · max Special(4)</div>
      </div>
      <p class="sb-meta">Current: {{specialDisplay}} · applies once per Round for the whole Bond</p>
      {{/if}}
    </details>
    {{#each bodyViews}}
    {{#if @root.multiBody}}
    <details class="sb-body" {{#if this.open}}open{{/if}} data-body-index="{{this.index}}">
      <summary>Body {{this.n}}{{#if this.dormant}} (Dormant){{/if}}</summary>
      <div class="sb-powers">
        <ul>
          {{#each this.powers}}
          <li class="{{#unless this.legal}}is-invalid{{/unless}}">{{this.name}} L{{this.level}} · {{this.ppCost}} PP · {{this.tokenCost}} tok
            {{#unless this.legal}}<span class="sb-meta"> — {{this.reason}}</span>{{/unless}}
            <button type="button" class="js-sb-remove-power" data-body="{{../index}}" data-power-idx="{{@index}}">✕</button>
          </li>
          {{/each}}
        </ul>
        <div class="sb-power-add">
          <select class="js-sb-power-template" data-body="{{this.index}}">
            {{#each @root.powerCatalog}}
            <option value="{{this.templateId}}" data-category="{{this.category}}" data-cost="{{this.tokenCost}}" title="{{this.reason}}" {{#unless this.affordable}}disabled{{/unless}}>{{this.name}} · {{this.category}} · {{this.ppCost}} PP · {{this.tokenCost}} tok{{#unless this.affordable}} (need {{this.tokenCost}} tok){{/unless}}</option>
            {{/each}}
          </select>
          <select class="js-sb-power-level" data-body="{{this.index}}">
            {{#each @root.powerLevels}}
            <option value="{{this}}">L{{this}}</option>
            {{/each}}
          </select>
          <button type="button" class="js-sb-add-power dialog-btn dialog-btn-secondary" data-body="{{this.index}}" {{#unless @root.canAddPower}}disabled{{/unless}}>Add Power</button>
        </div>
        <div class="sb-body-actions">
          {{#if this.summonActorId}}
          <button type="button" class="js-sb-open-actor dialog-btn dialog-btn-secondary" data-body="{{this.index}}">Open Actor</button>
          <button type="button" class="js-sb-place-token dialog-btn dialog-btn-secondary" data-body="{{this.index}}">Place Token</button>
          {{else}}
          <button type="button" class="js-sb-create-actor dialog-btn dialog-btn-secondary" data-body="{{this.index}}">Create Actor</button>
          {{/if}}
        </div>
      </div>
    </details>
    {{else}}
    <div class="sb-powers" data-body-index="{{this.index}}">
      <ul>
        {{#each this.powers}}
        <li class="{{#unless this.legal}}is-invalid{{/unless}}">{{this.name}} L{{this.level}} · {{this.ppCost}} PP · {{this.tokenCost}} tok
          {{#unless this.legal}}<span class="sb-meta"> — {{this.reason}}</span>{{/unless}}
          <button type="button" class="js-sb-remove-power" data-body="{{../index}}" data-power-idx="{{@index}}">✕</button>
        </li>
        {{/each}}
      </ul>
      <div class="sb-power-add">
        <select class="js-sb-power-template" data-body="{{this.index}}">
          {{#each @root.powerCatalog}}
          <option value="{{this.templateId}}" data-category="{{this.category}}" data-cost="{{this.tokenCost}}" title="{{this.reason}}" {{#unless this.affordable}}disabled{{/unless}}>{{this.name}} · {{this.category}} · {{this.ppCost}} PP · {{this.tokenCost}} tok{{#unless this.affordable}} (need {{this.tokenCost}} tok){{/unless}}</option>
          {{/each}}
        </select>
        <select class="js-sb-power-level" data-body="{{this.index}}">
          {{#each @root.powerLevels}}
          <option value="{{this}}">L{{this}}</option>
          {{/each}}
        </select>
        <button type="button" class="js-sb-add-power dialog-btn dialog-btn-secondary" data-body="{{this.index}}" {{#unless @root.canAddPower}}disabled{{/unless}}>Add Power</button>
      </div>
      <div class="sb-body-actions">
        {{#if this.summonActorId}}
        <button type="button" class="js-sb-open-actor dialog-btn dialog-btn-secondary" data-body="{{this.index}}">Open Actor</button>
        <button type="button" class="js-sb-place-token dialog-btn dialog-btn-secondary" data-body="{{this.index}}">Place Token</button>
        {{else}}
        <button type="button" class="js-sb-create-actor dialog-btn dialog-btn-secondary" data-body="{{this.index}}">Create Actor</button>
        {{/if}}
      </div>
    </div>
    {{/if}}
    {{/each}}
  </details>

  <details class="sb-fold sb-fold-card" data-fold="skills" {{#if skillsOpen}}open{{/if}}>
    <summary>Summon Skills <span class="sb-meta">{{tokens.skillSlots}} slots · MR × 2 ({{skillMinRating}})</span></summary>
    <p class="sb-hint">Only skills you have trained to at least <strong>MR × 2</strong> ({{skillMinRating}}) can be given to the Bond. Tick up to {{tokens.skillSlots}}. Then buy Skill Dice under Upgrades and assign them here (max = your Rating).</p>
    {{#if computed.skillDiceTotal}}
    <p class="sb-preview-line">Purchased Skill Dice: {{computed.skillDiceTotal}} · Assigned: {{skillDiceAssigned}} · Still to assign: {{skillDiceUnassigned}}</p>
    {{else}}
    <p class="sb-meta">{{#if hasEligibleSelected}}Buy Skill Dice under Upgrades, then assign them here.{{else}}Select an eligible skill first, then Skill Dice can be bought.{{/if}}</p>
    {{/if}}
    {{#if skillOptions.length}}
    <div class="sb-skill-list">
      {{#each skillOptions}}
      <div class="sb-skill-row">
        <label class="sb-check">
          <input type="checkbox" class="js-sb-skill-select" data-skill="{{this.id}}" {{#if this.selected}}checked{{/if}} {{#unless this.canSelect}}disabled{{/unless}} />
          {{this.label}} <span class="sb-meta">(owner {{this.ownerRating}})</span>
        </label>
        {{#if this.selected}}
        <div class="sb-stepper-row sb-stepper-row-inline">
          <button type="button" class="js-sb-step sb-step-btn" data-field="skillDice" data-skill="{{this.id}}" data-delta="-1" {{#unless this.canMinusDice}}disabled{{/unless}} aria-label="Decrease {{this.label}} dice">−</button>
          <span class="sb-stepper-count" aria-live="polite">{{this.dice}}</span>
          <button type="button" class="js-sb-step sb-step-btn" data-field="skillDice" data-skill="{{this.id}}" data-delta="1" {{#unless this.canPlusDice}}disabled{{/unless}} aria-label="Increase {{this.label}} dice">+</button>
        </div>
        {{/if}}
      </div>
      {{/each}}
    </div>
    {{else}}
    <p class="sb-warn">No eligible skills. Raise an owner skill to at least MR × 2 to make it available to this Summon.</p>
    {{/if}}
    {{#if invalidSkillOptions.length}}
    <div class="sb-invalid-skills">
      <h5>Invalid Selected Skills</h5>
      {{#each invalidSkillOptions}}
      <div class="sb-skill-row is-invalid">
        <label class="sb-check">
          <input type="checkbox" class="js-sb-skill-select" data-skill="{{this.id}}" checked />
          {{this.label}} <span class="sb-meta">(owner {{this.ownerRating}})</span>
        </label>
        <span class="sb-warn">Owner skill too low. Needs MR × 2.</span>
      </div>
      {{/each}}
    </div>
    {{/if}}
  </details>

  {{#if ritualErrors.length}}
  <ul class="sb-errors">{{#each ritualErrors}}<li>{{this}}</li>{{/each}}</ul>
  {{/if}}
  {{#if ritualWarnings.length}}
  <ul class="sb-warnings">{{#each ritualWarnings}}<li>{{this}}</li>{{/each}}</ul>
  {{/if}}

  <div class="sb-actions">
    <button type="button" class="js-sb-create-actor dialog-btn dialog-btn-secondary" data-body="{{createActorBodyIndex}}" {{#unless canCreateActor}}disabled title="Every body already has an actor"{{/unless}}>Create Actor</button>
    <button type="button" class="js-sb-apply-ritual dialog-btn dialog-btn-primary" {{#unless canApplyRitual}}disabled{{/unless}}>Apply Bond Ritual</button>
    <button type="button" class="js-sb-dissolve dialog-btn dialog-btn-danger">Dissolve Bond</button>
    <button type="button" class="js-sb-cancel dialog-btn dialog-btn-secondary">Close</button>
  </div>
  {{/if}}
</div>
