<div class="initiative-shop-dialog initiative-shop-lean">
  <div class="shop-toolbar-top">
    <button type="button" class="btn-primary btn-confirm-lean js-confirm" title="Initiative und Einkäufe übernehmen">
      <i class="fas fa-check"></i> Bestätigen
    </button>
  </div>

  <header class="shop-header shop-header-lean">
    <div class="header-left flexrow">
      <img src="{{actor.img}}" alt="{{actor.name}}" class="actor-portrait actor-portrait-lean">
      <div class="actor-info">
        <h2>{{actor.name}}</h2>
        <span class="mastery-badge">MR {{masteryRank}}</span>
      </div>
    </div>
  </header>

  <div class="lean-block">
    <div class="lean-line mastery-roll-line" title="Summe aller gewürfelten W8 (8er explodieren)">
      <span class="lean-label">Mastery Roll</span>
      <span class="lean-sep">:</span>
      <span class="lean-value">{{diceTotal}}</span>
      <span class="lean-muted">({{masteryRank}}d8)</span>
    </div>

    <div class="lean-line cr-line">
      <label class="lean-label" for="init-shop-cr-{{actor.id}}">Combat Reflexes</label>
      <span class="lean-sep">:</span>
      {{#if crSelectDisabled}}
      <span class="lean-muted">kein Pool / cap 0</span>
      {{else}}
      <select id="init-shop-cr-{{actor.id}}" class="lean-select js-cr-select" title="Wie viele Combat-Reflexes-Punkte auf diese Initiative legen? (max. {{crMax}}, Pool {{crPoolRemaining}}, Cap MR×4 = {{crCapPerRoll}})">
        {{#each crOptions}}
        <option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>
        {{/each}}
      </select>
      <span class="lean-muted lean-cr-hint">max. {{crMax}} · Pool {{crPoolRemaining}}</span>
      {{/if}}
    </div>

    <div class="lean-line pool-line" title="Gesamt für den Shop; nach Einkäufen bleibt der Rest als Initiative">
      <span class="lean-label">Shop-Pool</span>
      <span class="lean-sep">:</span>
      <span class="lean-value">{{totalInitiative}}</span>
      <span class="lean-muted">· Rest nach Shop</span>
      <span class="lean-value lean-rest">{{remainingInitiative}}</span>
    </div>
  </div>

  <section class="shop-lines" aria-label="Initiative Shop">
    <div class="shop-line" title="Je Kauf +{{costs.movementIncrement}}m Bewegung in dieser Runde; Kosten {{costs.movement}} Initiative-Punkte pro Stufe">
      <span class="shop-line-text">
        <span class="shop-name">Extra Movement</span><span class="shop-punct">:</span>
        <span class="shop-cost-label">Cost</span><span class="shop-punct">:</span>
        <span class="shop-cost-num">{{costs.movement}}</span>
        <span class="shop-extra">· +{{costs.movementIncrement}}m · ×{{purchases.extraMovement}} → +{{movementBonus}}m</span>
      </span>
      <span class="shop-line-actions">
        <button type="button" class="icon-btn js-remove-movement" title="Eine Stufe weniger" {{#unless purchases.extraMovement}}disabled{{/unless}}><i class="fas fa-minus"></i></button>
        <button type="button" class="icon-btn js-buy-movement" title="Eine Stufe kaufen ({{costs.movement}})" {{#unless (gte remainingInitiative costs.movement)}}disabled{{/unless}}><i class="fas fa-plus"></i></button>
      </span>
    </div>

    <div class="shop-line" title="Mit einvernehmlichem Spieler die Initiativewerte tauschen">
      <span class="shop-line-text">
        <span class="shop-name">Initiative Swap</span><span class="shop-punct">:</span>
        <span class="shop-cost-label">Cost</span><span class="shop-punct">:</span>
        <span class="shop-cost-num">{{costs.swap}}</span>
      </span>
      <button type="button" class="icon-btn icon-btn-toggle js-buy-swap {{#if purchases.initiativeSwap}}is-on{{/if}}"
              title="{{#if purchases.initiativeSwap}}Entfernen{{else}}Kaufen ({{costs.swap}}){{/if}}"
              {{#unless purchases.initiativeSwap}}{{#unless (gte remainingInitiative costs.swap)}}disabled{{/unless}}{{/unless}}>
        <i class="fas fa-{{#if purchases.initiativeSwap}}check{{else}}cart-plus{{/if}}"></i>
      </button>
    </div>

    <div class="shop-line" title="Eine zusätzliche Reaktion in dieser Runde">
      <span class="shop-line-text">
        <span class="shop-name">Extra Reaction</span><span class="shop-punct">:</span>
        <span class="shop-cost-label">Cost</span><span class="shop-punct">:</span>
        <span class="shop-cost-num">{{costs.extraReaction}}</span>
      </span>
      <button type="button" class="icon-btn icon-btn-toggle js-buy-reaction {{#if purchases.extraReaction}}is-on{{/if}}"
              title="{{#if purchases.extraReaction}}Entfernen{{else}}Kaufen ({{costs.extraReaction}}){{/if}}"
              {{#unless purchases.extraReaction}}{{#unless (gte remainingInitiative costs.extraReaction)}}disabled{{/unless}}{{/unless}}>
        <i class="fas fa-{{#if purchases.extraReaction}}check{{else}}cart-plus{{/if}}"></i>
      </button>
    </div>

    <div class="shop-line" title="1W8 Stress von den Stress-Leisten entfernen (beim Anwenden würfeln)">
      <span class="shop-line-text">
        <span class="shop-name">Remove Stress</span><span class="shop-punct">:</span>
        <span class="shop-cost-label">Cost</span><span class="shop-punct">:</span>
        <span class="shop-cost-num">{{costs.removeStress}}</span>
      </span>
      <button type="button" class="icon-btn icon-btn-toggle js-buy-stress {{#if purchases.removeStress}}is-on{{/if}}"
              title="{{#if purchases.removeStress}}Entfernen{{else}}Kaufen ({{costs.removeStress}}){{/if}}"
              {{#unless purchases.removeStress}}{{#unless (gte remainingInitiative costs.removeStress)}}disabled{{/unless}}{{/unless}}>
        <i class="fas fa-{{#if purchases.removeStress}}check{{else}}cart-plus{{/if}}"></i>
      </button>
    </div>

    <div class="shop-line" title="Einen zusätzlichen Angriff in dieser Runde">
      <span class="shop-line-text">
        <span class="shop-name">Extra Attack</span><span class="shop-punct">:</span>
        <span class="shop-cost-label">Cost</span><span class="shop-punct">:</span>
        <span class="shop-cost-num">{{costs.extraAttack}}</span>
      </span>
      <button type="button" class="icon-btn icon-btn-toggle js-buy-attack {{#if purchases.extraAttack}}is-on{{/if}}"
              title="{{#if purchases.extraAttack}}Entfernen{{else}}Kaufen ({{costs.extraAttack}}){{/if}}"
              {{#unless purchases.extraAttack}}{{#unless (gte remainingInitiative costs.extraAttack)}}disabled{{/unless}}{{/unless}}>
        <i class="fas fa-{{#if purchases.extraAttack}}check{{else}}cart-plus{{/if}}"></i>
      </button>
    </div>
  </section>
</div>
