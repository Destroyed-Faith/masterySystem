<div class="item-info-root" data-item-id="{{item.id}}">
  <header class="item-info-header">
    <img class="item-info-img" src="{{itemImg}}" alt="" />
    <div class="item-info-header-text">
      <h2 class="item-info-name">{{itemName}}</h2>
      <p class="item-info-type-badge">{{typeLabel}}</p>
    </div>
  </header>

  {{#if isWeapon}}
  <section class="item-info-section item-info-weapon" aria-label="Weapon stats">
    <h3 class="item-info-section-title">Weapon</h3>
    <dl class="item-info-dl">
      <dt>Weapon damage</dt><dd>{{weaponBlock.damage}}</dd>
      <dt>Hands</dt><dd>{{weaponBlock.hands}}</dd>
      <dt>Type</dt><dd>{{weaponBlock.weaponType}}</dd>
    </dl>
    {{#if weaponBlock.innateRows.length}}
    <h4 class="item-info-subtitle">Innate abilities</h4>
    <ul class="item-info-ability-list">
      {{#each weaponBlock.innateRows}}
      <li>
        <span class="item-info-ability-name">{{this.label}}</span>
        {{#if this.description}}
        <span class="item-info-ability-desc">{{this.description}}</span>
        {{/if}}
      </li>
      {{/each}}
    </ul>
    {{/if}}
    {{#if weaponBlock.specials.length}}
    <h4 class="item-info-subtitle">Special Effects</h4>
    <ul class="item-info-special-list">
      {{#each weaponBlock.specials}}
      <li>{{this}}</li>
      {{/each}}
    </ul>
    {{/if}}
    <p class="item-info-footnote">{{weaponBlock.specialsNote}}</p>
    {{#if weaponBlock.catalogNote}}
    <p class="item-info-flavor"><em>{{weaponBlock.catalogNote}}</em></p>
    {{/if}}
    {{#if enrichedDescription}}
    <h4 class="item-info-subtitle">Description</h4>
    <div class="item-info-description prose">{{{enrichedDescription}}}</div>
    {{/if}}
  </section>
  {{/if}}

  {{#if isArmor}}
  <section class="item-info-section item-info-armor" aria-label="Armor stats">
    <h3 class="item-info-section-title">Armor — {{armorBlock.typeLabel}}</h3>
    <p class="item-info-muted">{{armorBlock.name}}</p>
    <dl class="item-info-dl item-info-dl-grid">
      <dt>Armor value (on item)</dt><dd>{{armorBlock.armorValue}}</dd>
      <dt>Evade modifier</dt><dd>{{armorBlock.evade}}</dd>
      <dt>Initiative (type)</dt><dd>{{armorBlock.initiative}}</dd>
      <dt>Skill penalty</dt><dd>{{armorBlock.skillPenalty}}</dd>
    </dl>
    <p class="item-info-footnote">{{armorBlock.ruleHint}}</p>
  </section>
  {{/if}}

  {{#if isShield}}
  <section class="item-info-section item-info-shield" aria-label="Shield stats">
    <h3 class="item-info-section-title">Shield — {{shieldBlock.typeLabel}}</h3>
    <p class="item-info-muted">{{shieldBlock.name}}</p>
    <dl class="item-info-dl item-info-dl-grid">
      <dt>Shield value (on item)</dt><dd>{{shieldBlock.shieldValue}}</dd>
      <dt>Evade modifier</dt><dd>{{shieldBlock.evade}}</dd>
      <dt>Initiative (type)</dt><dd>{{shieldBlock.initiative}}</dd>
      <dt>Skill penalty (type)</dt><dd>{{shieldBlock.skillPenalty}}</dd>
    </dl>
    <p class="item-info-footnote">{{shieldBlock.ruleHint}}</p>
  </section>
  {{/if}}

  {{#if isGear}}
  <section class="item-info-section item-info-gear" aria-label="Gear">
    <h3 class="item-info-section-title">Gear</h3>
    <dl class="item-info-dl">
      <dt>Inventory size</dt><dd>{{gearBlock.inventorySize}}</dd>
      <dt>Weight</dt><dd>{{gearBlock.weight}}</dd>
      <dt>Quantity</dt><dd>{{gearBlock.quantity}}</dd>
    </dl>
    {{#if enrichedDescription}}
    <div class="item-info-description prose">{{{enrichedDescription}}}</div>
    {{/if}}
  </section>
  {{/if}}

  {{#if isArtifact}}
  <section class="item-info-section item-info-artifact" aria-label="Artifact">
    <h3 class="item-info-section-title">Artifact</h3>
    <dl class="item-info-dl item-info-dl-grid">
      <dt>Level</dt><dd>{{artifactProfile.level}}</dd>
      {{#if artifactProfile.slotLabel}}<dt>Slot</dt><dd>{{artifactProfile.slotLabel}}</dd>{{/if}}
      {{#if artifactProfile.baseProfileLabel}}<dt>Base profile</dt><dd>{{artifactProfile.baseProfileLabel}}</dd>{{/if}}
      <dt>Inventory size</dt><dd>{{artifactProfile.inventorySize}}</dd>
      {{#if artifactProfile.requirements}}
      <dt>Requirements</dt>
      <dd>Stones {{artifactProfile.requirements.stones}} · MR {{artifactProfile.requirements.masteryRank}}</dd>
      {{/if}}
    </dl>

    {{#if artifactProfile.hasBaseValues}}
    <h4 class="item-info-subtitle">Base values</h4>
    <ul class="item-info-special-list">
      {{#each artifactProfile.baseValues}}
      <li><strong>{{slot}}</strong> {{label}} <span class="item-info-muted">({{typeLabel}})</span>{{#if value}} — {{value}}{{/if}}</li>
      {{/each}}
    </ul>
    {{/if}}

    {{#if artifactProfile.hasAbilities}}
    <h4 class="item-info-subtitle">Abilities by level</h4>
    <ul class="item-info-ability-list">
      {{#each artifactProfile.abilities}}
      <li class="{{#unless unlocked}}item-info-muted{{/unless}}">
        <span class="item-info-ability-name">L{{level}} · {{name}}{{#if type}} <span class="item-info-muted">({{type}})</span>{{/if}}</span>
        {{#if effect}}<span class="item-info-ability-desc">{{effect}}</span>{{/if}}
        {{#if special}}<span class="item-info-ability-desc">Special Effect: {{special}}</span>{{/if}}
      </li>
      {{/each}}
    </ul>
    {{/if}}
    {{#if artifactProfile.legacyBonuses.show}}
    <h4 class="item-info-subtitle">Legacy flat bonuses</h4>
    <dl class="item-info-dl item-info-dl-grid">
      <dt>Attack bonus</dt><dd>{{artifactProfile.legacyBonuses.attack}}</dd>
      <dt>Defense bonus</dt><dd>{{artifactProfile.legacyBonuses.defense}}</dd>
      <dt>Damage</dt><dd>{{artifactProfile.legacyBonuses.damage}}</dd>
    </dl>
    {{/if}}

    {{#if artifactProfile.isWeapon}}
    {{#if artifactProfile.weapon}}
    <h4 class="item-info-subtitle">Weapon profile</h4>
    <dl class="item-info-dl">
      <dt>Damage</dt><dd>{{artifactProfile.weapon.damage}}</dd>
      <dt>Hands</dt><dd>{{artifactProfile.weapon.handsLabel}}</dd>
      <dt>Type</dt><dd>{{artifactProfile.weapon.weaponType}}</dd>
      <dt>{{#if (eq artifactProfile.weapon.weaponType "Ranged")}}Range{{else}}Reach / range{{/if}}</dt><dd>{{artifactProfile.weapon.rangeOrReach}}</dd>
    </dl>
    {{#if artifactProfile.weapon.innateRows.length}}
    <h4 class="item-info-subtitle">Innate abilities</h4>
    <ul class="item-info-ability-list">
      {{#each artifactProfile.weapon.innateRows}}
      <li>
        <span class="item-info-ability-name">{{this.label}}</span>
        {{#if this.description}}
        <span class="item-info-ability-desc">{{this.description}}</span>
        {{/if}}
      </li>
      {{/each}}
    </ul>
    {{/if}}
    {{#if artifactProfile.weapon.specials.length}}
    <h4 class="item-info-subtitle">Special Effects</h4>
    <ul class="item-info-special-list">
      {{#each artifactProfile.weapon.specials}}
      <li>{{this}}</li>
      {{/each}}
    </ul>
    {{/if}}
    <p class="item-info-footnote">{{artifactProfile.weapon.specialsNote}}</p>
    {{/if}}
    {{/if}}

    {{#if artifactProfile.isArmor}}
    {{#if artifactProfile.armor}}
    <h4 class="item-info-subtitle">Armor — {{artifactProfile.armor.typeLabel}}</h4>
    <p class="item-info-muted">{{artifactProfile.armor.name}}</p>
    <dl class="item-info-dl item-info-dl-grid">
      <dt>Armor value (on item)</dt><dd>{{artifactProfile.armor.armorValue}}</dd>
      <dt>Evade modifier</dt><dd>{{artifactProfile.armor.evade}}</dd>
      <dt>Initiative (type)</dt><dd>{{artifactProfile.armor.initiative}}</dd>
      <dt>Skill penalty</dt><dd>{{artifactProfile.armor.skillPenalty}}</dd>
    </dl>
    <p class="item-info-footnote">{{artifactProfile.armor.ruleHint}}</p>
    {{/if}}
    {{/if}}

    {{#if artifactProfile.isShield}}
    {{#if artifactProfile.shield}}
    <h4 class="item-info-subtitle">Shield — {{artifactProfile.shield.typeLabel}}</h4>
    <p class="item-info-muted">{{artifactProfile.shield.name}}</p>
    <dl class="item-info-dl item-info-dl-grid">
      <dt>Shield value (on item)</dt><dd>{{artifactProfile.shield.shieldValue}}</dd>
      <dt>Evade modifier</dt><dd>{{artifactProfile.shield.evade}}</dd>
      <dt>Initiative (type)</dt><dd>{{artifactProfile.shield.initiative}}</dd>
      <dt>Skill penalty (type)</dt><dd>{{artifactProfile.shield.skillPenalty}}</dd>
    </dl>
    <p class="item-info-footnote">{{artifactProfile.shield.ruleHint}}</p>
    {{/if}}
    {{/if}}

    {{#if artifactProfile.isGear}}
    {{#if artifactProfile.gear}}
    <h4 class="item-info-subtitle">Gear slot</h4>
    <dl class="item-info-dl">
      <dt>Slot</dt><dd>{{artifactProfile.gear.slotLabel}} <span class="item-info-muted">({{artifactProfile.gear.slotKey}})</span></dd>
    </dl>
    {{/if}}
    {{/if}}

    {{#if artifactProfile.lore}}
    <h4 class="item-info-subtitle">Lore</h4>
    <div class="item-info-lore">{{artifactProfile.lore}}</div>
    {{/if}}
  </section>
  {{/if}}

  {{#if isGeneric}}
  <section class="item-info-section item-info-generic">
    <h3 class="item-info-section-title">Description</h3>
    {{#if enrichedDescription}}
    <div class="item-info-description prose">{{{enrichedDescription}}}</div>
    {{else}}
    <p class="item-info-muted">No description.</p>
    {{/if}}
  </section>
  {{/if}}

  {{#if canEdit}}
  {{#if showQuickEdit}}
  <details class="item-info-edit-panel" {{#if quickEditOpen}}open{{/if}}>
    <summary class="item-info-edit-summary">Edit values</summary>
    <div class="item-info-edit-inner">

    {{#if isWeapon}}
    <div class="item-info-field-row item-info-field-row-2">
      <div>
        <label for="item-info-w-dmg">Weapon damage</label>
        <select id="item-info-w-dmg" class="item-info-select js-item-info-weapon-damage">
          {{#each weaponEdit.damageOptions}}
          <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
      </div>
      <div>
        <label for="item-info-w-hands">Hands</label>
        <select id="item-info-w-hands" class="item-info-select js-item-info-weapon-hands">
          {{#each weaponEdit.handsOptions}}
          <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
      </div>
    </div>
    <div class="item-info-field-row">
      <label for="item-info-w-type">Melee / Ranged</label>
      <select id="item-info-w-type" class="item-info-select js-item-info-weapon-type">
        {{#each weaponEdit.weaponTypeOptions}}
        <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
        {{/each}}
      </select>
    </div>
    <div class="item-info-field-row js-item-info-weapon-reach-row{{#if weaponEdit.initialRanged}} item-info-edit-hidden{{/if}}">
      <label for="item-info-w-reach">Melee reach (innate)</label>
      <select id="item-info-w-reach" class="item-info-select js-item-info-weapon-reach">
        {{#each weaponEdit.reachOptions}}
        <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
        {{/each}}
      </select>
    </div>
    <div class="item-info-field-row js-item-info-weapon-range-row{{#unless weaponEdit.initialRanged}} item-info-edit-hidden{{/unless}}">
      <label for="item-info-w-range">Ranged distance</label>
      <input id="item-info-w-range" type="text" class="item-info-input js-item-info-weapon-range" value="{{weaponEdit.range}}" placeholder="8m" />
    </div>
    {{/if}}

    {{#if isArmor}}
    <div class="item-info-field-row">
      <label for="item-info-a-type">Armor type</label>
      <select id="item-info-a-type" class="item-info-select js-item-info-armor-type">
        {{#each armorEdit.typeOptions}}
        <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
        {{/each}}
      </select>
    </div>
    <div class="item-info-field-row item-info-field-row-2">
      <div>
        <label for="item-info-a-val">Armor value</label>
        <input id="item-info-a-val" type="number" class="item-info-input js-item-info-armor-value" value="{{armorEdit.armorValue}}" step="1" />
      </div>
      <div>
        <label for="item-info-a-ev">Evade modifier</label>
        <input id="item-info-a-ev" type="number" class="item-info-input js-item-info-armor-evade" value="{{armorEdit.evadeModifier}}" step="1" />
      </div>
    </div>
    <div class="item-info-field-row">
      <label for="item-info-a-sk">Skill penalty</label>
      <input id="item-info-a-sk" type="text" class="item-info-input js-item-info-armor-skill-penalty" value="{{armorEdit.skillPenaltyPlain}}" placeholder="Empty = type default" />
    </div>
    {{/if}}

    {{#if isShield}}
    <div class="item-info-field-row">
      <label for="item-info-s-type">Shield type</label>
      <select id="item-info-s-type" class="item-info-select js-item-info-shield-type">
        {{#each shieldEdit.typeOptions}}
        <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
        {{/each}}
      </select>
    </div>
    <div class="item-info-field-row item-info-field-row-2">
      <div>
        <label for="item-info-s-val">Shield value</label>
        <input id="item-info-s-val" type="number" class="item-info-input js-item-info-shield-value" value="{{shieldEdit.shieldValue}}" step="1" min="0" />
      </div>
      <div>
        <label for="item-info-s-ev">Evade modifier</label>
        <input id="item-info-s-ev" type="number" class="item-info-input js-item-info-shield-evade" value="{{shieldEdit.evadeBonus}}" step="1" />
      </div>
    </div>
    {{/if}}

    {{#if isGear}}
    <div class="item-info-field-row">
      <label for="item-info-g-size">Inventory size</label>
      <select id="item-info-g-size" class="item-info-select js-item-info-gear-size">
        {{#each gearEdit.sizeOptions}}
        <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
        {{/each}}
      </select>
    </div>
    <div class="item-info-field-row item-info-field-row-2">
      <div>
        <label for="item-info-g-qty">Quantity</label>
        <input id="item-info-g-qty" type="number" class="item-info-input js-item-info-gear-qty" value="{{gearEdit.quantity}}" step="1" min="0" />
      </div>
      <div>
        <label for="item-info-g-w">Weight</label>
        <input id="item-info-g-w" type="number" class="item-info-input js-item-info-gear-weight" value="{{gearEdit.weight}}" step="0.1" min="0" />
      </div>
    </div>
    <div class="item-info-field-row">
      <label for="item-info-g-desc">Short description</label>
      <textarea id="item-info-g-desc" class="item-info-textarea js-item-info-gear-desc" rows="3" placeholder="Plain text">{{gearEdit.descriptionPlain}}</textarea>
    </div>
    {{/if}}

    <div class="item-info-edit-actions">
      <button type="button" class="dialog-btn dialog-btn-secondary js-item-info-save-edits">
        <i class="fas fa-save"></i> Save
      </button>
    </div>
    <p class="item-info-edit-hint">Only updates this item on the character. World storage items cannot be edited here.</p>
    </div>
  </details>
  {{/if}}
  {{/if}}

  <footer class="item-info-footer">
    {{#if showAdvancedSheetLink}}
    <button type="button" class="item-info-advanced-link js-item-info-advanced-sheet">
      Open item sheet…
    </button>
    {{/if}}
    <button type="button" class="dialog-btn js-item-info-close">
      <i class="fas fa-times"></i> Close
    </button>
  </footer>
</div>
