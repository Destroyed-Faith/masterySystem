<div class="stone-powers-dialog">
  {{#if combatActive}}
  {{#if combatMissingFromTracker}}
  <div class="stone-combat-hint-banner is-warn" role="alert">
    <i class="fas fa-exclamation-triangle" aria-hidden="true"></i>
    <span>Kampf läuft, aber diese Figur wurde im Tracker nicht gefunden (verknüpfter Token / falsches Blatt?). Steine ziehen und Aktivieren sind deaktiviert — Token in die Initiative ziehen oder vom Tracker öffnen.</span>
  </div>
  {{/if}}
  {{/if}}

  {{#if stoneReviewMode}}
  <div class="stone-plan-locked-banner" role="status">
    <i class="fas fa-eye" aria-hidden="true"></i>
    <div class="stone-plan-locked-text">
      <strong>{{combatLabel}} — nur Ansicht</strong>
      <span>Diese Steinzuordnung ist für die Runde bestätigt. Du siehst, was verteilt wurde. Steine können nicht verschoben oder neu bezahlt werden.</span>
    </div>
  </div>
  {{else if stonePlanLocked}}
  <div class="stone-plan-locked-banner" role="status">
    <i class="fas fa-lock" aria-hidden="true"></i>
    <div class="stone-plan-locked-text">
      <strong>{{combatLabel}}</strong>
      <span>Steinzuordnung und Aktivieren sind für diese Runde gesperrt, sobald du Bewegung, einen Angriff oder eine Reaktion genutzt hast.</span>
      <span class="stone-plan-locked-sub">Bereits voll bezahlte Wellen bleiben gültig — <strong>Übernehmen &amp; schließen</strong> verbucht sie und schließt den Dialog.</span>
    </div>
  </div>
  {{/if}}

  {{#if initiativeExchange.show}}
  <div class="initiative-exchange-bar{{#if initiativeExchange.locked}} is-locked{{/if}}">
    <div class="initiative-exchange-copy">
      <strong>Initiative Exchange</strong>
      <span>Initiative <b>{{initiativeExchange.initiative}}</b> · {{initiativeExchange.costPerStone}} Ini / Colorless Stone (MR {{initiativeExchange.masteryRank}})</span>
      {{#if initiativeExchange.boostUsed}}<span class="initiative-exchange-boost-used">Initiative Boost already used this combat.</span>{{/if}}
    </div>
    <div class="initiative-exchange-actions">
      <label class="initiative-exchange-count">
        Stones
        <input type="number" class="js-colorless-convert-count" min="0" max="{{initiativeExchange.maxConvert}}" value="{{initiativeExchange.convertCount}}" {{#if initiativeExchange.locked}}disabled{{/if}} />
      </label>
      <button type="button" class="dialog-btn dialog-btn-secondary js-convert-initiative-colorless" {{#if initiativeExchange.locked}}disabled{{/if}} {{#unless initiativeExchange.maxConvert}}disabled{{/unless}}>
        <i class="fas fa-arrows-rotate"></i> Initiative zu Colorless Stones umwandeln
      </button>
    </div>
  </div>
  {{/if}}

  {{#if showStonePools}}
  <div class="stone-pools-display">
    <div class="stone-pools-header-row">
      <h3>Available Stones</h3>
    </div>
    <div class="pools-grid">
      {{#each pools as |pool|}}
      <div class="pool-item" data-attribute="{{pool.key}}">
        <div class="pool-item-header">
          <span class="pool-name">{{pool.name}}</span>
        </div>
        <div class="pool-gems{{#unless pool.gemSlots.length}} is-empty{{/unless}}" data-attribute-key="{{pool.key}}" title="{{pool.name}} — Steine zum Ziehen">
          {{#each pool.boundSlots}}
          <span
            class="ms-stone-gem-chip ms-slot-gem-bound is-drag-disabled"
            draggable="false"
            data-attribute-key="{{../key}}"
            style="background: {{../gemStyle.fill}}; box-shadow: 0 0 0 2px {{../gemStyle.stroke}} inset, 0 1px 3px rgba(0,0,0,0.45);"
            title="{{../name}}: an Artefakt-Aktivierung gebunden — nicht zuweisbar"></span>
          {{/each}}
          {{#each pool.gemSlots}}
          <span
            class="ms-stone-gem-chip js-stone-draggable{{#unless @root.dragPoolEnabled}} is-drag-disabled{{/unless}}"
            {{#if @root.dragPoolEnabled}}draggable="true"{{else}}draggable="false"{{/if}}
            data-attribute-key="{{../key}}"
            style="background: {{../gemStyle.fill}}; box-shadow: 0 0 0 2px {{../gemStyle.stroke}} inset, 0 1px 3px rgba(0,0,0,0.45);"
            title="{{../name}}: hier greifen und auf Ablagefeld ziehen"></span>
          {{/each}}
        </div>
        {{#if pool.sustained}}
        <span class="pool-sustained">({{pool.sustained}} sustained)</span>
        {{/if}}
      </div>
      {{/each}}
    </div>
  </div>
  {{/if}}

  <div class="powers-list">
    <div class="powers-matrix" role="region" aria-label="Stone powers matrix">
    {{#if generalPowers.length}}
    <div class="power-group is-general" role="region" aria-label="General Powers">
      <div class="powers-grid powers-grid-general">
        {{#each generalPowers as |power|}}
        <div class="power-card power-card-general" title="Linksklick: nächsten Block füllen (1, dann 2, dann 4, dann 8 Steine — je Pool-Verfügbarkeit) · Rechtsklick: alles leeren · Drag: aus dem Pool ziehen">
          <div class="power-drop-slots-row power-drop-slots-row-general">
            <div class="power-drop-slots power-drop-slots-general" data-power-id="{{power.id}}">
              <div class="ms-stone-drop-slot-cluster" role="group">
                <div class="ms-stone-cluster-col-a">
                  {{#each power.paymentAnchor as |ls|}}
                  <div class="ms-stone-drop-slot slot-{{ls.state}}{{#unless @root.dragStonesEnabled}} slot-no-drag{{/unless}}"
                       data-power-id="{{../id}}"
                       data-is-generic="true"
                       data-slot-index="{{ls.slotIndex}}"
                       data-lane-index="{{ls.laneIndex}}"
                       title="{{#if (eq ls.state 'active')}}Beliebigen Attribut-Stein hier ablegen{{/if}}{{#if (eq ls.state 'filled')}}Gelegt — zum Freigeben in den Pool ziehen{{/if}}{{#if (eq ls.state 'disabled')}}Kein Tier 1 — starte im Tier-2-Feld{{/if}}{{#if (eq ls.state 'locked')}}{{#if ../canAfford}}Später{{else}}Nicht genug Steine in einem Pool{{/if}}{{/if}}">
                    <div class="ms-stone-slot-fill">{{#if (eq ls.state 'support')}}<span class="ms-stone-gem-chip ms-slot-gem-support" title="Artifact Support Stone (vom Artefakt bereitgestellt)"><i class="fas fa-gem"></i></span>{{/if}}</div>
                  </div>
                  {{/each}}
                </div>
                <div class="ms-stone-cluster-vsep ms-stone-cluster-vsep-1" role="separator" aria-hidden="true"></div>
                <div class="ms-stone-cluster-col-mid">
                  {{#each power.paymentMid as |ls|}}
                  <div class="ms-stone-drop-slot slot-{{ls.state}}{{#unless @root.dragStonesEnabled}} slot-no-drag{{/unless}}"
                       data-power-id="{{../id}}" data-is-generic="true" data-slot-index="{{ls.slotIndex}}" data-lane-index="{{ls.laneIndex}}"
                       title="{{#if (eq ls.state 'active')}}Beliebigen Attribut-Stein hier ablegen{{/if}}{{#if (eq ls.state 'filled')}}Gelegt — zum Freigeben in den Pool ziehen{{/if}}{{#if (eq ls.state 'locked')}}{{#if ../canAfford}}Später{{else}}Nicht genug Steine in einem Pool{{/if}}{{/if}}">
                    <div class="ms-stone-slot-fill">{{#if (eq ls.state 'support')}}<span class="ms-stone-gem-chip ms-slot-gem-support" title="Artifact Support Stone (vom Artefakt bereitgestellt)"><i class="fas fa-gem"></i></span>{{/if}}</div>
                  </div>
                  {{/each}}
                </div>
                <div class="ms-stone-cluster-vsep ms-stone-cluster-vsep-2" role="separator" aria-hidden="true"></div>
                <div class="ms-stone-cluster-col-quad">
                  {{#each power.paymentQuad as |ls|}}
                  <div class="ms-stone-drop-slot slot-{{ls.state}}{{#unless @root.dragStonesEnabled}} slot-no-drag{{/unless}}"
                       data-power-id="{{../id}}" data-is-generic="true" data-slot-index="{{ls.slotIndex}}" data-lane-index="{{ls.laneIndex}}"
                       title="{{#if (eq ls.state 'active')}}Beliebigen Attribut-Stein hier ablegen{{/if}}{{#if (eq ls.state 'filled')}}Gelegt — zum Freigeben in den Pool ziehen{{/if}}{{#if (eq ls.state 'locked')}}{{#if ../canAfford}}Später{{else}}Nicht genug Steine in einem Pool{{/if}}{{/if}}">
                    <div class="ms-stone-slot-fill">{{#if (eq ls.state 'support')}}<span class="ms-stone-gem-chip ms-slot-gem-support" title="Artifact Support Stone (vom Artefakt bereitgestellt)"><i class="fas fa-gem"></i></span>{{/if}}</div>
                  </div>
                  {{/each}}
                </div>
                <div class="ms-stone-cluster-vsep ms-stone-cluster-vsep-3" role="separator" aria-hidden="true"></div>
                <div class="ms-stone-cluster-col-oct">
                  {{#each power.paymentOct as |ls|}}
                  <div class="ms-stone-drop-slot slot-{{ls.state}}{{#unless @root.dragStonesEnabled}} slot-no-drag{{/unless}}"
                       data-power-id="{{../id}}" data-is-generic="true" data-slot-index="{{ls.slotIndex}}" data-lane-index="{{ls.laneIndex}}"
                       title="{{#if (eq ls.state 'active')}}Beliebigen Attribut-Stein hier ablegen{{/if}}{{#if (eq ls.state 'filled')}}Gelegt — zum Freigeben in den Pool ziehen{{/if}}{{#if (eq ls.state 'locked')}}{{#if ../canAfford}}Später{{else}}Nicht genug Steine in einem Pool{{/if}}{{/if}}">
                    <div class="ms-stone-slot-fill">{{#if (eq ls.state 'support')}}<span class="ms-stone-gem-chip ms-slot-gem-support" title="Artifact Support Stone (vom Artefakt bereitgestellt)"><i class="fas fa-gem"></i></span>{{/if}}</div>
                  </div>
                  {{/each}}
                </div>
              </div>
            </div>
          </div>
          <div class="power-title power-title-general">
            <strong class="power-name" title="{{power.effectLong}}">{{power.name}}</strong>
            {{#if power.supportTier}}<span class="power-support-badge{{#unless power.supportActive}} is-spent{{/unless}}" title="Stone Power Support ({{power.supportSource}}): {{#if power.supportActive}}Erstaktivierung startet auf Tier {{power.supportTier}} — du legst nur 1 Stein in den Anker, die Artifact Support Stones stellt das Artefakt.{{else}}Artifact Support Stones bereits genutzt — skaliert ab jetzt normal (Mindest-Tier {{power.supportTier}}).{{/if}}"><i class="fas fa-gem"></i> T{{power.supportTier}}</span>{{/if}}
          </div>
        </div>
        {{/each}}
      </div>
    </div>
    {{/if}}

    {{#each attributePowerMatrix}}
      <div class="powers-grid powers-grid-general powers-grid-attr-matrix">
        {{#each cells}}
          {{#if this}}
        <div class="power-card power-card-general" title="Linksklick: nächsten Block mit {{attribute}}-Steinen (1 → 2 → 4 → 8) · Rechtsklick: alles leeren · Drag: aus dem Pool ziehen">
          <div class="power-drop-slots-row power-drop-slots-row-general">
            <div class="power-drop-slots power-drop-slots-general" data-power-id="{{id}}">
              <div class="ms-stone-drop-slot-cluster" role="group">
                <div class="ms-stone-cluster-col-a">
                  {{#each paymentAnchor as |ls|}}
                  <div class="ms-stone-drop-slot slot-{{ls.state}}{{#unless @root.dragStonesEnabled}} slot-no-drag{{/unless}}"
                       data-power-id="{{../id}}"
                       data-pay-attribute="{{../attribute}}"
                       data-slot-index="{{ls.slotIndex}}"
                       data-lane-index="{{ls.laneIndex}}"
                       title="{{#if (eq ls.state 'active')}}Passenden {{../attribute}}-Stein ablegen{{/if}}{{#if (eq ls.state 'filled')}}Gelegt — zum Freigeben in den Pool ziehen{{/if}}{{#if (eq ls.state 'locked')}}{{#if ../canAfford}}Später{{else}}Nicht genug Steine{{/if}}{{/if}}">
                    <div class="ms-stone-slot-fill">{{#if (eq ls.state 'support')}}<span class="ms-stone-gem-chip ms-slot-gem-support" title="Artifact Support Stone (vom Artefakt bereitgestellt)"><i class="fas fa-gem"></i></span>{{/if}}</div>
                  </div>
                  {{/each}}
                </div>
                <div class="ms-stone-cluster-vsep ms-stone-cluster-vsep-1" role="separator" aria-hidden="true"></div>
                <div class="ms-stone-cluster-col-mid">
                  {{#each paymentMid as |ls|}}
                  <div class="ms-stone-drop-slot slot-{{ls.state}}{{#unless @root.dragStonesEnabled}} slot-no-drag{{/unless}}"
                       data-power-id="{{../id}}" data-pay-attribute="{{../attribute}}" data-slot-index="{{ls.slotIndex}}" data-lane-index="{{ls.laneIndex}}"
                       title="{{#if (eq ls.state 'active')}}Passenden {{../attribute}}-Stein ablegen{{/if}}{{#if (eq ls.state 'filled')}}Gelegt — zum Freigeben in den Pool ziehen{{/if}}{{#if (eq ls.state 'locked')}}{{#if ../canAfford}}Später{{else}}Nicht genug Steine{{/if}}{{/if}}">
                    <div class="ms-stone-slot-fill">{{#if (eq ls.state 'support')}}<span class="ms-stone-gem-chip ms-slot-gem-support" title="Artifact Support Stone (vom Artefakt bereitgestellt)"><i class="fas fa-gem"></i></span>{{/if}}</div>
                  </div>
                  {{/each}}
                </div>
                <div class="ms-stone-cluster-vsep ms-stone-cluster-vsep-2" role="separator" aria-hidden="true"></div>
                <div class="ms-stone-cluster-col-quad">
                  {{#each paymentQuad as |ls|}}
                  <div class="ms-stone-drop-slot slot-{{ls.state}}{{#unless @root.dragStonesEnabled}} slot-no-drag{{/unless}}"
                       data-power-id="{{../id}}" data-pay-attribute="{{../attribute}}" data-slot-index="{{ls.slotIndex}}" data-lane-index="{{ls.laneIndex}}"
                       title="{{#if (eq ls.state 'active')}}Passenden {{../attribute}}-Stein ablegen{{/if}}{{#if (eq ls.state 'filled')}}Gelegt — zum Freigeben in den Pool ziehen{{/if}}{{#if (eq ls.state 'locked')}}{{#if ../canAfford}}Später{{else}}Nicht genug Steine{{/if}}{{/if}}">
                    <div class="ms-stone-slot-fill">{{#if (eq ls.state 'support')}}<span class="ms-stone-gem-chip ms-slot-gem-support" title="Artifact Support Stone (vom Artefakt bereitgestellt)"><i class="fas fa-gem"></i></span>{{/if}}</div>
                  </div>
                  {{/each}}
                </div>
                <div class="ms-stone-cluster-vsep ms-stone-cluster-vsep-3" role="separator" aria-hidden="true"></div>
                <div class="ms-stone-cluster-col-oct">
                  {{#each paymentOct as |ls|}}
                  <div class="ms-stone-drop-slot slot-{{ls.state}}{{#unless @root.dragStonesEnabled}} slot-no-drag{{/unless}}"
                       data-power-id="{{../id}}" data-pay-attribute="{{../attribute}}" data-slot-index="{{ls.slotIndex}}" data-lane-index="{{ls.laneIndex}}"
                       title="{{#if (eq ls.state 'active')}}Passenden {{../attribute}}-Stein ablegen{{/if}}{{#if (eq ls.state 'filled')}}Gelegt — zum Freigeben in den Pool ziehen{{/if}}{{#if (eq ls.state 'locked')}}{{#if ../canAfford}}Später{{else}}Nicht genug Steine{{/if}}{{/if}}">
                    <div class="ms-stone-slot-fill">{{#if (eq ls.state 'support')}}<span class="ms-stone-gem-chip ms-slot-gem-support" title="Artifact Support Stone (vom Artefakt bereitgestellt)"><i class="fas fa-gem"></i></span>{{/if}}</div>
                  </div>
                  {{/each}}
                </div>
              </div>
            </div>
          </div>
          <div class="power-title power-title-general">
            <strong class="power-name" title="{{effectLong}}">{{name}}</strong>
            {{#if supportTier}}<span class="power-support-badge{{#unless supportActive}} is-spent{{/unless}}" title="Stone Power Support ({{supportSource}}): {{#if supportActive}}Erstaktivierung startet auf Tier {{supportTier}} — du legst nur 1 Stein in den Anker, die Artifact Support Stones stellt das Artefakt.{{else}}Artifact Support Stones bereits genutzt — skaliert ab jetzt normal (Mindest-Tier {{supportTier}}).{{/if}}"><i class="fas fa-gem"></i> T{{supportTier}}</span>{{/if}}
          </div>
        </div>
          {{else}}
        <div class="power-card power-card-general power-card-placeholder" aria-hidden="true"></div>
          {{/if}}
        {{/each}}
      </div>
    {{/each}}
    </div>
  </div>

  {{#unless combatStarted}}
  {{#unless stoneReviewMode}}
  <p class="stone-powers-close-hint">Voll bezahlte Stein-Wellen werden beim <strong>Übernehmen &amp; schließen</strong> abgerechnet (Pools, Kampf-Rundenstatus). Unvollständige Wellen bleiben bis zur nächsten vollen Welle offen.</p>
  {{/unless}}
  {{/unless}}

  <div class="dialog-footer stone-powers-footer">
    {{#unless combatStarted}}
    {{#unless stoneReviewMode}}
    <div class="stone-prefs-bar">
      <label class="stone-prefs-label">
        <input type="checkbox" class="js-stone-prefs-use-defaults"
               {{#if prefsUseDefaults}}checked{{/if}}
               {{#unless canSavePrefs}}disabled{{/unless}} />
        <span>Standard pro Runde automatisch übernehmen (zuletzt genutztes Attribut bei General Powers)</span>
      </label>
      <button type="button"
              class="dialog-btn dialog-btn-secondary js-save-stone-prefs{{#unless canSavePrefs}} is-disabled{{/unless}}"
              {{#unless canSavePrefs}}disabled title="Nur vor der ersten Aktion in der Runde oder außerhalb des Kampfes"{{/unless}}>
        <i class="fas fa-save"></i> Standard speichern
      </button>
    </div>
    {{/unless}}
    {{/unless}}
    {{#if stoneReviewMode}}
    <button type="button" class="dialog-btn dialog-btn-primary js-close" title="Dialog schließen. Die bestätigte Zuordnung bleibt.">
      <i class="fas fa-check"></i> Schließen
    </button>
    {{else}}
    <button type="button" class="dialog-btn dialog-btn-primary js-close" title="Verbucht voll bezahlte Wellen und schließt den Dialog.">
      <i class="fas fa-check"></i> Übernehmen &amp; schließen
    </button>
    {{/if}}
  </div>
</div>
