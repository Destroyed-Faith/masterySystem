<div class="stone-powers-dialog">
  {{#if combatActive}}
  {{#if combatMissingFromTracker}}
  <div class="stone-combat-hint-banner is-warn" role="alert">
    <i class="fas fa-exclamation-triangle" aria-hidden="true"></i>
    <span>Kampf läuft, aber diese Figur wurde im Tracker nicht gefunden (verknüpfter Token / falsches Blatt?). Steine ziehen und Aktivieren sind deaktiviert — Token in die Initiative ziehen oder vom Tracker öffnen.</span>
  </div>
  {{/if}}
  {{/if}}

  {{#if stoneReviewMode}}
  <div class="stone-plan-locked-banner" role="status">
    <i class="fas fa-eye" aria-hidden="true"></i>
    <div class="stone-plan-locked-text">
      <strong>{{combatLabel}} — nur Ansicht</strong>
      <span>Diese Steinzuordnung ist für die Runde bestätigt. Du siehst, was verteilt wurde. Steine können nicht verschoben oder neu bezahlt werden.</span>
    </div>
  </div>
  {{else if stonePlanLocked}}
  <div class="stone-plan-locked-banner" role="status">
    <i class="fas fa-lock" aria-hidden="true"></i>
    <div class="stone-plan-locked-text">
      <strong>{{combatLabel}}</strong>
      <span>Steinzuordnung und Aktivieren sind für diese Runde gesperrt, sobald du Bewegung, einen Angriff oder eine Reaktion genutzt hast.</span>
      <span class="stone-plan-locked-sub">Bereits voll bezahlte Wellen bleiben gültig — <strong>Übernehmen &amp; schließen</strong> verbucht sie und schließt den Dialog.</span>
    </div>
  </div>
  {{/if}}

  {{#if initiativeExchange.show}}
  <div class="initiative-exchange-bar{{#if initiativeExchange.locked}} is-locked{{/if}}">
    <div class="initiative-exchange-copy">
      <strong>Initiative Exchange</strong>
      <span>Initiative <b>{{initiativeExchange.initiative}}</b> · {{initiativeExchange.costPerStone}} Ini / Colorless Stone (MR {{initiativeExchange.masteryRank}})</span>
      {{#if initiativeExchange.boostUsed}}<span class="initiative-exchange-boost-used">Initiative Boost already used this combat.</span>{{/if}}
    </div>
    <div class="initiative-exchange-actions">
      {{#if initiativeExchange.combatReflexes.show}}
      <div class="initiative-exchange-uses" title="Combat Reflexes: 4 uses per Safe Haven Rest, each use applies {{initiativeExchange.combatReflexes.pointsPerUse}} points (Mastery Rank) as Initiative. {{initiativeExchange.combatReflexes.remainingPool}} points left.">
        <span class="initiative-exchange-stepper-label">Combat Reflexes</span>
        {{#each initiativeExchange.combatReflexes.boxes}}
        <button type="button"
                class="cr-use-box{{#if spent}} is-spent{{/if}}{{#if unavailable}} is-unavailable{{/if}}{{#if canSpend}} is-next{{/if}}{{#if canUndo}} is-undoable{{/if}} js-cr-box"
                data-cr-action="spend"
                {{#unless canSpend}}disabled{{/unless}}
                aria-label="Combat Reflexes use, {{size}} points">
          {{#if unavailable}}—{{else}}{{#if spent}}<i class="fas fa-xmark"></i>{{else}}{{remaining}}{{/if}}{{/if}}
        </button>
        {{/each}}
        <button type="button" class="initiative-exchange-btn js-cr-box" data-cr-action="undo" {{#unless initiativeExchange.combatReflexes.canUndo}}disabled{{/unless}} title="Take back the last use from this round" aria-label="Take back the last Combat Reflexes use">
          <i class="fas fa-rotate-left"></i>
        </button>
      </div>
      {{/if}}
      <div class="initiative-exchange-stepper" title="Colorless Stones to buy for {{initiativeExchange.costPerStone}} Initiative each (max {{initiativeExchange.maxConvert}}).">
        <span class="initiative-exchange-stepper-label">Stones</span>
        <button type="button" class="initiative-exchange-btn js-convert-count-remove" {{#unless initiativeExchange.canConvertLess}}disabled{{/unless}} aria-label="One stone less">
          <i class="fas fa-minus"></i>
        </button>
        <span class="initiative-exchange-value">{{initiativeExchange.convertCount}}</span>
        <button type="button" class="initiative-exchange-btn js-convert-count-add" {{#unless initiativeExchange.canConvertMore}}disabled{{/unless}} aria-label="One stone more">
          <i class="fas fa-plus"></i>
        </button>
      </div>
      <button type="button" class="dialog-btn dialog-btn-secondary js-convert-initiative-colorless" {{#if initiativeExchange.locked}}disabled{{/if}} {{#unless initiativeExchange.convertCount}}disabled{{/unless}}>
        <i class="fas fa-arrows-rotate"></i> Initiative zu Colorless Stones umwandeln
      </button>
    </div>
  </div>
  {{/if}}

  {{#if naturalRecovery.show}}
  <div class="natural-recovery-bar{{#if naturalRecovery.locked}} is-locked{{/if}}">
    <div class="natural-recovery-copy">
      <strong>{{naturalRecovery.title}}</strong>
      <span>{{naturalRecovery.hint}}</span>
    </div>
    <div class="natural-recovery-actions">
      <span class="natural-recovery-count{{#if naturalRecovery.remaining}} is-open{{/if}}">
        {{naturalRecovery.allocated}} / {{naturalRecovery.masteryRank}}
      </span>
      <button type="button"
              class="natural-recovery-pick js-nsr-skip{{#if naturalRecovery.skipped}} is-selected{{/if}}"
              {{#if naturalRecovery.locked}}disabled{{/if}}>
        {{naturalRecovery.noneLabel}}
      </button>
    </div>
    <div class="natural-recovery-rows">
      {{#each naturalRecovery.options}}
      <div class="natural-recovery-row">
        <span class="natural-recovery-label">{{this.label}}</span>
        <div class="natural-recovery-stepper">
          <button type="button"
                  class="natural-recovery-step js-nsr-remove"
                  data-special-id="{{this.id}}"
                  {{#unless this.canRemove}}disabled{{/unless}}
                  aria-label="One less">
            <i class="fas fa-minus"></i>
          </button>
          <span class="natural-recovery-value">{{this.allocated}}</span>
          <button type="button"
                  class="natural-recovery-step js-nsr-add"
                  data-special-id="{{this.id}}"
                  {{#unless this.canAdd}}disabled{{/unless}}
                  aria-label="One more">
            <i class="fas fa-plus"></i>
          </button>
        </div>
      </div>
      {{/each}}
    </div>
  </div>
  {{/if}}

  {{#if showStonePools}}
  <div class="stone-pools-display{{#if recovery.active}} is-recovery{{/if}}">
    <div class="stone-pools-header-row">
      <h3>Available Stones</h3>
    </div>
    {{#if recovery.active}}
    <div class="stone-recovery-bar" role="region" aria-label="Stone Recovery">
      <div class="stone-recovery-copy">
        <strong>Stone Recovery</strong>
        <span>Pick which spent stones come back — <b>{{recovery.points}}</b> (Mastery Rank). Pools without room are hidden.</span>
        {{#if recovery.saturated}}<span class="stone-recovery-note">All pools are full — the remaining {{recovery.remaining}} stone(s) are lost.</span>{{/if}}
      </div>
      <div class="stone-recovery-actions">
        <span class="stone-recovery-count{{#if recovery.remaining}} is-open{{/if}}">
          {{recovery.allocated}} / {{recovery.points}}
        </span>
        <button type="button" class="dialog-btn dialog-btn-primary js-recovery-done" {{#unless recovery.canFinish}}disabled title="Assign all recovery stones first."{{/unless}}>
          <i class="fas fa-check"></i> Recovery Done
        </button>
      </div>
    </div>
    {{/if}}
    <div class="pools-grid">
      {{#each pools as |pool|}}
      <div class="pool-item{{#if pool.blocked}} is-blocked{{/if}}{{#if pool.recoverShow}} is-recoverable{{/if}}" data-attribute="{{pool.key}}">
        <div class="pool-item-header">
          <span class="pool-name">{{pool.name}}</span>
          {{#if pool.blockedReason}}<span class="pool-blocked-reason" title="{{pool.blockedReason}}">{{pool.blockedReason}}</span>{{/if}}
        </div>
        {{#if pool.recoverShow}}
        <div class="pool-recovery" title="{{pool.name}}: {{pool.recoverSpace}} spent stone(s) can come back">
          <button type="button" class="pool-recovery-btn js-recover-remove" data-attribute="{{pool.key}}" {{#unless pool.recoverCanRemove}}disabled{{/unless}} aria-label="Recover one less">
            <i class="fas fa-minus"></i>
          </button>
          <span class="pool-recovery-value">+{{pool.recoverAlloc}}</span>
          <button type="button" class="pool-recovery-btn js-recover-add" data-attribute="{{pool.key}}" {{#unless pool.recoverCanAdd}}disabled{{/unless}} aria-label="Recover one more">
            <i class="fas fa-plus"></i>
          </button>
        </div>
        {{/if}}
        <div class="pool-gems{{#unless pool.gemSlots.length}} is-empty{{/unless}}" data-attribute-key="{{pool.key}}" title="{{pool.name}} — Steine zum Ziehen">
          {{#each pool.boundSlots}}
          <span
            class="ms-stone-gem-chip ms-slot-gem-bound is-drag-disabled"
            draggable="false"
            data-attribute-key="{{../key}}"
            style="background: {{../gemStyle.fill}}; box-shadow: 0 0 0 2px {{../gemStyle.stroke}} inset, 0 1px 3px rgba(0,0,0,0.45);"
            title="{{../name}}: reserved (legacy leftover — not spendable)"></span>
          {{/each}}
          {{#each pool.gemSlots}}
          <span
            class="ms-stone-gem-chip js-stone-draggable{{#unless @root.dragPoolEnabled}} is-drag-disabled{{/unless}}"
            {{#if @root.dragPoolEnabled}}draggable="true"{{else}}draggable="false"{{/if}}
            data-attribute-key="{{../key}}"
            style="background: {{../gemStyle.fill}}; box-shadow: 0 0 0 2px {{../gemStyle.stroke}} inset, 0 1px 3px rgba(0,0,0,0.45);"
            title="{{../name}}: hier greifen und auf Ablagefeld ziehen"></span>
          {{/each}}
        </div>
        {{#if pool.sustained}}
        <span class="pool-sustained">({{pool.sustained}} sustained)</span>
        {{/if}}
      </div>
      {{/each}}
    </div>
  </div>
  {{/if}}

  <div class="powers-list{{#if recovery.active}} is-recovery-locked{{/if}}" {{#if recovery.active}}aria-disabled="true" title="Finish Stone Recovery first."{{/if}}>
    <div class="powers-matrix" role="region" aria-label="Stone powers matrix">
    {{#if generalPowers.length}}
    <details class="power-group is-general{{#unless generalHasSpendable}} is-empty-section{{/unless}}" data-section="general" {{#if generalSectionOpen}}open{{/if}}>
      <summary class="powers-attr-label js-stone-section-toggle" data-section="general">
        <i class="fas fa-chevron-right" aria-hidden="true"></i>
        <span>General</span>
      </summary>
      <div class="powers-grid powers-grid-general">
        {{#each generalPowers as |power|}}
        <div class="power-card power-card-general" title="{{#if power.hideLeadSegment}}Linksklick: nächsten Block füllen (2, dann 4, dann 8 Steine — je Pool-Verfügbarkeit){{else}}Linksklick: nächsten Block füllen (1, dann 2, dann 4, dann 8 Steine — je Pool-Verfügbarkeit){{/if}} · Rechtsklick: alles leeren · Drag: aus dem Pool ziehen">
          <div class="power-drop-slots-row power-drop-slots-row-general">
            <div class="power-drop-slots power-drop-slots-general" data-power-id="{{power.id}}" data-acc-key="{{power.accKey}}">
              <div class="ms-stone-drop-slot-cluster{{#if power.hideLeadSegment}} is-ramp-skip{{/if}}" role="group">
                {{#unless power.hideLeadSegment}}
                <div class="ms-stone-cluster-col-a">
                  {{#each power.paymentAnchor as |ls|}}
                  <div class="ms-stone-drop-slot slot-{{ls.state}}{{#unless @root.dragStonesEnabled}} slot-no-drag{{/unless}}"
                       data-power-id="{{../id}}"
                       data-is-generic="true"
                       data-slot-index="{{ls.slotIndex}}"
                       data-lane-index="{{ls.laneIndex}}"
                       title="{{#if (eq ls.state 'active')}}Beliebigen Attribut-Stein hier ablegen{{/if}}{{#if (eq ls.state 'filled')}}Gelegt — zum Freigeben in den Pool ziehen{{/if}}{{#if (eq ls.state 'locked')}}{{#if ../canAfford}}Später{{else}}Nicht genug Steine in einem Pool{{/if}}{{/if}}">
                    <div class="ms-stone-slot-fill">{{#if (eq ls.state 'support')}}<span class="ms-stone-gem-chip ms-slot-gem-support" title="Artifact Support Stone (vom Artefakt bereitgestellt)"><i class="fas fa-gem"></i></span>{{/if}}</div>
                  </div>
                  {{/each}}
                </div>
                <div class="ms-stone-cluster-vsep ms-stone-cluster-vsep-1" role="separator" aria-hidden="true"></div>
                {{/unless}}
                <div class="ms-stone-cluster-col-mid">
                  {{#each power.paymentMid as |ls|}}
                  <div class="ms-stone-drop-slot slot-{{ls.state}}{{#unless @root.dragStonesEnabled}} slot-no-drag{{/unless}}"
                       data-power-id="{{../id}}" data-is-generic="true" data-slot-index="{{ls.slotIndex}}" data-lane-index="{{ls.laneIndex}}"
                       title="{{#if (eq ls.state 'active')}}Beliebigen Attribut-Stein hier ablegen{{/if}}{{#if (eq ls.state 'filled')}}Gelegt — zum Freigeben in den Pool ziehen{{/if}}{{#if (eq ls.state 'locked')}}{{#if ../canAfford}}Später{{else}}Nicht genug Steine in einem Pool{{/if}}{{/if}}">
                    <div class="ms-stone-slot-fill">{{#if (eq ls.state 'support')}}<span class="ms-stone-gem-chip ms-slot-gem-support" title="Artifact Support Stone (vom Artefakt bereitgestellt)"><i class="fas fa-gem"></i></span>{{/if}}</div>
                  </div>
                  {{/each}}
                </div>
                <div class="ms-stone-cluster-vsep ms-stone-cluster-vsep-2" role="separator" aria-hidden="true"></div>
                <div class="ms-stone-cluster-col-quad">
                  {{#each power.paymentQuad as |ls|}}
                  <div class="ms-stone-drop-slot slot-{{ls.state}}{{#unless @root.dragStonesEnabled}} slot-no-drag{{/unless}}"
                       data-power-id="{{../id}}" data-is-generic="true" data-slot-index="{{ls.slotIndex}}" data-lane-index="{{ls.laneIndex}}"
                       title="{{#if (eq ls.state 'active')}}Beliebigen Attribut-Stein hier ablegen{{/if}}{{#if (eq ls.state 'filled')}}Gelegt — zum Freigeben in den Pool ziehen{{/if}}{{#if (eq ls.state 'locked')}}{{#if ../canAfford}}Später{{else}}Nicht genug Steine in einem Pool{{/if}}{{/if}}">
                    <div class="ms-stone-slot-fill">{{#if (eq ls.state 'support')}}<span class="ms-stone-gem-chip ms-slot-gem-support" title="Artifact Support Stone (vom Artefakt bereitgestellt)"><i class="fas fa-gem"></i></span>{{/if}}</div>
                  </div>
                  {{/each}}
                </div>
                <div class="ms-stone-cluster-vsep ms-stone-cluster-vsep-3" role="separator" aria-hidden="true"></div>
                <div class="ms-stone-cluster-col-oct">
                  {{#each power.paymentOct as |ls|}}
                  <div class="ms-stone-drop-slot slot-{{ls.state}}{{#unless @root.dragStonesEnabled}} slot-no-drag{{/unless}}"
                       data-power-id="{{../id}}" data-is-generic="true" data-slot-index="{{ls.slotIndex}}" data-lane-index="{{ls.laneIndex}}"
                       title="{{#if (eq ls.state 'active')}}Beliebigen Attribut-Stein hier ablegen{{/if}}{{#if (eq ls.state 'filled')}}Gelegt — zum Freigeben in den Pool ziehen{{/if}}{{#if (eq ls.state 'locked')}}{{#if ../canAfford}}Später{{else}}Nicht genug Steine in einem Pool{{/if}}{{/if}}">
                    <div class="ms-stone-slot-fill">{{#if (eq ls.state 'support')}}<span class="ms-stone-gem-chip ms-slot-gem-support" title="Artifact Support Stone (vom Artefakt bereitgestellt)"><i class="fas fa-gem"></i></span>{{/if}}</div>
                  </div>
                  {{/each}}
                </div>
              </div>
            </div>
          </div>
          <div class="power-title power-title-general">
            <strong class="power-name" title="{{power.effectLong}}">{{power.name}}</strong>
            {{#if power.supportTier}}<span class="power-support-badge{{#unless power.supportActive}} is-spent{{/unless}}" title="Stone Power Support ({{power.supportSource}}): {{#if power.supportActive}}Erstaktivierung startet auf Tier {{power.supportTier}} — du legst nur 1 Stein in den Anker, die Artifact Support Stones stellt das Artefakt.{{else}}Artifact Support Stones bereits genutzt — skaliert ab jetzt normal (Mindest-Tier {{power.supportTier}}).{{/if}}"><i class="fas fa-gem"></i> T{{power.supportTier}}</span>{{/if}}
          </div>
        </div>
        {{/each}}
      </div>
    </details>
    {{/if}}

    {{#each attributePowerMatrix}}
      <details class="power-group is-attr{{#unless hasSpendable}} is-empty-section{{/unless}}" data-section="{{attrKey}}" {{#if sectionOpen}}open{{/if}}>
      <summary class="powers-attr-label js-stone-section-toggle" data-attribute="{{attrKey}}" data-section="{{attrKey}}">
        <i class="fas fa-chevron-right" aria-hidden="true"></i>
        <span>{{attrName}}</span>
      </summary>
      <div class="powers-grid powers-grid-general powers-grid-attr-matrix">
        {{#each cells}}
          {{#if this}}
        <div class="power-card power-card-general" title="{{#if hideLeadSegment}}Linksklick: nächsten Block mit {{attribute}}-Steinen (2 → 4 → 8){{else}}Linksklick: nächsten Block mit {{attribute}}-Steinen (1 → 2 → 4 → 8){{/if}} · Rechtsklick: alles leeren · Drag: aus dem Pool ziehen">
          <div class="power-drop-slots-row power-drop-slots-row-general">
            <div class="power-drop-slots power-drop-slots-general" data-power-id="{{id}}" data-acc-key="{{accKey}}">
              <div class="ms-stone-drop-slot-cluster{{#if hideLeadSegment}} is-ramp-skip{{/if}}" role="group">
                {{#unless hideLeadSegment}}
                <div class="ms-stone-cluster-col-a">
                  {{#each paymentAnchor as |ls|}}
                  <div class="ms-stone-drop-slot slot-{{ls.state}}{{#unless @root.dragStonesEnabled}} slot-no-drag{{/unless}}"
                       data-power-id="{{../id}}"
                       data-pay-attribute="{{../attribute}}"
                       data-slot-index="{{ls.slotIndex}}"
                       data-lane-index="{{ls.laneIndex}}"
                       title="{{#if (eq ls.state 'active')}}Passenden {{../attribute}}-Stein ablegen{{/if}}{{#if (eq ls.state 'filled')}}Gelegt — zum Freigeben in den Pool ziehen{{/if}}{{#if (eq ls.state 'locked')}}{{#if ../canAfford}}Später{{else}}Nicht genug Steine{{/if}}{{/if}}">
                    <div class="ms-stone-slot-fill">{{#if (eq ls.state 'support')}}<span class="ms-stone-gem-chip ms-slot-gem-support" title="Artifact Support Stone (vom Artefakt bereitgestellt)"><i class="fas fa-gem"></i></span>{{/if}}</div>
                  </div>
                  {{/each}}
                </div>
                <div class="ms-stone-cluster-vsep ms-stone-cluster-vsep-1" role="separator" aria-hidden="true"></div>
                {{/unless}}
                <div class="ms-stone-cluster-col-mid">
                  {{#each paymentMid as |ls|}}
                  <div class="ms-stone-drop-slot slot-{{ls.state}}{{#unless @root.dragStonesEnabled}} slot-no-drag{{/unless}}"
                       data-power-id="{{../id}}" data-pay-attribute="{{../attribute}}" data-slot-index="{{ls.slotIndex}}" data-lane-index="{{ls.laneIndex}}"
                       title="{{#if (eq ls.state 'active')}}Passenden {{../attribute}}-Stein ablegen{{/if}}{{#if (eq ls.state 'filled')}}Gelegt — zum Freigeben in den Pool ziehen{{/if}}{{#if (eq ls.state 'locked')}}{{#if ../canAfford}}Später{{else}}Nicht genug Steine{{/if}}{{/if}}">
                    <div class="ms-stone-slot-fill">{{#if (eq ls.state 'support')}}<span class="ms-stone-gem-chip ms-slot-gem-support" title="Artifact Support Stone (vom Artefakt bereitgestellt)"><i class="fas fa-gem"></i></span>{{/if}}</div>
                  </div>
                  {{/each}}
                </div>
                <div class="ms-stone-cluster-vsep ms-stone-cluster-vsep-2" role="separator" aria-hidden="true"></div>
                <div class="ms-stone-cluster-col-quad">
                  {{#each paymentQuad as |ls|}}
                  <div class="ms-stone-drop-slot slot-{{ls.state}}{{#unless @root.dragStonesEnabled}} slot-no-drag{{/unless}}"
                       data-power-id="{{../id}}" data-pay-attribute="{{../attribute}}" data-slot-index="{{ls.slotIndex}}" data-lane-index="{{ls.laneIndex}}"
                       title="{{#if (eq ls.state 'active')}}Passenden {{../attribute}}-Stein ablegen{{/if}}{{#if (eq ls.state 'filled')}}Gelegt — zum Freigeben in den Pool ziehen{{/if}}{{#if (eq ls.state 'locked')}}{{#if ../canAfford}}Später{{else}}Nicht genug Steine{{/if}}{{/if}}">
                    <div class="ms-stone-slot-fill">{{#if (eq ls.state 'support')}}<span class="ms-stone-gem-chip ms-slot-gem-support" title="Artifact Support Stone (vom Artefakt bereitgestellt)"><i class="fas fa-gem"></i></span>{{/if}}</div>
                  </div>
                  {{/each}}
                </div>
                <div class="ms-stone-cluster-vsep ms-stone-cluster-vsep-3" role="separator" aria-hidden="true"></div>
                <div class="ms-stone-cluster-col-oct">
                  {{#each paymentOct as |ls|}}
                  <div class="ms-stone-drop-slot slot-{{ls.state}}{{#unless @root.dragStonesEnabled}} slot-no-drag{{/unless}}"
                       data-power-id="{{../id}}" data-pay-attribute="{{../attribute}}" data-slot-index="{{ls.slotIndex}}" data-lane-index="{{ls.laneIndex}}"
                       title="{{#if (eq ls.state 'active')}}Passenden {{../attribute}}-Stein ablegen{{/if}}{{#if (eq ls.state 'filled')}}Gelegt — zum Freigeben in den Pool ziehen{{/if}}{{#if (eq ls.state 'locked')}}{{#if ../canAfford}}Später{{else}}Nicht genug Steine{{/if}}{{/if}}">
                    <div class="ms-stone-slot-fill">{{#if (eq ls.state 'support')}}<span class="ms-stone-gem-chip ms-slot-gem-support" title="Artifact Support Stone (vom Artefakt bereitgestellt)"><i class="fas fa-gem"></i></span>{{/if}}</div>
                  </div>
                  {{/each}}
                </div>
              </div>
            </div>
          </div>
          <div class="power-title power-title-general">
            <strong class="power-name" title="{{effectLong}}">{{name}}</strong>
            {{#if supportTier}}<span class="power-support-badge{{#unless supportActive}} is-spent{{/unless}}" title="Stone Power Support ({{supportSource}}): {{#if supportActive}}Erstaktivierung startet auf Tier {{supportTier}} — du legst nur 1 Stein in den Anker, die Artifact Support Stones stellt das Artefakt.{{else}}Artifact Support Stones bereits genutzt — skaliert ab jetzt normal (Mindest-Tier {{supportTier}}).{{/if}}"><i class="fas fa-gem"></i> T{{supportTier}}</span>{{/if}}
          </div>
        </div>
          {{else}}
        <div class="power-card power-card-general power-card-placeholder" aria-hidden="true"></div>
          {{/if}}
        {{/each}}
      </div>
      </details>
    {{/each}}
    </div>
  </div>

  {{#unless combatStarted}}
  {{#unless stoneReviewMode}}
  <p class="stone-powers-close-hint">Voll bezahlte Stein-Wellen werden beim <strong>Übernehmen &amp; schließen</strong> abgerechnet (Pools, Kampf-Rundenstatus). Unvollständige Wellen bleiben bis zur nächsten vollen Welle offen.</p>
  {{/unless}}
  {{/unless}}

  <div class="dialog-footer stone-powers-footer">
    {{#unless combatStarted}}
    {{#unless stoneReviewMode}}
    <div class="stone-prefs-bar">
      <label class="stone-prefs-label">
        <input type="checkbox" class="js-stone-prefs-use-defaults"
               {{#if prefsUseDefaults}}checked{{/if}}
               {{#unless canSavePrefs}}disabled{{/unless}} />
        <span>Standard pro Runde automatisch übernehmen (zuletzt genutztes Attribut bei General Powers)</span>
      </label>
      <button type="button"
              class="dialog-btn dialog-btn-secondary js-save-stone-prefs{{#unless canSavePrefs}} is-disabled{{/unless}}"
              {{#unless canSavePrefs}}disabled title="Nur vor der ersten Aktion in der Runde oder außerhalb des Kampfes"{{/unless}}>
        <i class="fas fa-save"></i> Standard speichern
      </button>
    </div>
    {{/unless}}
    {{/unless}}
    {{#if stoneReviewMode}}
    <button type="button" class="dialog-btn dialog-btn-primary js-close" title="Dialog schließen. Die bestätigte Zuordnung bleibt.">
      <i class="fas fa-check"></i> Schließen
    </button>
    {{else}}
    <button type="button" class="dialog-btn dialog-btn-primary js-close" {{#if recovery.active}}disabled title="Finish Stone Recovery first."{{else}}title="Verbucht voll bezahlte Wellen und schließt den Dialog."{{/if}}>
      <i class="fas fa-check"></i> Übernehmen &amp; schließen
    </button>
    {{/if}}
  </div>
</div>
