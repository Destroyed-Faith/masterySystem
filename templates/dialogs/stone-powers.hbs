<div class="stone-powers-dialog">
  {{#if combatActive}}
  {{#if combatMissingFromTracker}}
  <div class="stone-combat-hint-banner is-warn" role="alert">
    <i class="fas fa-exclamation-triangle" aria-hidden="true"></i>
    <span>Kampf läuft, aber diese Figur wurde im Tracker nicht gefunden (verknüpfter Token / falsches Blatt?). Steine ziehen und Aktivieren sind deaktiviert — Token in die Initiative ziehen oder vom Tracker öffnen.</span>
  </div>
  {{/if}}
  {{/if}}

  {{#if stonePlanLocked}}
  <div class="stone-plan-locked-banner" role="status">
    <i class="fas fa-lock" aria-hidden="true"></i>
    <div class="stone-plan-locked-text">
      <strong>{{combatLabel}}</strong>
      <span>Steinzuordnung und Aktivieren sind für diese Runde gesperrt, sobald du Bewegung, einen Angriff oder eine Reaktion genutzt hast.</span>
    </div>
  </div>
  {{/if}}

  <nav class="stone-powers-tabs-nav" role="tablist" aria-label="Stone Powers Bereiche">
    <button type="button" role="tab" class="stone-powers-tab js-stone-powers-tab{{#if tabCombatActive}} is-active{{/if}}" data-tab="combat" aria-selected="{{#if tabCombatActive}}true{{else}}false{{/if}}">Combat</button>
    <button type="button" role="tab" class="stone-powers-tab js-stone-powers-tab{{#if tabRitualsActive}} is-active{{/if}}" data-tab="rituals" aria-selected="{{#if tabRitualsActive}}true{{else}}false{{/if}}">Rituals</button>
    <button type="button" role="tab" class="stone-powers-tab js-stone-powers-tab{{#if tabSummonsActive}} is-active{{/if}}" data-tab="summons" aria-selected="{{#if tabSummonsActive}}true{{else}}false{{/if}}">Summons</button>
  </nav>

  {{#if showStonePools}}
  <div class="stone-pools-display">
    <div class="stone-pools-header-row">
      <h3>Available Stones</h3>
      {{#if showCombatRound1Save}}
      <button type="button"
              class="dialog-btn dialog-btn-stone-save dialog-btn-stone-save-inline js-save-stone-r1-combat-plan"
              title="Steinplan für Runde 1 sichern und Dialog schließen. Beim erneuten Öffnen in derselben Runde wird er wiederhergestellt.">
        <i class="fas fa-floppy-disk"></i> Speichern
      </button>
      {{/if}}
    </div>
    <div class="pools-grid">
      {{#each pools as |pool|}}
      <div class="pool-item" data-attribute="{{pool.key}}">
        <div class="pool-item-header">
          <span class="pool-name">{{pool.name}}</span>
        </div>
        <div class="pool-gems" data-attribute-key="{{pool.key}}" title="{{pool.name}} — Steine zum Ziehen">
          {{#each pool.gemSlots}}
          <span
            class="ms-stone-gem-chip js-stone-draggable{{#unless @root.dragPoolEnabled}} is-drag-disabled{{/unless}}"
            {{#if @root.dragPoolEnabled}}draggable="true"{{else}}draggable="false"{{/if}}
            data-attribute-key="{{../key}}"
            style="background: {{../gemStyle.fill}}; box-shadow: 0 0 0 2px {{../gemStyle.stroke}} inset, 0 1px 3px rgba(0,0,0,0.45);"
            title="{{../name}}: hier greifen und auf Ablagefeld ziehen"></span>
          {{/each}}
        </div>
        {{#if pool.sustained}}
        <span class="pool-sustained">({{pool.sustained}} sustained)</span>
        {{/if}}
      </div>
      {{/each}}
    </div>
  </div>
  {{/if}}

  {{#if tabCombatActive}}
  <div class="powers-list">
    <div class="powers-matrix" role="region" aria-label="Stone powers matrix">
    {{#if generalPowers.length}}
    <div class="power-group is-general" role="region" aria-label="General Powers">
      <div class="powers-grid powers-grid-general">
        {{#each generalPowers as |power|}}
        <div class="power-card power-card-general" title="Linksklick: nächsten Block füllen (1, dann 2, dann 4, dann 8 Steine — je Pool-Verfügbarkeit) · Rechtsklick: alles leeren · Drag: aus dem Pool ziehen">
          <div class="power-drop-slots-row power-drop-slots-row-general">
            <div class="power-drop-slots power-drop-slots-general" data-power-id="{{power.id}}">
              <div class="ms-stone-drop-slot-cluster" role="group">
                <div class="ms-stone-cluster-col-a">
                  {{#each power.paymentAnchor as |ls|}}
                  <div class="ms-stone-drop-slot slot-{{ls.state}}{{#unless @root.dragStonesEnabled}} slot-no-drag{{/unless}}"
                       data-power-id="{{../id}}"
                       data-is-generic="true"
                       data-slot-index="{{ls.slotIndex}}"
                       data-lane-index="{{ls.laneIndex}}"
                       title="{{#if (eq ls.state 'active')}}Beliebigen Attribut-Stein hier ablegen{{/if}}{{#if (eq ls.state 'filled')}}Gelegt — zum Freigeben in den Pool ziehen{{/if}}{{#if (eq ls.state 'locked')}}{{#if ../canAfford}}Später{{else}}Nicht genug Steine in einem Pool{{/if}}{{/if}}">
                    <div class="ms-stone-slot-fill"></div>
                  </div>
                  {{/each}}
                </div>
                <div class="ms-stone-cluster-vsep ms-stone-cluster-vsep-1" role="separator" aria-hidden="true"></div>
                <div class="ms-stone-cluster-col-mid">
                  {{#each power.paymentMid as |ls|}}
                  <div class="ms-stone-drop-slot slot-{{ls.state}}{{#unless @root.dragStonesEnabled}} slot-no-drag{{/unless}}"
                       data-power-id="{{../id}}" data-is-generic="true" data-slot-index="{{ls.slotIndex}}" data-lane-index="{{ls.laneIndex}}"
                       title="{{#if (eq ls.state 'active')}}Beliebigen Attribut-Stein hier ablegen{{/if}}{{#if (eq ls.state 'filled')}}Gelegt — zum Freigeben in den Pool ziehen{{/if}}{{#if (eq ls.state 'locked')}}{{#if ../canAfford}}Später{{else}}Nicht genug Steine in einem Pool{{/if}}{{/if}}">
                    <div class="ms-stone-slot-fill"></div>
                  </div>
                  {{/each}}
                </div>
                <div class="ms-stone-cluster-vsep ms-stone-cluster-vsep-2" role="separator" aria-hidden="true"></div>
                <div class="ms-stone-cluster-col-quad">
                  {{#each power.paymentQuad as |ls|}}
                  <div class="ms-stone-drop-slot slot-{{ls.state}}{{#unless @root.dragStonesEnabled}} slot-no-drag{{/unless}}"
                       data-power-id="{{../id}}" data-is-generic="true" data-slot-index="{{ls.slotIndex}}" data-lane-index="{{ls.laneIndex}}"
                       title="{{#if (eq ls.state 'active')}}Beliebigen Attribut-Stein hier ablegen{{/if}}{{#if (eq ls.state 'filled')}}Gelegt — zum Freigeben in den Pool ziehen{{/if}}{{#if (eq ls.state 'locked')}}{{#if ../canAfford}}Später{{else}}Nicht genug Steine in einem Pool{{/if}}{{/if}}">
                    <div class="ms-stone-slot-fill"></div>
                  </div>
                  {{/each}}
                </div>
                <div class="ms-stone-cluster-vsep ms-stone-cluster-vsep-3" role="separator" aria-hidden="true"></div>
                <div class="ms-stone-cluster-col-oct">
                  {{#each power.paymentOct as |ls|}}
                  <div class="ms-stone-drop-slot slot-{{ls.state}}{{#unless @root.dragStonesEnabled}} slot-no-drag{{/unless}}"
                       data-power-id="{{../id}}" data-is-generic="true" data-slot-index="{{ls.slotIndex}}" data-lane-index="{{ls.laneIndex}}"
                       title="{{#if (eq ls.state 'active')}}Beliebigen Attribut-Stein hier ablegen{{/if}}{{#if (eq ls.state 'filled')}}Gelegt — zum Freigeben in den Pool ziehen{{/if}}{{#if (eq ls.state 'locked')}}{{#if ../canAfford}}Später{{else}}Nicht genug Steine in einem Pool{{/if}}{{/if}}">
                    <div class="ms-stone-slot-fill"></div>
                  </div>
                  {{/each}}
                </div>
              </div>
            </div>
          </div>
          <div class="power-title power-title-general">
            <strong class="power-name" title="{{power.effectLong}}">{{power.name}}</strong>
          </div>
        </div>
        {{/each}}
      </div>
    </div>
    {{/if}}

    {{#each attributePowerMatrix}}
      <div class="powers-grid powers-grid-general powers-grid-attr-matrix">
        {{#each cells}}
          {{#if this}}
        <div class="power-card power-card-general" title="Linksklick: nächsten Block mit {{attribute}}-Steinen (1 → 2 → 4 → 8) · Rechtsklick: alles leeren · Drag: aus dem Pool ziehen">
          <div class="power-drop-slots-row power-drop-slots-row-general">
            <div class="power-drop-slots power-drop-slots-general" data-power-id="{{id}}">
              <div class="ms-stone-drop-slot-cluster" role="group">
                <div class="ms-stone-cluster-col-a">
                  {{#each paymentAnchor as |ls|}}
                  <div class="ms-stone-drop-slot slot-{{ls.state}}{{#unless @root.dragStonesEnabled}} slot-no-drag{{/unless}}"
                       data-power-id="{{../id}}"
                       data-pay-attribute="{{../attribute}}"
                       data-slot-index="{{ls.slotIndex}}"
                       data-lane-index="{{ls.laneIndex}}"
                       title="{{#if (eq ls.state 'active')}}Passenden {{../attribute}}-Stein ablegen{{/if}}{{#if (eq ls.state 'filled')}}Gelegt — zum Freigeben in den Pool ziehen{{/if}}{{#if (eq ls.state 'locked')}}{{#if ../canAfford}}Später{{else}}Nicht genug Steine{{/if}}{{/if}}">
                    <div class="ms-stone-slot-fill"></div>
                  </div>
                  {{/each}}
                </div>
                <div class="ms-stone-cluster-vsep ms-stone-cluster-vsep-1" role="separator" aria-hidden="true"></div>
                <div class="ms-stone-cluster-col-mid">
                  {{#each paymentMid as |ls|}}
                  <div class="ms-stone-drop-slot slot-{{ls.state}}{{#unless @root.dragStonesEnabled}} slot-no-drag{{/unless}}"
                       data-power-id="{{../id}}" data-pay-attribute="{{../attribute}}" data-slot-index="{{ls.slotIndex}}" data-lane-index="{{ls.laneIndex}}"
                       title="{{#if (eq ls.state 'active')}}Passenden {{../attribute}}-Stein ablegen{{/if}}{{#if (eq ls.state 'filled')}}Gelegt — zum Freigeben in den Pool ziehen{{/if}}{{#if (eq ls.state 'locked')}}{{#if ../canAfford}}Später{{else}}Nicht genug Steine{{/if}}{{/if}}">
                    <div class="ms-stone-slot-fill"></div>
                  </div>
                  {{/each}}
                </div>
                <div class="ms-stone-cluster-vsep ms-stone-cluster-vsep-2" role="separator" aria-hidden="true"></div>
                <div class="ms-stone-cluster-col-quad">
                  {{#each paymentQuad as |ls|}}
                  <div class="ms-stone-drop-slot slot-{{ls.state}}{{#unless @root.dragStonesEnabled}} slot-no-drag{{/unless}}"
                       data-power-id="{{../id}}" data-pay-attribute="{{../attribute}}" data-slot-index="{{ls.slotIndex}}" data-lane-index="{{ls.laneIndex}}"
                       title="{{#if (eq ls.state 'active')}}Passenden {{../attribute}}-Stein ablegen{{/if}}{{#if (eq ls.state 'filled')}}Gelegt — zum Freigeben in den Pool ziehen{{/if}}{{#if (eq ls.state 'locked')}}{{#if ../canAfford}}Später{{else}}Nicht genug Steine{{/if}}{{/if}}">
                    <div class="ms-stone-slot-fill"></div>
                  </div>
                  {{/each}}
                </div>
                <div class="ms-stone-cluster-vsep ms-stone-cluster-vsep-3" role="separator" aria-hidden="true"></div>
                <div class="ms-stone-cluster-col-oct">
                  {{#each paymentOct as |ls|}}
                  <div class="ms-stone-drop-slot slot-{{ls.state}}{{#unless @root.dragStonesEnabled}} slot-no-drag{{/unless}}"
                       data-power-id="{{../id}}" data-pay-attribute="{{../attribute}}" data-slot-index="{{ls.slotIndex}}" data-lane-index="{{ls.laneIndex}}"
                       title="{{#if (eq ls.state 'active')}}Passenden {{../attribute}}-Stein ablegen{{/if}}{{#if (eq ls.state 'filled')}}Gelegt — zum Freigeben in den Pool ziehen{{/if}}{{#if (eq ls.state 'locked')}}{{#if ../canAfford}}Später{{else}}Nicht genug Steine{{/if}}{{/if}}">
                    <div class="ms-stone-slot-fill"></div>
                  </div>
                  {{/each}}
                </div>
              </div>
            </div>
          </div>
          <div class="power-title power-title-general">
            <strong class="power-name" title="{{effectLong}}">{{name}}</strong>
          </div>
        </div>
          {{else}}
        <div class="power-card power-card-general power-card-placeholder" aria-hidden="true"></div>
          {{/if}}
        {{/each}}
      </div>
    {{/each}}
    </div>
  </div>
  {{/if}}

  {{#if tabRitualsActive}}
  <div class="stone-rituals-pane" role="tabpanel">
    <section class="stone-rituals-intro" aria-label="Ritual rules summary">
      <p class="stone-rituals-lead">Rituals are deliberate workings outside ordinary combat flow. Each ritual lists a <strong>fixed</strong> stone cost; stones you place here are reserved in this dialog and are not available for other rituals until you return them to the pool.</p>
      <p><strong>Resolution:</strong> Declare target TN (base <strong>20</strong>, <strong>+4</strong> per Raise you attempt — Raises must be declared before rolling). Roll attribute dice, keep a number equal to your Mastery Rank, add the listed skill. On success you gain outcomes up to your declared TN; on failure take 2d8 Stress. Ritual stones stay sealed until a full Safe Haven rest (not regenerated by Mastery Rank).</p>
      <p><strong>General:</strong> Casting time typically 10 min–1 h · Cost as listed · Backlash on failure or interruption may cause stress or false visions.</p>
    </section>
    <div class="stone-rituals-list">
      {{#each ritualRows as |ritual|}}
      <article class="stone-ritual-card" data-ritual-card-id="{{ritual.id}}">
        <header class="stone-ritual-card-head">
          <h4 class="stone-ritual-name">{{ritual.name}}</h4>
          <div class="stone-ritual-slots-row" role="group" aria-label="{{ritual.name}} stone cost">
            {{#each ritual.slotsUi as |slot|}}
            <div class="ms-stone-drop-slot ms-ritual-drop-slot slot-{{slot.state}}{{#unless @root.ritualDragEnabled}} slot-no-drag{{/unless}}"
                 data-ritual-id="{{../id}}"
                 data-ritual-slot-index="{{slot.slotIndex}}"
                 data-allowed-attrs="{{slot.allowedCsv}}"
                 title="{{#if (eq slot.state 'active')}}Allowed: {{slot.allowTitle}} — drop matching stone{{/if}}{{#if (eq slot.state 'filled')}}Placed — drag gem back to pool to clear{{/if}}{{#if (eq slot.state 'locked')}}No free stone of an allowed attribute{{/if}}">
              <div class="ms-stone-slot-fill">
                {{#if slot.placedKey}}
                <span
                  class="ms-stone-gem-chip ms-slot-gem-partial js-stone-returnable{{#unless @root.ritualDragEnabled}} is-drag-disabled{{/unless}}"
                  {{#if @root.ritualDragEnabled}}draggable="true"{{else}}draggable="false"{{/if}}
                  data-acc-key="ritual-slot:{{../id}}:{{slot.slotIndex}}"
                  data-return-attribute-key="{{slot.placedKey}}"
                  style="background: {{slot.gemStyle.fill}}; box-shadow: 0 0 0 2px {{slot.gemStyle.stroke}} inset, 0 1px 3px rgba(0,0,0,0.45);"
                  title="Zurück in den passenden Pool ziehen"></span>
                {{/if}}
              </div>
            </div>
            {{/each}}
          </div>
        </header>
        <p class="stone-ritual-meta"><strong>Roll:</strong> {{ritual.roll}} · <strong>Duration:</strong> {{ritual.duration}}</p>
        <p class="stone-ritual-req"><strong>Requirement:</strong> {{ritual.requirement}}</p>
        <p class="stone-ritual-intro">{{ritual.intro}}</p>
        <details class="stone-ritual-details">
          <summary>Raises &amp; effects</summary>
          <ul class="stone-ritual-raises">
            {{#each ritual.raises as |row|}}
            <li><strong>{{row.label}}:</strong> {{row.text}}</li>
            {{/each}}
          </ul>
        </details>
        {{#if ritual.danger}}
        <p class="stone-ritual-danger"><strong>Danger:</strong> {{ritual.danger}}</p>
        {{/if}}
        {{#if ritual.lore}}
        <p class="stone-ritual-lore">{{ritual.lore}}</p>
        {{/if}}
      </article>
      {{/each}}
    </div>
  </div>
  {{/if}}

  {{#if tabSummonsActive}}
  <div class="stone-summons-placeholder" role="tabpanel">
    <p class="stone-summons-placeholder-text">Summons — rules and stone layout will be added here (same dialog, third tab).</p>
  </div>
  {{/if}}

  <div class="dialog-footer stone-powers-footer">
    <div class="stone-prefs-bar">
      <label class="stone-prefs-label">
        <input type="checkbox" class="js-stone-prefs-use-defaults"
               {{#if prefsUseDefaults}}checked{{/if}}
               {{#unless canSavePrefs}}disabled{{/unless}} />
        <span>Standard pro Runde automatisch übernehmen (zuletzt genutztes Attribut bei General Powers)</span>
      </label>
      <button type="button"
              class="dialog-btn dialog-btn-secondary js-save-stone-prefs{{#unless canSavePrefs}} is-disabled{{/unless}}"
              {{#unless canSavePrefs}}disabled title="Nur vor der ersten Aktion in der Runde oder außerhalb des Kampfes"{{/unless}}>
        <i class="fas fa-save"></i> Standard speichern
      </button>
    </div>
    <button type="button" class="dialog-btn js-close">
      <i class="fas fa-times"></i> Schließen
    </button>
  </div>
</div>
