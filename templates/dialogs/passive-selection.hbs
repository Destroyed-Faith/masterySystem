<div class="passive-selection-overlay">
  <section class="passive-slots-section">
    <h3>Passive Slots</h3>
    <p class="passive-slots-legend">All six slots shown. Unlock order: MR 1 → 2 → 3 → 5 → 7 → 8. Locked slots open when your Mastery Rank reaches that number.</p>
    <div class="slots-grid">
      {{#each slots as |slot|}}
        <div class="passive-slot {{#if slot.locked}}locked{{else}}{{#if slot.passive}}active{{else}}empty droppable-slot{{/if}}{{/if}}"
             data-slot-index="{{slot.slotIndex}}"
             {{#if slot.locked}}title="Unlocks at Mastery Rank {{slot.unlockMasteryRank}}"{{/if}}>
          <div class="slot-header">
            <span class="slot-number">
              Slot {{inc slot.slotIndex}}
              <span class="slot-unlock">MR {{slot.unlockMasteryRank}}+</span>
            </span>
            {{#if slot.locked}}
              <span class="slot-locked-badge">Locked</span>
            {{else if slot.passive}}
              {{#if ../canEdit}}
              <button type="button" class="js-unslot-passive btn-remove" data-slot-index="{{slot.slotIndex}}" title="Clear slot">
                <i class="fas fa-times"></i>
              </button>
              {{/if}}
            {{/if}}
          </div>

          {{#if slot.locked}}
            <div class="slot-body locked-slot">
              <p>Opens at <strong>Mastery Rank {{slot.unlockMasteryRank}}</strong></p>
            </div>
          {{else if slot.passive}}
            <div class="slot-body">
              <h4>{{slot.passive.name}}</h4>
              {{#if slot.passive.description}}
              <p class="passive-effect">{{slot.passive.description}}</p>
              {{/if}}
            </div>
          {{else}}
            <div class="slot-body empty-slot">
              <p><em>Drop passive here</em></p>
            </div>
          {{/if}}
        </div>
      {{/each}}
    </div>
  </section>

  {{#if canEdit}}
  <section class="available-passives-section">
    <h3>Available Passives</h3>
    {{#if availablePassives}}
      <div class="passives-list">
        {{#each availablePassives as |passive|}}
          <div class="passive-item draggable-passive" 
               draggable="true"
               data-passive-id="{{passive.id}}">
            <h4>{{passive.name}}</h4>
            <p class="passive-effect">{{passive.description}}</p>
          </div>
        {{/each}}
      </div>
    {{else}}
      <div class="no-passives">
        <p><em>No unslotted Passives. Everything you own is already in a slot — clear a slot (×) to swap, or buy another Passive on the sheet.</em></p>
      </div>
    {{/if}}
  </section>
  {{/if}}

  <footer class="overlay-footer">
    <p class="passive-footer-hint">{{#if canEdit}}Closing with ✕ does <strong>not</strong> count as confirmation (the encounter waits). Use Next / Confirm.{{else}}View only — Passives stay set until Exchange Passive is paid.{{/if}}</p>
    <button class="js-prev-character btn-nav" {{#if isFirst}}disabled{{/if}}>
      <i class="fas fa-chevron-left"></i> Previous
    </button>
    
    <button class="js-next-character btn-primary">
      {{#if isLast}}
        Confirm <i class="fas fa-check"></i>
      {{else}}
        Next <i class="fas fa-chevron-right"></i>
      {{/if}}
    </button>
    
    {{#if isGM}}
      <button class="js-gm-skip btn-warning">
        <i class="fas fa-forward"></i> GM: Skip All
      </button>
    {{/if}}
  </footer>
</div>

























