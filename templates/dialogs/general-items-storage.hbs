<div class="general-items-storage-dialog">
  <div class="storage-header">
    <h3><i class="fas fa-box"></i> General Items Storage</h3>
    <p>Drag items from storage into your backpack grid</p>
    {{#if isGM}}
    <button type="button" class="seed-general-items" title="Seed General Items Storage">
      <i class="fas fa-seedling"></i> Seed General Items Storage
    </button>
    {{/if}}
  </div>

  <div class="storage-content">
    <div class="storage-items-panel">
      <h4>Storage Items</h4>
      {{#if hasStorage}}
        <div class="storage-items-grid">
          {{#each storageItems}}
            <div class="storage-item df-draggable-item" data-item-id="{{this.id}}" draggable="true" title="{{this.name}}">
              <img class="item-icon" src="{{this.img}}" alt="{{this.name}}" />
              <div class="item-name">{{this.name}}</div>
              <div class="item-type">{{this.type}}</div>
            </div>
          {{/each}}
        </div>
      {{else}}
        <div class="empty-message">
          <p><i class="fas fa-info-circle"></i> No items in General Items Storage.</p>
          <p>Create a folder named "General Items Storage" and add items to it.</p>
        </div>
      {{/if}}
    </div>

    <div class="inventory-panel">
      <h4>{{actor.name}}'s Equipment</h4>
      <div class="df-enc-table">
        <div class="df-enc-header">
          <div class="df-enc-title">EQUIPMENT</div>
          <div class="df-enc-coltitle">NOT ENCUMBERED</div>
          <div class="df-enc-coltitle">ENCUMBERED</div>
          <div class="df-enc-coltitle">HEAVILY ENCUMBERED</div>
        </div>
        
        <div class="df-enc-grids">
          <div class="df-enc-band df-dropzone" data-df-drop="band" data-band="not">
            {{#each equipmentUi.inventory.notCells}}
              <div class="df-cell">
                {{#if this}}
                  <div class="df-item-tile item df-draggable-item" data-item-id="{{this.id}}" draggable="true" title="{{this.name}}">
                    <img class="df-item-icon" src="{{this.img}}" />
                    {{#if (eq this.type "gear")}}
                      <div class="df-item-qty">{{default this.system.quantity 1}}</div>
                    {{/if}}
                    <div class="df-item-actions">
                      <a class="item-edit" title="Edit"><i class="fas fa-edit"></i></a>
                      <a class="item-delete" title="Delete"><i class="fas fa-trash"></i></a>
                    </div>
                  </div>
                {{/if}}
              </div>
            {{/each}}
            {{#if equipmentUi.inventory.notOverflow}}
              <div class="df-overflow">+{{equipmentUi.inventory.notOverflow}}</div>
            {{/if}}
          </div>
          
          <div class="df-enc-band df-dropzone" data-df-drop="band" data-band="enc">
            {{#each equipmentUi.inventory.encCells}}
              <div class="df-cell">
                {{#if this}}
                  <div class="df-item-tile item df-draggable-item" data-item-id="{{this.id}}" draggable="true" title="{{this.name}}">
                    <img class="df-item-icon" src="{{this.img}}" />
                    {{#if (eq this.type "gear")}}
                      <div class="df-item-qty">{{default this.system.quantity 1}}</div>
                    {{/if}}
                    <div class="df-item-actions">
                      <a class="item-edit" title="Edit"><i class="fas fa-edit"></i></a>
                      <a class="item-delete" title="Delete"><i class="fas fa-trash"></i></a>
                    </div>
                  </div>
                {{/if}}
              </div>
            {{/each}}
            {{#if equipmentUi.inventory.encOverflow}}
              <div class="df-overflow">+{{equipmentUi.inventory.encOverflow}}</div>
            {{/if}}
          </div>
          
          <div class="df-enc-band df-dropzone" data-df-drop="band" data-band="heavy">
            {{#each equipmentUi.inventory.heavyCells}}
              <div class="df-cell">
                {{#if this}}
                  <div class="df-item-tile item df-draggable-item" data-item-id="{{this.id}}" draggable="true" title="{{this.name}}">
                    <img class="df-item-icon" src="{{this.img}}" />
                    {{#if (eq this.type "gear")}}
                      <div class="df-item-qty">{{default this.system.quantity 1}}</div>
                    {{/if}}
                    <div class="df-item-actions">
                      <a class="item-edit" title="Edit"><i class="fas fa-edit"></i></a>
                      <a class="item-delete" title="Delete"><i class="fas fa-trash"></i></a>
                    </div>
                  </div>
                {{/if}}
              </div>
            {{/each}}
            {{#if equipmentUi.inventory.heavyOverflow}}
              <div class="df-overflow">+{{equipmentUi.inventory.heavyOverflow}}</div>
            {{/if}}
          </div>
        </div>
      </div>
      <p class="drop-hint"><i class="fas fa-hand-pointer"></i> Drop items here to add them to your equipment</p>
    </div>
  </div>
</div>
