<div class="general-items-storage-dialog">
  <div class="storage-header">
    <h3><i class="fas fa-box"></i> General Items Storage</h3>
    <p>Drag items from storage into your equipment</p>
    <div class="storage-toolbar">
      <button type="button" class="storage-toolbar-btn js-create-custom-catalog-item" title="{{localize 'MASTERY.customCatalog.buttonHint'}}">
        <i class="fas fa-plus"></i> {{localize "MASTERY.customCatalog.button"}}
      </button>
    </div>
  </div>

  <div class="storage-content">
    <div class="storage-items-panel">
      <h4>Storage Items</h4>
      {{#if hasStorage}}
        <div class="storage-category-panels">
          {{#each storageCategories}}
            <details class="storage-category-block" data-category="{{this.key}}" open>
              <summary class="storage-category-summary">
                <span class="storage-category-label-text">{{this.label}}</span>
                <span class="storage-category-count">({{this.items.length}})</span>
              </summary>
              <div class="storage-category-body">
                {{#if this.items.length}}
                  <div class="storage-items-grid">
                    {{#each this.items}}
                      <div class="storage-item df-draggable-item{{#if this.isCustom}} is-custom{{/if}}" data-item-id="{{this.id}}" data-custom="{{#if this.isCustom}}1{{else}}0{{/if}}" draggable="true" title="{{this.name}}">
                        <img class="item-icon" src="{{this.img}}" alt="{{this.name}}" />
                        <div class="item-name">{{this.name}}</div>
                        <div class="item-type">{{this.type}}</div>
                        {{#if this.isCustom}}
                        <span class="storage-item-custom-badge">{{localize "MASTERY.customCatalog.badge"}}</span>
                        {{/if}}
                        {{#if ../../isGM}}
                        <button type="button" class="storage-item-delete js-delete-catalog-item" data-item-id="{{this.id}}" title="{{localize 'MASTERY.customCatalog.deleteHint'}}" aria-label="{{localize 'MASTERY.customCatalog.delete'}}">
                          <i class="fas fa-trash"></i>
                        </button>
                        {{/if}}
                      </div>
                    {{/each}}
                  </div>
                {{else}}
                  <p class="storage-category-empty">No items in this category.</p>
                {{/if}}
              </div>
            </details>
          {{/each}}
        </div>
      {{else}}
        <div class="empty-message">
          <p><i class="fas fa-info-circle"></i> No items in General Items Storage.</p>
          {{#if isGM}}
            <p>Items will be generated automatically for GMs on open.</p>
          {{else}}
            <p>Ask the GM to open this dialog once to seed the storage items.</p>
          {{/if}}
        </div>
      {{/if}}
    </div>

  </div>
</div>
