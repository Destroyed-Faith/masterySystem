<div class="embedded-power-dialog-inner">
  <section class="ep-json-panel">
    <h4>JSON import</h4>
    <p class="ep-hint">Paste one power object, an array of powers, or <code>{"powers":[...]}</code>. Old <code>powerType</code> entries are migrated automatically.</p>
    <textarea id="ep-json-area" class="ep-json-area" rows="5" placeholder='{ "name": "...", "category": "active", ... }'></textarea>
    <div class="ep-json-actions flexrow">
      <button type="button" class="ep-btn" data-action="ep-import-replace">Import (replace all)</button>
      <button type="button" class="ep-btn" data-action="ep-import-append">Import (append)</button>
    </div>
  </section>

  <div class="ep-main flexrow">
    <aside class="ep-power-list">
      <div class="ep-power-list-header flexrow">
        <h4>Powers</h4>
        <button type="button" class="ep-btn ep-btn-small" data-action="ep-add-power" title="Add power" {{#if addPowerDisabled}}disabled{{/if}}>+</button>
      </div>
      {{#if powerList.length}}
        {{#each powerList}}
        <button type="button" class="ep-power-tab {{#if (eq i ../selectedIndex)}}active{{/if}}" data-action="ep-select-power" data-index="{{i}}">
          <span class="ep-power-tab-line">
            {{#if inherited}}<span class="ep-power-badge ep-badge-inherited" title="Inherited / Vererbt">↑</span>{{/if}}
            {{#if tierShort}}<span class="ep-power-badge ep-badge-tier" title="Defined at tree tier / Stufe">{{tierShort}}</span>{{/if}}
            <span class="ep-power-tab-name">{{name}}</span>
          </span>
          <span class="ep-power-tab-cat">{{category}}</span>
        </button>
        {{/each}}
      {{else}}
        <p class="ep-hint">No powers yet.</p>
      {{/if}}
      {{#if hasPowers}}
      <div class="ep-power-list-actions">
        <button type="button" class="ep-btn ep-btn-block" data-action="ep-duplicate-power" {{#if duplicatePowerDisabled}}disabled{{/if}}>Duplicate</button>
        <button type="button" class="ep-btn ep-btn-block ep-btn-danger" data-action="ep-delete-power" {{#if selectedPowerDeleteLocked}}disabled{{/if}}>Delete</button>
      </div>
      {{/if}}
    </aside>

    <div class="ep-detail">
      {{#if hasPowers}}
      <div class="ep-detail-scroll">
        {{#if detailReadOnly}}
        <p class="ep-hint ep-inherited-readonly-hint">Vererbt — nur lesen. Mit <strong>+</strong> eine neue Power für <strong>diese Baumstufe</strong> anlegen (wird an Kinder weitergegeben). / Inherited — read-only. Use <strong>+</strong> to add <strong>this tier’s</strong> power (propagates to children).</p>
        {{/if}}
        <fieldset class="ep-detail-fieldset" {{#if detailReadOnly}}disabled{{/if}}>
        <div class="form-group">
          <label>Name</label>
          <input type="text" id="ep-detail-name" value="{{detail.name}}" />
        </div>
        <div class="form-group">
          <label>Flavor</label>
          <textarea id="ep-detail-fluff" rows="2" placeholder="Optional narrative text">{{detail.fluff}}</textarea>
        </div>
        <div class="ep-detail-grid">
          <div class="form-group">
            <label>Category</label>
            <select id="ep-detail-category">
              {{#each categories}}
              <option value="{{this}}" {{#if (eq ../detail.category this)}}selected{{/if}}>{{this}}</option>
              {{/each}}
            </select>
          </div>
          <div class="form-group ep-span2 ep-tags-block">
            <label>Tags</label>
            <p class="ep-hint ep-tags-hint">Choose preset tags or <strong>Custom…</strong> and type your own. Empty rows are ignored.</p>
            <div id="ep-tags-rows" class="ep-multi-rows">
              {{#each detail.tagRows}}
              <div class="ep-tag-row flexrow">
                <select class="ep-tag-preset">
                  <option value="">— None —</option>
                  {{#each @root.tagPresetOptions}}
                  <option value="{{this}}" {{#if (eq ../preset this)}}selected{{/if}}>{{this}}</option>
                  {{/each}}
                  <option value="__custom__" {{#if (eq preset "__custom__")}}selected{{/if}}>Custom…</option>
                </select>
                <input type="text" class="ep-tag-custom {{#unless (eq preset "__custom__")}}hidden{{/unless}}" value="{{customTag}}" placeholder="e.g. elemental" />
                <button type="button" class="ep-tag-remove" title="Remove tag row">×</button>
              </div>
              {{/each}}
            </div>
            <button type="button" class="ep-btn ep-btn-small" data-action="ep-add-tag-row">+ Tag</button>
          </div>
        </div>

        <h4 class="ep-subhead">Cost</h4>
        <div class="ep-detail-grid">
          <div class="form-group">
            <label>Action</label>
            <select id="ep-cost-action">
              {{#each actionCosts}}
              <option value="{{this}}" {{#if (eq ../detail.cost.action this)}}selected{{/if}}>{{this}}</option>
              {{/each}}
            </select>
          </div>
          <div class="form-group">
            <label>Stones</label>
            <input type="number" id="ep-cost-stones" value="{{detail.cost.stones}}" min="0" step="1" />
          </div>
          <div class="form-group">
            <label>Charges</label>
            <input type="number" id="ep-cost-charges" value="{{detail.cost.charges}}" min="0" step="1" />
          </div>
        </div>
        <div class="form-group ep-limit-row">
          <label class="ep-checkbox-label"><input type="checkbox" id="ep-limit-enabled" {{#if detail.limitEnabled}}checked{{/if}} /> Cap how often this power can be used</label>
          <p class="ep-hint ep-limit-hint">When checked, you set a maximum number of uses per round, combat, day, or week (rules text for “limited” powers).</p>
          <div class="ep-limit-fields flexrow">
            <select id="ep-limit-per">
              {{#each limitPers}}
              <option value="{{this}}" {{#if (eq ../detail.cost.limit.per this)}}selected{{/if}}>{{this}}</option>
              {{/each}}
            </select>
            <label class="ep-limit-uses-label" for="ep-limit-uses">Max uses</label>
            <select id="ep-limit-uses">
              {{#each limitUseOptions}}
              <option value="{{this}}" {{#if (eq ../detail.cost.limit.uses this)}}selected{{/if}}>{{this}}</option>
              {{/each}}
            </select>
          </div>
        </div>

        <div class="form-group">
          <label>Power trigger (reaction / passive)</label>
          <input type="text" id="ep-trigger" value="{{detail.trigger}}" placeholder="When…" />
        </div>

        <h4 class="ep-subhead">Roll (optional)</h4>
        <div class="ep-detail-grid">
          <div class="form-group">
            <label>Kind</label>
            <input type="text" id="ep-roll-kind" value="{{detail.rollKind}}" placeholder="e.g. skill" />
          </div>
          <div class="form-group">
            <label>Attribute</label>
            <input type="text" id="ep-roll-attribute" value="{{detail.rollAttr}}" />
          </div>
          <div class="form-group">
            <label>Vs</label>
            <input type="text" id="ep-roll-vs" value="{{detail.rollVs}}" />
          </div>
        </div>

        <h4 class="ep-subhead">Levels</h4>
        {{#each detail.levelsList}}
        <details class="ep-level-details" {{#if (eq key "1")}}open{{/if}}>
          <summary>Level {{key}}</summary>
          <div class="ep-level-block" data-level="{{key}}">
            <div class="form-group">
              <label>Type</label>
              <input type="text" class="ep-l-type" value="{{row.type}}" placeholder="Melee, Ranged, Buff…" />
            </div>

            <div class="ep-builder ep-range-block">
              <span class="ep-builder-label">Range</span>
              <div class="ep-builder-row flexrow">
                <select class="ep-l-range-kind">
                  <option value="">— None —</option>
                  {{#each @root.rangeKinds}}
                  <option value="{{this}}" {{#if (eq rangeKind this)}}selected{{/if}}>{{this}}</option>
                  {{/each}}
                </select>
                <input type="number" class="ep-l-range-m" value="{{rangeM}}" min="0" step="1" placeholder="m" />
                <input type="text" class="ep-l-range-note" value="{{rangeNote}}" placeholder="note" />
              </div>
            </div>

            <div class="ep-builder ep-aoe-block">
              <span class="ep-builder-label">AoE</span>
              <div class="ep-builder-row flexrow">
                <select class="ep-l-aoe-shape">
                  {{#each @root.aoeShapes}}
                  <option value="{{this}}" {{#if (eq aoeShape this)}}selected{{/if}}>{{this}}</option>
                  {{/each}}
                </select>
              </div>
              <div class="ep-aoe-metrics ep-detail-grid">
                <div class="form-group">
                  <label>m</label>
                  <input type="number" class="ep-l-aoe-m" value="{{aoeM}}" min="0" step="1" />
                </div>
                <div class="form-group">
                  <label>radius m</label>
                  <input type="number" class="ep-l-radiusM" value="{{aoeRadiusM}}" min="0" step="1" />
                </div>
                <div class="form-group">
                  <label>length m</label>
                  <input type="number" class="ep-l-lengthM" value="{{aoeLengthM}}" min="0" step="1" />
                </div>
                <div class="form-group">
                  <label>width m</label>
                  <input type="number" class="ep-l-widthM" value="{{aoeWidthM}}" min="0" step="1" />
                </div>
                <div class="form-group">
                  <label>angle °</label>
                  <input type="number" class="ep-l-angleDeg" value="{{aoeAngleDeg}}" min="0" step="1" />
                </div>
                <div class="form-group">
                  <label>targets</label>
                  <input type="number" class="ep-l-targets" value="{{aoeTargets}}" min="0" step="1" />
                </div>
              </div>
              <div class="form-group">
                <label>AoE note</label>
                <input type="text" class="ep-l-aoe-note" value="{{aoeNote}}" />
              </div>
            </div>

            <div class="ep-builder ep-dur-block">
              <span class="ep-builder-label">Duration</span>
              <div class="ep-builder-row flexrow">
                <select class="ep-l-dur-kind">
                  {{#each @root.durationKinds}}
                  <option value="{{this}}" {{#if (eq durKind this)}}selected{{/if}}>{{this}}</option>
                  {{/each}}
                </select>
                <input type="number" class="ep-l-dur-rounds" value="{{durRounds}}" min="1" step="1" placeholder="rounds" />
                <input type="text" class="ep-l-dur-note" value="{{durNote}}" placeholder="note" />
              </div>
            </div>

            <div class="ep-builder">
              <span class="ep-builder-label">Effect</span>
              <div class="form-group">
                <textarea class="ep-l-effect-text" rows="2" placeholder="Effect text">{{effectText}}</textarea>
              </div>
              <div class="form-group">
                <label>Dice</label>
                <input type="text" class="ep-l-effect-dice" value="{{effectDice}}" placeholder="e.g. 4d8" />
              </div>
            </div>

            <div class="ep-detail-grid">
              <div class="form-group">
                <label>Level trigger (override)</label>
                <input type="text" class="ep-l-trigger" value="{{lvlTrigger}}" />
              </div>
              <div class="form-group">
                <label>lvl #</label>
                <input type="number" class="ep-l-row-lvl" value="{{lvlNum}}" min="0" step="1" />
              </div>
            </div>

            <div class="ep-specials-block">
              <span class="ep-builder-label">Specials</span>
              <div class="ep-special-rows" data-level="{{key}}">
                {{#each specialsList}}
                <div class="ep-sp-row flexrow">
                  <input type="text" class="ep-sp-key" value="{{spKey}}" placeholder="key" />
                  <input type="number" class="ep-sp-rank" value="{{rank}}" placeholder="rank" />
                  <input type="number" class="ep-sp-value" value="{{value}}" placeholder="value" />
                  <input type="number" class="ep-sp-raise" value="{{raiseCost}}" placeholder="raise" />
                  <input type="text" class="ep-sp-note" value="{{note}}" placeholder="note" />
                  <button type="button" class="ep-sp-remove" title="Remove">×</button>
                </div>
                {{/each}}
              </div>
              <button type="button" class="ep-btn ep-btn-small ep-add-special" data-level="{{key}}">+ Special</button>
            </div>
          </div>
        </details>
        {{/each}}
        </fieldset>
      </div>
      {{else}}
      <p class="ep-empty">Add a power with <strong>+</strong> or use JSON import.</p>
      {{/if}}
    </div>
  </div>

  <footer class="ep-dialog-footer flexrow">
    <button type="button" class="ep-btn" data-action="ep-cancel">Cancel</button>
    <button type="button" class="ep-btn ep-btn-primary" data-action="ep-save" {{#unless isEditable}}disabled{{/unless}}>Save to item</button>
  </footer>
</div>
