<div class="ae-dialog">
  <p class="ae-intro">
    <strong>Mastery &amp; cap:</strong> MR 1 — base item only (no link). MR 2–6 — link ({{constants.linkStone}} stone), then each step: {{constants.upStone}} stone + {{constants.upXp}} XP.
    Max artifact level = (MR − 1) × 2 (max {{constants.maxLevel}}). MR 6: optional ultimate ({{constants.ultXp}} XP) at level {{constants.maxLevel}}.
  </p>

  {{#if cards.length}}
  {{#each cards}}
  <section class="ae-card" data-emb-id="{{embeddedId}}">
    <h3 class="ae-card-title">{{displayName}}</h3>
    <p class="ae-card-meta">
      MR {{masteryRank}} — max item level <strong>{{maxSystemLevel}}</strong> ·
      Stones <strong>{{stones}}</strong> · XP <strong>{{xp}}</strong>
    </p>
    <p class="ae-current">Current: <strong>{{currentLabel}}</strong> (system level {{currentSystemLevel}}) {{#unless linked}}<span class="ae-warn">· not linked</span>{{/unless}}</p>

    {{#if canLinkRules}}
      {{#unless linked}}
      <button type="button" class="ae-btn ae-btn-primary" data-action="ae-link" data-root-id="{{rootWorldId}}" data-emb-id="{{embeddedId}}"
        {{#unless (gte stones ../constants.linkStone)}}disabled title="Need {{../constants.linkStone}} stone"{{/unless}}>
        Link artifact ({{../constants.linkStone}} stone, permanent)
      </button>
      {{/unless}}
    {{else}}
      <p class="ae-muted">Mastery Rank 2+ required to link.</p>
    {{/if}}

    {{#if linked}}
    <div class="ae-paths">
      <h4>Evolution paths</h4>
      {{#if paths.length}}
      <ul class="ae-path-list">
        {{#each paths}}
        <li>
          <button type="button" class="ae-btn ae-btn-path" data-action="ae-upgrade"
            data-root-id="{{../rootWorldId}}" data-emb-id="{{../embeddedId}}"
            data-target-world-id="{{worldItemId}}" data-target-node-id="{{nodeId}}"
            {{#if disabledReason}}disabled title="{{disabledReason}}"{{/if}}>
            → {{label}} (level {{targetLevel}}) — {{@root.constants.upStone}} stone + {{@root.constants.upXp}} XP
          </button>
          {{#if disabledReason}}<span class="ae-path-reason">{{disabledReason}}</span>{{/if}}
        </li>
        {{/each}}
      </ul>
      {{else}}
      <p class="ae-muted">No further branches from this node (or tree ends here).</p>
      {{/if}}
    </div>
    {{/if}}

    {{#if canUltimate}}
    <div class="ae-ultimate">
      {{#if ultimateUnlocked}}
      <p class="ae-success">Ultimate unlocked.</p>
      {{else}}
      <button type="button" class="ae-btn ae-btn-ultimate" data-action="ae-ultimate" data-root-id="{{rootWorldId}}" data-emb-id="{{embeddedId}}"
        {{#unless (gte xp ../constants.ultXp)}}disabled title="Need {{../constants.ultXp}} XP"{{/unless}}>
        Unlock ultimate ({{../constants.ultXp}} XP)
      </button>
      {{/if}}
    </div>
    {{/if}}
  </section>
  {{/each}}
  {{else}}
  <p class="ae-empty">No evolution-bound artifacts on this actor. A GM must assign you in the Artifact Builder and give you the Level 1 item.</p>
  {{/if}}

  <footer class="ae-footer">
    <button type="button" class="ae-btn" data-action="ae-close">Close</button>
  </footer>
</div>
