<div class="ae-dialog">
  <div class="ae-scroll-body">
    <details class="ae-rules-details">
      <summary>Regeln &amp; Kapazität</summary>
      <p class="ae-intro">
        <strong>Mastery &amp; cap:</strong> MR 1 — inaktiv. MR 2+ — <strong>{{constants.linkStone}} Stone</strong> (einmal), dann {{constants.upXp}} XP pro Stufe.
        Max = (MR − 1) × 2 (cap {{constants.maxLevel}}). Ein Upgrade pro Upgrade Step.
      </p>
      <p class="ae-intro {{#if capacity.full}}ae-warn{{/if}}">
        <strong>Artifact Capacity:</strong> {{capacity.bound}} / {{capacity.max}} bound.
        {{#if capacity.full}} Voll — erst ein Artefakt lösen.{{/if}}
      </p>
    </details>

    {{#if hasUnwiredArtifacts}}
    <section class="ae-unwired">
      <h3 class="ae-unwired-title">Not linked to evolution tree</h3>
      {{#each unwiredArtifacts}}
      <div class="ae-unwired-row">
        <span>{{this.name}}</span>
        <button type="button" class="ae-btn ae-btn-primary" data-action="ae-wire-artifact" data-emb-id="{{this.id}}">
          Mit World-Tree verbinden
        </button>
      </div>
      {{/each}}
    </section>
    {{/if}}

    {{#if cards.length}}
    {{#each cards}}
    <section class="ae-card" data-emb-id="{{embeddedId}}">
      <header class="ae-card-head">
        <h3 class="ae-card-title">{{displayName}}</h3>
        <span class="ae-card-badge">
          L{{currentSystemLevel}}
          {{#unless linked}}· inaktiv{{else}}· aktiv{{/unless}}
        </span>
      </header>
      <p class="ae-card-meta">
        MR {{masteryRank}} · max L{{maxSystemLevel}} · Stones <strong>{{stones}}</strong> · XP <strong>{{xp}}</strong>
        {{#if isEchoBound}}<span class="ae-tag ae-tag-echo">Echo</span>{{/if}}
      </p>

      {{#unless linked}}
        {{#if canLinkRules}}
          {{#if linkDisabledReason}}
          <button type="button" class="ae-btn ae-btn-primary" disabled title="{{linkDisabledReason}}">
            Aktivieren ({{@root.constants.linkStone}} Stone)
          </button>
          <p class="ae-path-reason">{{linkDisabledReason}}</p>
          {{else if @root.usesStonePools}}
          <div class="ae-activate-row">
            <label class="ae-field-label" for="ae-stone-{{embeddedId}}">Stone-Pool</label>
            <select id="ae-stone-{{embeddedId}}" class="ae-stone-select" data-emb-id="{{embeddedId}}">
              <option value="">— Pool wählen —</option>
              {{#each @root.stonePools}}
              <option value="{{key}}" {{#unless canSpend}}disabled{{/unless}}>
                {{label}} ({{spendable}} frei)
              </option>
              {{/each}}
            </select>
            <button type="button" class="ae-btn ae-btn-primary" data-action="ae-activate"
              data-root-id="{{rootWorldId}}" data-emb-id="{{embeddedId}}">
              Aktivieren
            </button>
          </div>
          {{else}}
          <button type="button" class="ae-btn ae-btn-primary" data-action="ae-link" data-root-id="{{rootWorldId}}" data-emb-id="{{embeddedId}}">
            Aktivieren ({{@root.constants.linkStone}} Stone)
          </button>
          {{/if}}
        {{else}}
          <p class="ae-muted">Mastery Rank 2+ required to activate.</p>
        {{/if}}
      {{else}}
        {{#if hasBaseValues}}
        <details class="ae-details">
          <summary>Base Values</summary>
          <ul class="ae-stat-list">
            {{#each baseValues}}
            <li><strong>{{label}}</strong>{{#if value}}: {{value}}{{/if}}</li>
            {{/each}}
          </ul>
        </details>
        {{/if}}

        {{#if hasAbilities}}
        <details class="ae-details" open>
          <summary>Abilities (L{{currentSystemLevel}})</summary>
          <ul class="ae-ability-list">
            {{#each abilities}}
            <li>
              <strong>{{name}}</strong>
              {{#if type}}<span class="ae-ability-type">{{type}}</span>{{/if}}
              {{#if effect}}<p class="ae-ability-effect">{{effect}}</p>{{/if}}
            </li>
            {{/each}}
          </ul>
        </details>
        {{/if}}

        {{#if @root.isGM}}
        <div class="ae-gm-panel">
          {{#if activationStoneLabel}}
          <span class="ae-muted">Aktiviert mit: <strong>{{activationStoneLabel}}</strong></span>
          {{/if}}
          <button type="button" class="ae-btn ae-btn-gm" data-action="ae-gm-reset"
            data-root-id="{{rootWorldId}}" data-emb-id="{{embeddedId}}" data-display-name="{{displayName}}">
            GM: Aktivierung zurücksetzen
          </button>
        </div>
        {{/if}}

        <details class="ae-details" {{#if paths.length}}open{{/if}}>
          <summary>Evolution</summary>
          {{#if paths.length}}
          <div class="ae-upgrade-row">
            <label class="ae-field-label" for="ae-path-{{embeddedId}}">Pfad</label>
            <select id="ae-path-{{embeddedId}}" class="ae-path-select" data-emb-id="{{embeddedId}}">
              {{#each paths}}
              <option value="{{nodeId}}" data-world-id="{{worldItemId}}"
                {{#if disabledReason}}disabled title="{{disabledReason}}"{{/if}}>
                {{label}} (L{{targetLevel}}, {{@root.constants.upXp}} XP){{#if disabledReason}} — {{disabledReason}}{{/if}}
              </option>
              {{/each}}
            </select>
            <button type="button" class="ae-btn ae-btn-primary" data-action="ae-upgrade-selected"
              data-root-id="{{rootWorldId}}" data-emb-id="{{embeddedId}}">
              Upgraden
            </button>
          </div>
          {{else if atMaxTierForMr}}
          <p class="ae-muted">Max level for current Mastery Rank.</p>
          {{else}}
          <p class="ae-muted">No further branches from this node.</p>
          {{/if}}
        </details>
      {{/unless}}
    </section>
    {{/each}}
    {{else}}
    {{#unless hasUnwiredArtifacts}}
    <p class="ae-empty">No evolution-bound artifacts on this actor.</p>
    {{/unless}}
    {{/if}}
  </div>

  <footer class="ae-footer">
    <button type="button" class="ae-btn" data-action="ae-close">Close</button>
  </footer>
</div>
