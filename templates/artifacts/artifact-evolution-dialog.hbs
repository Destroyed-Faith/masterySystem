<div class="ae-dialog">
  <div class="ae-scroll-body">
    <div class="ae-rules">
      <p class="ae-rules-lead">
        Each artifact is listed separately: flavor first, then current abilities, then activate or upgrade.
      </p>
      <ul class="ae-rules-facts">
        <li><strong>Attunement / Binding Ritual</strong> is one-time and free (no Stone reserved)</li>
        <li><strong>Level 1</strong> is free after Attunement. Further levels: L2–3 = 8 XP, L4–6 = 16 XP, L7–9 = 32 XP, L10 = 64 XP (cost of the new level)</li>
        <li>Max Artifact Level = (MR − 1) × 2 (cap {{constants.maxLevel}}) · one upgrade per step</li>
        <li class="{{#if capacity.full}}ae-warn{{/if}}">Capacity {{capacity.bound}} / {{capacity.max}}{{#if capacity.full}} — full{{/if}}</li>
      </ul>
    </div>

    {{#if hasUnwiredArtifacts}}
    <section class="ae-unwired">
      <h3 class="ae-unwired-title">Not linked to evolution tree</h3>
      {{#each unwiredArtifacts}}
      <div class="ae-unwired-row">
        <span>{{this.name}}</span>
        <button type="button" class="ae-btn ae-btn-primary" data-action="ae-wire-artifact" data-emb-id="{{this.id}}">
          Mit World-Tree verbinden
        </button>
      </div>
      {{/each}}
    </section>
    {{/if}}

    {{#if cards.length}}
    <div class="ae-card-list">
    {{#each cards}}
    <section class="ae-card" data-emb-id="{{embeddedId}}">
      <header class="ae-card-head">
        {{#if img}}<img class="ae-card-thumb" src="{{img}}" alt="" />{{/if}}
        <div class="ae-card-head-copy">
          <h3 class="ae-card-title">{{displayName}}</h3>
          {{#if flavor}}<p class="ae-card-flavor">{{flavor}}</p>{{/if}}
        </div>
        <span class="ae-card-badge">
          L{{currentSystemLevel}}
          {{#unless linked}}· inaktiv{{else}}· aktiv{{/unless}}
        </span>
      </header>
      <ul class="ae-stat-chips">
        <li>MR {{masteryRank}}</li>
        <li>max L{{maxSystemLevel}}</li>
        <li>XP {{xp}}</li>
        <li>Stones {{stones}}</li>
        {{#if isEchoBound}}<li class="ae-tag-echo">Echo</li>{{/if}}
      </ul>
      {{#if legacyOverCap}}
      <p class="ae-warn">{{legacyOverCapReason}}</p>
      {{/if}}

      {{#if hasAbilities}}
      <details class="ae-details" {{#if openAbilities}}open{{/if}}>
        <summary>{{#if linked}}Current abilities{{else}}What it does when activated{{/if}}</summary>
        <ul class="ae-ability-list">
          {{#each abilities}}
          <li>
            <strong>{{name}}</strong>
            {{#if type}}<span class="ae-ability-type">{{type}}</span>{{/if}}
            {{#if effect}}<p class="ae-ability-effect">{{effect}}</p>{{/if}}
          </li>
          {{/each}}
        </ul>
      </details>
      {{/if}}

      {{#if hasBaseValues}}
      <details class="ae-details">
        <summary>Base values</summary>
        <ul class="ae-stat-list">
          {{#each baseValues}}
          <li><strong>{{label}}</strong>{{#if value}}: {{value}}{{/if}}</li>
          {{/each}}
        </ul>
      </details>
      {{/if}}

      {{#unless linked}}
        {{#if linkDisabledReason}}
          <button type="button" class="ae-btn ae-btn-primary" disabled title="{{linkDisabledReason}}">
            Attunement Ritual
          </button>
          <p class="ae-path-reason">{{linkDisabledReason}}</p>
        {{else}}
          <button type="button" class="ae-btn ae-btn-primary" data-action="ae-link" data-root-id="{{rootWorldId}}" data-emb-id="{{embeddedId}}">
            Attunement Ritual
          </button>
        {{/if}}
      {{else}}
        {{#if @root.isGM}}
        <div class="ae-gm-panel">
          {{#if activationStoneLabel}}
          <span class="ae-muted">Aktiviert mit: <strong>{{activationStoneLabel}}</strong></span>
          {{/if}}
          <button type="button" class="ae-btn ae-btn-gm" data-action="ae-gm-reset"
            data-root-id="{{rootWorldId}}" data-emb-id="{{embeddedId}}" data-display-name="{{displayName}}">
            GM: Aktivierung zurücksetzen
          </button>
        </div>
        {{/if}}

        {{#if paths.length}}
        <div class="ae-upgrade-row">
          <label class="ae-field-label" for="ae-path-{{embeddedId}}">Pfad</label>
          <select id="ae-path-{{embeddedId}}" class="ae-path-select" data-emb-id="{{embeddedId}}">
            {{#each paths}}
            <option value="{{nodeId}}" data-world-id="{{worldItemId}}"
              data-gm-disabled="{{#if gmDisabledReason}}1{{/if}}"
              {{#if disabledReason}}{{#unless @root.isGM}}disabled{{/unless}}{{/if}}
              {{#if gmDisabledReason}}{{#if @root.isGM}}disabled{{/if}}{{/if}}
              title="{{#if @root.isGM}}{{#if gmDisabledReason}}{{gmDisabledReason}}{{else}}{{#if disabledReason}}{{disabledReason}}{{/if}}{{/if}}{{else}}{{#if disabledReason}}{{disabledReason}}{{/if}}{{/if}}">
              {{label}} (L{{targetLevel}}{{#unless @root.isGM}}, {{xpCost}} XP{{/unless}}){{#if disabledReason}}{{#unless @root.isGM}} — {{disabledReason}}{{/unless}}{{/if}}
            </option>
            {{/each}}
          </select>
          <button type="button" class="ae-btn ae-btn-primary" data-action="ae-upgrade-selected"
            data-root-id="{{rootWorldId}}" data-emb-id="{{embeddedId}}"
            {{#unless canUpgrade}}disabled title="{{upgradeDisabledReason}}"{{/unless}}>
            Upgraden ({{#if nextUpgrade}}{{nextUpgrade.xpCost}}{{else}}{{#each paths}}{{#if @first}}{{xpCost}}{{/if}}{{/each}}{{/if}} XP)
          </button>
          {{#if @root.isGM}}
          <button type="button" class="ae-btn ae-btn-gm" data-action="ae-gm-upgrade-selected"
            data-root-id="{{rootWorldId}}" data-emb-id="{{embeddedId}}"
            {{#unless nextGmUpgrade}}disabled{{/unless}}
            title="Evolution ohne XP — ignoriert MR-Cap und Upgrade-Step-Regel">
            GM: Upgraden (ohne XP)
          </button>
          {{/if}}
        </div>
        {{#unless canUpgrade}}
        <p class="ae-path-reason">{{upgradeDisabledReason}}</p>
        {{/unless}}
        {{else if atMaxTierForMr}}
        <p class="ae-muted">Max level for current Mastery Rank.</p>
        {{else}}
        <p class="ae-muted">No further branches from this node.</p>
        {{/if}}
      {{/unless}}
    </section>
    {{/each}}
    </div>
    {{else}}
    {{#unless hasUnwiredArtifacts}}
    <p class="ae-empty">No evolution-bound artifacts on this actor.</p>
    {{/unless}}
    {{/if}}
  </div>

  <footer class="ae-footer">
    {{#if isGM}}
    <button type="button" class="ae-btn ae-btn-gm" data-action="ae-release-all-stones"
      title="Gibt alle durch Artefakte blockierten Aktivierungs-Steine wieder frei (für hängengebliebene/doppelte Aktivierungen).">
      GM: Aktivierungs-Steine freigeben
    </button>
    {{/if}}
    <button type="button" class="ae-btn" data-action="ae-close">Close</button>
  </footer>
</div>
