<form class="node-editor-form">
  <div class="node-editor-grid">
    {{#if lineageHint}}
    <p class="node-editor-hint node-editor-span2 node-lineage-hint">{{lineageHint}}</p>
    {{/if}}

    <!-- New Artifact Spec fields: Slot, Base Profile, Base Values, Stone Function -->
    <div class="node-editor-span2 node-spec-row" style="border-top:1px dashed var(--color-border-light-primary,#888);padding-top:8px;">
      <h4 class="node-profile-title">Artifact Spec (Slot, Base Profile, Base Values, Stone Function)</h4>
      <p class="node-editor-hint">From <em>Artefacts.md</em>. The Slot drives which Base Profiles and Base Values are legal, and which Attributes may host the Stone Function.</p>
      <div class="form-group node-editor-span2 node-base-type-row">
        <label>Base Type <span class="node-editor-hint-inline">(standard weapon / armor from the rulebook)</span></label>
        <select id="node-spec-base-type" {{#unless isLineageRoot}}disabled{{/unless}}>
          <option value="" {{#unless baseTypeKey}}selected{{/unless}}>— Custom / Define your own —</option>
          {{#each baseTypeGroups as |grp|}}
          <optgroup label="{{grp.group}}">
            {{#each grp.options as |opt|}}
            <option value="{{opt.id}}" {{#if (eq ../../baseTypeKey opt.id)}}selected{{/if}}>{{opt.label}}</option>
            {{/each}}
          </optgroup>
          {{/each}}
        </select>
        <p class="node-editor-hint">Pick a standard base to auto-fill Slot, Base Profile, damage/armor values, innate abilities and specials from the rulebook — then fine-tune below. Choose <strong>Custom</strong> to build everything by hand. Only editable on the root (Level 1-1) node.</p>
      </div>
      <div class="form-group node-editor-span2 node-free-trait-row" data-profile="weapon">
        <label>Free Trait <span class="node-editor-hint-inline">(one free innate ability)</span></label>
        <select id="node-spec-free-trait" {{#unless isLineageRoot}}disabled{{/unless}}>
          <option value="" {{#unless freeTrait}}selected{{/unless}}>— None —</option>
          {{#each freeTraitOptions as |trait|}}
          <option value="{{trait}}" {{#if (eq ../freeTrait trait)}}selected{{/if}}>{{trait}}</option>
          {{/each}}
        </select>
        <p class="node-editor-hint">Every weapon artifact may pick <strong>one</strong> weapon property for free on top of its base type's innate abilities — e.g. a Greatsword artifact with <em>Finesse</em>. Only Finesse, Light, Versatile, Reach, Balanced and Defensive are eligible (Spell Focus is too strong). This is the only way to add an innate ability; everything else the artifact has comes from its Base Type. Only editable on the root (Level 1-1) node; child levels inherit it.</p>
      </div>
      <div class="node-editor-grid">
        <div class="form-group">
          <label>Slot</label>
          <select id="node-spec-slot" {{#unless isLineageRoot}}disabled{{/unless}}>
            <option value="">— Choose Slot —</option>
            {{#each specSlotOptions as |opt|}}
            <option value="{{opt.key}}" {{#if (eq ../specSlot opt.key)}}selected{{/if}}>{{opt.label}}</option>
            {{/each}}
          </select>
        </div>
        <div class="form-group">
          <label>Base Profile</label>
          <select id="node-spec-base-profile" {{#unless isLineageRoot}}disabled{{/unless}}>
            <option value="">— Choose Profile —</option>
            {{#each specBaseProfileOptions as |opt|}}
            <option value="{{opt.key}}" {{#if (eq ../specBaseProfile opt.key)}}selected{{/if}}>{{opt.label}}</option>
            {{/each}}
          </select>
        </div>
      </div>

      <div class="form-group">
        <label>Base Values <span class="node-editor-hint-inline" id="node-spec-bv-limit-hint">(values auto-scale with the Artifact's level)</span></label>
        <p class="node-editor-hint">This Slot grants a fixed set of Base Value slots — <strong>A</strong> (from Artifact Level 1), <strong>B</strong> (from Level 4) and <strong>C</strong> (from Level 7). You only choose <em>what</em> each slot does; set its type to <strong>— None —</strong> to leave it unused.</p>
        <div id="node-spec-base-values" class="node-multi-select">
          {{#each specBaseValueRows as |row|}}
          <div class="node-select-row node-spec-bv-row" data-bv-slot="{{row.slot}}">
            <span class="node-spec-bv-slot-label" title="Unlocks at the shown Artifact Level">{{row.slotLabel}}</span>
            <select class="node-spec-bv-type">
              <option value="none" {{#if row.isNone}}selected{{/if}}>— None —</option>
              {{#each ../specBaseValueTypeOptions as |opt|}}
              <option value="{{opt.key}}" {{#if (eq row.type opt.key)}}selected{{/if}}>{{opt.label}}</option>
              {{/each}}
            </select>
            <select class="node-spec-bv-special {{#unless row.isSpecial}}hidden{{/unless}}" data-current="{{row.specialId}}">
              <option value="">— Choose Special —</option>
              {{#each ../specSpecialOptions as |opt|}}
              <option value="{{opt.id}}" {{#if (eq row.specialId opt.id)}}selected{{/if}}>{{opt.label}}</option>
              {{/each}}
            </select>
            <span class="node-spec-bv-derived" data-derived="{{row.derivedDisplay}}" title="Auto-calculated from Base Profile + Artifact Level">{{#unless row.unlocked}}— (unlocks L{{row.unlockLevel}}){{else}}{{#if row.derivedDisplay}}auto: {{row.derivedDisplay}}{{else}}—{{/if}}{{/unless}}</span>
            <input type="text" class="node-spec-bv-override" value="{{row.overrideStr}}" placeholder="{{#unless row.unlocked}}Unlocks at L{{row.unlockLevel}}{{else}}Value{{/unless}}" title="The Base Value for this slot. Leave blank to use the auto-scaled value shown on the left." {{#unless row.unlocked}}disabled{{/unless}} />
          </div>
          {{/each}}
        </div>
      </div>

      <p class="node-editor-hint" id="node-spec-slot-power-hint">{{specSlotAccessHint}}</p>
    </div>

    <!-- Level Progression: 3 picks introduced at Basic Level 1/2/3 (Power or Stone Function) -->
    <div class="node-editor-span2 node-progression-row" style="border-top:1px dashed var(--color-border-light-primary,#888);padding-top:8px;">
      <h4 class="node-profile-title">Level Progression (Level 1–3 picks)</h4>
      <p class="node-editor-hint">Pick up to three lines, introduced at Basic <strong>Level 1, 2 and 3</strong>. Each pick is a <strong>Power</strong> (from the catalog) or a <strong>Stone Function</strong>. Under <strong>Active</strong>, choose a template — including <em>Special Damage</em> rows (e.g. Ranged AoE + Ruin) or weapon attacks (<em>Ranged AoE Attack</em> = weapon only). Templates that need a Special show a second dropdown. The system scales picks across stages (PL 4 → 10 → 16). At most one Stone Function per artifact.</p>
      <div id="node-progression-picks" class="node-multi-select">
        {{#each progressionPickRows as |row|}}
        <div class="node-select-row node-progression-pick" data-level="{{row.level}}">
          <span class="node-pick-level-label" title="Introduced at Basic Level {{row.level}}">Level {{row.level}}</span>
          {{#if row.isAuthored}}
          <input type="hidden" class="node-pick-kind" value="authored" />
          <span class="node-pick-authored" title="Bespoke, hand-authored line. Shown read-only; preserved on save. Its staged rows appear in the table below.">
            <i class="fas fa-lock"></i> Authored{{#if row.authoredSummary}}: {{row.authoredSummary}}{{/if}}
          </span>
          {{else}}
          <select class="node-pick-kind">
            <option value="none" {{#if (eq row.kind "none")}}selected{{/if}}>— Empty —</option>
            <option value="power" {{#if (eq row.kind "power")}}selected{{/if}}>Power</option>
            <option value="stoneFunction" {{#if (eq row.kind "stoneFunction")}}selected{{/if}}>Stone Function</option>
          </select>
          <span class="node-pick-power-wrap {{#unless row.isPower}}hidden{{/unless}}">
            <select class="node-pick-power-mode" title="What kind of Power this slot grants">
              {{#each ../powerModeOptions as |opt|}}
              <option value="{{opt.value}}" {{#if (eq row.powerMode opt.value)}}selected{{/if}}>{{opt.label}}</option>
              {{/each}}
            </select>
            <span class="node-pick-template-wrap" title="Catalog Power for this slot">
              <select class="node-pick-template" data-current="{{row.selectedTemplateId}}">
                <option value="">— Choose Power —</option>
                {{#each (lookup ../powerCatalogOptions row.powerMode) as |opt|}}
                <option value="{{opt.id}}" {{#if (eq row.selectedTemplateId opt.id)}}selected{{/if}}>{{opt.name}}</option>
                {{/each}}
              </select>
              <span class="node-pick-catalog-special-wrap {{#unless row.needsCatalogSpecial}}hidden{{/unless}}" title="Special applied by this Power">
                <select class="node-pick-catalog-special" data-current="{{row.specialKey}}">
                  <option value="">— Choose Special —</option>
                  {{#each row.catalogSpecialOptions as |opt|}}
                  <option value="{{opt.key}}" title="{{opt.description}}" {{#if (eq ../row.specialKey opt.key)}}selected{{/if}}>{{opt.label}}</option>
                  {{/each}}
                </select>
                {{#if row.needsCatalogSpecial}}{{#unless row.specialKey}}
                <span class="node-pick-special-hint" title="This Power requires a Special">Please choose a Special.</span>
                {{/unless}}{{/if}}
              </span>
            </span>
            <input type="text" class="node-pick-name" value="{{row.displayName}}" placeholder="Flavor name (optional)" title="Optional display name shown to players (e.g. 'Breath Weapon'). The mechanics stay editable." />
            <span class="node-pick-spell-wrap {{#unless row.showSpellConfig}}hidden{{/unless}}" title="Cast this ranged Active as a Spell">
              <label class="node-pick-spell-label">
                <input type="checkbox" class="node-pick-is-spell" {{#if row.isSpell}}checked{{/if}} />
                Cast as Spell
              </label>
              <span class="node-pick-spell-fields {{#unless row.isSpell}}hidden{{/unless}}">
                <select class="node-pick-casting-attr" title="Casting attribute">
                  <option value="intellect" {{#if (eq row.castingAttribute "intellect")}}selected{{/if}}>Intellect</option>
                  <option value="resolve" {{#if (eq row.castingAttribute "resolve")}}selected{{/if}}>Resolve</option>
                </select>
                <select class="node-pick-spell-resolution" title="Spell resolution">
                  <option value="spellAttack" {{#if (eq row.spellResolution "spellAttack")}}selected{{/if}}>Spell Attack</option>
                  <option value="saveSpell" {{#if (eq row.spellResolution "saveSpell")}}selected{{/if}}>Save Spell</option>
                </select>
              </span>
            </span>
          </span>
          <span class="node-pick-stonefn {{#unless row.isStoneFn}}hidden{{/unless}}">
            <select class="node-pick-stone-kind">
              <option value="">— Stone Function —</option>
              <option value="stonePowerSupport" {{#if (eq row.stoneKind "stonePowerSupport")}}selected{{/if}}>Stone Power Support</option>
              <option value="stonePool" {{#if (eq row.stoneKind "stonePool")}}selected{{/if}}>Stone Pool</option>
              <option value="stoneRefresh" {{#if (eq row.stoneKind "stoneRefresh")}}selected{{/if}}>Stone Refresh</option>
              <option value="stoneBattery" {{#if (eq row.stoneKind "stoneBattery")}}selected{{/if}}>Stone Battery</option>
            </select>
            <select class="node-pick-stone-attr">
              <option value="">— Attribute (slot-gated) —</option>
              {{#each ../specStoneFnAttrOptions as |opt|}}
              <option value="{{opt.key}}" {{#if (eq row.stoneAttr opt.key)}}selected{{/if}}>{{opt.label}}</option>
              {{/each}}
            </select>
            <span class="node-pick-stone-power-wrap {{#unless (eq row.stoneKind "stonePowerSupport")}}hidden{{/unless}}" title="Stone Power supported by this artifact (4 per attribute)">
              <select class="node-pick-stone-power" data-current="{{row.stonePowerId}}">
                <option value="">— Choose Stone Power —</option>
              </select>
            </span>
          </span>
          {{/if}}
        </div>
        {{/each}}
      </div>
      <p class="node-editor-hint node-progression-stonefn-warning hidden" style="color:var(--color-text-hyperlink,#c0531e);">More than one Stone Function selected — the spec allows at most one Stone Function per artifact.</p>
    </div>

    <!-- Live overview of the Level Progression (Level 1–9), generated from the picks above -->
    <div class="node-editor-span2 node-levelprog-overview" style="border-top:1px dashed var(--color-border-light-primary,#888);padding-top:8px;">
      <h4 class="node-profile-title">Level Progression (generated from picks)</h4>
      <p class="node-editor-hint">Generated from the three picks above. Each pick scales across stages I / II / III (PL 4 → 10 → 16): Pick 1 fills Levels 1/4/7, Pick 2 fills 2/5/8, Pick 3 fills 3/6/9. The current node's level is highlighted. Change a pick to update this table.</p>
      <table class="node-levelprog-table">
        <thead>
          <tr>
            <th>Lvl</th>
            <th>Name</th>
            <th>Type</th>
            <th>Range</th>
            <th>Duration</th>
            <th>Effect</th>
          </tr>
        </thead>
        <tbody>
          {{#each levelProgressionRows as |row|}}
          <tr class="{{#if row.isCurrent}}node-levelprog-current{{/if}}">
            <td class="node-levelprog-lvl">{{row.level}}</td>
            <td class="node-levelprog-name">{{row.name}}{{#if row.special}}<span class="node-levelprog-special" title="Special">{{row.special}}</span>{{/if}}</td>
            <td>{{row.type}}</td>
            <td>{{row.range}}</td>
            <td>{{row.duration}}</td>
            <td class="node-levelprog-effect">{{row.effect}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
      <p class="node-levelprog-empty node-editor-hint {{#if hasLevelProgression}}hidden{{/if}}">No progression yet — pick a Power or Stone Function above to generate the table.</p>
    </div>

    <div class="form-group node-editor-span2">
      <label>Inventory size</label>
      <select id="node-inventory-size">
        {{#each inventorySizeOptions}}
        <option value="{{this}}" {{#if (eq ../inventorySize this)}}selected{{/if}}>{{this}}</option>
        {{/each}}
      </select>
      <p class="node-editor-hint">Grid footprint on the character inventory (same presets as gear).</p>
    </div>

    <div class="node-profile-block node-editor-span2 {{#unless (eq artifactKind "weapon")}}hidden{{/unless}}" data-profile="weapon">
      <h4 class="node-profile-title">Weapon</h4>
      <div class="node-editor-grid">
        <div class="form-group">
          <label>Type</label>
          <select id="node-weapon-type" {{#unless isLineageRoot}}disabled{{/unless}}>
            <option value="melee" {{#if (eq weaponProfile.weaponType "melee")}}selected{{/if}}>Melee</option>
            <option value="ranged" {{#if (eq weaponProfile.weaponType "ranged")}}selected{{/if}}>Ranged</option>
          </select>
        </div>
        <div class="form-group">
          <label>Hands</label>
          <select id="node-weapon-hands" {{#unless isLineageRoot}}disabled{{/unless}}>
            <option value="1" {{#unless weaponHandsIsTwo}}selected{{/unless}}>1 hand</option>
            <option value="2" {{#if weaponHandsIsTwo}}selected{{/if}}>2 hands</option>
          </select>
        </div>
        <div class="form-group node-editor-span2 node-weapon-damage-reach-row">
          <div class="node-weapon-damage-stack">
            <label>Damage</label>
            <select id="node-weapon-damage-preset">
              {{#each damagePresetOptions}}
              <option value="{{this.value}}" {{#if (eq this.value ../weaponDamagePreset)}}selected{{/if}}>{{this.label}}</option>
              {{/each}}
            </select>
          </div>
          <div class="form-group node-weapon-reach-col">
            <label id="node-weapon-range-label">{{#if (eq weaponProfile.weaponType "ranged")}}Range{{else}}Reach{{/if}}</label>
            <input type="text" id="node-weapon-range" value="{{weaponProfile.range}}" placeholder="{{#if (eq weaponProfile.weaponType "ranged")}}e.g. 8/16/32m{{else}}e.g. 0m, Reach (+1 m){{/if}}" />
          </div>
        </div>
      </div>
      <div class="form-group">
        <label>Innate abilities</label>
        <p class="node-editor-hint">Prefilled from the Base Type — the weapon brings its full kit. You may only <strong>remove</strong> entries that don't fit the artifact's story (×). The single allowed addition is the <strong>Free Trait</strong> above.</p>
        <div id="node-weapon-innates" class="node-multi-select">
          {{#each weaponInnateRows as |row|}}
          <div class="node-select-row {{#if row.locked}}node-row-locked{{/if}}">
            <select class="node-weapon-innate" disabled>
              <option value="">—</option>
              {{#each ../innateOptions as |opt|}}
              <option value="{{opt}}" {{#if (eq row.value opt)}}selected{{/if}}>{{opt}}</option>
              {{/each}}
            </select>
            <button type="button" class="node-row-remove {{#if row.locked}}hidden{{/if}}" title="Remove row">×</button>
          </div>
          {{/each}}
        </div>
      </div>
      <div class="form-group">
        <label>Special Effects</label>
        <p class="node-editor-hint">Prefilled from the Base Type. <strong>Remove-only</strong> (×) — new Specials come from the artifact's Powers, not from this list. If the rules use a variable number (often written as “X”), adjust <strong>Strength</strong> in the small field.</p>
        <div id="node-weapon-specials" class="node-multi-select">
          {{#each weaponSpecialRows as |row|}}
          <div class="node-select-row node-special-row {{#if row.locked}}node-row-locked{{/if}}">
            <select class="node-weapon-special-id" disabled>
              <option value="">—</option>
              {{#each ../specialSelectOptions as |opt|}}
              <option value="{{opt.id}}" data-has-value="{{#if opt.hasValue}}true{{else}}false{{/if}}" {{#if (eq row.specialId opt.id)}}selected{{/if}}>{{opt.label}}</option>
              {{/each}}
            </select>
            <div class="node-weapon-special-val-wrap {{#unless row.showValueInput}}hidden{{/unless}}">
              <label class="node-special-strength-label" title="Numeric strength or rank when the effect uses a value (e.g. Push 2)">Strength</label>
              <input type="number" class="node-weapon-special-val" min="0" max="99" step="1" value="{{row.valueStr}}" placeholder="0" title="Strength / rank for this effect" {{#if row.locked}}disabled{{/if}} />
            </div>
            <button type="button" class="node-row-remove {{#if row.locked}}hidden{{/if}}" title="Remove this row">Remove</button>
          </div>
          {{/each}}
        </div>
      </div>
    </div>

    <div class="node-profile-block node-editor-span2 {{#unless (eq artifactKind "armor")}}hidden{{/unless}}" data-profile="armor">
      <h4 class="node-profile-title">Armor</h4>
      <div class="node-editor-grid">
        <div class="form-group">
          <label>Armor type</label>
          <select id="node-armor-type" {{#unless isLineageRoot}}disabled{{/unless}}>
            <option value="light" {{#if (eq armorProfile.type "light")}}selected{{/if}}>Light</option>
            <option value="medium" {{#if (eq armorProfile.type "medium")}}selected{{/if}}>Medium</option>
            <option value="heavy" {{#if (eq armorProfile.type "heavy")}}selected{{/if}}>Heavy</option>
          </select>
        </div>
        <div class="form-group">
          <label>Armor value</label>
          <input type="number" id="node-armor-value" value="{{armorProfile.armorValue}}" min="0" step="1" />
        </div>
        <div class="form-group">
          <label>Evade modifier</label>
          <input type="number" id="node-armor-evade" value="{{armorProfile.evadeModifier}}" step="1" />
        </div>
        <div class="form-group node-editor-span2">
          <label>Skill penalty <span class="node-editor-hint-inline">(empty = type default)</span></label>
          <input type="text" id="node-armor-skill-penalty" value="{{armorProfile.skillPenalty}}" placeholder="e.g. −1d8 to Physical Skill checks" />
        </div>
      </div>
    </div>

    <div class="node-profile-block node-editor-span2 {{#unless (eq artifactKind "shield")}}hidden{{/unless}}" data-profile="shield">
      <h4 class="node-profile-title">Shield</h4>
      <div class="node-editor-grid">
        <div class="form-group">
          <label>Shield type</label>
          <select id="node-shield-type" {{#unless isLineageRoot}}disabled{{/unless}}>
            <option value="parry" {{#if (eq shieldProfile.type "parry")}}selected{{/if}}>Parry</option>
            <option value="medium" {{#if (eq shieldProfile.type "medium")}}selected{{/if}}>Medium</option>
            <option value="tower" {{#if (eq shieldProfile.type "tower")}}selected{{/if}}>Tower</option>
          </select>
        </div>
        <div class="form-group">
          <label>Shield value</label>
          <input type="number" id="node-shield-value" value="{{shieldProfile.shieldValue}}" min="0" step="1" />
        </div>
        <div class="form-group">
          <label>Evade bonus</label>
          <input type="number" id="node-shield-evade" value="{{shieldProfile.evadeBonus}}" step="1" />
        </div>
        <div class="form-group node-editor-span2">
          <label>Skill penalty</label>
          <input type="text" id="node-shield-skill-penalty" value="{{shieldProfile.skillPenalty}}" placeholder="Optional override" />
        </div>
      </div>
    </div>

    <div class="form-group">
      <label>Stones required</label>
      <input type="number" id="node-stones" value="{{requirements.stones}}" min="0" />
    </div>
    <div class="form-group">
      <label>Mastery rank required</label>
      <input type="number" id="node-mastery-rank" value="{{requirements.masteryRank}}" min="1" />
    </div>
  </div>

  <footer class="node-editor-footer">
    <button type="button" class="node-editor-btn-primary" data-button="save" title="Save changes to this item">
      <i class="fas fa-save"></i> Save
    </button>
    <button type="button" class="node-editor-btn-secondary" data-button="cancel" title="Discard changes">Cancel</button>
  </footer>
</form>
