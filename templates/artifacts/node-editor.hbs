<form class="node-editor-form">
  <div class="node-editor-grid">
    {{#if lineageHint}}
    <p class="node-editor-hint node-editor-span2 node-lineage-hint">{{lineageHint}}</p>
    {{/if}}
    <div class="node-editor-span2 node-level-item-row">
      <div class="node-level-item-grid">
        <div class="form-group">
          <label>Level</label>
          <input type="number" id="node-level" value="{{level}}" disabled />
        </div>
        <div class="form-group">
          <label>Item type</label>
          <select id="node-artifact-kind" {{#unless isLineageRoot}}disabled{{/unless}}>
            <option value="weapon" {{#if (eq artifactKind "weapon")}}selected{{/if}}>Weapon</option>
            <option value="armor" {{#if (eq artifactKind "armor")}}selected{{/if}}>Armor</option>
            <option value="shield" {{#if (eq artifactKind "shield")}}selected{{/if}}>Shield</option>
            <option value="gear" {{#if (eq artifactKind "gear")}}selected{{/if}}>Gear (accessory)</option>
          </select>
        </div>
      </div>
      <p class="node-editor-hint node-level-item-hint">Weapon / armor / shield use standard equip slots. Gear picks a ring, belt, cloak, etc.</p>
    </div>

    <div class="form-group node-editor-span2 {{#unless (eq artifactKind "gear")}}hidden{{/unless}}" data-profile="gear">
      <label>Gear slot</label>
      <select id="node-gear-slot" {{#unless isLineageRoot}}disabled{{/unless}}>
        <option value="">— Select slot —</option>
        {{#each gearSlotOptions}}
        <option value="{{this.value}}" {{#if (eq ../gearSlot this.value)}}selected{{/if}}>{{this.label}}</option>
        {{/each}}
      </select>
    </div>

    <div class="node-profile-block node-editor-span2 {{#unless (eq artifactKind "weapon")}}hidden{{/unless}}" data-profile="weapon">
      <h4 class="node-profile-title">Weapon</h4>
      <div class="node-editor-grid">
        <div class="form-group">
          <label>Type</label>
          <select id="node-weapon-type" {{#unless isLineageRoot}}disabled{{/unless}}>
            <option value="melee" {{#if (eq weaponProfile.weaponType "melee")}}selected{{/if}}>Melee</option>
            <option value="ranged" {{#if (eq weaponProfile.weaponType "ranged")}}selected{{/if}}>Ranged</option>
          </select>
        </div>
        <div class="form-group">
          <label>Hands</label>
          <select id="node-weapon-hands" {{#unless isLineageRoot}}disabled{{/unless}}>
            <option value="1" {{#unless weaponHandsIsTwo}}selected{{/unless}}>1 hand</option>
            <option value="2" {{#if weaponHandsIsTwo}}selected{{/if}}>2 hands</option>
          </select>
        </div>
        <div class="form-group node-editor-span2 node-weapon-damage-reach-row">
          <div class="node-weapon-damage-stack">
            <label>Damage</label>
            <select id="node-weapon-damage-preset">
              {{#each damagePresetOptions}}
              <option value="{{this.value}}" {{#if (eq this.value ../weaponDamagePreset)}}selected{{/if}}>{{this.label}}</option>
              {{/each}}
            </select>
          </div>
          <div class="form-group node-weapon-reach-col">
            <label id="node-weapon-range-label">{{#if (eq weaponProfile.weaponType "ranged")}}Range{{else}}Reach{{/if}}</label>
            <input type="text" id="node-weapon-range" value="{{weaponProfile.range}}" placeholder="{{#if (eq weaponProfile.weaponType "ranged")}}e.g. 8/16/32m{{else}}e.g. 0m, Reach (+1 m){{/if}}" />
          </div>
        </div>
      </div>
      <div class="form-group">
        <label>Innate abilities</label>
        <div id="node-weapon-innates" class="node-multi-select">
          {{#each weaponInnateRows as |row|}}
          <div class="node-select-row {{#if row.locked}}node-row-locked{{/if}}">
            <select class="node-weapon-innate" {{#if row.locked}}disabled{{/if}}>
              <option value="">—</option>
              {{#each ../innateOptions as |opt|}}
              <option value="{{opt}}" {{#if (eq row.value opt)}}selected{{/if}}>{{opt}}</option>
              {{/each}}
            </select>
            <button type="button" class="node-row-remove {{#if row.locked}}hidden{{/if}}" title="Remove row">×</button>
          </div>
          {{/each}}
        </div>
        <button type="button" class="node-add-row" data-target="innates">+ Add innate</button>
      </div>
      <div class="form-group">
        <label>Specials</label>
        <p class="node-editor-hint">Pick an effect. If the rules use a variable number (often written as “X”), set <strong>Strength</strong> in the small field next to it.</p>
        <div id="node-weapon-specials" class="node-multi-select">
          {{#each weaponSpecialRows as |row|}}
          <div class="node-select-row node-special-row {{#if row.locked}}node-row-locked{{/if}}">
            <select class="node-weapon-special-id" {{#if row.locked}}disabled{{/if}}>
              <option value="">—</option>
              {{#each ../specialSelectOptions as |opt|}}
              <option value="{{opt.id}}" data-has-value="{{#if opt.hasValue}}true{{else}}false{{/if}}" {{#if (eq row.specialId opt.id)}}selected{{/if}}>{{opt.label}}</option>
              {{/each}}
            </select>
            <div class="node-weapon-special-val-wrap {{#unless row.showValueInput}}hidden{{/unless}}">
              <label class="node-special-strength-label" title="Numeric strength or rank when the effect uses a value (e.g. Push 2)">Strength</label>
              <input type="number" class="node-weapon-special-val" min="0" max="99" step="1" value="{{row.valueStr}}" placeholder="0" title="Strength / rank for this effect" {{#if row.locked}}disabled{{/if}} />
            </div>
            <button type="button" class="node-row-remove {{#if row.locked}}hidden{{/if}}" title="Remove this row">Remove</button>
          </div>
          {{/each}}
        </div>
        <button type="button" class="node-add-row" data-target="specials">+ Add special</button>
      </div>
    </div>

    <div class="node-profile-block node-editor-span2 {{#unless (eq artifactKind "armor")}}hidden{{/unless}}" data-profile="armor">
      <h4 class="node-profile-title">Armor</h4>
      <div class="node-editor-grid">
        <div class="form-group">
          <label>Armor type</label>
          <select id="node-armor-type" {{#unless isLineageRoot}}disabled{{/unless}}>
            <option value="light" {{#if (eq armorProfile.type "light")}}selected{{/if}}>Light</option>
            <option value="medium" {{#if (eq armorProfile.type "medium")}}selected{{/if}}>Medium</option>
            <option value="heavy" {{#if (eq armorProfile.type "heavy")}}selected{{/if}}>Heavy</option>
          </select>
        </div>
        <div class="form-group">
          <label>Armor value</label>
          <input type="number" id="node-armor-value" value="{{armorProfile.armorValue}}" min="0" step="1" />
        </div>
        <div class="form-group">
          <label>Evade modifier</label>
          <input type="number" id="node-armor-evade" value="{{armorProfile.evadeModifier}}" step="1" />
        </div>
        <div class="form-group node-editor-span2">
          <label>Skill penalty <span class="node-editor-hint-inline">(empty = type default)</span></label>
          <input type="text" id="node-armor-skill-penalty" value="{{armorProfile.skillPenalty}}" placeholder="e.g. −1d8 to Physical Skill checks" />
        </div>
      </div>
    </div>

    <div class="node-profile-block node-editor-span2 {{#unless (eq artifactKind "shield")}}hidden{{/unless}}" data-profile="shield">
      <h4 class="node-profile-title">Shield</h4>
      <div class="node-editor-grid">
        <div class="form-group">
          <label>Shield type</label>
          <select id="node-shield-type" {{#unless isLineageRoot}}disabled{{/unless}}>
            <option value="parry" {{#if (eq shieldProfile.type "parry")}}selected{{/if}}>Parry</option>
            <option value="medium" {{#if (eq shieldProfile.type "medium")}}selected{{/if}}>Medium</option>
            <option value="tower" {{#if (eq shieldProfile.type "tower")}}selected{{/if}}>Tower</option>
          </select>
        </div>
        <div class="form-group">
          <label>Shield value</label>
          <input type="number" id="node-shield-value" value="{{shieldProfile.shieldValue}}" min="0" step="1" />
        </div>
        <div class="form-group">
          <label>Evade bonus</label>
          <input type="number" id="node-shield-evade" value="{{shieldProfile.evadeBonus}}" step="1" />
        </div>
        <div class="form-group node-editor-span2">
          <label>Skill penalty</label>
          <input type="text" id="node-shield-skill-penalty" value="{{shieldProfile.skillPenalty}}" placeholder="Optional override" />
        </div>
      </div>
    </div>

    <div class="form-group">
      <label>Stones required</label>
      <input type="number" id="node-stones" value="{{requirements.stones}}" min="0" />
    </div>
    <div class="form-group">
      <label>Mastery rank required</label>
      <input type="number" id="node-mastery-rank" value="{{requirements.masteryRank}}" min="1" />
    </div>

    <div class="form-group node-editor-span2 node-embedded-powers-row">
      <label>Embedded powers</label>
      <p class="node-editor-hint">Stored on this artifact item (<code>system.powers</code>), not in the fields above. Use the artifact item sheet “Powers” tab or the editor below. Saves in a separate window from this dialog.</p>
      <p class="node-embedded-powers-summary" role="status">{{embeddedPowersSummary}}</p>
      <button type="button" class="node-open-embedded-powers" data-action="open-embedded-powers">Edit embedded powers…</button>
    </div>
  </div>
</form>
