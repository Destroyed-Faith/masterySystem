<form class="artifact-creation-form">
  <div class="form-group">
    <label>Artifact Name:</label>
    <input type="text" id="artifact-name" name="artifact-name" placeholder="Enter artifact name..." />
  </div>
  
  <div class="form-group">
    <label>Initial Bonuses:</label>
    <div class="bonus-inputs">
      <div class="bonus-row">
        <label>Attack:</label>
        <input type="number" id="artifact-attack" name="artifact-attack" value="0" min="0" />
      </div>
      <div class="bonus-row">
        <label>Defense:</label>
        <input type="number" id="artifact-defense" name="artifact-defense" value="0" min="0" />
      </div>
      <div class="bonus-row">
        <label>Damage:</label>
        <input type="text" id="artifact-damage" name="artifact-damage" placeholder="e.g., +1d6" />
      </div>
    </div>
  </div>
  
  <div class="form-group">
    <label>Lore/Description:</label>
    <textarea id="artifact-lore" name="artifact-lore" rows="3" placeholder="Enter artifact lore or description..."></textarea>
  </div>
  
  <div class="form-group">
    <label>Requirements:</label>
    <div class="requirement-inputs">
      <div class="requirement-row">
        <label>Stones:</label>
        <input type="number" id="artifact-stones" name="artifact-stones" value="0" min="0" />
      </div>
      <div class="requirement-row">
        <label>Mastery Rank:</label>
        <input type="number" id="artifact-mastery-rank" name="artifact-mastery-rank" value="1" min="1" />
      </div>
    </div>
  </div>
</form>

