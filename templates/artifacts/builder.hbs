<div class="artifact-builder">
  <div class="artifact-header">
    <div class="artifact-header-left">
      <img class="artifact-image" src="{{artifactImage}}" data-edit="img" alt="{{artifactName}}">
    </div>
    <div class="artifact-header-main">
      <div class="artifact-name-row">
        <input type="text" class="artifact-name-input" value="{{artifactName}}" placeholder="Artifact Name">
        <button type="button" class="save-artifact-name" title="Save Name">
          <i class="fas fa-check-circle"></i>
        </button>
      </div>
      <div class="artifact-damage-row">
        <label>Damage</label>
        <select class="artifact-damage-select">
          {{#each damageOptions}}
          <option value="{{this.value}}" {{#ifEquals this.value ../artifactDamage}}selected{{/ifEquals}}>
            {{this.label}}
          </option>
          {{/each}}
          <option value="custom" {{#if damageIsCustom}}selected{{/if}}>Custom</option>
        </select>
        <input type="text" class="artifact-damage-custom {{#unless damageIsCustom}}hidden{{/unless}}" value="{{artifactDamage}}" placeholder="e.g., 2d6+1">
      </div>
    </div>
  </div>

  <div class="artifact-tree">
    <h3>Artifact Evolution Tree</h3>
    <div class="tree-container">
      {{{treeHTML}}}
    </div>
  </div>

  <div class="artifact-assignments">
    <h3>Actor Allocation</h3>
    <div class="assignments-list">
      {{#each actorLevels}}
      <div class="assignment-item">
        <label>{{actorName}}</label>
        <input type="number" class="assign-actor-level" data-actor-id="{{actorId}}" value="{{level}}" min="0"/>
      </div>
      {{/each}}
    </div>
    <div class="add-assignment">
      <select id="actor-select">
        <option value="">Select Actor...</option>
        {{#each availableActors}}
        <option value="{{this.id}}">{{this.name}}</option>
        {{/each}}
      </select>
      <button type="button" class="add-actor-assignment">Add Assignment</button>
    </div>
  </div>
</div>

