<div class="artifact-builder">
  <div class="artifact-header">
    <div class="artifact-header-left">
      <img class="artifact-image" src="{{artifactImage}}" data-edit="img" alt="{{artifactName}}">
    </div>
    <div class="artifact-header-main">
      <div class="artifact-name-row">
        <input type="text" class="artifact-name-input" value="{{artifactName}}" placeholder="Artifact name" aria-label="Artifact name" />
        <button type="button" class="save-artifact-name" title="Save name">
          <i class="fas fa-check"></i>
        </button>
        <button type="button" class="resync-artifact-actors" title="Resync this artifact onto all linked actors (each at their own evolution level)">
          <i class="fas fa-sync"></i> Resync to actors
        </button>
      </div>
    </div>
  </div>

  <div class="artifact-tree">
    <h3>Artifact Evolution Tree</h3>
    <p class="artifact-tree-hint">Klicke einen Knoten zum Bearbeiten — <strong>Speichern</strong> unten im Fenster. Plus = Kindknoten; Minus = diesen Ast löschen. Pfeil zeigt den Elternknoten. / Click a node to edit — use <strong>Save</strong> at the bottom of the dialog. Plus adds a child; minus removes that branch. The arrow shows the parent node.</p>
    <div class="tree-container">
      {{{treeHTML}}}
    </div>
  </div>

  <div class="artifact-assignments">
    <h3>Actor Allocation</h3>
    <p class="artifact-assignments-hint">Assigned actors may receive the Level 1 item; linking and upgrades happen on the character sheet (Artifact evolution).</p>
    <div class="assignments-list">
      {{#each actorLevels}}
      <div class="assignment-item">
        <span class="assignment-actor-name">{{actorName}}</span>
        <span class="assignment-linked-badge">{{linkedLabel}}{{#if orphan}} — not in world{{/if}}</span>
        <button type="button" class="remove-actor-assignment" data-actor-id="{{actorId}}" title="Remove assignment">Remove</button>
      </div>
      {{/each}}
    </div>
    <div class="add-assignment">
      <select id="actor-select">
        <option value="">Select Actor...</option>
        {{#each availableActors}}
        <option value="{{this.id}}">{{this.name}}</option>
        {{/each}}
      </select>
      <button type="button" class="add-actor-assignment">Add Assignment</button>
    </div>
  </div>
</div>

