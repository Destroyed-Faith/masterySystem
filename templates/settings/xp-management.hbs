<div class="mastery-xp-management">
  <nav class="tabs" data-group="primary">
    <a class="item active" data-tab="characters">
      <i class="fas fa-users"></i> Characters
    </a>
  </nav>
  
  <section class="content">
    <div class="tab active" data-tab="characters">
      <div class="xp-management-header">
        <h2><i class="fas fa-coins"></i> Character XP Management</h2>
        <p class="hint">View XP spending and grant XP allowances to player characters.</p>
      </div>
      
      <!-- Bulk Grant Section -->
      <div class="bulk-grant-section">
        <h3>Bulk Grant XP</h3>
        <div class="bulk-grant-controls">
          <div class="bulk-grant-group">
            <label>Regular XP:</label>
            <input type="number" class="bulk-xp-amount" min="0" value="0" />
            <button type="button" class="bulk-grant-btn" title="Grant regular XP (once-per-step rule applies) to all characters">
              <i class="fas fa-gift"></i> Grant to All
            </button>
          </div>
          <div class="bulk-grant-group">
            <label>Free XP:</label>
            <input type="number" class="bulk-free-xp-amount" min="0" value="0" />
            <button type="button" class="bulk-grant-free-btn" title="Grant Free XP (spent first, no once-per-step limit) to all characters">
              <i class="fas fa-star"></i> Grant Free to All
            </button>
          </div>
        </div>
      </div>
      
      <!-- Characters List -->
      <div class="characters-list">
        <table class="xp-table xp-table-compact">
          <thead>
            <tr>
              <th>Character</th>
              <th>Player</th>
              <th>Spent</th>
              <th>Avail.</th>
              <th>Free Avail.</th>
              <th>Earned</th>
              <th>Step bumps</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {{#each characters}}
            <tr data-character-id="{{this.id}}">
              <td class="character-cell">
                <img src="{{this.img}}" alt="{{this.name}}" class="character-avatar" />
                <span class="character-name">{{this.name}}</span>
              </td>
              <td class="player-cell">{{this.player}}</td>
              <td class="xp-cell"><strong>{{this.xp.spent}}</strong></td>
              <td class="xp-cell"><strong>{{this.xp.available}}</strong></td>
              <td class="xp-cell xp-cell-free" title="Free XP available ({{this.xp.freeEarned}} granted total)"><strong>{{this.xp.freeAvailable}}</strong></td>
              <td class="xp-cell"><strong>{{this.xp.totalEarned}}</strong></td>
              <td class="xp-cell" title="{{this.xp.stepSummary}}">
                {{this.xp.stepTotal}}
              </td>
              <td class="grant-cell">
                <div class="grant-controls">
                  <div class="grant-group">
                    <input type="number" class="xp-amount-input" data-character-id="{{this.id}}" min="0" value="0" placeholder="+" title="Grant regular XP (once-per-step rule applies)" />
                    <button type="button" class="grant-xp-btn" data-character-id="{{this.id}}" title="Grant regular XP (once-per-step rule applies)">
                      <i class="fas fa-plus"></i>
                    </button>
                  </div>
                  <div class="grant-group grant-group-free">
                    <input type="number" class="free-xp-amount-input" data-character-id="{{this.id}}" min="0" value="0" placeholder="+" title="Grant Free XP (spent first, no once-per-step limit)" />
                    <button type="button" class="grant-free-xp-btn" data-character-id="{{this.id}}" title="Grant Free XP (spent first, no once-per-step limit)">
                      <i class="fas fa-star"></i>
                    </button>
                  </div>
                  <div class="xp-row-actions">
                    <button type="button" class="end-xp-step-btn" data-character-id="{{this.id}}" title="End current Upgrade Step. Clears the once-per-step bump lists for Attributes / Skills / Powers / Artifacts.">
                      <i class="fas fa-flag-checkered"></i>
                    </button>
                    <button type="button" class="history-xp-btn" data-character-id="{{this.id}}" title="XP History">
                      <i class="fas fa-history"></i>
                    </button>
                    {{#if (userIsGM)}}
                    <button type="button" class="reset-progress-xp-btn" data-character-id="{{this.id}}" title="Reset to post-creation (attributes, skills, powers). All earned XP becomes available." {{#unless this.hasPostCreationSnapshot}}disabled{{/unless}}>
                      <i class="fas fa-undo"></i>
                    </button>
                    {{/if}}
                  </div>
                </div>
              </td>
            </tr>
            {{else}}
            <tr>
              <td colspan="8" class="empty-message">
                <i class="fas fa-info-circle"></i> No player characters found.
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</div>

