<div class="mastery-xp-management">
  <nav class="tabs" data-group="primary">
    <a class="item active" data-tab="characters">
      <i class="fas fa-users"></i> Characters
    </a>
  </nav>
  
  <section class="content">
    <div class="tab active" data-tab="characters">
      <div class="xp-management-header">
        <h2><i class="fas fa-coins"></i> Character XP Management</h2>
        <p class="hint">View XP spending and grant XP allowances to player characters.</p>
      </div>
      
      <!-- Bulk Grant Section -->
      <div class="bulk-grant-section">
        <h3>Bulk Grant XP</h3>
        <div class="bulk-grant-controls">
          <div class="bulk-grant-group">
            <label>XP:</label>
            <input type="number" class="bulk-xp-amount" min="0" value="0" />
            <button type="button" class="bulk-grant-btn">
              <i class="fas fa-gift"></i> Grant to All
            </button>
          </div>
        </div>
      </div>
      
      <!-- Characters List -->
      <div class="characters-list">
        <table class="xp-table xp-table-compact">
          <thead>
            <tr>
              <th>Character</th>
              <th>Player</th>
              <th>Spent</th>
              <th>Avail.</th>
              <th>Earned</th>
              <th>Attr cap</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {{#each characters}}
            <tr data-character-id="{{this.id}}">
              <td class="character-cell">
                <img src="{{this.img}}" alt="{{this.name}}" class="character-avatar" />
                <span class="character-name">{{this.name}}</span>
              </td>
              <td class="player-cell">{{this.player}}</td>
              <td class="xp-cell"><strong>{{this.xp.spent}}</strong></td>
              <td class="xp-cell"><strong>{{this.xp.available}}</strong></td>
              <td class="xp-cell"><strong>{{this.xp.totalEarned}}</strong></td>
              <td class="xp-cell">{{this.xp.spentAttributes}} / {{this.xp.maxAttributeSpend}}</td>
              <td class="grant-cell">
                <div class="grant-controls">
                  <div class="grant-group">
                    <input type="number" class="xp-amount-input" data-character-id="{{this.id}}" min="0" value="0" placeholder="+" title="Grant XP" />
                    <button type="button" class="grant-xp-btn" data-character-id="{{this.id}}" title="Grant XP">
                      <i class="fas fa-plus"></i>
                    </button>
                  </div>
                  <div class="xp-row-actions">
                    <button type="button" class="history-xp-btn" data-character-id="{{this.id}}" title="XP History">
                      <i class="fas fa-history"></i>
                    </button>
                    {{#if (userIsGM)}}
                    <button type="button" class="reset-progress-xp-btn" data-character-id="{{this.id}}" title="Reset to post-creation (attributes, skills, powers). All earned XP becomes available." {{#unless this.hasPostCreationSnapshot}}disabled{{/unless}}>
                      <i class="fas fa-undo"></i>
                    </button>
                    {{/if}}
                  </div>
                </div>
              </td>
            </tr>
            {{else}}
            <tr>
              <td colspan="7" class="empty-message">
                <i class="fas fa-info-circle"></i> No player characters found.
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</div>

