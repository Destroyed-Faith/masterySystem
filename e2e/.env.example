# Base URL of your Foundry server (no trailing slash)
FOUNDRY_URL=https://forge-vtt.com

# Direct game URL — fastest for Forge (copy from browser after GM login)
FOUNDRY_GAME_URL=https://forge-vtt.com/game/your-world-slug

# Optional: world name on join/setup screen (display name substring, NOT a URL)
# FOUNDRY_WORLD=Destroyed Faith

# Join credentials (GM user recommended)
FOUNDRY_USERNAME=your-playwright-gm-user
# FOUNDRY_PASSWORD=your-password-here

# Setup/admin gate password (self-hosted Foundry only)
# FOUNDRY_ADMIN_PASSWORD=

# Required for DF 2026 smoke specs — must be an isolated test world (never campaign)
# FOUNDRY_ISOLATED_TEST=1
